    )
    if any(marker in message for marker in io_markers):
        return EXIT_IO
    if any(marker in message for marker in stale_markers):
        return EXIT_COLLISION
    if any(marker in message for marker in malformed_markers):
        return 3
    return EXIT_INTERNAL

def _evolve_json_bytes(claim: Any) -> bytes:
    return (
            "blast_radius": blast_radius,
            "accepted_blast_radius_sha256": accepted_blast_radius_sha256,
            # Present only under a policy: absent fields stay out of the
            # digest body, so a policy-free preview keeps its digest (MG-R1).
            **policy_values,
            **shape_values,
            **outcome_values,
            **(_include_snapshot_values(before_loaded_model, candidate_model)
               if before_loaded_model.includes else {}),
        }
        digest_body = {key: _json_ready(value) for key, value in values.items()}
        digest_body["schema_version"] = proposal.schema_version
        preview = EvolutionPreview(
            schema_version=proposal.schema_version,
            **values,
            preview_sha256=canonical_sha256(digest_body),
        )
        if before_loaded_model.includes:
            _include_claim_cap(canonical_json_bytes(preview))
        return preview

    def _include_candidate(self, proposal, before, document, placed):
        from gnd.model import _composed_view
    assert exit_code == answer["preview_exit"], refusal
    reason = answer["preview_reason"]
    if reason is not None:
        assert EXPECTED["reasons"].get(reason, reason) in refusal


def test_t5_d12_outcomes_equal_the_base_commit_table() -> None:
    spec = importlib.util.spec_from_file_location("ik2_d12_capture", D12_CAPTURE)
    assert spec is not None and spec.loader is not None
    capture = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(capture)
    baseline = json.loads(D12_BASELINE.read_text(encoding="utf-8"))
    before = capture.base()
    rows: dict[str, str] = {}
    for source in capture.SOURCES:
        for status in ("proposed", "confirmed"):
            for modality in ("alethic", "deontic"):
                constraint = capture.new_constraint(source, status, modality)
                rows[f"new:{source}:{status}:{modality}"] = capture.outcome(
                    before, capture.with_constraint(before, constraint)
                )
    rows["unchanged"] = capture.outcome(before, copy.deepcopy(before))
    smuggled = capture.new_constraint("llm-inferred", "proposed", "deontic")
    smuggled["provenance"]["actor_id"] = "owner:fixture"
    rows["audit-smuggling"] = capture.outcome(before, capture.with_constraint(before, smuggled))
    unknown = capture.new_constraint("llm-inferred", "proposed", "deontic")
    unknown["source"] = "oracle"
    rows["unknown-source"] = capture.outcome(before, capture.with_constraint(before, unknown))
    assert len(baseline["rows"]) == 27
    assert rows == {**baseline["rows"], **VG2_D12_DELTA}
    assert len(VG2_D12_DELTA) == 8 and set(VG2_D12_DELTA) <= set(baseline["rows"])


#: reviewed-vocabulary-growth VG2 (issue 218, plan D2 (a)): the eight rows of the
#: table captured at 328061ee that D-12 now answers differently. The captured
#: fixture stays as recorded; every other row must still equal it.
VG2_D12_DELTA = {
    f"new:{source}:{status}:{modality}": (
        "admitted" if (status, modality) == ("proposed", "deontic")
        else "new sample and common-sense constraints must be proposed/deontic (D-12)")
    for source in ("sample", "common-sense")
    for status in ("proposed", "confirmed")
    for modality in ("alethic", "deontic")
}



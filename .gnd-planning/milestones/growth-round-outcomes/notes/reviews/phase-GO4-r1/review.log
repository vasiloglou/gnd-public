   234	def _constraint_modify_detail(before: Any, after: Any) -> str | None:
   235	    """None when the MODIFY is admitted; otherwise the refusing key and verdict."""
   236	
   237	    changes = diff_paths(before, after)
   238	    if not changes:
   239	        return None
   240	    family = _lookup(before, "type")
   241	    for path, left, right in changes:
   242	        verdict = constraint_change(path, left, right, family=family)
   243	        if verdict in (_ADMITTED, _WEAKENING):
   244	            continue
   245	        return f"{path} {verdict}"
   246	    return None

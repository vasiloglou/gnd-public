   249	def _element_modify_detail(before: Any, after: Any, allowed: frozenset[str]) -> str | None:
   250	    changes = diff_paths(before, after)
   251	    # A path is admitted when it is an allowed key or lies beneath one, so an
   252	    # edited `description.summary` is a description edit.
   253	    refused = sorted(
   254	        path for path, _left, _right in changes
   255	        if not any(path == key or path.startswith(key + ".") for key in allowed)
   256	    )

t\", \"json\")\n177\t    checked = _success(out, \"check\", model, population, \"--format\", \"json\")\n178\t    return {\n179\t        \"model_sha256\": index[\"model\"][\"sha256\"],\n180\t        \"population_sha256\": sha256_hex(raw),\n181\t        \"extraction_sha256\": sha256_hex(sidecar),\n182\t        \"bundle_index_sha256\": sha256_hex(index_raw),\n183\t        \"verification\": _decode(verified)[\"outcome\"],\n184\t        \"check\": _decode(checked)[\"outcome\"],\n185\t    }\n186\t\n187\t\n188\tdef compare_scores(left: dict[str, str], right: dict[str, str]) -> tuple[str, list[str]]:\n189\t    \"\"\"Compare scores by the declared evidence context.\"\"\"\n190\t    mismatches = [name for name in CONTEXT if name in left and name in right and left[name] != right[name]]\n191\t    if mismatches:\n192\t        return \"incompatible\", mismatches\n193\t    missing = [name for name in (*CONTEXT, \"score\") if name not in left or name not in right]\n194\t    return (\"unknown\", missing) if missing else (\"comparable\", [])\n195\t\n196\t\n197\tdef _comparison_inputs(raw: bytes) -> tuple[dict, list[dict], dict[str, dict[str, str]]]:\n198\t    fixture = _decode(raw)\n199\t    if (fixture.get(\"origin\") != \"synthetic\" or not isinstance(fixture.get(\"facts\"), dict)\n200\t            or not isinstance(fixture.get(\"pairs\"), list)):\n201\t        raise ExampleError(\"invalid synthetic comparison corpus\")\n202\t    facts, pairs = fixture[\"facts\"], fixture[\"pairs\"]\n203\t    _fact_rows(facts)\n204\t    by_experiment: dict[str, dict[str, str]] = {}\n205\t    for field, fact in EXPERIMENT_FIELDS.items():\n206\t        for row in facts.get(fact, []):\n207\t            if set(row) != {\"experiment\", field}:\n208\t                raise ExampleError(f\"invalid synthetic experiment field {field}\")\n209\t            record = by_experiment.setdefault(row[\"experiment\"], {})\n210\t            if field in record:\n211\t                raise ExampleError(f\"ambiguous synthetic experiment field {field}\")\n212\t            record[field] = row[field]\n213\t    ids = set()\n214\t    for pair in pairs:\n215\t        if (not isinstance(pair, dict) or set(pair) != {\"id\", \"left\", \"right\"}\n216\t                or any(not isinstance(value, str) for value in pair.values())\n217\t                or pair[\"id\"] in ids or pair[\"left\"] not in by_experiment or pair[\"right\"] not in by_experiment):\n218\t            raise ExampleError(\"invalid synthetic comparison pair\")\n219\t        ids.add(pair[\"id\"])\n220\t    return facts, pairs, by_experiment\n221\t\n222\t\n223\tdef _checked_comparisons(out: Path, facts: dict, pairs: list[dict],\n224\t                         experiments: dict[str, dict[str, str]]) -> tuple[list[dict], str]:\n225\t    population = _write(out, \"comparison.population.json\", {\n226\t        \"population\": {\"model\": \"vocabulary.orm.json\", \"source\": \"fixture\"},\n227\t        \"facts\": facts,\n228\t    })\n229\t    _success(out, \"check\", \"vocabulary.orm.json\", \"comparison.population.json\", \"--format\", \"json\")\n230\t    rows = []\n231\t    for pair in pairs:\n232\t        status, fields = compare_scores(experiments[pair[\"left\"]], experiments[pair[\"right\"]])\n233\t        rows.append({**pair, \"origin\": \"synthetic\", \"status\": status, \"fields\": fields})\n234\t    return rows, sha256_hex(population)\n235\t\n236\t\n237\tdef _dimension_probe() -> dict:\n238\t    reported, equivalent, energy = \"2 fs\", \"0.002 ps\", \"2 eV\"\n239\t    text = f\"{reported}\\n{equivalent}\\n{energy}\"\n240\t    index = recognition_index(text, {\"integer\", \"decimal\"})\n241\t    magnitude = int(reported.split()[0])\n242\t    integer_ranges = recognised_ranges(index, \"integer\", magnitude)\n243\t    equivalent_start = len(reported) + 1\n244\t    energy_start = equivalent_start + len(equivalent) + 1\n245\t    equivalent_magnitude = Decimal(equivalent.split()[0])\n246\t    equivalent_range = (equivalent_start, equivalent_start + len(str(equivalent_magnitude)))\n247\t    recognized_equivalent = equivalent_range in recognised_ranges(index, \"decimal\", equivalent_magnitude)\n248\t    normalized_equivalent = equivalent_range in integer_ranges\n249\t    energy_matches = (energy_start, energy_start + len(str(magnitude))) in integer_ranges\n250\t    return {\n251\t        \"axis\": \"dimensions\",\n252\t        \"observed\": {\n253\t            \"time\": {\"reported\": reported, \"equivalent\": equivalent},\n254\t            \"energy\": energy,\n255\t            \"reported_matches_checked_magnitude\": (0, len(str(magnitude))) in integer_ranges,\n256\t            \"equivalent_recognized_as_decimal\": recognized_equivalent,\n257\t            \"equivalent_matches_checked_magnitude\": normalized_equivalent,\n258\t            \"energy_matches_checked_magnitude\": energy_matches,\n259\t        },\n260\t        \"opens_ld2\": not normalized_equivalent or energy_matches,\n261\t        \"requirement\": \"Accept an equivalent time step and refuse the same magnitude in energy units.\",\n262\t    }\n263\t\n264\t\n265\tdef _percentage_probe() -> dict:\n266\t    before, after = Decimal(40), Decimal(45)\n267\t    absolute = after - before\n268\t    relative = (absolute / before * 100).normalize()\n269\t    values = (before, after, relative)\n270\t    text = f\"From {before}% to {after}%: {absolute} percentage points, or a relative change of {relative}%.\"\n271\t    index = recognition_index(text, {\"percent\"})\n272\t    recognized = [value for value in values if recognised_ranges(index, \"percent\", value)]\n273\t    points_as_percent = bool(recognised_ranges(index, \"percent\", absolute))\n274\t    return {\n275\t        \"axis\": \"percent-versus-points\",\n276\t        \"observed\": {\n277\t            \"recognized_percentages\": [float(value) if value % 1 else int(value) for value in recognized],\n278\t            \"absolute_change_points\": str(absolute),\n279\t            \"relative_cha
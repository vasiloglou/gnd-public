   120	def _diff(before: Any, after: Any, prefix: str, out: list[tuple[str, Any, Any]]) -> None:
   121	    """Dotted paths at which two values differ.
   122	
   123	    Dicts are descended; lists are compared whole, except ``ranges`` lists of
   124	    equal length, which are compared element-wise so a narrowed range is seen
   125	    as a change to ``ranges[i].min`` rather than to the whole list.
   126	    """
   127	
   128	    if isinstance(before, dict) and isinstance(after, dict):
   129	        for key in sorted(set(before) | set(after), key=str):
   130	            path = f"{prefix}.{key}" if prefix else str(key)
   131	            _diff(_lookup(before, key), _lookup(after, key), path, out)
   132	        return
   133	    if (
   134	        prefix.rsplit(".", 1)[-1] == "ranges"
   135	        and isinstance(before, (list, tuple))
   136	        and isinstance(after, (list, tuple))
   137	        and len(before) == len(after)
   138	    ):
   139	        for position, (left, right) in enumerate(zip(before, after, strict=True)):
   140	            _diff(left, right, f"{prefix}[{position}]", out)
   141	        return
   142	    if before != after:
   143	        out.append((prefix, before, after))
   144	

+REASONS = ('include:declaration', 'include:path', 'include:unreadable',
+           'include:size', 'include:hash-mismatch', 'include:parse',
+           'include:forbidden-section', 'include:invalid-included-model',
+           'include:unknown-target', 'include:collision', 'include:unresolved',
+           'include:unsupported-route')
+Declarations = list[dict[str, Any]]
+SECTIONS = (*ID_SECTIONS[:2], 'constraints', 'deontic_notes')
+
+
+@dataclass(frozen=True)
+class CompositionView:
+    document: dict
+    origins: tuple
+    included: tuple
+    issues: tuple
+    model: Any = None
+
+
+def _refuse(reason, path='$', detail='') -> NoReturn:
+    code = 'include:' + reason
+    raise ModelValidationError([ValidationIssue(
+        path=path, message=code + (': ' + detail if detail else ''), rule_id=code)])
+
+
+def refuse_unresolved() -> NoReturn:
+    """Refuse a consumer's include Model without matching resolver metadata."""
+    _refuse('unresolved')
+
+
+def declares_includes(document: object) -> bool:
+    return isinstance(document, Mapping) and any(
+        key in document for key in ('includes', 'fact_type_constraints'))
+
+
+def parse_declarations(document: object) -> Declarations:
+    if not isinstance(document, Mapping) or document.get('version') != 5:
+        _refuse('declaration')
+    entries = document.get('includes')
+    if not isinstance(entries, list) or not 1 <= len(entries) <= 8:
+        _refuse('declaration', '$.includes')
+    ids = set()
+    for i, entry in enumerate(entries):
+        path = f'$.includes[{i}]'
+        if not isinstance(entry, Mapping) or set(entry) != {'id', 'path', 'sha256'}:
+            _refuse('declaration', path)
+        identifier, relative, digest = (entry[k] for k in ('id', 'path', 'sha256'))
+        if (not isinstance(identifier, str) or not 1 <= len(identifier) <= 128
+                or identifier in ids or not isinstance(relative, str)
+                or not 1 <= len(relative) <= 4096 or not isinstance(digest, str)
+                or not re.fullmatch('[0-9a-f]{64}', digest)):
+            _refuse('declaration', path)
+        ids.add(identifier)
+    if 'fact_type_constraints' in document:
+        attached = document['fact_type_constraints']
+        if not isinstance(attached, list) or not attached:
+            _refuse('declaration', '$.fact_type_constraints')
+        for i, entry in enumerate(attached):
+            if (not isinstance(entry, Mapping) or set(entry) != {'fact_type', 'constraints'}
+                    or not isinstance(entry['fact_type'], str) or not entry['fact_type']
+                    or not isinstance(entry['constraints'], list) or not entry['constraints']):
+                _refuse('declaration', f'$.fact_type_constraints[{i}]')
+    return entries
+
+
+def parse_included(raw: bytes, *, include_id: str, path: str) -> dict:
+    try:
+        doc = parse_model_document(raw, source=path)
+        if isinstance(doc, dict):
+            return doc
+    except (ModelLoadError, UnicodeError, ValueError, TypeError, RecursionError, YAMLError):
+        pass
+    _refuse('parse', f'includes[{include_id}]')
+
+
+def _structural(document):
+    try:
+        return _layer1_structural(document)
+    except (TypeError, ValueError, RecursionError):
+        _refuse('declaration')
+
+
+
+def _clone(value):
+    try:
+        return copy.deepcopy(value)
+    except RecursionError:
+        _refuse('declaration', detail='container depth refused during composition')
+
+
+def include_reason(error) -> str | None:
+    return next((i.rule_id for i in error.issues if i.rule_id.startswith('include:')), None)
+
+def _ids(document):
+    """One shared id-bearing-kind walk, including anonymous constraint origins."""
+    for section in (*ID_SECTIONS, 'constraints', 'deontic_notes'):
+        for i, element in enumerate(document.get(section, [])):
+            address = f'$.{section}[{i}]'
+            yield address, element
+            if section == 'fact_types':
+                for j, constraint in enumerate(element.get('constraints', [])):
+                    yield f'{address}.constraints[{j}]', constraint
+
+
+def _merge(document, included, declarations, *, issues=None):
+    result = _clone(dict(document))
+    origins = {address: ElementOrigin('model', address, address, element.get('id'))
+               for address, element in _ids(document)}
+    targets = {}
+    for entry, doc in zip(declarations, included, strict=True):
+        offsets = {section: len(result.get(section, [])) for section in SECTIONS}
+        for section in SECTIONS:
+            result.setdefault(section, []).extend(_clone(doc.get(section, [])))
+        for address, element in _ids(doc):
+            match = re.match(r'^\$\.([a-z_]+)\[(\d+)\](.*)$', address)
+            section, index, rest = match.groups()
+            composed = f'$.{section}[{int(index) + offsets[section]}]{rest}'
+            origins[composed] = ElementOrigin(f"includes[{entry['id']}]", composed, address, element.get('id'))
+        for i, ft in enumerate(doc.get('fact_types', [])):
+            targets[ft['id']] = i + offsets['fact_types']
+    result.setdefault('object_types', [])
+    result.setdefault('fact_types', [])
+    orphaned = []
+    for i, attachment in enumerate(document.get('fact_type_constraints', [])):
+        target = targets.get(attachment['fact_type'])
+        if target is None:
+            address = f'$.fact_type_constraints[{i}]'
+            if issues is None:
+                _refuse('unknown-target', address)
+            issues.append(ValidationIssue(path=address, message='include:unknown-target',
+                                          rule_id='include:unknown-target'))
+            for j, constraint in enumerate(attachment['constraints']):
+                path = f'{address}.constraints[{j}]'
+                origins[path] = ElementOrigin('model', path, path, constraint.get('id'))
+                orphaned.append((path, constraint))
+            continue
+        constraints = result['fact_types'][target].setdefault('constraints', [])
+        for j, constraint in enumerate(attachment['constraints']):
+            address = f'$.fact_types[{target}].constraints[{len(constraints)}]'
+            origins[address] = ElementOrigin('model', address,
+                f'$.fact_type_constraints[{i}].constraints[{j}]', constraint.get('id'))
+            constraints.append(_clone(constraint))
+    seen = {}
+    for address, element in chain(_ids(result), orphaned):
+        identifier = element.get('id')
+        if identifier is not None:
+            if identifier in seen:
+                prior = origins[seen[identifier]]
+                current = origins[address]
+                _refuse('collision', current.original_address,
+                        f'{prior.origin} and {current.origin}; {address.split("[")[0]}')
+            seen[identifier] = address
+    return result, tuple(origins.values())
+
+
+def compose(document: object, *, descriptor: int, source: str | Path, historical=None, issues=None):
+    declarations = parse_declarations(document)
+    if historical is not None and (not isinstance(historical, Mapping)
+                                  or set(historical) - {entry['id'] for entry in declarations}):
+        _refuse('declaration')
+    if structural := _structural(document):
+        raise ModelValidationError(structural)
+    for i, entry in enumerate(declarations):
+        try:
+            entry['path'].encode('utf-8')  # a path the filesystem cannot name is a path refusal
+            _relative(entry['path'])
+        except (ReferenceInputError, UnicodeError):
+            _refuse('path', f'$.includes[{i}]')
+    buffers, total = [], 0
+    for i, entry in enumerate(declarations):
+        path = entry['path']
+        try:
+            if historical is not None and entry['id'] in historical:
+                historical_path_at(descriptor, path)
+                raw = historical[entry['id']]
+                if not isinstance(raw, bytes):
+                    _refuse('declaration', f'$.includes[{i}]')
+                if len(raw) > MAX_MODEL_BYTES:
+                    _refuse('size', f'$.includes[{i}]')
+            else:
+                raw, _ = artifacts.read_regular_bounded_at(descriptor, path, max_bytes=MAX_MODEL_BYTES)
+        except (OSError, artifacts.ArtifactError, ReferenceInputError) as error:
+            # Exact legacy bounded-reader spellings; no exception class changes.
+            growth = f'artifact {path} grew over the {MAX_MODEL_BYTES}-byte cap'
+            oversize = re.escape(f'artifact {path} is ') + rf'\d+ bytes, over the {MAX_MODEL_BYTES}-byte cap'
+            size = str(error) == growth or re.fullmatch(oversize, str(error))
+            _refuse('size' if size else 'unreadable', f'$.includes[{i}]')
+        total += len(raw)
+        if total > 32 * 1024 * 1024:
+            _refuse('size', f'$.includes[{i}]')
+        buffers.append(raw)
+    for i, (entry, raw) in enumerate(zip(declarations, buffers, strict=True)):
+        if hashlib.sha256(raw).hexdigest() != entry['sha256']:
+            _refuse('hash-mismatch', f'$.includes[{i}]')
+    included = [parse_included(raw, include_id=entry['id'], path=entry['path'])
+                for entry, raw in zip(declarations, buffers, strict=True)]
+    forbidden = ('includes', 'reference_populations', 'operations',
+                 'rejected_proposals', 'fact_type_constraints')
+    for entry, doc in zip(declarations, included, strict=True):
+        source_doc = doc.get('source')
+        forbidden_key = next((key for key in forbidden if key in doc), None)
+        if forbidden_key is not None:
+            _refuse('forbidden-section', f'includes[{entry["id"]}]', forbidden_key)
+        if isinstance(source_doc, Mapping) and source_doc.get('mode') == 'unattended':
+            _refuse('forbidden-section', f'includes[{entry["id"]}]', 'unattended source')
+    for entry, doc in zip(declarations, included, strict=True):
+        included_issues = _structural(doc)
+        if not included_issues:
+            included_issues = [i for i in semantic_validate(doc) if i.severity == 'error']
+        if doc.get('version') not in (1, 2, 3, 4) or included_issues:
+            detail = f'{included_issues[0].rule_id} at {included_issues[0].path}' if included_issues else 'version'
+            _refuse('invalid-included-model', f'includes[{entry["id"]}]', detail)
+    result, origins = _merge(document, included, declarations, issues=issues)
+    metadata = tuple(IncludedFile(entry['id'], entry['path'], entry['sha256'],
+                      doc['version'], doc.get('model_id'), _clone(doc.get('source')), raw)
+                     for entry, doc, raw in zip(declarations, included, buffers, strict=True))
+    return result, origins, metadata
+
+
+def included_rows(document: Mapping, origins) -> frozenset[int]:
+    """``id()`` of every element of DOCUMENT whose origin is an include (VG3).
+
+    The one origin test of the unattended rules and of the span walk. It walks
+    ``_ids(document)``, the walk ``_merge`` keys origins by, so no address is
+    parsed. A constraint the root attaches to an included fact type has origin
+    ``model``. Positional: it reads the composed document and a dump of it alike.
+    """
+    if not isinstance(document, Mapping):
+        return frozenset()
+    by_address = {entry.composed_address: entry.origin for entry in origins}
+    try:
+        return frozenset(id(element) for address, element in _ids(document)
+                         if by_address.get(address, 'model') != 'model')
+    except (AttributeError, TypeError):
+        return frozenset()
+
+
+def include_attribution(model) -> list[dict[str, Any]]:
+    """One row per include of MODEL: its id, sha256 and what its file declares (VG3, D5).
+
+    Read from each included file's own document, which is what composition
+    appends; counts only, never a value.
+    """
+    rows = []
+    for included in getattr(model, '_included', ()) or ():
+        doc = parse_included(included.raw, include_id=included.id, path=included.path)
+        constraints = [constraint for _, constraint in _iter_constraints(doc)]
+        fact_types = [row for row in doc.get('fact_types') or [] if isinstance(row, Mapping)]
+        rows.append({
+            'id': included.id, 'sha256': included.sha256,
+            'object_type_count': len(doc.get('object_types') or []),
+            'fact_type_count': len(fact_types),
+            'sample_rows': sum(len(row.get('sample_population') or []) for row in fact_types),
+            'constraints': len(constraints),
+            'confirmed': sum(c.get('status') == 'confirmed' for c in constraints),
+            'alethic': sum(c.get('modality') == 'alethic' for c in constraints),
+            'explicit_or_user_supplied': sum(c.get('source') in ('explicit', 'user-supplied')
+                                             for c in constraints),
+            'deontic_notes': len(doc.get('deontic_notes') or []),
+        })
+    return rows
+
+
+def remap_issues(issues, origins):
+    addresses = {entry.composed_address: entry for entry in origins}
+    # An issue may name an element by id: ``$.fact_types[id=X]`` or, since VG3,
+    # ``$.object_types[id=X]`` (plan H17). The selector is matched as the whole
+    # text the rules write for a declared element, never parsed, so an id holding
+    # a newline or a bracket is still found (VG3 review r1, F2).
+    selectors = {}
+    for entry in origins:
+        for section in ('$.fact_types', '$.object_types'):
+            if re.fullmatch(re.escape(section) + r'\[\d+\]', entry.composed_address):
+                selectors[f'{section}[id={entry.element_id}]'] = entry
+    result = []
+    for issue in issues:
+        path = issue.path
+        selector = max((text for text in selectors if path.startswith(text)), key=len, default=None)
+        if selector is not None:
+            path = selectors[selector].composed_address + path[len(selector):]
+        candidates = re.findall(r'\$\.[a-z_]+\[\d+\](?:\.constraints\[\d+\])?', path)
+        address = candidates[0] if candidates else ''
+        entry = addresses.get(address)
+        if entry is None and '.constraints[' in address:
+            address = address.split('.constraints[')[0]
+            entry = addresses.get(address)
+        if entry is not None:
+            if entry.origin == 'model' and entry.original_address == entry.composed_address:
+                result.append(issue)
+                continue
+            prefix = '' if entry.origin == 'model' else entry.origin + ':'
+            original = entry.original_address
+            host = selectors[selector] if selector is not None else None
+            if host is not None and entry.origin != 'model' and original.startswith(host.original_address):
+    """Every index of ``documents`` that declares ``sha256`` (one pass)."""
+    return [
+        index for index, item in enumerate(documents)
+        if isinstance(item, dict) and item.get("sha256") == sha256
+    ]
+
+
+def _declared_digests(document: dict[str, Any]) -> set[str]:
+    """The digests ``source.documents`` declares, in one pass (UG3); empty without a list."""
+    source = document.get("source")
+    listed = source.get("documents") if isinstance(source, dict) else None
+    if not isinstance(listed, list):
+        return set()
+    return {item["sha256"] for item in listed if isinstance(item, dict) and isinstance(item.get("sha256"), str)}
+
+
+def _source_document_target(
+    document: dict[str, Any],
+    operation: EvolutionOperation,
+    locator: SourceDocumentLocator,
+    declared: set[str] | None = None,
+) -> tuple[list[Any], int | None]:
+    """The ``source.documents`` list and the declared entry's index (UG3).
+
+    An add appends after refusing a duplicate digest; nothing reorders, so a
+    candidate that only reorders still fails replay equality. ``declared``, when
+    the replay passes it, is the digest set it keeps current, so a run of adds
+    is linear (UG3 review finding 6). A modify or delete needs exactly one entry
+    with the digest: two would make the target depend on list order (finding 5)."""
+    source = document.get("source")
+    documents = source.get("documents") if isinstance(source, dict) else None
+    if (documents is None and isinstance(source, dict) and "documents" not in source
+            and source.get("mode") == "unattended" and operation.kind is EvolutionOperationKind.ADD):
+        # VG4 (VG4-D1): an unattended root may start without documents (U1's
+        # first-document rule); its first round's add creates the list.
+        documents = source["documents"] = []
+    if not isinstance(documents, list):
+        purpose = " to append to" if operation.kind is EvolutionOperationKind.ADD else ""
+        raise EvolutionError(
+            f"stable locator {locator.reference()}: the model declares no source.documents{purpose}"
+        )
+    if operation.kind is EvolutionOperationKind.ADD:
+        present = (
+            locator.sha256 in declared if declared is not None
+            else bool(_declared_positions(documents, locator.sha256))
+        )
+        if present:
+            raise EvolutionError(f"add target {locator.reference()}: source document is already declared")
+        return documents, None
+    matches = _declared_positions(documents, locator.sha256)
+    if not matches:
+        raise EvolutionError(f"stable locator {locator.reference()} is absent")
+    if len(matches) > 1:
+        raise EvolutionError(
+            f"stable locator {locator.reference()} is ambiguous: {len(matches)} entries declare it"
+        )
+    return documents, matches[0]
+
+
+def _apply_declared_operations(
+    before: dict[str, Any],
+    operations: tuple[EvolutionOperation, ...],
+    *,
+    placed: list[tuple[int, str | None, list[Any], Any]] | None = None,
+) -> dict[str, Any]:
+    """Replay ``operations`` over a copy of ``before``.
+
+    ``placed`` (UG2) receives, for each constraint ADD or MODIFY, the operation
+    index, host fact type id, host list and the object put there, so the
+    population check can find the constraint's final position by identity.
+    """
+
+    document = deepcopy(before)
+    declared: set[str] | None = None  # UG3: built on the first source-document operation
+    attachments = None
+    for position, operation in enumerate(operations):
+        if isinstance(operation.locator, IncludeLocator):
+            entries = document.get('includes', [])
+            matches = [i for i, entry in enumerate(entries) if entry['id'] == operation.locator.include_id]
+            dumped = operation.model_dump(mode='json')
+            if len(matches) != 1 or entries[matches[0]] != dumped['before']:
+                raise EvolutionIncludeError('declared before value differs from include locator')
+            entries[matches[0]] = deepcopy(dumped['after'])
+            continue
+        if isinstance(operation.locator, ConstraintLocator) and operation.locator.host == 'included_fact_type':
+            from ._includes import AttachmentReplay
+
+            if attachments is None:
+                attachments = _include_input(AttachmentReplay, document)
+            placed_value = _include_input(attachments.apply, operation)
+            if placed_value is not None:
+                _record_placement(placed, position, operation, *placed_value)
+            continue
+        if isinstance(operation.locator, SourceDocumentLocator) and declared is None:
+            declared = _declared_digests(document)
+        if isinstance(operation.locator, ModelIdentityLocator):
+            dumped = operation.model_dump(mode="json")
+            declared_before = dumped["before"]
+            declared_after = dumped["after"]
+            actual_before = {
+                "version": document.get("version"),
+                "model_id": document.get("model_id"),
+            }
+            if actual_before != declared_before:
+                raise EvolutionError(
+                    f"declared before value does not match {operation.reference()}"
+                )
+            assert declared_after is not None
+            document.update(deepcopy(declared_after))
+            continue
+        collection, index = _operation_target(document, operation, declared=declared)
+    def preview(
+        self,
+        proposal: EvolutionProposal,
+        *,
+        accepted_blast_radius_sha256: str | None = None,
+        policy: str | None = None,
+        populated: Sequence[str] = (),
+        shape_report: bool = False,
+        check_population: str | None = None,
+        expected_population_sha256: str | None = None,
+        previous_includes=None,
+    ) -> EvolutionPreview:
+        """Validate and bind a proposal without changing any publication leaf.
+
+        With ``policy="additive"`` the preview also carries the additive
+        policy's verdict (MG2): ``populated_args``, the effective ``populated``
+        set and ``policy_issues``. Issues do not raise here; the preview is
+        returned for review and the CLI exits 3 when the list is non-empty.
+
+        With ``shape_report=True`` the preview also carries ``shape_matches``
+        (MG3), advice that no exit, ``breaking`` or blast radius reads.
+
+        With ``check_population`` (UG2), a population file (workspace-relative
+        or absolute beneath the workspace), the policy may clear a
+        populated-constraint refusal on the evidence of that population, and the
+        preview carries ``population_check``. ``expected_population_sha256``
+        (apply's rebuild) refuses changed bytes as stale before parsing them.
+        """
+
+        if policy is not None and policy != POLICY_ADDITIVE:
+            raise EvolutionError(f"invalid evolution policy {policy!r}: the only policy is {POLICY_ADDITIVE!r}")
+        if populated and policy is None:
+            raise EvolutionError("invalid request: --populated requires --policy additive")
+        try:
+            proposal = read_evolution_proposal_document(proposal.model_dump(mode="json"))
+        except (AttributeError, ValidationError, ValueError) as error:
+            raise EvolutionError(f"invalid proposal identity: {error}") from error
+        if proposal.schema_version != EVOLUTION_SCHEMA_VERSION:
+            raise EvolutionError(
+                "new evolution previews require the current schema version; "
+                "versions 1 and 2 are read-only compatibility evidence"
+            )
+
+        # Checked before the model is read: an incomplete evolution is a
+        # precondition failure of starting a new one, and reporting it must not
+        # be masked by the stale-CAS refusal it will usually also cause.
+        self.refuse_inherited_pending_finalization(proposal.proposal_id)
+
+        before_bytes = _regular_bytes(
+            self.allowed_project_root,
+            self._model_relative,
+            label="model",
+        )
+        before_sha256 = sha256_hex(before_bytes)
+        if before_sha256 != proposal.expected_model_sha256:
+            raise EvolutionError(
+                "stale expected model identity before preview: "
+                f"expected {proposal.expected_model_sha256}, observed {before_sha256}"
+            )
+        try:
+            before_text = before_bytes.decode("utf-8")
+        except UnicodeDecodeError as error:
+            raise EvolutionError(f"model is not UTF-8: {error}") from error
+
+        # The CURRENT model is validated first, and nothing reads its parsed
+        # form before this line. `load_model` is what runs the alias/event guard
+        # (T-01-02) and the two validation layers, so parsing the live bytes
+        # ahead of it would both construct alias-bearing input the guard exists
+        # to refuse and hand the gate below a document whose shapes nothing has
+        # checked -- where `parameters: 1` raises TypeError instead of returning
+        # a refusal.
+        from ._includes import enforce_ownership, provided_history
+
+        history = _include_input(provided_history, proposal, previous_includes)
+        before_loaded_model, before_document = _load_model_document(
+            before_bytes,
+            label="current model",
+            model_path=self._model_path,
+            historical=history,
+        )
+
+        # Before the CANDIDATE is validated, deliberately. The gate reads only
+        # the current model and the proposal's declared locators, so its answer
+        # never depends on the candidate -- and running it later would make its
+        # commonest case unreachable. Renaming a fact type an operation
+        # references cannot produce a VALID candidate without also editing that
+        # operation, which is itself gated; checking the candidate's form first
+        # would therefore answer "your candidate is invalid, go fix the
+        # operations", sending the author straight into the other half of the
+        # same gate.
+        if before_loaded_model.includes:
+            if proposal.linked_projects:
+                raise EvolutionIncludeError('include:unsupported-route: linked project evolution')
+            _include_input(enforce_ownership, before_loaded_model, before_document, proposal.operations)
+        _enforce_operations_gate(before_document, proposal)
+
+        placed: list[tuple[int, str | None, list[Any], Any]] = []
+        if before_loaded_model.includes:
+            candidate_model, candidate_document, validation, declared_document = self._include_candidate(
+                proposal, before_loaded_model, before_document, placed)
+        else:
+            candidate_model, candidate_document, validation = self._validated_candidate(
+                proposal.candidate_model,
+                declared_references=before_loaded_model.reference_populations,
+            )
+            declared_document = _apply_declared_operations(before_document, proposal.operations, placed=placed)
+            if declared_document != candidate_document:
+                raise EvolutionError("declared operations do not equal the canonical candidate model")
+        _enforce_d12(before_document, candidate_document)
+        # After the gate (18), candidate validation, replay equality and D-12
+        # (all 3), so a preview written with issues is otherwise valid (spec D6).
+        # The population option is judged here, after every proposal refusal
+        # and before the policy walk that consumes its outcomes (UG2 spec §6.4,
+        # review R8): its policy requirement, then the read.
+        if check_population is not None and policy is None:
+            raise EvolutionError("invalid request: --check-population requires --policy additive")
+        policy_values = self._policy_values(
+            before_loaded_model,
+            proposal,
+            policy,
+            populated,
+            population=self._population_runner(
+                check_population,
+                before_loaded_model,
+                proposal,
+                candidate_model,
+                placed,
+                declared_document,
+                expected_population_sha256,
+            ),
+        )
+        # After the policy and every refusal, and read by nothing below: the

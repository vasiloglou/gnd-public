    """``load_model_bytes`` after the parse, for a caller that already parsed
    the same bytes under the same source (D9: one parse per load)."""
    from gnd.model._includes import _refuse, declares_includes, parse_declarations

    if declares_includes(doc):
        if "includes" not in doc:
            parse_declarations(doc)
        _refuse("unresolved")
    return _finish_model(doc)


def _model_warnings(doc, origins):
    from gnd.model._includes import included_rows, remap_issues
    from gnd.model._unattended import _INCLUDED

    issues = remap_issues(_layer1_structural(doc), origins)
    if issues:
        raise ModelValidationError(issues)
    # VG3: the unattended rules read which elements came from an include.
    token = _INCLUDED.set(included_rows(doc, origins))
    try:
        issues = remap_issues(semantic_validate(dict(doc)), origins)
    finally:
        _INCLUDED.reset(token)
    errors = [issue for issue in issues if issue.severity == "error"]
    warnings = [issue for issue in issues if issue.severity == "warning"]
    if errors:
        raise ModelValidationError(errors, warnings)
    return warnings


def _finish_model(doc, origins=(), included=(), *, _warnings=None, _references_validated=False) -> Model:
    warnings = _model_warnings(doc, origins) if _warnings is None else _warnings
    model = Model.model_validate({**dict(doc), "warnings": warnings})

    model._provenance = origins
    model._included = included
    if not _references_validated:
        validate_declarations(model)
    _attach_compiled_obligations(model)
    return model




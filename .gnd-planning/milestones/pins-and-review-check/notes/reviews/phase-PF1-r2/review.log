+def iter_skill_files(root: Traversable, prefix: str='') -> Iterator[tuple[str, Traversable]]:
+    for entry in root.iterdir():
+        rel = f'{prefix}{entry.name}'
+        if entry.is_dir():
+            yield from iter_skill_files(entry, f'{rel}/')
+        else:
+            yield (rel, entry)

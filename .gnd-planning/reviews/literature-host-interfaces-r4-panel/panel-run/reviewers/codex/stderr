574: def replay(folder: Path, *, fixture: Path = FIXTURE, vocabulary_fixture: Path = DEPTH_FIXTURE) -> dict:
575:     """Re-derive the reading result from retained evidence without invoking producers."""
576:     manifest, artifacts, retained = _read_retained(folder)
577:     inputs = ReadingInputs(fixture, retained_responses=artifacts["producer-output-table.json"],
578:                            vocabulary_fixture=vocabulary_fixture)
579:     _need(manifest.get("inputs") == inputs.pins(), "stale reading input")
580:     observed, actual, report = _evaluate(inputs, manifest.get("budget_bytes"),

     determinant_constraints[frozenset(ModelIndex.constraint_roles(constraint))].append(i)\n146\t    if len(roles) < 2:\n147\t        return roles, None, ()\n148\t    if len(roles) == 2 and all(frozenset({role}) in determinant_constraints for role in roles):\n149\t        return (\n150\t            roles,\n151\t            \"OneToOne\",\n152\t            tuple(i for role in roles for i in determinant_constraints[frozenset({role})]),\n153\t        )\n154\t    role_set = frozenset(roles)\n155\t    by_omitted = {\n156\t        next(iter(role_set - determinant)): indexes\n157\t        for determinant, indexes in determinant_constraints.items()\n158\t        if len(determinant) == len(roles) - 1 and determinant <= role_set\n159\t    }\n160\t    for omitted in reversed(roles):\n161\t        if selected := by_omitted.get(omitted):\n162\t            prefix = tuple(role for role in roles if role != omitted)\n163\t            return (*prefix, omitted), \"ManyToOne\", selected\n164\t    return roles, None, ()\n165\t\n166\t\n167\tdef _verbalizes(fact, role_tokens, role_types):\n168\t    roles = list(role_types)\n169\t    forward = iter(roles)\n170\t    readings = [_PLACEHOLDER.sub(lambda _match: role_tokens[next(forward)], fact[\"reading\"])]\n171\t    inverse = fact.get(\"inverse_reading\")\n172\t    if not inverse:\n173\t        return readings, False\n174\t    matches = list(_PLACEHOLDER.finditer(inverse))\n175\t    if not matches and len(roles) == 2:\n176\t        return [*readings, f\"{role_tokens[roles[1]]} {inverse} {role_tokens[roles[0]]}\"], True\n177\t    inverse_roles = [match[1].partition(\":\")[2].strip() for match in matches]\n178\t    if len(inverse_roles) == len(roles) and set(inverse_roles) == set(roles):\n179\t        readings.append(\n180\t            _PLACEHOLDER.sub(lambda match: role_tokens[match[1].partition(\":\")[2].strip()], inverse)\n181\t        )\n182\t        return readings, True\n183\t    return readings, False\n184\t\n185\t\n186\tdef _relationship(fact, names, order, role_types):\n187\t    by_role = {role: names[object_type] for role, object_type in role_types.items()}\n188\t    first, *additional = order\n189\t    roles = [{\"concept\": by_role[role], \"name\": role} for role in additional]\n190\t    tokens = {first: \"{\" + by_role[first] + \"}\"}\n191\t    tokens.update({role: f\"{{{by_role[role]}:{role}}}\" for role in additional})\n192\t    readings, inverse = _verbalizes(fact, tokens, role_types)\n193\t    result = {\"name\": fact[\"id\"], \"verbalizes\": readings}\n194\t    if roles:\n195\t        result[\"roles\"] = roles\n196\t    return result, inverse\n197\t\n198\t\n199\tdef _add_references(objects, components, names, functional_links, constraints, mapped, indexes, identification):\n200\t    # Pre-index composite UC candidates by their shared identifying entity.\n201\t    composite = {}\n202\t    for i, constraint in enumerate(constraints):\n203\t        if (\n204\t            constraint.get(\"type\") != \"uniqueness\"\n205\t            or constraint.get(\"scope\") != \"external\"\n206\t            or constraint.get(\"modality\") != \"alethic\"\n207\t            or constraint.get(\"status\") != \"confirmed\"\n208\t        ):\n209\t            continue\n210\t        links = []\n211\t        entity = None\n212\t        for ref in constraint.get(\"role_refs\", ()):\n213\t            fact_id = ref[\"fact_type\"]\n214\t            link = functional_links.get(fact_id)\n215\t            if link is None:\n216\t                break\n217\t            owner, dependent_role = link\n218\t            if dependent_role != ref[\"role\"]:\n219\t                break\n220\t            if entity is not None and owner != entity:\n221\t                break\n222\t            entity = owner\n223\t            links.append(fact_id)\n224\t        else:\n225\t            if entity is not None and links:\n226\t                priority = bool(constraint.get(\"preferred\"))\n227\t                previous = composite.get(entity)\n228\t                if previous is None or (priority and not previous[0]):\n229\t                    composite[entity] = (priority, i, links)\n230\t\n231\t    for oid, obj in objects.items():\n232\t        ref = obj.get(\"reference\") or {}\n233\t        component = components[oid]\n234\t        mode = ref.get(\"mode\")\n235\t        path = (\"object_types\", indexes[oid], \"reference\")\n236\t        if mode in {\"popular\", \"general\"}:\n237\t            value_type = ref[\"value_type\"]\n238\t            rels = component.setdefault(\"relationships\", [])\n239\t            used = {r[\"name\"] for r in rels}\n240\t            key = \"gnd_reference\"\n241\t            while key in used:\n242\t                key = \"_\" + key\n243\t            rels.append(\n244\t                {\n245\t                    \"name\": key,\n246\t                    \"roles\": [{\"concept\": names[value_type]}],\n247\t                    \"verbalizes\": [f\"{{{names[oid]}}} is identified by {{{names[value_type]}}}\"],\n248\t                    \"multiplicity\": \"OneToOne\",\n249\t                }\n250\t            )\n251\t            component[\"identify_by\"] = [key]\n252\t            identification[oid] = (\"simple\", key)\n253\t            mapped[path] = _NATIVE_LITERAL\n254\t            mapped[(*path, \"value_type\")] = _NATIVE_LITERAL\n255\t        elif mode == \"external\" and oid in composite:\n256\t            _, index, links = composite[oid]\n257\t            component[\"identify_by\"] = links\n258\t            identification[oid] = (\"composite\", tuple(links))\n259\t            mapped[path] = _NATIVE_LITERAL\n260\t            mapped[(\"constraints\", index)] = _NATIVE_LITERAL\n261\t\n262\t\n263\tdef _inherit_identifiers(objects, components, indexes, mapped, identification):\n264\t    parents = {oid: tuple(obj.get(\"subtype_of\") or ()) for oid, obj in objects.items()}\n265\t    try:\n266\t        order = list(TopologicalSorter(parents).static_order())\n267\t    except CycleError as error:\n268\t        raise OssieInputError(\"ossie:cyclic-subtypes\") from error\n269\t    direct = {\n270\t        oid\n271\t        for oid, obj in objects.items()\n272\t        if (obj.get(\"reference\") or {}).get(\"mode\") in {\"popular\", \"general\"}\n273\t    }\n274\t    for oid in order:\n275\t        if not objects[oid].get(\"inherits_reference\") or len(parents[oid]) != 1:\n276\t            continue\n277\t        parent = parents[oid][0]\n278\t        if parent not in direct:\n279\t            continue\n280\t        child = components[oid]\n281\t        inherited = components[parent][\"identify_by\"]\n282\t        own_names = {relationship[\"name\"] for relationship in child.get(\"relationships\", ())}\n283\t        if inherited and not child.get(\"identify_by\") and own_names.isdisjoint(inherited):\n284\t            child[\"identify_by\"] = list(inherited)\n285\t            identification[oid] = identification[parent]\n286\t            direct.add(oid)\n287\t            mapped[(\"object_types\", indexes[oid], \"inherits_reference\")] = _NATIVE_LITERAL\n288\t\n289\t\n290\tdef _ontology(document, model):\n291\t    ontology, mapped, _view = _project(document, model)\n292\t    return ontology, mapped\n293\t\n294\t\n295\tdef _project(document, model):\n296\t    \"\"\"The ontology, its loss dispositions, and the view the relational mapping reads.\"\"\"\n297\t    index = ModelIndex.for_model(model)\n298\t    objects = index.object_types_by_id()\n299\t    # Role name -> object type per fact type, in declared role order.\n300\t    role_types_by_fact = index.role_object_types()\n301\t    fact_types = list(index.iter_fact_types())\n302\t    names = _names(objects)\n303\t    if not names:\n304\t        raise OssieInputError(\"an Ossie ontology requires at least one concept\")\n305\t    indexes = {obj[\"id\"]: i for i, obj in enumerate(document.get(\"object_types\", ()))}\n306\t    components = {}\n307\t    mapped = {}\n308\t    for oid, i in indexes.
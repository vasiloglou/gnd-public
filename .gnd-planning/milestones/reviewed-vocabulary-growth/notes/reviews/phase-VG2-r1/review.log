def _evolve_error_exit(error: Exception) -> int:
    from gnd.evolve import (
        EvolutionError,
        EvolutionIncludeError,
        EvolutionOperationsGatedError,
        EvolutionPolicyGapError,
        EvolutionPolicyRefusedError,
        EvolutionReadOnlyCompatibilityError,
    )
    from gnd.evolve.population_check import EvolutionPopulationError
    from gnd.safefs import InstallPathError

    if isinstance(error, _EvolutionCLIError):
        return error.exit_code
    if isinstance(error, EvolutionIncludeError):
        return 3
    # Before the generic EvolutionError arm, and by TYPE rather than by message
    # substring: the gate's refusal text names user-supplied element ids, and a
    # message-family match over those is how an id containing "stale " would
    # silently become exit 11.
    if isinstance(error, EvolutionOperationsGatedError):
        return EXIT_EVOLUTION_OPERATIONS_GATED
    # By type as well: the additive policy's refusal at apply names
    # user-supplied ids, and 3 is the band for a valid request refused by
    # policy (MG-D12).
    if isinstance(error, EvolutionPolicyRefusedError):
        return 3
    # By type (UG3): a locator kind the policy has no rule for fails closed.
    if isinstance(error, EvolutionPolicyGapError):
        return 3
    # By type: the population check's refusal carries its own band and a
    # fixed, value-free message (UG2, UG-R6).
    if isinstance(error, EvolutionPopulationError):
        return error.exit_code
    # Before the generic arm, and by TYPE for the same reason: a pending state
    # this tool can read but cannot finish is a collision with existing
    # evidence, not a malformed input (D-P3.5).
    if isinstance(error, EvolutionReadOnlyCompatibilityError):
        return EXIT_COLLISION
    if isinstance(error, EvolutionError):
        return _evolve_service_exit(error)
    if isinstance(error, InstallPathError):
        return EXIT_IO
    if isinstance(error, FileNotFoundError):
        return EXIT_NO_INPUT
    if isinstance(error, OSError):
        return EXIT_IO
    return EXIT_INTERNAL
    return EXIT_INTERNAL

def _evolve_policy_arguments(
    policy: str | None, populated: list[str] | None, check_population: str | None = None
) -> None:
    """``--populated`` and ``--check-population`` mean something only under a policy (3)."""

    if populated and policy is None:
        raise _EvolutionCLIError(3, "--populated requires --policy additive")


def _reviewed_population_sha256(reviewed: Any) -> str | None:
    check = getattr(reviewed, "population_check", None)
    return None if check is None else check.sha256


def _evolve_population_relative(workspace: Path, value: str | None) -> str | None:
    """The population path as given, made absolute lexically, or None without the option (UG2).

    No filesystem access here: containment, symlinks and existence are judged
    by the service's read, after every proposal refusal (UG2 spec §6.4, review R8).
    """

    if value is None:
        return None
    return os.path.abspath(value)


def _evolve_fail(error: Exception, *, stage: str) -> int:
    exit_code = _evolve_error_exit(error)
    print(f"EVOLUTION {stage.upper()} REFUSED ({exit_code}): {error}", file=sys.stderr)
    return exit_code

def _evolve_finish_apply(service: Any, pending: Any, output_format: str) -> int:
    """Complete the published evolution inside the same ``apply`` invocation.

    R-02 (MODEL-02): ``run_conformance`` is reachable only from
    ``EvolutionService.finalize``, and ``apply``/``finalize`` are separate
    user-facing subcommands, so "stopped after apply" was an ordinary user state
    in which a model change was published with no downstream recheck. The staged
    two-phase *service* protocol is deliberately unchanged (04-05…04-07 locked
    the model CAS as the explicit commit point, with conformance following it
    without rollback and the record published last); the gap closes here, at the
    command boundary.

    The two claims stay two payloads — D-24 forbids presenting the publication
    claim and the conformance claim as one verdict — and the command's exit is
    finalize's raw aggregate conformance exit, so drift is a published model
    with a reported problem rather than a failed apply.
    """

    _evolve_emit_claim(pending, output_format, stage="apply")
    try:
        record = service.finalize(pending)
    except Exception as error:  # closed public exit mapping
        raise _EvolutionCLIError(
            _evolve_error_exit(error),
            "model CAS committed, but the chained finalization was refused; the model "
            "is published and its downstream recheck is incomplete — complete it with "
            f"`gnd evolve finalize`: {error}",
        ) from error
    _evolve_emit_claim(record, output_format, stage="finalize")
    return record.conformance_exit_code

def _evolve_previous_includes(workspace, model, relative, proposal, flags):
    if flags is None or flags == []:
        return None
    from gnd.artifacts import sha256_hex
    from gnd.evolve import EvolutionIncludeError
    from gnd.evolve._includes import previous_bindings, provided_history
    from gnd.evolve.service import _include_input, _regular_bytes
    from gnd.model import parse_model_document

    raw = _regular_bytes(workspace, relative, label='model')
    if sha256_hex(raw) != proposal.expected_model_sha256:
        raise _EvolutionCLIError(EXIT_COLLISION, 'stale expected model identity before preview')
    document = _include_input(parse_model_document, raw, source=model)
    paths = _include_input(previous_bindings, document, flags)
    _include_input(provided_history, proposal, {identifier: b'' for identifier in paths})
    snapshots = {}
    for identifier, path in paths.items():
        try:
            selected = Path(path) if Path(path).is_absolute() else workspace / path
            _, source = _evolve_workspace_path(workspace, str(selected), label='previous include', required=True)
        except _EvolutionCLIError as error:
            raise EvolutionIncludeError(str(error)) from error
        snapshots[identifier] = _include_input(_regular_bytes, workspace, source, label='previous include')
    return snapshots



_keys\": []},\n37\t}\n38\tPACKAGED_NAMES = (\"study-methods\", \"alanine\", \"approximation\", \"alternative_integrator\", \"subject_label\",\n39\t                  \"saved-public-fixture\")\n40\t\n41\t\n42\tclass Producer:\n43\t    \"\"\"A host's producer: only ``produce``, and its own record of every call.\"\"\"\n44\t\n45\t    def __init__(self, answers=None):\n46\t        self.answers = answers if answers is not None else ANSWERS\n47\t        self.seen = []\n48\t\n49\t    def produce(self, call):\n50\t        self.seen.append(call)\n51\t        return copy.deepcopy(self.answers[call.section])\n52\t\n53\t\n54\tclass Forbidden:\n55\t    def produce(self, call):\n56\t        pytest.fail(f\"producer called for {call.section}\")\n57\t\n58\t\n59\tclass Reviewer:\n60\t    def __init__(self, decision=\"supported\"):\n61\t        self.decision = decision\n62\t\n63\t    def review(self, call):\n64\t        if self.decision == \"list\":\n65\t            return [\"supported\"]\n66\t        return {\"decision\": self.decision, \"basis\": f\"the excerpt states it ({call.section})\"}\n67\t\n68\t\n69\tdef _root(tmp_path, *, declared=False, profile=None, name=\"root\"):\n70\t    root = tmp_path / name\n71\t    shutil.copytree(CALLER, root)\n72\t    if declared:\n73\t        shutil.copyfile(root / \"profile-declared.json\", root / \"profile.json\")\n74\t    if profile is not None:\n75\t        (root / \"profile.json\").write_bytes(canonical_json_bytes(profile))\n76\t    return root\n77\t\n78\t\n79\tdef _profile(**changes):\n80\t    value = json.loads((CALLER / \"profile.json\").read_bytes())\n81\t    value.update(changes)\n82\t    return value\n83\t\n84\t\n85\tdef _edit(root, name, change):\n86\t    value = json.loads((root / name).read_bytes())\n87\t    change(value)\n88\t    (root / name).write_bytes(canonical_json_bytes(value))\n89\t\n90\t\n91\tdef _refuses(out, call, match=None):\n92\t    with pytest.raises((reading.ExampleError, ArtifactError), match=match):\n93\t        call
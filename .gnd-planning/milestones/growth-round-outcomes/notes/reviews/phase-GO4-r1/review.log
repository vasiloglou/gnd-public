    54	def _translate(reply: dict[str, Any], raw: bytes) -> dict[str, Any]:
    55	    digest = hashlib.sha256(raw).hexdigest()
    56	
    57	    def spans(entry: dict[str, Any]) -> list[dict[str, Any]]:
    58	        return [_span(raw, entry["quote"], entry.get("quote_occurrence"))]
    59	
    60	    object_types: list[dict[str, Any]] = []
    61	    for entry in reply["object_types"]:
    62	        element = {k: v for k, v in entry.items() if k != "quote"}
    63	        element["provenance"] = {"spans": spans(entry)}
    64	        object_types.append(element)
    65	    by_id = {element["id"]: element for element in object_types}
    66	    for link in reply["subtype_links"]:
    67	        subtype = by_id[link["subtype"]]
    68	        subtype["subtype_of"] = [link["supertype"]]
    69	        subtype["inherits_reference"] = link["inherits_reference"]
    70	        subtype["provenance"]["spans"].append(_span(raw, link["quote"]))
    71	        subtype["provenance"]["rationale"] = link["rationale"]
    72	
    73	    fact_types: list[dict[str, Any]] = []
    74	    for entry in reply["fact_types"]:
    75	        element = {k: v for k, v in entry.items() if k not in {"quote", "rows"}}
    76	        element["sample_population"] = [row["values"] for row in entry["rows"]]
    77	        element["provenance"] = {
    78	            "spans": spans(entry),
    79	            "sample_spans": [{"row": i, "span": _span(raw, row["quote"])} for i, row in enumerate(entry["rows"])],
    80	        }
    81	        fact_types.append(element)
    82	
    83	    for entry in reply.get("derived_fact_types", ()):   # the acceptance replay builds replies without it
    84	        # A derived fact type is the model's own fact type shape with a structured rule. It
    85	        # holds no rows: its facts follow from the rule, so there is nothing to sample.
    86	        assert isinstance(entry["derivation_rule"], dict), "an opaque rule is an open question, not a proposal"
    87	        assert "rows" not in entry
    88	        element = {k: v for k, v in entry.items() if k not in {"quote", "rationale"}}
    89	        element["provenance"] = {"spans": spans(entry), "rationale": entry["rationale"]}
    90	        fact_types.append(element)
    91	
    92	    top_level: list[dict[str, Any]] = []
    93	    for entry in reply["constraints"]:
    94	        constraint = copy.deepcopy(entry["constraint"])
    95	        constraint.update(
    96	            source=_SOURCE_BY_BASIS[entry["basis"]], status="proposed", modality="deontic",
    97	            rationale=entry["rationale"],
    98	        )
    99	        if entry["basis"] == "library":
   100	            constraint["provenance"] = {"library_entry": entry["library_entry"]}
   101	        else:
   102	            constraint["provenance"] = {"spans": spans(entry)}
   103	            if entry["basis"] == "text-cue":
   104	                constraint["provenance"]["rationale_world_fact"] = entry["cue"]
   105	        if entry["host"] == "model":
   106	            top_level.append(constraint)
   107	        else:
   108	            next(f for f in fact_types if f["id"] == entry["host"]).setdefault("constraints", []).append(constraint)
   109	
   110	    return {
   111	        "version": 1,
   112	        "model_id": "unattended-growth-example",
   113	        "source": {"kind": "prose", "mode": "unattended", "reviewer": "none",
   114	                   "documents": [{"sha256": digest, "label": reply["document"]}]},
   115	        "object_types": object_types,
   116	        "fact_types": fact_types,
   117	        "constraints": top_level,
   118	    }

}]+)\\}\")\n50\t_NATIVE_LITERAL = (\"native\", \"projected-with-source-spelling\", None)\n51\t_POPULATION_REFUSAL = \"population:out-of-scope\"\n52\t#: Largest size of each written artifact unless the caller raises it (OB1). Equal to\n53\t#: ``input_policy.MAX_BYTES`` today but deliberately not an alias of that input cap.\n54\tDEFAULT_MAX_OUTPUT_BYTES = 10 * 1024 * 1024\n55\tMAX_OUTPUT_BYTES_CEILING = MAX_BYTES_CEILING\n56\t\n57\t\n58\tclass OssieInputError(ValueError):\n59\t    \"\"\"The source cannot be exported with the selected policy.\"\"\"\n60\t\n61\t\n62\t#: What :func:`render_ossie` raises for a refused input, besides the model's own errors.\n63\tINPUT_REFUSALS = (OssieInputError, BindingError)\n64\t\n65\t\n66\t@dataclass(frozen=True)\n67\tclass OssieArtifacts:\n68\t    document: bytes\n69\t    sidecar: bytes\n70\t    loss_report: bytes\n71\t    #: How many fact types declare ``redact``, on the fact type or on a role. The\n72\t    #: export carries their readings, constraints and provenance text unchanged\n73\t    #: (issue 169); the command says so with this count and no name or value.\n74\t    redacted_fact_types: int = 0\n75\t    #: The Ossie semantic model and mapping (OB3), or ``None`` for an ontology-only run.\n76\t    semantic_model: bytes | None = None\n77\t    mapping: bytes | None = None\n78\t\n79\t\n80\t@lru_cache(maxsize=1)\n81\tdef _schema() -> Draft202012Validator:\n82\t    resource = files(\"gnd\").joinpath(\"schema\", \"ossie\", \"ontology.json\")\n83\t    return Draft202012Validator(loads(resource.read_bytes()))\n84\t\n85\t\n86\tdef _read_model(path: Path):\n87\t    try:\n88\t        descriptor = open_regular(path)\n89\t    except NotRegularFileError as error:\n90\t        raise OssieInputError(\"model path is not a regular file\") from error\n91\t    with open(descriptor, \"rb\") as stream:\n92\t        raw = stream.read(MAX_MODEL_BYTES + 1)\n93\t    try:\n94\t        if path.suffix != \".json\":\n95\t            guard_yaml(raw, max_bytes=M
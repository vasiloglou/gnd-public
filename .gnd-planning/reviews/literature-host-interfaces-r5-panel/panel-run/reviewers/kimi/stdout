acts\")\n418\t    _need(manifest.get(\"format\") == \"literature-reading-run/1\"\n419\t          and isinstance(roster, dict) and set(roster) == set(FILES), \"incomplete stage roster\")\n420\t    artifacts = {}\n421\t    predecessor = None\n422\t    for index, stage in enumerate(STAGES):\n423\t        name = f\"stage-{index}.json\"\n424\t        raw = _read(run, name)\n425\t        stage_record = _decode(raw)\n426\t        _need(sha256_hex(raw) == roster[name] and stage_record.get(\"stage\") == stage\n427\t              and stage_record.get(\"predecessor_sha256\") == predecessor\n428\t              and stage_record.get(\"payload_sha256\") == roster[f\"payload-{index}.json\"],\n429\t              \"stale retained reading stage\")\n430\t        artifacts[name] = raw\n431\t        predecessor = sha256_hex(raw)\n432\t    for name in FILES:\n433\t        if name in artifacts:\n434\t            continue\n435\t        raw = _read(run, name)\n436\t        _need(sha256_hex(raw) == roster[name], \"stale retained reading output\")\n437\t        artifacts[name] = raw\n438\t    retained = {}\n439\t    for stage_index in (1, 3):\n440\t        payload = _decode(artifacts[f\"payload-{stage_index}.json\"])\n441\t        retained.update({row[\"section\"]: row[\"response\"] for row in payload[\"attempts\"]})\n442\t    return manifest, artifacts, retained\n443\t\n444\t\n445\tdef _evaluate(inputs, budget, scenario, *, producer=None, retained=None, retained_pins=None):\n446\t    _need(type(budget) is int and 0 <= budget <= MAX_BUDGET and scenario in SCENARIOS, \"invalid reading settings\")\n447\t    retained = retained or {}\n448\t    unavailable = {\"study-methods\"} if scenario == \"unavailable\" else set()\n449\t    broad, left = _inspect(inputs, STAGES[1], inputs.selection(\"opening\"), budget, producer, retained)\n450\t    opened = {row[\"section\"]: row for row in broad[\"attempts\"]}\n451\t    needed = {row[\"section\"] for row in inputs.questions.values() if row[\"superseded_by\"] is None\n452\t              and row[\"fact\"] not in opened.get(row[\"section\"], {}).get(\"response\", {}).get(\"facts\", {})}\n453\t    planned_targeted = [name for name in inputs.selection(\"targeted\") if name in needed]\n454\t    selected = [name for name in planned_targeted if name not in unavailable]\n455\t    targeted, left = _inspect(inputs, STAGES[3], selected, left, producer, retained)\n456\t    recorded_calls = {STAGES[1]: broad[\"original_producer_calls\"], STAGES[3]: targeted[\"original_producer_calls\"]}\n457\t    _need(producer is None or producer.calls == recorded_calls, \"producer call counts disagree with captured attempts\")\n458\t    attempts = [*broad[\"attempts\"], *targeted[\"attempts\"]]\n459\t    attempted = {row[\"section\"]: row for row in attempts}\n460\t    judgments = _review_attempts(inputs, attempts)\n461\t    coverage, questions = _outcomes(inputs, attempted, unavailable)\n462\t    resolved = {row[\"id\"] for row in questions if row[\"outcome\"] == \"resolved\"}\n463\t    required = set()\n464\t    for key, question in inputs.questions.items():\n465\t        if not question[\"required\"]:\n466\t            continue\n467\t        while inputs.questions[key][\"superseded_by\"] is not None:\n468\t            key = inputs.questions[key][\"superseded_by\"]\n469\t        required.add(key)\n470\t    unavailable_reads = unavailable | {\n471\t        row[\"section\"] for row in coverage if row[\"state\"] == \"unavailable\"\n472\t    }\n473\t    if required <= resolved:\n474\t        stop = \"required-coverage-completed\"\n475\t    elif broad[\"omitted\"] or targeted[\"omitted\"]:\n476\t        stop = \"budget-exhausted\"\n477\t    else:\n478\t        stop = \"available-evidence-exhausted\"\n479\t    proposed_keys = {key for row in targeted[\"attempts\"] for key in row[\"response\"][\"proposal_keys\"]}\n480\t    earlier = {name: row for name, row in inputs.sections.items() if name in opened}\n481\t    revisit = affected_sections(earlier, proposed_keys)\n482\t    routes, artifacts, fidelity = _public_results(inputs, broad[\"attempts\"], attempts)\n483\t    coverage_doc = {\"format\": \"literature-reading-coverage/1\", \"rows\": coverage}\n484\t    artifacts.update({\n485\t        \"coverage.json\": canonical_json_bytes(coverage_doc),\n486\t        \"scope.json\": inputs.raw[\"scope.json\"], \"closure.json\": inputs.raw[\"closure.json\"],\n487\t        \"producer-output-table.json\": inputs.raw[\"responses.json\"],\n488\t        **{f\"fidelity-{name}.json\": result[0] for name, result in fidelity.items()},\n489\t    })\n490\t    absence = {}\n491\t    for kind, (raw, _counts) in fidelity.items():\n492\t        scoped = {name: artifacts[name] for name in (\"scope.json\", \"closure.json\", \"coverage.json\")}\n493\t        scoped[\"fidelity.json\"] = raw\n494\t        source_pins = inputs.pins()\n495\t        pins = {\"scope.json\": source_pins[\"scope.json\"], \"closure.json\": source_pins[\"closure.json\"]}\n496\t        if retained_pins is None:\n497\t            pins.update({\"coverage.json\": sha256_hex(artifacts[\"coverage.json\"]), \"fidelity.json\": sha256_hex(raw)})\n498\t        else:\n499\t            pins.update({\"coverage.json\": retained_pins[\"coverage.json\"],\n500\t                         \"fidelity.json\": retained_pins[f\"fidelity-{kind}.json\"]})\n501\t        absence[kind] = absence_status(scoped, pins)\n502\t    payloads = (\n503\t        {\"sources\": list(inputs.sources.values()), \"sections\": list(inputs.sections.values()), \"unavailable\": sorted(unavailable)},\n504\t        broad, {\"selected\": selected, \"unresolved\": sorted(needed)}, targeted,\n505\t        {\"coverage\": coverage, \"questions\": questions, \"semantic_reviews\": judgments,\n506\t         \"vocabulary_proposals\": sorted(proposed_keys), \"revisit\": revisit},\n507\t        {\"public_routes\": routes, \"fidelity\": {name: val[1] for name, val in fidelity.items()}, \"absence\": absence},\n508\t    )\n509\t    stages = []\n510\t    predecessor = None\n511\t    for i, (stage, purpose, payload) in enumerate(zip(STAGES, PURPOSES, payloads, strict=True)):\n512\t        payload_name = f\"payload-{i}.json\"\n513\t        artifacts[payload_name] = raw = canonical_json_bytes(payload)\n514\t        record = {\n515\t            \"stage\": stage, \"purpose\": purpose, \"inputs\": inputs.pins(),\n516\t            \"predecessor_sha256\": predecessor, \"payload_sha256\": sha256_hex(raw),\n517\t            \"inspected\": [row[\"section\"] for row in payload.get(\"attempts\", [])],\n518\t            \"questions\": list(inputs.questions),\n519\t        }\n520\t        stages.append(record)\n521\t        artifacts[f\"stage-{i}.json\"] = raw = canonical_json_bytes(record)\n522\t        predecessor = sha256_hex(raw)\n523\t    manifest = {\"format\": \"literature-reading-run/1\", \"scenario\": scenario, \"budget_bytes\": budget,\n524\t                \"inputs\": inputs.pins(), \"artifacts\": {name: sha256_hex(raw) for name, raw in artifacts.items()}}\n525\t    broad_facts, final_facts = _combined(broad[\"attempts\"]), _combined(attempts)\n526\t    report = {\n527\t        \"format\": \"literature-reading-report/1\", \"stop\": stop, \"stages\": stages,\n528\t        \"producer_calls\": producer.calls if producer is not None else dict.fromkeys((STAGES[1], STAGES[3]), 0),\n529\t        \"coverage\": coverage, \"questions\": questions, \"revisit\": revisit,\n530\t        \"inspections\": [{key: value for key, value in row.items() if key != \"response\"} for row in attempts],\n531\t        \"reading_bytes\": budget - left, \"attempt_counts\": {kind: sum(row[\"outcome\"] == kind for row in attempts)\n532\t                                                            for kind in (\"accepted\", \"empty\", \"refused\")},\n533\t        \"omitted\": broad[\"omitted\"] + targeted[\"omitted\"],\n534\t        \"read_denominator\": {\n535\t            \"scheduled\": len(inputs.selection(\"opening\")) + len(selected) + len(unavailable_reads),\n536\t            \"attempted\": len(attempts),\n537\t            \"omitted\": len(broad[\"omitted\"]) + len(targeted[\"omitted\"]),\n538\t            \"unavailable\": len(unavailable_reads),\n539\t        },\n540\t        \"broad_fact_types\": sorted(broad_facts),\n541\t        \"targeted_fact_types\": sorted(final_facts),\n542\t        \"public_routes\": routes, \"fidelity\": payloads[-1][\"fidelity\"],\n543\t        \"absence\": {\"status\": absence[\"high\"], \"below_floor_status\": absence[\"low\"]},\n544\t        \"evidence_sha256\": sha256_hex(canonical_json_bytes(manifest)),\n545\t    }\n546\t    report[\"supported_fact_gain\"] = sum(\n547\t        len({canonical_json_bytes(row) for row in rows}\n548\t            - {canonical_json_bytes(row) for row in broad_facts.get(fact, [])})\n549\t        for fact, rows in final_facts.items()\n550\t    )\n551\t    report[\"newly_answered\"] = sum(\n552\t        row[\"outcome\"] == \"resolved\" and inputs.questions[row[\"id\"]][\"section\"] not in opened\n553\t        for row in questions\n554\t    )\n555\t    report[\"productivity\"] = {\n556\t        \"new_facts_per_byte\": {\"numerator\": report[\"supported_fact_gain\"], \"denominator\": budget - left},\n557\t        \"new_answers_per_byte\": {\"numerator\": report[\"newly_answered\"], \"denominator\": budget - left},\n558\t    }\n559\t    return manifest, artifacts, report\n560\t\n561\t\n562\tdef run(out: Path, *, budget=DEFAULT_BUDGET, scenario=\"full\", fixture: Path = FIXTURE) -> dict:\n563\t    \"\"\"Run the saved-response workflow and retain its complete evidence.\"\"\"\n564\t    _need(not out.exists() and not out.is_symlink(), \"reading output already exists\")\n565\t    inputs = ReadingInputs(fixture)\n566\t    manifest, artifacts, report = _evaluate(inputs, budget, scenario, producer=SavedProducer(inputs.responses))\n567\t    out.mkdir()\n568\t    for name, raw in artifacts.items():\n569\t        (out / name).write_bytes(raw)\n570\t    (out / \"run.json\").write_bytes(canonical_json_bytes(manifest))\n571\t    return report\n572\t\n573\t\n574\tdef replay(folder: Path, *, fixture: Path = FIXTURE, vocabulary_fixture: Path = DEPTH_FIXTURE) -> dict:\n575\t    \"\"\"Re-derive the reading result from retained evidence without invoking producers.\"\"\"\n576\t    manifest, artifacts, retained = _read_retained(folder)\n577\t    inputs = ReadingInputs(fixture, retained_responses=artifacts[\"producer-output-table.json\"],\n578\t                           vocabulary_fixture=vocabulary_fixture)\n579\t    _need(manifest.get(\"inputs\") == inputs.pins(), \"stale reading input\")\n580\t    observed, actual, report = _evaluate(inputs, manifest.get(\"budget_bytes\"),\n581\t                                         manifest.get(\"scenario\"), retained=retained,\n582\t                                         retained_pins=manifest[\"artifacts\"])\n583\t    _need(manifest == observed and artifacts == actual, \"re-derived reading evidence differs\")\n584\t    return report\n585\t\n586\t\n587\tdef main(argv: list[str] | None = None) -> int:\n588\t    parser = argparse.ArgumentParser(description=__doc__)\n589\t    commands = parser.add_subparsers(dest=\"command\", required=True)\n590\t    fresh = commands.add_parser(\"run\")\n591\t    fresh.add_argument(\"--out\", type=Path, required=True)\n592\t    fresh.add_argument(\"--budget-bytes\", type=int, default=DEFAULT_BUDGET)\n593\t    fresh.add_argument(\"--scenario\", choices=SCENARIOS, default=\"full\")\n594\t    repeat = commands.add_parser(\"replay\")\n595\t    repeat.add_argument(\"folder\", type=Path)\n596\t    args = parser.parse_args(argv)\n597\t    try:\n598\t        if args.command == \"run\":\n599\t            result = run(args.out, budget=args.budget_bytes, scenario=args.scenario)\n600\t        else:\n601\t            result = replay(args.folder.resolve())\n602\t    except (ArtifactError, OSError, ValueError, KeyError, TypeError, AttributeError, IndexError) as error:\n603\t        sys.stdout.buffer.write(canonical_json_bytes({\"status\": \"incomplete\", \"reason\": str(error)}))\n604\t        return 3\n605\t    sys.stdout.buffer.write(canonical_json_bytes(result))\n606\t    return 0\n607\t\n608\t\n609\tif __name__ == \"__main__\":\n610\t    raise SystemExit(main())"}
{"role":"tool","tool_call_id":"tool_0Iv36cMc7NdS9mnibfj0DLVi","content":"1\t\"\"\"Publish the positive contextual assertions selected by saved judgments.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport asyncio\n7\timport json\n8\timport os\n9\timport sys\n10\timport tempfile\n11\tfrom pathlib import Path\n12\tfrom typing import Any\n13\t\n14\tfrom gnd.anchors import read_regular_path, strict_json\n15\tfrom gnd.artifacts import ArtifactError, canonical_json_bytes, publish_directory_once, sha256_hex\n16\tfrom gnd.disclosure import ENVIRONMENT as DISCLOSURE_ENV\n17\tfrom gnd.process import ProcessLimits, run_bounded_process\n18\t\n19\tfrom .assurance_report import Refusal\n20\t\n21\tSCHEMA = \"literature-assertion-admission/1\"\n22\tSTATEMENT = \"assertion_statement\"\n23\tWORK = \"assertion_names_work\"\n24\tPASSAGE = \"assertion_names_passage\"\n25\tMODEL, RAW, POLICY, RECEIPTS = \"model.orm.yaml\", \"raw.population.json\", \"policy.json\", \"receipts.json\"\n26\tREPORT, ADMITTED, RECORD = \"judgment-report.json\", \"admitted.population.json\", \"admission.json\"\n27\tCAP = 10 << 20\n28\tREPORT_CAP = 16 << 20\n29\tMAX_TARGETS = 1024\n30\tABSENT_CONDITIONS = frozenset({\"unspecified\", \"none\", \"n/a\"})\n31\tROLES = {\n32\t    \"passage\", \"work\", \"version\", \"predicate\", \"actor\", \"actor_kind\", \"object\", \"object_kind\",\n33\t    \"qualification\", \"condition\", \"regime\", \"experiment\", \"polarity\", \"attribution\",\n34\t}\n35\tTAGS = {\n36\t    \"actor_kind\": (\"sense\", \"mention\"), \"object_kind\": (\"sense\", \"mention\"),\n37\t    \"qualification\": (\"conditional\", \"unqualified\"), \"polarity\": (\"asserts\", \"negates\"),\n38\t    \"attribution\": (\"own-finding\", \"baseline-comparison\", \"speculation\", \"cites-other-work\"),\n39\t}\n40\tLIMITS = ProcessLimits(timeout_seconds=90, terminate_grace_seconds=1, stdin_limit_bytes=0,\n41\t                       stdout_limit_bytes=REPORT_CAP, stderr_limit_bytes=128 << 10,\n42\t                       total_output_limit_bytes=REPORT_CAP + (128 << 10))\n43\t\n44\t\n45\tdef _rows(value: Any, roles: set[str]) -> list[dict]:\n46\t    if not isinstance(value, list) or len(value) > MAX_TARGETS:\n47\t        raise Refusal(\"input:invalid-contextual-population\")\n48\t    for row in value:\n49\t        if (not isinstance(row, dict) or set(row) != roles\n50\t                or not all(isinstance(item, str) and item.strip() for item in row.values())):\n51\t            raise Refusal(\"input:invalid-contextual-population\")\n52\t    return value\n53\t\n54\t\n55\tdef _identities(works: list[dict], passages: list[dict]) -> dict[tuple[str, str], str]:\n56\t    work_by_id = {row[\"assertion\"]: row[\"work\"] for row in works}\n57\t    passage_by_id = {row[\"assertion\"]: row[\"passage\"] for row in passages}\n58\t    if len(work_by_id) != len(works) or len(passage_by_id) != len(passages) or work_by_id.keys() != passage_by_id.keys():\n59\t        raise Refusal(\"input:assertion-identities\")\n60\t    by_location = {(work, passage_by_id[identifier]): identifier for identifier, work in work_by_id.items()}\n61\t    if len(by_location) != len(work_by_id):\n62\t        raise Refusal(\"input:assertion-identities\")\n63\t    return by_location\n64\t\n65\t\n66\tdef _targets(items: Any, count: int) -> dict[int, dict]:\n67\t    if not isinstance(items, list) or len(items) > MAX_TARGETS:\n68\t        raise Refusal(\"judgments:invalid-result\")\n69\t    by_index = {}\n70\t    for item in items:\n71\t        if not isinstance(item, dict) or item.get(\"fact_type\") != STATEMENT:\n72\t            raise Refusal(\"judgments:invalid-result\")\n73\t        index, judgments = item.get(\"index\"), item.get(\"judgments\")\n74\t        if (type(index) is not int or not 0 <= index < count or index in by_index\n75\t                or type(item.get(\"admitted\")) is not bool or not isinstance(judgments, list) or len(judgments) > 32\n76\t                or not all(isinstance(j, dict) and j.get(\"verdict\") in (\"approve\", \"reject\", \"abstain\", \"missing\")\n77\t                           for j in judgments)):\n78\t            raise Refusal(\"judgments:invalid-result\")\n79\t        by_index[index] = item\n80\t    return by_index\n81\t\n82\t\n83\tdef _support(row: dict, target: dict | None) -> str | None:\n84\t    missing = row[\"condition\"].strip().casefold() in ABSENT_CONDITIONS\n85\t    if row[\"qualification\"] == \"conditional\" and missing:\n86\t        return \"missing-condition\"\n87\t    if row[\"qualification\"] == \"unqualified\" and not missing:\n88\t        return \"qualification-mismatch\"\n89\t    if target is None:\n90\t        return \"missing\"\n91\t    if target[\"admitted\"]:\n92\t        return None\n93\t    verdicts = {item[\"verdict\"] for item in target[\"judgments\"]}\n94\t    for verdict, reason in ((\"missing\", \"missing\"), (\"reject\", \"rejected\"), (\"abstain\", \"abstained\")):\n95\t        if verdict in verdicts:\n96\t            return reason\n97\t    return \"approval-or-mechanical-floor\"\n98\t\n99\t\n100\tdef project(subject: Any, targets: Any) -> tuple[dict, dict]:\n101\t    \"\"\"Project accepted positive occurrences and their original identity links.\"\"\"\n102\t    if not isinstance(subject, dict) or not isinstance(subject.get(\"population\"), dict):\n103\t        raise Refusal(\"input:invalid-contextual-population\")\n104\t    facts = subject.get(\"facts\")\n105\t    if not isinstance(facts, dict) or set(facts) != {STATEMENT, WORK, PASSAGE}:\n106\t        raise Refusal(\"input:invalid-contextual-population\")\n107\t    statements = _rows(facts[STATEMENT], ROLES)\n108\t    works = _rows(facts[WORK], {\"assertion\", \"work\"})\n109\t    passages = _rows(facts[PASSAGE], {\"assertion\", \"passage\"})\n110\t    identities = _identities(works, passages)\n111\t    locations = {(row[\"work\"], row[\"passage\"]) for row in statements}\n112\t    if locations != identities.keys() or len(locations) != len(statements):\n113\t        raise Refusal(\"input:assertion-identities\")\n114\t    verified = _targets(targets, len(statements))\n115\t    stages: dict[str, list[dict]] = {\"semantic-support\": [], \"positive-own-findings\": []}\n116\t    kept, included = [], set()\n117\t    for index, row in enumerate(statements):\n118\t        if any(row[tag] not in allowed for tag, allowed in TAGS.items()):\n119\t            raise Refusal(\"input:invalid-contextual-population\")\n120\t        support = _support(row, verified.get(index))\n121\t        effective = support\n122\t        if effective is None and (row[\"polarity\"], row[\"attribution\"]) != (\"asserts\", \"own-finding\"):\n123\t            effective = \"negated\" if row[\"polarity\"] == \"negates\" else row[\"attribution\"]\n124\t        for stage, reason in ((\"semantic-support\", support), (\"positive-own-findings\", effective)):\n125\t            stages[stage].append({\"index\": index, \"status\": \"pass\" if reason is None else \"fail\", \"reason\": reason})\n126\t        if effective is None:\n127\t            kept.append(row)\n128\t            included.add(identities[row[\"work\"], row[\"passage\"]])\n129\t    return {\n130\t        **({\"format_version\": subject[\"format_version\"]} if \"format_version\" in subject else {}),\n131\t        \"population\": {**subject[\"population\"], \"source\": \"tool-output\", \"producer\": SCHEMA,\n132\t                       \"covers\": [STATEMENT, WORK, PASSAGE]},\n133\t        \"instances\": {},\n134\t        \"facts\": {\n135\t            STATEMENT: kept,\n136\t            WORK: [row for row in works if row[\"assertion\"] in included],\n137\t            PASSAGE: [row for row in passages if row[\"assertion\"] in included],\n138\t        },\n139\t    }, stages\n140\t\n141\t\n142\tdef _judgments(snapshots: dict[str, bytes], trusted_root: Path) -> tuple[dict, bytes]:\n143\t    \"\"\"Run the standard judgment route with the immutable input snapshot.\"\"\"\n144\t    with tempfile.TemporaryDirectory(prefix=\"gnd-assertions-\") as folder:\n145\t        cwd = Path(folder).resolve()\n146\t        for name, raw in snapshots.items():\n147\t            (cwd / name).write_bytes(raw)\n148\t        argv = (sys.executable, \"-m\", \"gnd\", \"judgments\", \"check\", MODEL, RAW,\n149\t                \"--policy\", POLICY, \"--receipts\", RECEIPTS, \"--trusted-root\", str(trusted_root.absolute()),\n150\t                \"--format\", \"json\")\n151\t        environment = ({} if DISCLOSURE_ENV not in os.environ else {DISCLOSURE_ENV: os.environ[DISCLOSURE_ENV]})\n152\t        done = asyncio.run(run_bounded_process(argv, cwd=cwd, env=environment, limits=LIMITS,\n153\t                                               disclosed_names=frozenset({DISCLOSURE_ENV})))\n154\t    if done.return_code not in (0, 1) or done.stdout_truncated or not done.process_group_cleaned:\n155\t        raise Refusal(\"judgments:refused\")\n156\t    report = strict_json(done.stdout, max_bytes=REPORT_CAP, too_large=\"judgments:report-cap\")\n157\t    if (not isinstance(report, dict) or report.get(\"command\") != \"judgments\"\n158\t            or type(report.get(\"outcome\")) is not int or report[\"outcome\"] != done.return_code\n159\t            or report.get(\"error\") is not None or not isinstance(report.get(\"judgment_policy\"), dict)):\n160\t        raise Refusal(\"judgments:invalid-result\")\n161\t    judgment = report[\"judgment_policy\"]\n162\t    if judgment.get(\"verification_contract\") != \"consumer-pinned-bytes-v1\":\n163\t        raise Refusal(\"judgments:consumer-pins-required\")\n164\t    _verify_report_inputs(judgment, snapshots)\n165\t    return judgment, done.stdout\n166\t\n167\t\n168\tdef _verify_report_inputs(judgment: dict, snapshots: dict[str, bytes]) -> None:\n169\t    policy = strict_json(snapshots[POLICY], max_bytes=1 << 20, too_large=\"input:policy-cap\")\n170\t    receipt_bytes = snapshots[RECEIPTS]\n171\t    receipts = strict_json(receipt_bytes, max_bytes=CAP, too_large=\"input:receipt-cap\")\n172\t    if not receipts[\"receipts\"]:\n173\t        receipt_bytes = canonical_json_bytes({\"schema_version\": 1, \"receipts\": []})\n174\t    targets = judgment.get(\"targets\")\n175\t    if (judgment.get(\"policy_sha256\") != sha256_hex(snapshots[POLICY])\n176\t            or judgment.get(\"receipts_sha256\") != sha256_hex(receipt_bytes)\n177\t            or not isinstance(targets, list)\n178\t            or not all(isinstance(item, dict) for item in targets)\n179\t            or [{\"fact_type\": item.get(\"fact_type\"), \"index\": item.get(\"index\")} for item in targets] != policy[\"targets\"]):\n180\t        raise Refusal(\"judgments:binding-mismatch\")\n181\t\n182\t\n183\tdef admit(model: Path, raw: Path, policy: Path, receipts: Path, trusted_root: Path, out: Path) -> dict:\n184\t    \"\"\"Check saved opinion bytes, project supported rows and publish one bound result.\"\"\"\n185\t    out = out.absolute()\n186\t    if out.exists() or out.is_symlink():\n187\t        raise Refusal(\"output:exists\")\n188\t    snapshots = {\n189\t        name: read_regular_path(path, label=name, max_bytes=(1 << 20) if name == POLICY else CAP)\n190\t        for name, path in ((MODEL, model), (RAW, raw), (POLICY, policy), (RECEIPTS, receipts))\n191\t    }\n192\t    judgment, report_raw = _judgments(snapshots, trusted_root)\n193\t    subject = strict_json(snapshots[RAW], max_bytes=CAP, too_large=\"input:population-cap\")\n194\t    population, stages = project(subject, judgment.get(\"targets\"))\n195\t    admitted_raw = canonical_json_bytes(population)\n196\t    record = {\n197\t        \"schema\": SCHEMA, \"model_sha256\": sha256_hex(snapshots[MODEL]), \"raw_sha256\": sha256_hex(snapshots[RAW]),\n198\t        \"policy_sha256\": sha256_hex(snapshots[POLICY]), \"receipts_sha256\": sha256_hex(snapshots[RECEIPTS]),\n199\t        \"judgment_report_sha256\": sha256_hex(report_raw), \"admitted_sha256\": sha256_hex(admitted_raw), \"stages\": stages,\n200\t    }\n201\t    publish_directory_once(\n202\t        out.parent, out.name, {RAW: snapshots[RAW], REPORT: report_raw, ADMITTED: admitted_raw,\n203\t                               RECORD: canonical_json_bytes(record)},\n204\t        manifest_name=RECORD, max_file_bytes=REPORT_CAP, max_total_bytes=4 * REPORT_CAP,\n205\t    )\n206\t    return record\n207\t\n208\t\n209\tdef main(argv: list[str] | None = None) -> int:\n210\t    parser = argparse.ArgumentParser(description=__doc__)\n211\t    for label in (\"model\", \"raw\", \"policy\", \"receipts\", \"trusted_root\"):\n212\t        parser.add_argument(label, type=Path)\n213\t    parser.add_argument(\"--out\", required=True, type=Path)\n214\t    args = parser.parse_args(argv)\n215\t    try:\n216\t        admit(args.model, args.raw, args.policy, args.receipts, args.trusted_root, args.out)\n217\t    except Refusal as error:\n218\t        print(json.dumps({\"exit_code\": 3, \"reason\": error.reason}))\n219\t        return 3\n220\t    except (ArtifactError, OSError, ValueError, UnicodeError, RecursionError):\n221\t        print(json.dumps({\"exit_code\": 3, \"reason\": \"input-or-output:invalid\"}))\n222\t        return 3\n223\t    print(json.dumps({\"exit_code\": 0}))\n224\t    return 0\n225\t\n226\t\n227\tif __name__ == \"__main__\":\n228\t    raise SystemExit(main())"}
{"role":"tool","tool_call_id":"tool_nEByCsKh7AjA4NmMzpQ2wVra","content":"1\t\"\"\"Run the three source-scoped literature competency examples offline.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport asyncio\n6\timport sys\n7\tfrom decimal import Decimal\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tfrom gnd.anchors import recognised_ranges, recognition_index, strict_json\n12\tfrom gnd.artifacts import (\n13\t    ArtifactError,\n14\t    canonical_json_bytes,\n15\t    read_regular_bounded,\n16\t    sha256_hex,\n17\t)\n18\tfrom gnd.process import BoundedProcessResult, ProcessLimits, run_bounded_process\n19\t\n20\tFIXTURE = Path(__file__).parent / \"depth_fixture\"\n21\tINPUT_LIMIT = 128 * 1024\n22\tPROCESS_LIMIT = 1 << 20\n23\tPROCESS_LIMITS = ProcessLimits(\n24\t    timeout_seconds=30,\n25\t    terminate_grace_seconds=1,\n26\t    stdin_limit_bytes=0,\n27\t    stdout_limit_bytes=PROCESS_LIMIT,\n28\t    stderr_limit_bytes=INPUT_LIMIT,\n29\t    total_output_limit_bytes=PROCESS_LIMIT,\n30\t)\n31\tCASES = (\"dynamics\", \"molecular\", \"algorithms\")\n32\tCASES_SHA = \"366dee9620694a6037496f51247248e8f937feae04939778b0cfce0d99327d70\"\n33\tSUPPORT_SHA = \"8d697a5a169d6dfa27a0dacb498df9e86bd78f1ffbd5365ea82f38264333ed59\"\n34\tCONTEXT = {\n35\t    \"dataset_version\": \"experiment_dataset\",\n36\t    \"split\": \"experiment_split\",\n37\t    \"metric\": \"experiment_metric\",\n38\t    \"units\": \"experiment_units\",\n39\t    \"conditions\": \"experiment_conditions\",\n40\t}\n41\tRELATIONS = (\"subject_specializes\", \"subject_has_component\", \"subject_influenced_by\")\n42\tEXPERIMENT_FIELDS = {\n43\t    **CONTEXT,\n44\t    \"score\": \"experiment_score\",\n45\t    \"baseline\": \"experiment_baseline\",\n46\t    \"configuration\": \"experiment_configuration\",\n47\t    \"uncertainty\": \"experiment_uncertainty\",\n48\t}\n49\t\n50\t\n51\tclass ExampleError(ValueError):\n52\t    \"\"\"The worked example cannot establish the requested output.\"\"\"\n53\t\n54\t\n55\tdef _read(root: Path, name: str) -> bytes:\n56\t    return read_regular_bounded(root, name, max_bytes=INPUT_LIMIT)[0]\n57\t\n58\t\n59\tdef _decode(data: bytes) -> dict:\n60\t    try:\n61\t        value = strict_json(data, max_bytes=PROCESS_LIMIT, too_large=\"example JSON exceeds its cap\")\n62\t    except (ValueError, RecursionError) as error:\n63\t        raise ExampleError(\"invalid example JSON\") from error\n64\t    if not isinstance(value, dict):\n65\t        raise ExampleError(\"expected an example JSON object\")\n66\t    return value\n67\t\n68\t\n69\tdef _write(out: Path, name: str, data: Any) -> bytes:\n70\t    raw = canonical_json_bytes(data)\n71\t    (out / name).write_bytes(raw)\n72\t    return raw\n73\t\n74\t\n75\tdef _command(out: Path, *args: str) -> BoundedProcessResult:\n76\t    result = asyncio.run(run_bounded_process(\n77\t        (sys.executable, \"-m\", \"gnd\", *args), cwd=out, env={}, limits=PROCESS_LIMITS,\n78\t    ))\n79\t    if (result.status not in {\"succeeded\", \"failed\"} or result.stdout_truncated\n80\t            or result.stderr_truncated or not result.process_group_cleaned):\n81\t        raise ExampleError(f\"{args[0]} failed to finish its bounded run\")\n82\t    return result\n83\t\n84\t\n85\tdef _success(out: Path, *args: str) -> bytes:\n86\t    result = _command(out, *args)\n87\t    if result.return_code != 0:\n88\t        raise ExampleError(f\"{args[0]} exited {result.return_code}\")\n89\t    return result.stdout\n90\t\n91\t\n92\tdef _load_reviewed(fixture: Path, name: str, expected_sha: str) -> dict:\n93\t    raw = _read(fixture, name)\n94\t    document = _decode(raw)\n95\t    if sha256_hex(raw) != expected_sha:\n96\t        raise ExampleError(f\"reviewed {name} binding differs\")\n97\t    return document\n98\t\n99\t\n100\tdef _fact_rows(facts: dict) -> None:\n101\t    if not all(\n102\t        isinstance(rows, list) and all(\n103\t            isinstance(row, dict) and all(isinstance(value, str) for value in row.values())\n104\t            for row in rows\n105\t        ) for rows in facts.values()\n106\t    ):\n107\t        raise ExampleError(\"invalid example fact rows\")\n108\t\n109\t\n110\tdef _question_rows(case: dict, support: dict, document: bytes, facts: dict) -> list[dict]:\n111\t    if sha256_hex(document) != support[\"document_sha256\"]:\n112\t        raise ExampleError(\"reviewed source document binding differs\")\n113\t    text = document.decode(\"utf-8\")\n114\t    _fact_rows(facts)\n115\t    by_fact = {\n116\t        fact: [row for row in rows if row.get(\"subject\") == case[\"subject\"]]\n117\t        for fact, rows in facts.items()\n118\t    }\n119\t    answers = []\n120\t    for question, evidence in zip(case[\"questions\"], support[\"rows\"], strict=True):\n121\t        if question[\"id\"] != evidence[\"id\"]:\n122\t            raise ExampleError(\"reviewed question roster differs\")\n123\t        primary = evidence[\"primary\"]\n124\t        claimed_locator = {key: value for key, value in primary.items() if key != \"evidence_form\"}\n125\t        if claimed_locator != question[\"primary\"]:\n126\t            raise ExampleError(f\"reviewed primary locator differs for {question['id']}\")\n127\t        start, end = evidence[\"span\"]\n128\t        excerpt = text[start:end]\n129\t        if not (0 <= start < end <= len(text)) or sha256_hex(excerpt.encode()) != evidence[\"span_sha256\"]:\n130\t            raise ExampleError(\"reviewed source span differs\")\n131\t        selected = {fact: by_fact.get(fact, []) for fact in question[\"requires\"]}\n132\t        reviewed = evidence[\"facts\"]\n133\t        for fact, rows in selected.items():\n134\t            if rows and rows != reviewed.get(fact):\n135\t                raise ExampleError(f\"unreviewed facts for {question['id']}\")\n136\t        supported = all(selected.values()) and evidence[\"decision\"] == \"supported\"\n137\t        answers.append({\n138\t            \"id\": questi
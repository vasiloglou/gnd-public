ANSWERS = {r['id']: r for r in json.loads((CORPUS / 'answers.json').read_text())['cases']}


def read(path):
    return json.loads(path.read_text())


def write(path, data):
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + '\n')


def sha(data):
    return hashlib.sha256(data).hexdigest()



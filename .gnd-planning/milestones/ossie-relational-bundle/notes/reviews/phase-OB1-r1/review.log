"""RF7 shared JSON, YAML and ISO datetime input restrictions."""
from __future__ import annotations

import json
import math
import re
from datetime import datetime

from ruamel.yaml import YAML
from ruamel.yaml.events import AliasEvent, CollectionEndEvent, CollectionStartEvent

MAX_BYTES = 10 * 1024 * 1024
#: The largest byte bound a caller may raise a size limit to (ossie-relational-bundle D3).
MAX_BYTES_CEILING = 256 * 1024 * 1024
MAX_DEPTH = 64
_DATETIME = re.compile(
    r'[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]'
    r'(?::[0-5][0-9](?:\.[0-9]{1,6})?)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])?'
)


def _text(raw, max_bytes=MAX_BYTES):
    if isinstance(raw, (bytes, bytearray)):
        if len(raw) > max_bytes:
            raise ValueError('JSON input exceeds byte cap')
        # Preserve the standard decoder's UTF BOM/encoding interpretation.
        raw = bytes(raw).decode(json.detect_encoding(raw), 'surrogatepass')
    if not isinstance(raw, str):
        raise TypeError('JSON input must be str, bytes or bytearray')
    if len(raw.encode('utf-8', 'surrogatepass')) > max_bytes:
        raise ValueError('JSON input exceeds byte cap')
    return raw


def _depth(text, idx):
    if text[idx:idx + 1] not in ('{', '['):
        return
    depth = 0
    quoted = escaped = False
    for char in text[idx:]:
        if quoted:
            if escaped:
                escaped = False
            elif char == '\\':
                escaped = True
            elif char == '"':
                quoted = False
        elif char == '"':
            quoted = True
        elif char in '{[':
            depth += 1
            if depth > MAX_DEPTH:
                raise InputRefusal('JSON depth exceeds cap', text, idx)
        elif char in '}]':
            depth -= 1
            if depth == 0:
                return


class InputRefusal(json.JSONDecodeError):
    """Keep domain diagnostic messages independent of synthetic locations."""

    def __str__(self):
        return self.msg


class JSONDecoder(json.JSONDecoder):
    """Native decoder interface with one duplicate/finite/depth policy."""

    def __init__(self, *, max_bytes=MAX_BYTES, **kwargs):
        self._max_bytes = max_bytes
        pairs_hook = kwargs.pop('object_pairs_hook', None)
        object_hook = kwargs.pop('object_hook', None)
        float_hook = kwargs.pop('parse_float', None) or float
        constant_hook = kwargs.pop('parse_constant', None)

        def pairs(items):
            duplicate = len({key for key, _ in items}) != len(items)
            # Preserve domain refusals, but callbacks cannot erase raw evidence.
            result = pairs_hook(items) if pairs_hook else dict(items)
            if duplicate:
                raise InputRefusal('duplicate JSON key', '', 0)
            return object_hook(result) if object_hook and not pairs_hook else result

        def number(token):
            result = float_hook(token)
            if not math.isfinite(float(token)):
                raise InputRefusal('nonfinite JSON number', '', 0)
            return result

        def constant(token):
            if constant_hook:
                constant_hook(token)
            raise InputRefusal('nonfinite JSON constant', '', 0)

        super().__init__(object_pairs_hook=pairs, parse_float=number,
                         parse_constant=constant, **kwargs)

    def raw_decode(self, text, idx=0):
        text = _text(text, self._max_bytes)
        _depth(text, idx)
        return super().raw_decode(text, idx)


def loads(raw, *, max_bytes=MAX_BYTES, **kwargs):
    """Decode with native numeric types or caller hooks; refuse unsafe syntax.

    ``max_bytes`` bounds the encoded input; callers that admit larger documents
    pass their own bound, at most :data:`MAX_BYTES_CEILING`.
    """
    return JSONDecoder(max_bytes=max_bytes, **kwargs).decode(_text(raw, max_bytes))


def load(handle, **kwargs):
    """Apply the byte cap to the read, before decoding or constructing nodes."""
    raw = handle.read(MAX_BYTES + 1)
    return loads(raw, **kwargs)


def guard_yaml(raw, *, max_bytes=MAX_BYTES, max_events=1_000_000, max_depth=MAX_DEPTH):
    """Reject amplification and over-budget input before constructing YAML nodes."""
    if isinstance(raw, str):
        data = raw.encode('utf-8')
    elif isinstance(raw, bytes):
        data = raw
    else:
        raise TypeError('YAML input must be text or bytes')
    if len(data) > max_bytes:
        raise ValueError('YAML byte cap exceeded')
    depth = 0
    for count, event in enumerate(YAML(typ='safe').parse(data), 1):
        if count > max_events:
            raise ValueError('YAML event cap exceeded')
        if isinstance(event, AliasEvent):
            raise ValueError('YAML alias refused')  # noqa: TRY004 -- input syntax refusal
        if isinstance(event, CollectionStartEvent):
            depth += 1
            if depth > max_depth:
                raise ValueError('YAML depth cap exceeded')
        elif isinstance(event, CollectionEndEvent):
            depth -= 1


def parse_datetime(value):
    """Parse the approved ASCII extended ISO grammar, retaining naive values."""
    if not isinstance(value, str) or _DATETIME.fullmatch(value) is None:
        raise ValueError('strict ISO datetime required')
    return datetime.fromisoformat(value[:-1] + '+00:00' if value.endswith('Z') else value)
"""Bounded, offline import of the pinned Apache Ossie ontology dialect."""

from __future__ import annotations

import hashlib
import json
import re
from collections import defaultdict
from dataclasses import dataclass
from functools import lru_cache
from graphlib import CycleError, TopologicalSorter
from importlib.resources import files
from pathlib import Path

from jsonschema import Draft202012Validator
from referencing import Registry, Resource
from referencing.exceptions import Unresolvable
from ruamel.yaml import YAML
from ruamel.yaml.error import YAMLError

from gnd.artifacts import canonical_json_bytes
from gnd.errors import ModelLoadError, ModelValidationError
from gnd.input_policy import MAX_BYTES, MAX_BYTES_CEILING, MAX_DEPTH, guard_yaml, loads
from gnd.model import json_document, load_model_bytes
from gnd.model._documents import ModelValueError
from gnd.safefs import open_regular
from gnd.values import ModelIdentityError, model_identity

_CORE_URI = "https://raw.githubusercontent.com/apache/ossie/main/core-spec/ossie-schema.json"
_SCHEMA_HOME = ("schema", "ossie")
_PRIMITIVES = {
    "Boolean": "Boolean",
    "Date": "Date",
    "DateTime": "DateTime",
    "Decimal": "Number",
    "Float": "Float",
    "Integer": "Integer",
    "String": "String",
}
_BUILTINS = frozenset(_PRIMITIVES) | {"Any"}
_SHA = re.compile(r"[0-9a-f]{64}\Z")
_INDEX = re.compile(r"(?:0|[1-9][0-9]{0,8})\Z")
_POINTER_ESCAPE = re.compile(r"~(?![01])")
_ROLE_TOKEN = re.compile(r"\{([^{}:]+)(?::([^{}]+))?\}")
_FLIGHTS = "821d850f66098b2bb3ed8888e853a287627bb1eec676c2a7a190680d0ca89e87"
_OSSIE_COMMIT = "ee89dbdc2844d8b7d293ed42c8613928bb99505f"


class OssieImportError(ValueError):
    """A value-free refusal at a documented import boundary."""

    def __init__(self, rule: str):
        self.rule_id = f"ossie-import:{rule}"
        super().__init__(self.rule_id)


@dataclass(frozen=True)
class OssieImportResult:
    model: bytes
    loss_report: bytes


def _read(path: Path, rule: str, *, max_bytes: int, optional: bool = False) -> bytes | None:
    try:
        with open(open_regular(path), "rb") as stream:
            data = stream.read(max_bytes + 1)
    except FileNotFoundError:
        if optional:
            try:
                path.lstat()
            except FileNotFoundError:
                return None
            except OSError:
                pass
        raise OssieImportError(rule) from None
    except (OSError, ValueError):
        raise OssieImportError(rule) from None
    if len(data) > max_bytes:
        raise OssieImportError(f"{rule}-size")
    return data


def _parse(data: bytes, rule: str, *, max_bytes: int, yaml: bool = False):
    try:
        if yaml:
            guard_yaml(data, max_bytes=max_bytes)
            document = json_document(YAML(typ="safe").load(data))
        else:
            document = loads(data, max_bytes=max_bytes)
        # JSON permits escapes for isolated UTF-16 surrogates. The wire format is UTF-8.
        for part in json.JSONEncoder(ensure_ascii=False).iterencode(document):
            part.encode("utf-8")
        return document
    except (YAMLError, ModelValueError, ValueError, TypeError, RecursionError, OverflowError):
        raise OssieImportError(rule) from None


@lru_cache(maxsize=1)
def _schemas():
    package = files("gnd")
    root = package.joinpath(*_SCHEMA_HOME)
    ontology = loads(root.joinpath("ontology.json").read_bytes())
    core = Resource.from_contents(loads(root.joinpath("core-spec.json").read_bytes()))
    # Registry() refuses unregistered retrieval. No URI in user input opens a connection.
    registry = Registry().with_resource(_CORE_URI, core)
    report = loads(package.joinpath("ossie-loss-report.schema.json").read_bytes())
    return Draft202012Validator(ontology, registry=registry), Draft202012Validator(report)


def _relationship_roles(relationship):
    """The additional roles of one foreign Ossie relationship; the format omits the key for none."""
    return relationship.get("roles", ())


def _schema_check(document, validator, rule: str) -> None:
    try:
        valid = validator.is_valid(document)
    except (Unresolvable, ValueError, TypeError, RecursionError, OverflowError):
        raise OssieImportError(rule) from None
    if not valid:
        raise OssieImportError(rule)


def _pointer(parts) -> str:
    return "".join("/" + str(part).replace("~", "~0").replace("/", "~1") for part in parts)


def _tokens(pointer) -> tuple[str, ...]:
    if not isinstance(pointer, str) or (pointer and not pointer.startswith("/")):
        raise OssieImportError("sidecar-pointer")
    parts = pointer.split("/")[1:]
    if len(parts) > MAX_DEPTH or any(_POINTER_ESCAPE.search(part) for part in parts):
        raise OssieImportError("sidecar-pointer")
    return tuple(part.replace("~1", "/").replace("~0", "~") for part in parts)


def _scalar(value) -> bool:
    return type(value) in {str, int, float, bool, type(None)}


def _value_at(document, pointer):
    for key in _tokens(pointer):
        if isinstance(document, dict) and key in document:
            document = document[key]
        elif isinstance(document, list) and _INDEX.fullmatch(key) and int(key) < len(document):
            document = document[int(key)]
        else:
            raise OssieImportError("sidecar-pointer")
    if not _scalar(document):
        raise OssieImportError("sidecar-entry")
    return document


class _NameGraph:
    def __init__(self, document):
    for path, parts in refused.items():
        population_root = parts == ("reference_populations",) or (
            len(parts) == 3 and parts[0] == "fact_types"
            and _INDEX.fullmatch(parts[1]) and parts[2] == "sample_population"
        )
        parent = path.rsplit("/", 1)[0]
        if parent not in (retained if population_root else refused):
            raise OssieImportError("report-pointer")
    return rows


def _bounded_model(document, source_identity, *, require_identity: bool) -> tuple[bytes, bool]:
    encoder = json.JSONEncoder(
        ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")
    )
    result = bytearray()
    try:
        for part in encoder.iterencode(document):
            data = part.encode("utf-8")
            if len(result) + len(data) >= MAX_BYTES:
                raise OssieImportError("model-size")
            result.extend(data)
    except OssieImportError:
        raise
    except (ValueError, TypeError, RecursionError, OverflowError):
        raise OssieImportError("model") from None
    result.extend(b"\n")
    data = bytes(result)
    try:
        admitted = load_model_bytes(data, source="restored.orm.json")
    except (ModelLoadError, ModelValidationError, ValueError, RecursionError, OverflowError):
        raise OssieImportError("model") from None
    identity_verified = False
    if source_identity is not None:
        try:
            identity_verified = model_identity(admitted) == source_identity
        except ModelIdentityError:
            raise OssieImportError("model-identity") from None
        if require_identity and not identity_verified:
            raise OssieImportError("model-identity")
    return data, identity_verified


class _Identifiers:
    def __init__(self):
        self.used = set()
        self.counters = defaultdict(int)

    def take(self, raw: str) -> str:
        text = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", raw)
        base = re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")
        if not base or not base[0].isalpha():
            base = "ossie_" + base
        candidate = base
        while candidate in self.used:
            self.counters[base] += 1
        "source": source,
        "object_types": objects,
        "fact_types": facts,
    }
    return result, _foreign_rows(document, projected)


def _loss_report_bytes(digest, source_identity, identity_verified, rows, *, max_bytes: int) -> bytes:
    # Serialize each row once and cap the total before a foreign tree can
    # amplify to a large report through repeated pointer prefixes.
    empty = canonical_json_bytes({
        "schema": "gnd-ossie-import-loss/1",
        "document_sha256": digest,
        "source_model_identity": source_identity,
        "source_identity_verified": identity_verified,
        "dispositions": [],
    })
    prefix, _, suffix = empty.partition(b'"dispositions":[]')
    result = bytearray(prefix)
    result.extend(b'"dispositions":[')
    for i, row in enumerate(rows):
        data = canonical_json_bytes(row).rstrip()
        if len(result) + len(data) + len(suffix) + 2 > 2 * max_bytes:
            raise OssieImportError("loss-size")
        if i:
            result.extend(b",")
        result.extend(data)
    result.extend(b"]")
    result.extend(suffix)
    return bytes(result)


def plan_ossie_import(path: Path, *, max_input_bytes: int = MAX_BYTES) -> OssieImportResult:
    """Admit one standalone ontology or bound bundle without network access.

    ``max_input_bytes`` bounds each of the three input files, the YAML and JSON
    parse of each, and (doubled) the import loss report (OB1). The restored model
    keeps its fixed ``model-size`` cap: it must load as a model anyway.
    """
    if isinstance(max_input_bytes, bool) or not isinstance(max_input_bytes, int) or not (
        1 <= max_input_bytes <= MAX_BYTES_CEILING
    ):
        raise ValueError(f"max_input_bytes must be an integer from 1 to {MAX_BYTES_CEILING}")
    raw = _read(path, "input", max_bytes=max_input_bytes)
    assert raw is not None
    ontology = _parse(raw, "syntax", max_bytes=max_input_bytes, yaml=path.suffix.lower() != ".json")
    _schema_check(ontology, _schemas()[0], "schema")
    graph = _NameGraph(ontology)
    digest = hashlib.sha256(raw).hexdigest()
    sidecar_raw = _read(
        path.with_name(path.name + ".gnd.json"), "sidecar-input", max_bytes=max_input_bytes, optional=True
    )
    source_identity = None
    require_identity = False
    if sidecar_raw is None:
        model, rows = _foreign(ontology, graph, digest)
    else:
        sidecar = _parse(sidecar_raw, "sidecar-syntax", max_bytes=max_input_bytes)
        _binding(sidecar, digest)
        source_identity = sidecar["model_identity"]
        report_raw = _read(
            path.with_name(path.name + ".loss.json"), "report-input", max_bytes=max_input_bytes, optional=True
        )
        report = (
            _parse(report_raw, "report-syntax", max_bytes=max_input_bytes) if report_raw is not None else None
        )
        if report_raw is not None:
            _schema_check(report, _schemas()[1], "report-schema")
            if any(report[key] != sidecar[key] for key in ("model_identity", "document_sha256")):
                raise OssieImportError("report-binding")
        model, retained = _restore(sidecar, ontology)
        rows = _source_dispositions(report, retained)
        require_identity = report is not None and all(row["disposition"] != "refused" for row in rows)
    model_bytes, identity_verified = _bounded_model(model, source_identity, require_identity=require_identity)
    return OssieImportResult(
        model_bytes,
        _loss_report_bytes(digest, source_identity, identity_verified, rows, max_bytes=max_input_bytes),
    )
"""Render a GND model as a pinned Ossie ontology and bound interchange metadata."""

from __future__ import annotations

import hashlib
import re
from collections import Counter, defaultdict
from dataclasses import dataclass
from functools import lru_cache
from graphlib import CycleError, TopologicalSorter
from importlib.resources import files
from io import StringIO
from pathlib import Path

from jsonschema import Draft202012Validator
from ruamel.yaml import YAML
from ruamel.yaml.error import YAMLError

from gnd.artifacts import canonical_json_bytes
from gnd.export.ossie_formulas import ProjectedRelation, place_formulas
from gnd.input_policy import MAX_BYTES_CEILING, guard_yaml, loads
from gnd.model import (
    MAX_MODEL_BYTES,
    iter_derivation_clauses,
    json_document,
    load_model_bytes,
    parse_model_document,
)
from gnd.model._documents import ModelValueError
from gnd.model._includes import guard_document
from gnd.model_index import ModelIndex
from gnd.safefs import NotRegularFileError, open_regular
from gnd.terms import guarded_clause_refusal, where_uses_membership
from gnd.values import ModelIdentityError, model_identity

_VERSION = "0.3.0.dev0"
_BUILTINS = frozenset(
    {"Any", "Boolean", "Date", "DateTime", "Decimal", "Float", "Integer", "String"}
)
_ALIAS = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
_PLACEHOLDER = re.compile(r"\{([^{}]+)\}")
_NATIVE_LITERAL = ("native", "projected-with-source-spelling", None)
_POPULATION_REFUSAL = "population:out-of-scope"
#: Largest size of each written artifact unless the caller raises it (OB1). Equal to
#: ``input_policy.MAX_BYTES`` today but deliberately not an alias of that input cap.
DEFAULT_MAX_OUTPUT_BYTES = 10 * 1024 * 1024
MAX_OUTPUT_BYTES_CEILING = MAX_BYTES_CEILING


class OssieInputError(ValueError):
    """The source cannot be exported with the selected policy."""


@dataclass(frozen=True)
class OssieArtifacts:
    document: bytes
    sidecar: bytes
    loss_report: bytes
    #: How many fact types declare ``redact``, on the fact type or on a role. The
    #: export carries their readings, constraints and provenance text unchanged
    #: (issue 169); the command says so with this count and no name or value.
    redacted_fact_types: int = 0


@lru_cache(maxsize=1)
def _schema() -> Draft202012Validator:
    resource = files("gnd").joinpath("schema", "ossie", "ontology.json")
    return Draft202012Validator(loads(resource.read_bytes()))


def _read_model(path: Path):
    try:
        descriptor = open_regular(path)
    except NotRegularFileError as error:
        raise OssieInputError("model path is not a regular file") from error
    with open(descriptor, "rb") as stream:
        raw = stream.read(MAX_MODEL_BYTES + 1)
    try:
        if path.suffix != ".json":
            guard_yaml(raw, max_bytes=MAX_MODEL_BYTES)
        doc = parse_model_document(raw, source=path)
    except (YAMLError, ValueError, RecursionError, OverflowError) as error:
        raise OssieInputError("invalid model syntax or input limit exceeded") from error
    guard_document(doc, "export.ossie")
    model = load_model_bytes(raw, source=path)
    try:
        return json_document(doc), model
    except ModelValueError as error:
        raise OssieInputError(str(error)) from error


def _names(objects):
    counts = Counter(obj.get("name", oid) for oid, obj in objects.items())
    names = {
        oid: name
        for oid, obj in objects.items()
        if (name := obj.get("name", oid)) not in _BUILTINS
        and counts[name] == 1
        and _ALIAS.fullmatch(name)
    }
    used = set(names.values()) | _BUILTINS
    for oid in objects:
        if oid not in names:
            alias = f"gnd_{oid}"
            while alias in used:
                alias = "_" + alias
            names[oid] = alias
            used.add(alias)
    return names


def _pointers(*path) -> str:
    return "".join("/" + str(part).replace("~", "~0").replace("/", "~1") for part in path)


def _copy(target):
    return "native", "projection", target


def _role_order(fact, role_types):
    roles = tuple(role_types)
    determinant_constraints = defaultdict(list)
    for i, constraint in enumerate(fact.get("constraints", ())):
        if (
            constraint["type"] == "uniqueness"
            and constraint.get("scope", "internal") == "internal"
            and constraint.get("modality") == "alethic"
            and constraint.get("status") == "confirmed"
        ):
            determinant_constraints[frozenset(ModelIndex.constraint_roles(constraint))].append(i)
    if len(roles) < 2:
        return roles, None, ()
    if len(roles) == 2 and all(frozenset({role}) in determinant_constraints for role in roles):
        return (
            roles,
            "OneToOne",
            tuple(i for role in roles for i in determinant_constraints[frozenset({role})]),
        )
    role_set = frozenset(roles)
    by_omitted = {
        next(iter(role_set - determinant)): indexes
        for determinant, indexes in determinant_constraints.items()
        if len(determinant) == len(roles) - 1 and determinant <= role_set
    }
    for omitted in reversed(roles):
        if selected := by_omitted.get(omitted):
            prefix = tuple(role for role in roles if role != omitted)
            return (*prefix, omitted), "ManyToOne", selected
    return roles, None, ()


def _verbalizes(fact, role_tokens, role_types):
    roles = list(role_types)
    forward = iter(roles)
    readings = [_PLACEHOLDER.sub(lambda _match: role_tokens[next(forward)], fact["reading"])]
        for key, child in children:
            visit(child, (*path, key), owner, refusal, disposition == "requires")

    visit(document)
    return rows, dict(elements), refused


def render_ossie(
    model_path: Path,
    *,
    output_format: str,
    strict: bool = False,
    max_output_bytes: int = DEFAULT_MAX_OUTPUT_BYTES,
) -> OssieArtifacts:
    """Render three deterministic artifacts from one bounded, admitted model read.

    Every artifact must fit in ``max_output_bytes``; otherwise the whole export is
    refused with ``ossie:output-size`` and nothing is returned to publish.
    """
    if isinstance(max_output_bytes, bool) or not isinstance(max_output_bytes, int) or not (
        1 <= max_output_bytes <= MAX_OUTPUT_BYTES_CEILING
    ):
        raise ValueError(f"max_output_bytes must be an integer from 1 to {MAX_OUTPUT_BYTES_CEILING}")
    document, model = _read_model(model_path)
    ontology, mapped = _ontology(document, model)
    _schema().validate(ontology)
    incompatible = {}
    for index, constraint in enumerate(document.get("constraints", ())):
        reason = guarded_clause_refusal(constraint)
        if reason is not None:
            incompatible[("constraints", index)] = reason
    for index, fact in enumerate(ModelIndex(None, document).iter_fact_types_shared()):
        if any(
            where_uses_membership(clause.get("where"))
            for clause in iter_derivation_clauses(fact.get("derivation_rule"))
        ):
            incompatible[("fact_types", index, "derivation_rule")] = "membership-unsupported"
    mapped.update((path, ("extension", reason, None)) for path, reason in incompatible.items())
    rows, elements, refused = _metadata(document, mapped)
    if strict and refused:
        raise OssieInputError(_POPULATION_REFUSAL)
    if strict and incompatible:
        raise OssieInputError(next(iter(incompatible.values())))
    if output_format == "json":
        data = canonical_json_bytes(ontology)
    elif output_format == "yaml":
        yaml = YAML(typ="safe", pure=True)
        yaml.version = (1, 1)
        yaml.default_flow_style = False
        yaml.sort_base_mapping_type_on_output = False
        stream = StringIO()
        yaml.dump(ontology, stream)
        data = stream.getvalue().encode("utf-8")
    else:
        raise OssieInputError("unsupported Ossie output format")
    try:
        identity = model_identity(model)
        binding = {"model_identity": identity, "document_sha256": hashlib.sha256(data).hexdigest()}
        report = canonical_json_bytes(
            {"schema": "gnd-ossie-loss/1", **binding, "dispositions": rows}
        )
        sidecar = canonical_json_bytes(
            {"schema": "gnd-ossie-sidecar/1", **binding, "elements": elements}
        )
    except (ModelIdentityError, UnicodeEncodeError, ValueError) as error:
        raise OssieInputError("model has no encodable interchange identity") from error
    if max(len(data), len(sidecar), len(report)) > max_output_bytes:
        raise OssieInputError("ossie:output-size")
    from gnd.redaction import RedactionPolicy

    declared = {row.fact_type for row in RedactionPolicy.from_model(model).declarations}
    return OssieArtifacts(data, sidecar, report, len(declared))


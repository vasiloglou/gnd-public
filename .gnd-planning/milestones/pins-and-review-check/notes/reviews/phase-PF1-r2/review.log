+def _shimmed(tmp_path: Path) -> Path:
+    real = shutil.which('gnd')
+    if real is None:
+        pytest.skip('no `gnd` console script on PATH to shim')
+    shim_dir = tmp_path / 'toolbin'
+    shim_dir.mkdir()
+    (shim_dir / 'gnd').symlink_to(Path(real))
+    return shim_dir

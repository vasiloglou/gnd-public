diff --git a/tools/project_version.py b/tools/project_version.py
new file mode 100644
index 00000000..c8e17cfe
--- /dev/null
+++ b/tools/project_version.py
@@ -0,0 +1,12 @@
+"""Read the project version from a pyproject.toml."""
+from __future__ import annotations
+
+import tomllib
+from pathlib import Path
+
+
+def project_version(path: str | Path) -> str | None:
+    """Return ``[project].version``, or None when the file declares none."""
+    with Path(path).open("rb") as handle:
+        version = tomllib.load(handle).get("project", {}).get("version")
+    return version if isinstance(version, str) else None

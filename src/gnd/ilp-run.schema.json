{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnd.dev/schemas/ilp-run.schema.json",
  "title": "GND ILP learner run record (gnd-ilp-run/1)",
  "description": "IK5. What a learner run reports: the learner, the export and clause bytes it bound, and the example ids each clause covers. A claim GND re-checks, never an input it trusts (IK-R2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learner",
    "export_sha256",
    "clauses_sha256",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "gnd-ilp-run/1"
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        }
      }
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clauses_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause",
          "covered"
        ],
        "properties": {
          "clause": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "covered": {
            "type": "array",
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]{0,63}$"
            }
          }
        }
      }
    }
  }
}

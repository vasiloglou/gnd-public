{"role":"tool","tool_call_id":"tool_AXVqcySS3esnaSOhsL7rHKrD","content":"1\t\"\"\"Canonical production and parsing of GND model-element addresses.\n2\t\n3\tDeclared model elements use a class-qualified identifier. Constraints that do\n4\tnot declare an identifier retain the positional references emitted by the\n5\tchecker since v1.0; those references are intentionally recognizable as the\n6\tlegacy, unstable form.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\timport re\n12\tfrom dataclasses import dataclass\n13\tfrom typing import Literal\n14\t\n15\tElementClass = Literal[\"operation\", \"fact_type\", \"constraint\", \"derivation\"]\n16\tAddressing = Literal[\"declared-id\", \"positional\"]\n17\t\n18\t\n19\t@dataclass(frozen=True)\n20\tclass Address:\n21\t    \"\"\"One parsed element address.\"\"\"\n22\t\n23\t    text: str\n24\t    element_class: ElementClass\n25\t    addressing: Addressing\n26\t    identifier: str | None = None\n27\t    fact_type_id: str | None = None\n28\t    index: int | None = None\n29\t\n30\t\n31\t_INLINE_CONSTRAINT = re.compile(\n32\t    r\"fact_types\\[(?P<fact_type>[^\\[\\]]+)\\]\\.constraints\\[(?P<index>[0-9]+)\\]\"\n33\t)\n34\t_TOP_LEVEL_CONSTRAINT = re.compile(r\"constraints\\[(?P<index>[0-9]+)\\]\")\n35\t\n36\t\n37\tdef operation_address(op_id: str) -> str:\n38\t    \"\"\"Return the declared-id address for an operation.\"\"\"\n39\t\n40\t    return f\"operation:{op_id}\"\n41\t\n42\t\n43\tdef fact_type_address(ft_id: str) -> str:\n44\t    \"\"\"Return the declared-id address for a fact type.\"\"\"\n45\t\n46\t    return f\"fact_type:{ft_id}\"\n47\t\n48\t\n49\tdef constraint_address(constraint_id: str) -> str:\n50\t    \"\"\"Return the declared-id address for a constraint.\"\"\"\n51\t\n52\t    return f\"constraint:{constraint_id}\"\n53\t\n54\t\n55\tdef derivation_address(fact_type_id: str) -> str:\n56\t    \"\"\"Return the address for one derivation obligation (v5.0 r2 R2).\n57\t\n58\t    Deliberately DISTINCT from :func:`fact_type_address` over the same id: one\n59\t    fact type, two obligations, two addresses. Parsed by :func:`parse_address`\n60\t    and counted by ``gnd coverage`` since Phase 3 (T3.6).\n61\t    \"\"\"\n62\t\n63\t    return f\"derivation:{fact_type_id}\"\n64\t\n65\t\n66\tdef positional_constraint_ref(fact_type_id: str | None, index: int) -> str:\n67\t    \"\"\"Return the legacy positional constraint reference emitted since v1.0.\"\"\"\n68\t\n69\t    if fact_type_id is None:\n70\t        return f\"constraints[{index}]\"\n71\t    return f\"fact_types[{fact_type_id}].constraints[{index}]\"\n72\t\n73\t\n74\tdef _parse_index(text: str) -> int | None:\n75\t    \"\"\"Convert an ASCII digit run without leaking Python's integer cap error.\"\"\"\n76\t\n77\t    if len(text) > 32:\n78\t        return None\n79\t    try:\n80\t        return int(text)\n81\t    except ValueError:\n82\t        return None\n83\t\n84\t\n85\tdef parse_address(text: str) -> Address | None:\n86\t    \"\"\"Parse ``text`` as an element address; return ``None`` for anything else.\n87\t\n88\t    This function is total over arbitrary :class:`str`: malformed and hostile\n89\t    strings are ordinary non-addresses and never raise.\n90\t    \"\"\"\n91\t\n92\t    for prefix, element_class in (\n93\t        (\"operation:\", \"operation\"),\n94\t        (\"fact_type:\", \"fact_type\"),\n95\t        (\"constraint:\", \"constraint\"),\n96\t        (\"derivation:\", \"derivation\"),\n97\t    ):\n98\t        if text.startswith(prefix):\n99\t            identifier = text[len(prefix) :]\n100\t            if not identifier or identifier.strip() != identifier:\n101\t                return None\n102\t            return Address(text, element_class, \"declared-id\", identifier=identifier)\n103\t\n104\t    inline = _INLINE_CONSTRAINT.fullmatch(text)\n105\t    if inline is not None:\n106\t        index = _parse_index(inline.group(\"index\"))\n107\t        if index is None:\n108\t            return None\n109\t        return Address(\n110\t            text,\n111\t            \"constraint\",\n112\t            \"positional\",\n113\t            fact_type_id=inline.group(\"fact_type\"),\n114\t            index=index,\n115\t        )\n116\t\n117\t    top_level = _TOP_LEVEL_CONSTRAINT.fullmatch(text)\n118\t    if top_level is not None:\n119\t        index = _parse_index(top_level.group(\"index\"))\n120\t        if index is None:\n121\t            return None\n122\t        return Address(text, \"constraint\", \"positional\", index=index)\n123\t    return None"}

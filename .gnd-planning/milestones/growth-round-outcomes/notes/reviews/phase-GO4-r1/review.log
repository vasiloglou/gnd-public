   363	def _population_eligible(operation: Any, kind: Any) -> bool:
   364	    """UG2: only a `proposed` + `deontic` constraint after the operation can be cleared."""
   365	    after = operation.after
   366	    return (
   367	        kind in (_ADD, _MODIFY)
   368	        and _lookup(after, "status") == "proposed"
   369	        and _lookup(after, "modality") == "deontic"
   370	    )

+{"role":"tool","tool_call_id":"tool_y0NyCnSYxH0BzAQK93tnMdMX","content":"1\t\"\"\"Replay a bounded literature reading run with typed coverage and fidelity.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport math\n6\timport os\n7\timport re\n8\timport sys\n9\timport tempfile\n10\tfrom collections.abc import Iterable\n11\tfrom dataclasses import dataclass, fields\n12\tfrom pathlib import Path\n13\tfrom typing import Protocol\n14\t\n15\tfrom gnd.artifacts import ArtifactError, canonical_json_bytes, read_regular_bounded, sha256_hex\n16\tfrom gnd.input_policy import MAX_BYTES as JSON_READ_LIMIT\n17\tfrom gnd.process import ProcessLimits\n18\t\n19\tfrom .depth import FIXTURE as DEPTH_FIXTURE\n20\tfrom .depth import INPUT_LIMIT, PROCESS_LIMITS, ExampleError, _command, _decode, _read\n21\t\n22\tFIXTURE = Path(__file__).parent / \"reading_fixture\"\n23\tSTAGES = (\n24\t    \"inventory\", \"broad-extraction\", \"selection\", \"targeted-extraction\", \"review\", \"recheck\",\n25\t)\n26\tPURPOSES = (\n27\t    \"Identify available source versions and sections\",\n28\t    \"Read opening material and retain unanswered questions\",\n29\t    \"Select available ranges for unresolved questions\",\n30\t    \"Recover targeted facts and identify earlier material to revisit\",\n31\t    \"Resolve source coverage and review reported assertions\",\n32\t    \"Check affected facts and measure held-back fidelity\",\n33\t)\n34\tINPUTS = (\n35\t    \"roster.json\", \"producer-pin.json\", \"reviews.json\", \"gold.json\", \"calibration.json\",\n36\t    \"calibration.txt\", \"conflict.json\", \"conflict.txt\", \"scope.json\", \"closure.json\", \"reading.orm.json\",\n37\t)\n38\tEVIDENCE = (\n39\t    \"coverage.json\", \"scope.json\", \"closure.json\", \"fidelity-high.json\", \"fidelity-low.json\",\n40\t    \"reported-conflict.population.json\", \"reported-conflict.source.txt\", \"broad.population.json\",\n41\t    \"targeted.population.json\", \"producer-output-table.json\",\n42\t)\n43\tFILES = (*EVIDENCE, *(f\"stage-{i}.json\" for i in range(6)), *(f\"payload-{i}.json\" for i in range(6)))\n44\tIDENTIFIER = re.compile(r\"[a-z][a-z0-9-]{0,63}\\Z\")\n45\tSCENARIOS = (\"full\", \"unavailable\")\n46\tDEFAULT_BUDGET = 4096\n47\tMAX_BUDGET = 1 << 20\n48\tROSTER_LIMIT = 128\n49\tCALIBRATION_FACTS = frozenset({\"approximation\", \"alternative_integrator\"})\n50\tCOVERAGE_STATES = (\n51\t    \"supported\", \"explicitly-denied\", \"inspected-not-found\", \"unavailable\",\n52\t    \"not-applicable\", \"omitted\", \"producer-refused\", \"empty-extraction\",\n53\t)\n54\tSUBJECT = \"alanine-in-vacuum\"\n55\tLABEL = {\"subject\": SUBJECT, \"label\": \"Alanine dipeptide observation\"}\n56\t\n57\tRUN_FORMAT = \"literature-reading-run/1\"\n58\tCALLER_RUN_FORMAT = \"literature-reading-run/2\"\n59\tPROFILE = \"profile.json\"\n60\tPROFILE_FORMAT = \"literature-reading-profile/1\"\n61\tPROFILE_KEYS = frozenset({\n62\t    \"format\", \"model\", \"includes\", \"producer_label\", \"base_facts\", \"review\", \"calibration\", \"conflict\", \"absence\",\n63\t})\n64\tMODEL_NAME = re.compile(r\"[a-z][a-z0-9-]{0,63}\\.orm\\.json\\Z\")\n65\tPRODUCER_LABEL = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\\Z\")\n66\tMAX_MODEL_FILES = 17\n67\tJSON_DEPTH = 8\n68\tLIMIT_CEILINGS = {\"roster\": 4096, \"max_budget\": 1 << 26, \"input_bytes\": 8 << 20,\n69\t                  \"response_bytes\": 1 << 20, \"route_seconds\": 600,\n70\t                  \"route_output_bytes\": 16 << 20, \"retained_bytes\": JSON_READ_LIMIT}\n71\tRETAINED_FLOOR = 128 * 1024\n72\tROW_OVERHEAD = 1024\n73\tCALLER_EXITS = (0, 1, 2, 4)\n74\tSTEPS = (\"review\", \"calibration\", \"conflict\", \"absence\")\n75\t\n76\t\n77\tdef _need(condition: bool, reason: str) -> None:\n78\t    if not condition:\n79\t        raise ExampleError(reason)\n80\t\n81\t\n82\t@dataclass(frozen=True)\n83\tclass ReadingLimits:\n84\t    \"\"\"The caps of a caller run; each default is today's constant or effective bound.\"\"\"\n85\t\n86\t    roster: int = ROSTER_LIMIT\n87\t    max_budget: int = MAX_BUDGET\n88\t    input_bytes: int = INPUT_LIMIT\n89\t    response_bytes: int = 128 * 1024\n90\t    route_seconds: int = 30\n91\t    route_output_bytes: int = 1 << 20\n92\t    retained_bytes: int | None = None\n93\t\n94\t\n95\tdef _checked_limits(limits: object) -> ReadingLimits:\n96\t    _need(isinstance(limits, ReadingLimits), \"invalid reading limits\")\n97\t    for item in fields(ReadingLimits):\n98\t        value = getattr(limits, item.name)\n99\t        if item.name == \"retained_bytes\" and value is None:\n100\t            continue\n101\t        _need(type(value) is int and 1 <= value <= LIMIT_CEILINGS[item.name],\n102\t              f\"invalid reading limit {item.name}\")\n103\t    return limits\n104\t\n105\t\n106\tdef _route_limits(limits: ReadingLimits) -> ProcessLimits:\n107\t    return ProcessLimits(\n108\t        timeout_seconds=limits.route_seconds, terminate_grace_seconds=1, stdin_limit_bytes=0,\n109\t        stdout_limit_bytes=limits.route_output_bytes, stderr_limit_bytes=INPUT_LIMIT,\n110\t        total_output_limit_bytes=limits.route_output_bytes,\n111\t    )\n112\t\n113\t\n114\t@dataclass(frozen=True)\n115\tclass ProducerCall:\n116\t    \"\"\"One section offered to a producer, with its bytes and the open questions on it.\"\"\"\n117\t\n118\t    stage: str\n119\t    section: str\n120\t    source: str\n121\t    source_version: str\n122\t    kind: str\n123\t    start: int\n124\t    end: int\n125\t    excerpt: bytes\n126\t    excerpt_sha256: str\n127\t    questions: tuple[dict, ...]\n128\t\n129\t\n130\tclass Producer(Protocol):\n131\t    def produce(self, call: ProducerCall) -> dict: ...\n132\t\n133\t\n134\t@dataclass(frozen=True)\n135\tclass ReviewCall:\n136\t    \"\"\"One accepted response offered to a reviewer.\"\"\"\n137\t\n138\t    section: str\n139\t    excerpt: bytes\n140\t    excerpt_sha256: str\n141\t    facts: dict\n142\t    facts_sha256: str\n143\t\n144\t\n145\tclass Reviewer(Protocol):\n146\t    def review(self, call: ReviewCall) -> dict: ...\n147\t\n148\t\n149\t@dataclass(frozen=True)\n150\tclass Profile:\n151\t    \"\"\"What a root binds the loop to: the packaged constants, or a caller's profile.json.\"\"\"\n152\t\n153\t    model: str\n154\t    includes: tuple[str, ...]\n155\t    producer_label: str\n156\t    base_facts: dict\n157\t    review: bool\n158\t    calibration: dict | None\n159\t    conflict: dict | None\n160\t    absence: bool\n161\t    exits: tuple[int, ...]\n162\t    caller: bool\n163\t\n164\t    def steps(self) -> dict:\n165\t        return {name: \"ran\" if getattr(self, name) not in (False, None) else \"skipped\" for name in STEPS}\n166\t\n167\t\n168\tPACKAGED_PROFILE = Profile(\n169\t    model=\"reading.orm.json\", includes=(\"vocabulary.orm.json\",), producer_label=\"saved-public-fixture\",\n170\t    base_facts={\"subject_label\": [LABEL]}, review=True,\n171\t    calibration={\"section\": \"study-methods\", \"section_facts\": [\"approximation\"],\n172\t                 \"held_back_facts\": [\"alternative_integrator\"], \"renderer_label\": \"authored-public-fixture\",\n173\t                 \"case_names\": [\"run-methods\", \"held-back-predicate\"]},\n174\t    conflict={\"fact_type\": \"subject_label\", \"role\": \"label\"}, absence=True, exits=(0,), caller=False,\n175\t)\n176\t\n177\t\n178\tdef _plain(value: object, what: str) -> None:\n179\t    \"\"\"Refuse anything that is not plain JSON, without recursion, before it is serialized.\"\"\"\n180\t    stack = [(value, 0)]\n181\t    while stack:\n182\t        item, level = stack.pop()\n183\t        _need(level <= JSON_DEPTH, f\"{what} nests too deeply\")\n184\t        if isinstance(item, dict):\n185\t            for key, child in item.items():\n186\t                _need(type(key) is str, f\"{what} has a non-string key\")\n187\t                stack.append((child, level + 1))\n188\t        elif isinstance(item, list):\n189\t            stack.extend((child, level + 1) for child in item)\n190\t        elif type(item) is float:\n191\t            _need(math.isfinite(item), f\"{what} has a non-finite number\")\n192\t        else:\n193\t            _need(item is None or type(item) in (str, int, bool), f\"{what} is not JSON\")\n194\t\n195\t\n196\tdef _canonical(value: object, what: str) -> bytes:\n197\t    \"\"\"Serialize an untrusted value, refusing what canonical JSON cannot carry.\"\"\"\n198\t    try:\n199\t        return canonical_json_bytes(value)\n200\t    except (ValueError, TypeError, RecursionError, UnicodeError) as error:\n201\t        raise ExampleError(f\"{what} is not serializable JSON\") from error\n202\t\n203\t\n204\tdef _utf8(raw: bytes, what: str) -> None:\n205\t    try:\n206\t        raw.decode(\"utf-8\")\n207\t    except UnicodeDecodeError as error:\n208\t        raise ExampleError(f\"{what} is not UTF-8 text\") from error\n209\t\n210\t\n211\tSHA256 = re.compile(r\"[0-9a-f]{64}\\Z\")\n212\tSOURCE_KEYS = frozenset({\"id\", \"version\", \"path\", \"sha256\"})\n213\tSECTION_KEYS = frozenset({\"id\", \"source\", \"kind\", \"selection\", \"keys\", \"span\", \"reason\"})\n214\tQUESTION_KEYS = frozenset({\"id\", \"section\", \"fact\", \"required\", \"superseded_by\", \"denial\"})\n215\t\n216\t\n217\tdef _fact_rows(value: object, what: str) -> dict:\n218\t    \"\"\"The one row validator: fact-type names mapped to rows of role names and scalar values.\"\"\"\n219\t    _need(isinstance(value, dict), f\"invalid {what}\")\n220\t    for name, rows in value.items():\n221\t        _need(isinstance(name, str) and isinstance(rows, list), f\"invalid {what}\")\n222\t        for row in rows:\n223\t            _need(isinstance(row, dict) and all(\n224\t                isinstance(role, str) and (type(item) in (str, int, bool)\n225\t                                           or type(item) is float and math.isfinite(item))\n226\t                for role, item in row.items()), f\"invalid {what} row\")\n227\t    return value\n228\t\n229\t\n230\tdef _rows_by_id(rows: list, limit: int = ROSTER_LIMIT) -> dict:\n231\t    _need(isinstance(rows, list) and 0 < len(rows) <= limit, \"invalid reading roster size\")\n232\t    indexed = {}\n233\t    for row in rows:\n234\t        id_ = row.get(\"id\") if isinstance(row, dict) else None\n235\t        _need(isinstance(id_, str) and IDENTIFIER.fullmatch(id_) is not None and id_ not in indexed,\n236\t              \"invalid or duplicate reading roster ID\")\n237\t        indexed[id_] = row\n238\t    return indexed\n239\t\n240\t\n241\tdef _profile(raw: bytes, limits: ReadingLimits) -> Profile:\n242\t    value = _decode(raw, max_bytes=limits.input_bytes)\n243\t    _plain(value, \"reading profile\")\n244\t    _canonical(value, \"reading profile\")\n245\t    _need(set(value) == PROFILE_KEYS and value[\"format\"] == PROFILE_FORMAT, \"invalid reading profile keys\")\n246\t    model, includes = value[\"model\"], value[\"includes\"]\n247\t    _need(isinstance(includes, list) and len(includes) < MAX_MODEL_FILES\n248\t          and all(isinstance(name, str) and MODEL_NAME.fullmatch(name) for name in (model, *includes))\n249\t          and len({model, *includes}) == len(includes) + 1, \"invalid reading profile model files\")\n250\t    label = value[\"producer_label\"]\n251\t    _need(isinstance(label, str) and PRODUCER_LABEL.fullmatch(label) is not None, \"invalid producer label\")\n252\t    _fact_rows(value[\"base_facts\"], \"profile base facts\")\n253\t    _need(type(value[\"review\"]) is bool and type(value[\"absence\"]) is bool, \"invalid reading profile steps\")\n254\t    calibration = value[\"calibration\"]\n255\t    if calibration is not None:\n256\t        _need(isinstance(calibration, dict) and set(calibration) == {\n257\t            \"section\", \"section_facts\", \"held_back_facts\", \"renderer_label\", \"case_names\"}, \"invalid calibration step\")\n258\t        lists = calibration[\"section_facts\"], calibration[\"held_back_facts\"]\n259\t        cases = calibration[\"case_names\"]\n260\t        _need(isinstance(calibration[\"section\"], str)\n261\t              and all(isinstance(names, list) and names and all(isinstance(n, str) for n in names) for names in lists)\n262\t              and not set(lists[0]) & set(lists[1])\n263\t              and isinstance(calibration[\"renderer_label\"], str)\n264\t              and PRODUCER_LABEL.fullmatch(calibration[\"renderer_label\"]) is not None\n265\t              and isinstance(cases, list) and len(cases) == 2 and cases[0] != cases[1]\n266\t              and all(isinstance(n, str) and IDENTIFIER.fullmatch(n) for n in cases), \"invalid calibration step\")\n267\t    conflict = value[\"conflict\"]\n268\t    _need(conflict is None or isinstance(conflict, dict) and set(conflict) == {\"fact_type\", \"role\"}\n269\t          and all(isinstance(conflict[key], str) for key in (\"fact_type\", \"role\")), \"invalid conflict step\")\n270\t    _need(not value[\"absence\"] or calibration is not None, \"the absence step needs calibration\")\n271\t    return Profile(model=model, includes=tuple(includes), producer_label=label, base_facts=value[\"base_facts\"],\n272\t                   review=value[\"review\"], calibration=calibration, conflict=conflict, absence=value[\"absence\"],\n273\t                   exits=CALLER_EXITS, caller=True)\n274\t\n275\t\n276\tdef _has_profile(root: Path) -> bool:\n277\t    return os.path.lexists(root / PROFILE)\n278\t\n279\t\n280\tclass ReadingInputs:\n281\t    \"\"\"Read and validate the declared source, section and question inventories.\"\"\"\n282\t\n283\t    def __init__(self, root: Path, *, retained_responses: bytes | None = None,\n284\t                 vocabulary_fixture: Path = DEPTH_FIXTURE, limits: ReadingLimits | None = None,\n285\t                 live: bool = False, live_review: bool = False, unavailable: Iterable[str] = (),\n286\t                 retained_reviews: bytes | None = None) -> None:\n287\t        self.limits = limits if limits is not None else ReadingLimits()\n288\t        if _has_profile(root):\n289\t            self._caller(root, retained_responses, live, live_review, unavailable, retained_reviews)\n290\t        else:\n291\t            self._packaged(root, retained_responses, vocabulary_fixture)\n292\t        self.by_section = {}\n293\t        for name, question in self.questions.items():\n294\t            if question[\"superseded_by\"] is None:\n295\t                self.by_section.setdefault(question[\"section\"], []).append(\n296\t                    {\"id\": name, \"fact\": question[\"fact\"], \"denial\": question[\"denial\"]})\n297\t        self.input_pins = {name: sha256_hex(raw) for name, raw in self.raw.items()}\n298\t\n299\t    def _packaged(self, root, retained_responses, vocabulary_fixture):\n300\t        self.profile = PACKAGED_PROFILE\n301\t        self.raw = {name: _read(root, name) for name in INPUTS}\n302\t        responses = _read(root, \"responses.json\") if retained_responses is None else retained_responses\n303\t        producer_pin = _decode(self.raw[\"producer-pin.json\"])\n304\t        _need(producer_pin == {\"sha256\": sha256_hex(responses)}, \"saved producer table differs from its pin\")\n305\t        self.raw[\"responses.json\"] = responses\n306\t        roster = _decode(self.raw[\"roster.json\"])\n307\t        self.responses = _decode(self.raw[\"responses.json\"])\n308\t        self.reviews = _decode(self.raw[\"reviews.json\"])\n309\t        self._roster(roster, lambda path: _read(root, path), ROSTER_LIMIT)\n310\t        _need(set(self.responses) == self.response_sections, \"saved response roster differs\")\n311\t        self.raw[\"vocabulary.orm.json\"] = _read(vocabulary_fixture, \"vocabulary.orm.json\")\n312\t        self._steps(PROCESS_LIMITS.stdout_limit_bytes)\n313\t\n314\t    def _caller(self, root, retained_responses, live, live_review, unavailable, retained_reviews):\n315\t        cap = self.limits.input_bytes\n316\t        kept = self.limits.retained_bytes or LIMIT_CEILINGS[\"retained_bytes\"]\n317\t\n318\t        def read(name):\n319\t            return read_regular_bounded(root, name, max_bytes=cap)[0]\n320\t\n321\t        self.raw = {PROFILE: read(PROFILE)}\n322\t        self.profile = profile = _profile(self.raw[PROFILE], self.limits)\n323\t        self.raw[\"roster.json\"] = read(\"roster.json\")\n324\t        roster = _decode(self.raw[\"roster.json\"], max_bytes=cap)\n325\t        _canonical(roster, \"reading roster\")\n326\t        self._roster(roster, read, self.limits.roster)\n327\t        _need(all(isinstance(name, str) and name in self.sections for name in unavailable),\n328\t              \"unknown unavailable section\")\n329\t        for name in (profile.model, *profile.includes):\n330\t            self.raw[name] = read(name)\n331\t        needed = ((\"gold.json\", \"calibration.json\", \"calibration.txt\") if profile.calibration else ()) + (\n332\t            (\"conflict.json\", \"conflict.txt\") if profile.conflict else ()) + (\n333\t            (\"scope.json\", \"closure.json\") if profile.absence else ())\n334\t        for name in needed:\n335\t            self.raw[name] = read(name)\n336\t        self._steps(cap)\n337\t        if profile.calibration is not None:\n338\t            section = self.sections.get(profile.calibration[\"section\"])\n339\t            _need(section is not None and section[\"selection\"] == \"targeted\", \"invalid calibration section\")\n340\t        if profile.absence:\n341\t            scope = _decode(self.raw[\"scope.json\"], max_bytes=cap)\n342\t            _need(isinstance(scope.get(\"questions\"), list) and scope[\"questions\"]\n343\t                  and all(isinstance(q, str) and q in self.questions\n344\t                          and self.questions[q][\"fact\"] == scope.get(\"predicate\") for q in scope[\"questions\"]),\n345\t                  \"invalid absence scope\")\n346\t            self.predicate = scope[\"predicate\"]\n347\t        self.responses = None\n348\t        if live and retained_responses is not None:\n349\t            self.responses = _decode(retained_responses, max_bytes=kept)\n350\t            _canonical(self.responses, \"retained responses\")\n351\t        if not live:\n352\t            responses = read(\"responses.json\") if retained_responses is None else retained_responses\n353\t            self.raw[\"producer-pin.json\"] = read(\"producer-pin.json\")\n354\t            _need(_decode(self.raw[\"producer-pin.json\"], max_bytes=cap) == {\"sha256\": sha256_hex(responses)},\n355\t                  \"saved producer table differs from its pin\")\n356\t            self.raw[\"responses.json\"] = responses\n357\t            self.responses = _decode(responses, max_bytes=cap)\n358\t            _canonical(self.responses, \"saved responses\")\n359\t            _need(set(self.responses) == self.response_sections, \"saved response roster differs\")\n360\t        _need(profile.review or not live_review, \"a reviewer needs the review step\")\n361\t        self.reviews = None\n362\t        if profile.review and (not live_review or retained_reviews is not None):\n363\t            if live_review:\n364\t                self.reviews = _decode(retained_reviews, max_bytes=kept)\n365\t            else:\n366\t                self.raw[\"reviews.json\"] = read(\"reviews.json\")\n367\t                self.reviews = _decode(self.raw[\"reviews.json\"], max_bytes=cap)\n368\t            _canonical(self.reviews, \"saved reviews\")\n369\t            for name, receipt in self.reviews.items():\n370\t                _need(name in self.response_sections and isinstance(receipt, dict)\n371\t                      and set(receipt) == {\"basis\", \"decision\", \"excerpt_sha256\", \"facts_sha256\"}\n372\t                      and all(isinstance(item, str) for item in receipt.values())\n373\t                      and len(canonical_json_bytes(receipt)) <= self.limits.response_bytes,\n374\t                      \"invalid saved reviews\")\n375\t                _need(receipt[\"decision\"] == \"supported\" and bool(receipt[\"basis\"])\n376\t                      and receipt[\"excerpt_sha256\"] == sha256_hex(self.source_range(self.sections[name]))\n377\t                      and SHA256.fullmatch(receipt[\"facts_sha256\"]) is not None,\n378\t                      \"stale semantic reading review\")\n379\t\n380\t    def _roster(self, roster, read, limit):\n381\t        _need(roster.get(\"format\") == \"literature-reading-roster/1\", \"invalid reading roster format\")\n382\t        self.sources = _rows_by_id(roster.get(\"sources\"), limit)\n383\t        self.sections = _rows_by_id(roster.get(\"sections\"), limit)\n384\t        self.questions = _rows_by_id(roster.get(\"questions\"), limit)\n385\t        for rows, keys in ((self.sources, SOURCE_KEYS), (self.sections, SECTION_KEYS),\n386\t                           (self.questions, QUESTION_KEYS)):\n387\t            _need(all(keys <= set(row) for row in rows.values()), \"incomplete reading roster row\")\n388\t        self.documents = {}\n389\t        for name, source in self.sources.items():\n390\t            _need(source.get(\"path\") == f\"{name}.txt\" and isinstance(source.get(\"version\"), str),\n391\t                  \"invalid reading source location\")\n392\t            document = read(source[\"path\"])\n393\t            _need(sha256_hex(document) == source.get(\"sha256\"), \"stale reading source\")\n394\t            _utf8(document, \"reading source\")\n395\t            self.documents[name] = document\n396\t            self.raw[source[\"path\"]] = document\n397\t        last_end: dict[str, int] = {}\n398\t        self.response_sections = set()\n399\t        for section in self.sections.values():\n400\t            source, span, selection = section.get(\"source\"), section.get(\"span\"), section.get(\"selection\")\n401\t            _need(isinstance(source, str) and source in self.documents\n402\t                  and section.get(\"kind\") in (\"section\", \"equation\", \"table\"),\n403\t                  \"invalid source section\")\n404\t            if span is None:\n405\t                _need(selection is None and section.get(\"reason\") in (\"unavailable\", \"not-applicable\"),\n406\t                      \"invalid unavailable section\")\n407\t            else:\n408\t                _need(isinstance(span, list) and len(span) == 2 and all(type(x) is int for x in span)\n409\t                      and last_end.get(source, 0) <= span[0] < span[1] <= len(self.documents[source])\n410\t                      and selection in (\"opening\", \"targeted\"), \"invalid reading span\")\n411\t                _utf8(self.documents[source][span[0]:span[1]], \"reading span\")\n412\t                last_end[source] = span[1]\n413\t                self.response_sections.add(section[\"id\"])\n414\t            keys = section.get(\"keys\")\n415\t            _need(isinstance(keys, list) and all(isinstance(key, str) for key in keys),\n416\t                  \"invalid section dependency keys\")\n417\t        for question in self.questions.values():\n418\t            section = question.get(\"section\")\n419\t            successor = question.get(\"superseded_by\")\n420\t            _need(isinstance(section, str) and section in self.sections\n421\t                  and isinstance(question.get(\"fact\"), str) and type(question.get(\"required\")) is bool\n422\t                  and type(question.get(\"denial\")) is bool,\n423\t                  \"invalid question evidence selector\")\n424\t            _need(successor is None or isinstance(successor, str) and successor in self.questions,\n425\t                  \"unknown superseding question\")\n426\t        settled = set()\n427\t        for question in self.questions:\n428\t            seen = set()\n429\t            successor = question\n430\t            while successor is not None and successor not in settled:\n431\t                _need(successor not in seen, \"cyclic question supersession\")\n432\t                seen.add(successor)\n433\t                successor = self.questions[successor][\"superseded_by\"]\n434\t            settled.update(seen)\n435\t        keys = roster.get(\"revisit_keys\")\n436\t        _need(isinstance(keys, list) and all(isinstance(key, str) for key in keys), \"invalid revisit keys\")\n437\t        self.revisit_keys = set(keys)\n438\t\n439\t    def _steps(self, cap):\n440\t        \"\"\"Decode the files of the declared steps; one home for both kinds of root.\"\"\"\n441\t        profile = self.profile\n442\t        self.gold = self.calibration = self.conflict_facts = None\n443\t        if profile.calibration is not None:\n444\t            gold = _fact_rows(_decode(self.raw[\"gold.json\"], max_bytes=cap), \"held-back gold\")\n445\t            _canonical(gold, \"held-back gold\")\n446\t            wanted = {*profile.calibration[\"section_facts\"], *profile.calibration[\"held_back_facts\"]}\n447\t            _need(set(gold) == wanted, \"invalid held-back gold roster\")\n448\t            calibration = _decode(self.raw[\"calibration.json\"], max_bytes=cap)\n449\t            _need(set(calibration) == {\"high\", \"low\"}, \"invalid calibration candidates\")\n450\t            for kind in (\"high\", \"low\"):\n451\t                _fact_rows(calibration[kind], \"calibration candidate\")\n452\t            _canonical(calibration, \"calibration candidates\")\n453\t            self.gold, self.calibration = gold, calibration\n454\t        if profile.conflict is not None:\n455\t            document = self.raw[\"conflict.txt\"]\n456\t            conflict = _decode(self.raw[\"conflict.json\"], max_bytes=cap)\n457\t            facts = _fact_rows(conflict.get(\"facts\"), \"reported conflict facts\")\n458\t            _canonical(facts, \"reported conflict facts\")\n459\t            rows, role = facts.get(profile.conflict[\"fact_type\"]), profile.conflict[\"role\"]\n460\t            _need(conflict.get(\"document_sha256\") == sha256_hex(document)\n461\t                  and isinstance(rows, list) and len(rows) == 2\n462\t                  and all(isinstance(row.get(role), str) and row[role].encode() in document for row in rows),\n463\t                  \"stale reported conflict extraction\")\n464\t            self.conflict_facts = facts\n465\t\n466\t    def selection(self, kind: str) -> list[str]:\n467\t        return [name for name, section in self.sections.items() if section[\"selection\"] == kind]\n468\t\n469\t    def source_range(self, section: dict) -> bytes:\n470\t        first, last = section[\"span\"]\n471\t        return self.documents[section[\"source\"]][first:last]\n472\t\n473\t    def pins(self) -> dict:\n474\t        return dict(self.input_pins)\n475\t\n476\t\n477\t\n478\tclass SavedProducer:\n479\t    \"\"\"Local saved-response adapter with observed invocation counts.\"\"\"\n480\t\n481\t    def __init__(self, responses: dict) -> None:\n482\t        self.responses = responses\n483\t        self.calls = dict.fromkeys((STAGES[1], STAGES[3]), 0)\n484\t\n485\t    def produce(self, call: ProducerCall) -> dict:\n486\t        self.calls[call.stage] += 1\n487\t        return self.responses[call.section]\n488\t\n489\t\n490\tdef affected_sections(sections: dict, changed_keys: set[str]) -> list[str]:\n491\t    \"\"\"Return available earlier section IDs sharing a changed dependency key.\"\"\"\n492\t    return [name for name, row in sections.items()\n493\t            if row[\"span\"] is not None and changed_keys.intersection(row[\"keys\"])]\n494\t\n495\t\n496\tdef _response(value, inputs, covers, limits):\n497\t    \"\"\"Validate a producer's answer and return the parsed copy the loop retains.\"\"\"\n498\t    _plain(value, \"producer response\")\n499\t    outcome = value.get(\"outcome\") if isinstance(value, dict) else None\n500\t    facts = value.get(\"facts\") if isinstance(value, dict) else None\n501\t    proposed = value.get(\"proposal_keys\") if isinstance(value, dict) else None\n502\t    _need(isinstance(proposed, list) and all(isinstance(key, str) and key in inputs.revisit_keys for key in proposed),\n503\t          \"invalid vocabulary proposal\")\n504\t    _need(set(value) == {\"outcome\", \"facts\", \"proposal_keys\"} and outcome in (\"accepted\", \"empty\", \"refused\")\n505\t          and isinstance(facts, dict) and bool(facts) == (outcome == \"accepted\"), \"invalid saved producer response\")\n506\t    _fact_rows(facts, \"producer facts\")\n507\t    _need(covers is None or set(facts) <= covers, \"producer fact type outside the model\")\n508\t    raw = _canonical(value, \"producer response\")\n509\t    _need(len(raw) <= limits.response_bytes, \"producer response exceeds its cap\")\n510\t    return _decode(raw, max_bytes=limits.response_bytes)\n511\t\n512\t\n513\tdef _inspect(inputs, stage, selected, remaining, producer, retained, *,\n514\t             documents=None, covers=None, counts=None):\n515\t    attempts, omitted = [], []\n516\t    for name in selected:\n517\t        row = inputs.sections[name]\n518\t        excerpt = inputs.source_range(row)\n519\t        left = documents.get(row[\"source\"]) if documents is not None else None\n520\t        if len(excerpt) > remaining or left is not None and len(excerpt) > left:\n521\t            omitted.append(name)\n522\t            continue\n523\t        first, last = row[\"span\"]\n524\t        if producer is not None:\n525\t            call = ProducerCall(\n526\t                stage=stage, section=name, source=row[\"source\"],\n527\t                source_version=inputs.sources[row[\"source\"]][\"version\"], kind=row[\"kind\"], start=first, end=last,\n528\t                excerpt=excerpt, excerpt_sha256=sha256_hex(excerpt),\n529\t                questions=tuple(dict(question) for question in inputs.by_section.get(name, ())),\n530\t            )\n531\t            if counts is not None:\n532\t                counts[stage] += 1\n533\t            try:\n534\t                answer = producer.produce(call)\n535\t            except Exception as error:\n536\t                raise ExampleError(f\"producer failed at {stage} {name}\") from error\n537\t            response = _response(answer, inputs, covers, inputs.limits)\n538\t        else:\n539\t            response = retained.get(name)\n540\t            _need(response is not None and response == inputs.responses.get(name),\n541\t                  \"retained producer response differs\")\n542\t            response = _response(response, inputs, covers, inputs.limits)\n543\t        attempts.append({\n544\t            \"section\": name, \"source\": row[\"source\"], \"start\": first, \"end\": last,\n545\t            \"source_version\": inputs.sources[row[\"source\"]][\"version\"],\n546\t            \"excerpt_sha256\": sha256_hex(excerpt), \"response_sha256\": sha256_hex(canonical_json_bytes(response)),\n547\t            \"outcome\": response[\"outcome\"], \"response\": response,\n548\t        })\n549\t        remaining -= len(excerpt)\n550\t        if left is not None:\n551\t            documents[row[\"source\"]] = left - len(excerpt)\n552\t    return {\"attempts\": attempts, \"omitted\": omitted, \"original_producer_calls\": len(attempts)}, remaining\n553\t\n554\t\n555\tdef _review_attempts(inputs, attempts, reviewer=None):\n556\t    verified, receipts = [], {}\n557\t    if not inputs.profile.review:\n558\t        return verified, receipts\n559\t    for row in attempts:\n560\t        if row[\"outcome\"] != \"accepted\":\n561\t            continue\n562\t        name = row[\"section\"]\n563\t        facts_sha256 = sha256_hex(canonical_json_bytes(row[\"response\"][\"facts\"]))\n564\t        if reviewer is None:\n565\t            receipt = inputs.reviews.get(name)\n566\t            receipts[name] = receipt\n567\t        else:\n568\t            call = ReviewCall(section=name, excerpt=inputs.source_range(inputs.sections[name]),\n569\t                              excerpt_sha256=row[\"excerpt_sha256\"],\n570\t                              facts=_decode(canonical_json_bytes(row[\"response\"][\"facts\"])),\n571\t                              facts_sha256=facts_sha256)\n572\t            try:\n573\t                answer = reviewer.review(call)\n574\t            except Exception as error:\n575\t                raise ExampleError(f\"reviewer failed at {name}\") from error\n576\t            _plain(answer, \"review receipt\")\n577\t            _need(isinstance(answer, dict) and set(answer) == {\"decision\", \"basis\"}, \"invalid review receipt\")\n578\t            receipt = {**answer, \"excerpt_sha256\": row[\"excerpt_sha256\"], \"facts_sha256\": facts_sha256}\n579\t            _need(len(_canonical(receipt, \"review receipt\")) <= inputs.limits.response_bytes,\n580\t                  \"invalid review receipt\")\n581\t            receipts[name] = receipt\n582\t        _need(isinstance(receipt, dict) and receipt.get(\"decision\") == \"supported\"\n583\t              and receipt.get(\"excerpt_sha256\") == row[\"excerpt_sha256\"]\n584\t              and receipt.get(\"facts_sha256\") == facts_sha256\n585\t              and isinstance(receipt.get(\"basis\"), str) and bool(receipt[\"basis\"]),\n586\t              \"stale semantic reading review\")\n587\t        verified.append({\"section\": name, **receipt})\n588\t    return verified, receipts\n589\t\n590\t\n591\tdef _outcomes(inputs, attempted, unavailable):\n592\t    coverage, questions = [], []\n593\t    for name, question in inputs.questions.items():\n594\t        successor = question[\"superseded_by\"]\n595\t        if successor is not None:\n596\t            questions.append({\"id\": name, \"outcome\": \"superseded\", \"target\": successor})\n597\t            continue\n598\t        section = question[\"section\"]\n599\t        observation = attempted.get(section)\n600\t        facts = observation[\"response\"][\"facts\"] if observation else {}\n601\t        if section in unavailable:\n602\t            state = \"unavailable\"\n603\t        elif inputs.sections[section][\"span\"] is None:\n604\t            state = inputs.sections[section][\"reason\"]\n605\t        elif observation is None:\n606\t            state = \"omitted\"\n607\t        elif observation[\"outcome\"] == \"refused\":\n608\t            state = \"producer-refused\"\n609\t        elif observation[\"outcome\"] == \"empty\":\n610\t            state = \"empty-extraction\"\n611\t        elif question[\"fact\"] in facts:\n612\t            state = \"explicitly-denied\" if question[\"denial\"] else \"supported\"\n613\t        else:\n614\t            state = \"inspected-not-found\"\n615\t        inspected = observation is not None\n616\t        coverage.append({\"question\": name, \"source\": inputs.sections[section][\"source\"],\n617\t                         \"section\": section, \"state\": state, \"inspected\": inspected})\n618\t        resolved = state in (\"explicitly-denied\", \"supported\")\n619\t        questions.append({\"id\": name, \"outcome\": \"resolved\" if resolved else \"retained\", \"reason\": state})\n620\t    return coverage, questions\n621\t\n622\t\n623\tdef _combined(attempts, base=PACKAGED_PROFILE.base_facts):\n624\t    facts = {name: list(rows) for name, rows in base.items()}\n625\t    for row in attempts:\n626\t        for name, assertions in row[\"response\"][\"facts\"].items():\n627\t            facts.setdefault(name, []).extend(assertions)\n628\t    return facts\n629\t\n630\t\n631\tdef _population(header, facts):\n632\t    return canonical_json_bytes({\"population\": header, \"facts\": facts})\n633\t\n634\t\n635\t@dataclass(frozen=True)\n636\tclass _Work:\n637\t    \"\"\"The extracted model a run checks against, in its own temporary folder.\"\"\"\n638\t\n639\t    folder: Path\n640\t    index: dict\n641\t    stem: str\n642\t    route: ProcessLimits\n643\t    profile: Profile\n644\t\n645\t    @property\n646\t    def header(self) -> dict:\n647\t        return self.index[\"header_template\"]\n648\t\n649\t    @property\n650\t    def covers(self) -> frozenset:\n651\t        return frozenset(self.header[\"covers\"])\n652\t\n653\t\n654\tdef _extract(inputs, folder):\n655\t    profile = inputs.profile\n656\t    route = _route_limits(inputs.limits) if profile.caller else PROCESS_LIMITS\n657\t    for name in (profile.model, *profile.includes):\n658\t        (folder / name).write_bytes(inputs.raw[name])\n659\t    _route(folder, \"extract\", profile.model, \"--out\", \"bundle\", limits=route)\n660\t    stem = profile.model.removesuffix(\".json\")\n661\t    if profile.caller:\n662\t        raw = read_regular_bounded(folder, f\"bundle/{stem}.artifacts.json\",\n663\t                                   max_bytes=inputs.limits.route_output_bytes)[0]\n664\t        index = _decode(raw, max_bytes=inputs.limits.route_output_bytes)\n665\t    else:\n666\t        index = _decode(_read(folder, f\"bundle/{stem}.artifacts.json\"))\n667\t    return _Work(folder=folder, index=index, stem=stem, route=route, profile=profile)\n668\t\n669\t\n670\tdef _extraction_sidecar(work, document, raw, document_name, population_name):\n671\t    header, index = work.header, work.index\n672\t    return {\n673\t        \"schema_version\": 1, \"model\": header[\"model\"], \"model_sha256\": index[\"model\"][\"sha256\"],\n674\t        \"population\": population_name, \"population_sha256\": sha256_hex(raw),\n675\t        \"document\": document_name, \"document_sha256\": sha256_hex(document),\n676\t        \"projection_sha256\": index[\"artifacts\"][f\"{work.stem}.projection.schema.json\"][\"sha256\"],\n677\t        \"skill\": \"gnd-extract\", \"skill_version\": \"1\", \"executing_model\": work.profile.producer_label,\n678\t    }\n679\t\n680\t\n681\tdef _route(folder, *arguments, exits=(0,), limits=PROCESS_LIMITS):\n682\t    result = _command(folder, *arguments, limits=limits)\n683\t    _need(result.return_code in exits, f\"{arguments[0]} exited {result.return_code}\")\n684\t    return result\n685\t\n686\t\n687\tdef _checked(work, stem, document, facts):\n688\t    folder, header = work.folder, work.header\n689\t    exits = CALLER_EXITS if work.profile.caller else (0, 1)\n690\t    raw = _population(header, facts)\n691\t    document_name = stem + \".txt\"\n692\t    name = stem + \".population.json\"\n693\t    (folder / name).write_bytes(raw)\n694\t    (folder / document_name).write_bytes(document)\n695\t    (folder / (stem + \".population.extraction.json\")).write_bytes(canonical_json_bytes(\n696\t        _extraction_sidecar(work, document, raw, document_name, name)\n697\t    ))\n698\t    verify = _route(folder, \"verify\", header[\"model\"], name, \"--artifacts\", \"bundle\",\n699\t                    \"--format\", \"json\", exits=exits, limits=work.route)\n700\t    check = _route(folder, \"check\", header[\"model\"], name, \"--format\", \"json\", exits=exits, limits=work.route)\n701\t    return raw, {\"verify\": verify.return_code, \"check\": check.return_code}\n702\t\n703\t\n704\tdef _write_fidelity_case(case_root, work, document, gold, facts):\n705\t    header, index = work.header, work.index\n706\t    case_root.mkdir(parents=True)\n707\t    source = _population({**header, \"source\": \"fixture\"}, gold)\n708\t    candidate = _population(header, facts)\n709\t    sidecar = _extraction_sidecar(work, document, candidate, \"document.md\", \"extracted.population.json\")\n710\t    document_manifest = {\n711\t        \"schema_version\": 1, \"model\": header[\"model\"], \"model_sha256\": index[\"model\"][\"sha256\"],\n712\t        \"source_population\": \"source.population.json\", \"source_population_sha256\": sha256_hex(source),\n713\t        \"document\": \"document.md\", \"document_sha256\": sha256_hex(document),\n714\t        \"applicable_sha256\": index[\"artifacts\"][f\"{work.stem}.applicable.json\"][\"sha256\"],\n715\t        \"renderer_skill\": \"gnd-render-doc\", \"renderer_skill_version\": \"1\",\n716\t        \"executing_model\": work.profile.calibration[\"renderer_label\"], \"distractors\": [],\n717\t    }\n718\t    for name, raw in (\n719\t        (\"document.md\", document), (\"source.population.json\", source),\n720\t        (\"extracted.population.json\", candidate),\n721\t        (\"extracted.population.extraction.json\", canonical_json_bytes(sidecar)),\n722\t        (\"document.manifest.json\", canonical_json_bytes(document_manifest)),\n723\t    ):\n724\t        (case_root / name).write_bytes(raw)\n725\t\n726\t\n727\tdef _calibrate(work, inputs, targeted):\n728\t    step = work.profile.calibration\n729\t    gold, calibration = inputs.gold, inputs.calibration\n730\t    section_facts, held_back = step[\"section_facts\"], step[\"held_back_facts\"]\n731\t    methods = next((row for row in targeted if row[\"section\"] == step[\"section\"]), None)\n732\t    facts = methods[\"response\"][\"facts\"] if methods is not None else {}\n733\t    observed = {name: facts[name] for name in section_facts if name in facts}\n734\t    measured = {}\n735\t    cap = inputs.limits.route_output_bytes if work.profile.caller else PROCESS_LIMITS.stdout_limit_bytes\n736\t    for kind in (\"high\", \"low\"):\n737\t        _write_fidelity_case(work.folder / kind / step[\"case_names\"][0], work,\n738\t                             inputs.source_range(inputs.sections[step[\"section\"]]),\n739\t                             {name: gold[name] for name in section_facts}, observed)\n740\t        _write_fidelity_case(work.folder / kind / step[\"case_names\"][1], work,\n741\t                             inputs.raw[\"calibration.txt\"], {name: gold[name] for name in held_back},\n742\t                             calibration[kind])\n743\t        report = _route(work.folder, \"fidelity\", work.header[\"model\"], \"--cases\", kind,\n744\t                        \"--artifacts\", \"bundle\", \"--format\", \"json\", limits=work.route).stdout\n745\t        measured[kind] = report, _recall(report, frozenset(gold), max_bytes=cap)\n746\t    return measured\n747\t\n748\t\n749\tdef _recall(raw, facts=CALIBRATION_FACTS, *, max_bytes=PROCESS_LIMITS.stdout_limit_bytes):\n750\t    value = _decode(raw, max_bytes=max_bytes)\n751\t    rows = [row for row in value[\"per_fact_type\"] if row[\"id\"] in facts]\n752\t    _need(value[\"cases\"][\"ran\"] == 2 and value[\"cases\"][\"failed\"] == value[\"cases\"][\"skipped\"] == 0\n753\t          and len(rows) == len(facts) and {row[\"id\"] for row in rows} == facts,\n754\t          \"invalid fidelity census\")\n755\t    counts = [sum(row[\"recall\"][key] for row in rows) for key in (\"numerator\", \"denominator\")]\n756\t    _need(all(type(count) is int for count in counts) and 0 <= counts[0] <= counts[1],\n757\t          \"invalid fidelity denominator\")\n758\t    return counts\n759\t\n760\t\n761\tdef read_coverage_rows(folder: Path, expected_sha256: str) -> list[dict]:\n762\t    \"\"\"Read a run's optional coverage artifact using its external digest.\"\"\"\n763\t    try:\n764\t        raw = _read(folder, \"coverage.json\")\n765\t    except (ArtifactError, OSError) as error:\n766\t        raise ExampleError(\"unreadable coverage evidence\") from error\n767\t    _need(sha256_hex(raw) == expected_sha256, \"stale coverage evidence\")\n768\t    document = _decode(raw)\n769\t    _need(document.get(\"format\") == \"literature-reading-coverage/1\"\n770\t          and isinstance(document.get(\"rows\"), list), \"invalid coverage evidence\")\n771\t    return document[\"rows\"]\n772\t\n773\t\n774\tdef absence_status(artifacts, pins, *, facts=CALIBRATION_FACTS, predicate=\"alternative_integrator\",\n775\t                   floor=(2, 2)):\n776\t    \"\"\"Qualify the declared absence claim from four independently bound inputs.\"\"\"\n777\t    names = (\"scope.json\", \"closure.json\", \"coverage.json\", \"fidelity.json\")\n778\t    if any(name not in artifacts or name not in pins or sha256_hex(artifacts[name]) != pins[name]\n779\t           for name in names):\n780\t        return \"unavailable\"\n781\t    try:\n782\t        scope, closure, coverage = (_decode(artifacts[name]) for name in names[:3])\n783\t        observed = {(row[\"question\"], row[\"section\"]) for row in coverage[\"rows\"]\n784\t                    if row[\"state\"] == \"inspected-not-found\" and row[\"inspected\"] is True}\n785\t        scoped = set(zip(scope[\"questions\"], scope[\"sections\"], strict=True))\n786\t        ready = (\n787\t            scope[\"format\"] == \"literature-reading-scope/1\"\n788\t            and closure[\"format\"] == \"literature-reading-closure/1\"\n789\t            and coverage[\"format\"] == \"literature-reading-coverage/1\"\n790\t            and bool(scoped) and scoped <= observed and _recall(artifacts[\"fidelity.json\"], facts) == list(floor)\n791\t            and scope[\"predicate\"] == predicate\n792\t            and closure[\"scope_sha256\"] == pins[\"scope.json\"] and closure[\"sections\"] == scope[\"sections\"]\n793\t        )\n794\t    except (ValueError, KeyError, TypeError):\n795\t        return \"unavailable\"\n796\t    return \"qualified\" if ready else \"unavailable\"\n797\t\n798\t\n799\tdef _public_results(inputs, broad, targeted, work):\n800\t    profile = work.profile\n801\t    results, artifacts = {}, {}\n802\t    for name, attempts in ((\"broad\", broad), (\"targeted\", targeted)):\n803\t        document = b\"\\n\".join(inputs.source_range(inputs.sections[row[\"section\"]]) for row in attempts)\n804\t        raw, results[name] = _checked(work, name, document, _combined(attempts, profile.base_facts))\n805\t        _need(profile.caller or results[name] == {\"verify\": 0, \"check\": 0}, f\"{name} extraction is unverified\")\n806\t        artifacts[name + \".population.json\"] = raw\n807\t    if profile.conflict is None:\n808\t        results[\"reported-conflict\"] = \"skipped\"\n809\t    else:\n810\t        document = inputs.raw[\"conflict.txt\"]\n811\t        raw, results[\"reported-conflict\"] = _checked(work, \"reported-conflict\", document, inputs.conflict_facts)\n812\t        _need(results[\"reported-conflict\"] == {\"verify\": 1, \"check\": 1}, \"the reported conflict was not preserved\")\n813\t        artifacts[\"reported-conflict.population.json\"] = raw\n814\t        artifacts[\"reported-conflict.source.txt\"] = document\n815\t    fidelity = _calibrate(work, inputs, targeted) if profile.calibration is not None else {}\n816\t    return results, artifacts, fidelity\n817\t\n818\t\n819\tdef _retained_files(read, roster, files, max_bytes):\n820\t    \"\"\"Read a run's files: the stage chain first, then the rest, each against the manifest's digest.\"\"\"\n821\t    artifacts = {}\n822\t    predecessor = None\n823\t    for index, stage in enumerate(STAGES):\n824\t        name = f\"stage-{index}.json\"\n825\t        raw = read(name)\n826\t        stage_record = _decode(raw, max_bytes=max_bytes)\n827\t        _need(sha256_hex(raw) == roster[name] and stage_record.get(\"stage\") == stage\n828\t              and stage_record.get(\"predecessor_sha256\") == predecessor\n829\t              and stage_record.get(\"payload_sha256\") == roster[f\"payload-{index}.json\"],\n830\t              \"stale retained reading stage\")\n831\t        artifacts[name] = raw\n832\t        predecessor = sha256_hex(raw)\n833\t    for name in files:\n834\t        if name in artifacts:\n835\t            continue\n836\t        raw = read(name)\n837\t        _need(sha256_hex(raw) == roster[name], \"stale retained reading output\")\n838\t        artifacts[name] = raw\n839\t    retained = {}\n840\t    for stage_index in (1, 3):\n841\t        payload = _decode(artifacts[f\"payload-{stage_index}.json\"], max_bytes=max_bytes)\n842\t        rows = payload.get(\"attempts\")\n843\t        _need(isinstance(rows, list) and all(isinstance(row, dict) and isinstance(row.get(\"section\"), str)\n844\t                                             and \"response\" in row for row in rows), \"invalid retained payload\")\n845\t        retained.update({row[\"section\"]: row[\"response\"] for row in rows})\n846\t    return artifacts, retained\n847\t\n848\t\n849\tdef _read_retained(run):\n850\t    raw_manifest = _read(run, \"run.json\")\n851\t    manifest = _decode(raw_manifest)\n852\t    _need(raw_manifest == canonical_json_bytes(manifest), \"noncanonical reading manifest\")\n853\t    _need(manifest.get(\"format\") != CALLER_RUN_FORMAT, \"a caller run replays against its own root\")\n854\t    roster = manifest.get(\"artifacts\")\n855\t    _need(manifest.get(\"format\") == RUN_FORMAT\n856\t          and isinstance(roster, dict) and set(roster) == set(FILES), \"incomplete stage roster\")\n857\t    artifacts, retained = _retained_files(lambda name: _read(run, name), roster, FILES,\n858\t                                          PROCESS_LIMITS.stdout_limit_bytes)\n859\t    return manifest, artifacts, retained\n860\t\n861\t\n862\tdef _read_run_file(folder: Path, name: str, max_bytes: int) -> bytes:\n863\t    \"\"\"Read one file of a caller run under the retained-file cap the run recorded.\"\"\"\n864\t    return read_regular_bounded(folder, name, max_bytes=max_bytes)[0]\n865\t\n866\t\n867\tdef _caller_files(steps: dict) -> set:\n868\t    names = {\"coverage.json\", \"broad.population.json\", \"targeted.population.json\", \"producer-output-table.json\",\n869\t             *(f\"stage-{i}.json\" for i in range(6)), *(f\"payload-{i}.json\" for i in range(6))}\n870\t    for step, files in ((\"review\", (\"reviews.json\",)), (\"calibration\", (\"fidelity-high.json\", \"fidelity-low.json\")),\n871\t                        (\"conflict\", (\"reported-conflict.population.json\", \"reported-conflict.source.txt\")),\n872\t                        (\"absence\", (\"scope.json\", \"closure.json\"))):\n873\t        if steps[step] == \"ran\":\n874\t            names.update(files)\n875\t    return names\n876\t\n877\t\n878\tdef _caller_settings(manifest: dict) -> tuple[ReadingLimits, dict, dict]:\n879\t    \"\"\"Check a caller run's recorded settings and steps before any of its files is read.\"\"\"\n880\t    settings, steps = manifest.get(\"settings\"), manifest.get(\"steps\")\n881\t    _need(isinstance(settings, dict) and set(settings) == {\n882\t        \"document_budget_bytes\", \"unavailable\", \"limits\", \"producer\", \"reviewer\"}\n883\t          and isinstance(steps, dict) and set(steps) == set(STEPS)\n884\t          and all(value in (\"ran\", \"skipped\") for value in steps.values()), \"invalid caller run settings\")\n885\t    recorded = settings[\"limits\"]\n886\t    _need(isinstance(recorded, dict) and set(recorded) == {item.name for item in fields(ReadingLimits)}\n887\t          and recorded[\"retained_bytes\"] is not None, \"invalid caller run settings\")\n888\t    limits = _checked_limits(ReadingLimits(**recorded))\n889\t    budget, unavailable = settings[\"document_budget_bytes\"], settings[\"unavailable\"]\n890\t    _need((budget is None or type(budget) is int and 0 <= budget <= limits.max_budget)\n891\t          and isinstance(unavailable, list) and all(isinstance(name, str) for name in unavailable)\n892\t          and settings[\"producer\"] in (\"live\", \"saved\") and settings[\"reviewer\"] in (\"live\", \"saved\", \"none\")\n893\t          and type(manifest.get(\"budget_bytes\")) is int and 0 <= manifest[\"budget_bytes\"] <= limits.max_budget\n894\t          and manifest.get(\"scenario\") == \"full\", \"invalid caller run settings\")\n895\t    return limits, settings, steps\n896\t\n897\t\n898\tdef _read_caller_retained(run):\n899\t    ceiling = LIMIT_CEILINGS[\"retained_bytes\"]\n900\t    raw_manifest = read_regular_bounded(run, \"run.json\", max_bytes=ceiling)[0]\n901\t    manifest = _decode(raw_manifest, max_bytes=ceiling)\n902\t    _need(raw_manifest == canonical_json_bytes(manifest), \"noncanonical reading manifest\")\n903\t    _need(manifest.get(\"format\") != RUN_FORMAT, \"a packaged run replays against the packaged root\")\n904\t    _need(manifest.get(\"format\") == CALLER_RUN_FORMAT, \"incomplete stage roster\")\n905\t    limits, settings, steps = _caller_settings(manifest)\n906\t    roster = manifest.get(\"artifacts\")\n907\t    files = _caller_files(steps)\n908\t    _need(isinstance(roster, dict) and set(roster) == files, \"incomplete stage roster\")\n909\t    cap = limits.retained_bytes\n910\t    artifacts, retained = _retained_files(lambda name: _read_run_file(run, name, cap), roster,\n911\t                                          sorted(files), cap)\n912\t    return manifest, artifacts, retained, limits, settings\n913\t\n914\t\n915\tdef _retained_cap(inputs, work, unavailable, live):\n916\t    \"\"\"An upper bound on every file a caller run retains, from what is known before the first call.\n917\t\n918\t    Roster strings, input pins and saved files are measured; each answer and receipt counts at the\n919\t    response cap; identifiers are at most 64 characters, so a coverage or question row fits in 512 bytes.\n920\t    \"\"\"\n921\t    limits, profile = inputs.limits, inputs.profile\n922\t    response = limits.response_bytes\n923\t    eligible = [name for name in inputs.sections if name in inputs.response_sections]\n924\t\n925\t    def attempt(name):\n926\t        section = inputs.sections[name]\n927\t        stub = {\"section\": name, \"source\": section[\"source\"], \"start\": section[\"span\"][0],\n928\t                \"end\": section[\"span\"][1], \"source_version\": inputs.sources[section[\"source\"]][\"version\"],\n929\t                \"excerpt_sha256\": \"0\" * 64, \"response_sha256\": \"0\" * 64, \"outcome\": \"accepted\", \"response\": None}\n930\t        return len(canonical_json_bytes(stub)) + response\n931\t\n932\t    ids = (len(inputs.sections) + len(inputs.questions)) * (64 + 4) + ROW_OVERHEAD\n933\t    rows = len(inputs.questions) * 512\n934\t    receipts = len(eligible) * (response + 300)\n935\t    header = len(canonical_json_bytes(work.header))\n936\t    bounds = [\n937\t        sum(attempt(name) for name in eligible) + ids,\n938\t        len(inputs.raw[\"responses.json\"]) if not live else receipts,\n939\t        header + len(canonical_json_bytes(profile.base_facts)) + len(eligible) * response + ROW_OVERHEAD,\n940\t        len(canonical_json_bytes({\"sources\": list(inputs.sources.values()),\n941\t                                  \"sections\": list(inputs.sections.values()), \"unavailable\": sorted(unavailable)})),\n942\t        rows + receipts + len(canonical_json_bytes(sorted(inputs.revisit_keys))) + ids,\n943\t        len(canonical_json_bytes(inputs.input_pins)) + ids + ROW_OVERHEAD,\n944\t    ]\n945\t    if profile.review:\n946\t        bounds.append(len(inputs.raw[\"reviews.json\"]) if \"reviews.json\" in inputs.raw else receipts)\n947\t    if profile.conflict is not None:\n948\t        bounds += [len(inputs.raw[\"conflict.txt\"]),\n949\t                   header + len(canonical_json_bytes(inputs.conflict_facts)) + ROW_OVERHEAD]\n950\t    if profile.absence:\n951\t        bounds += [len(inputs.raw[\"scope.json\"]), len(inputs.raw[\"closure.json\"])]\n952\t    if profile.calibration is not None:\n953\t        bounds.append(limits.route_output_bytes)\n954\t    bound = max(bounds)\n955\t    if limits.retained_bytes is not None:\n956\t        _need(bound <= limits.retained_bytes, \"retained files would exceed the retained-file cap\")\n957\t        return limits.retained_bytes\n958\t    cap = max(RETAINED_FLOOR, bound)\n959\t    _need(cap <= LIMIT_CEILINGS[\"retained_bytes\"], \"retained files would exceed the retained-file ceiling\")\n960\t    return cap\n961\t\n962\t\n963\tdef _stops(inputs, terminal, resolved, omitted):\n964\t    \"\"\"The global stop rule, applied to each source's own required questions and sections.\n965\t\n966\t    A required question belongs to the source of its own section; it is answered when its last\n967\t    successor is resolved, wherever that successor points.\n968\t    \"\"\"\n969\t    open_sources = {inputs.sections[question[\"section\"]][\"source\"] for key, question in inputs.questions.items()\n970\t                    if question[\"required\"] and terminal[key] not in resolved}\n971\t    short_sources = {inputs.sections[name][\"source\"] for name in omitted}\n972\t    return {source: \"required-coverage-completed\" if source not in open_sources\n973\t            else \"budget-exhausted\" if source in short_sources else \"available-evidence-exhausted\"\n974\t            for source in inputs.sources}\n975\t\n976\t\n977\tdef _terminal(questions):\n978\t    \"\"\"Each question's last successor, resolving every supersession chain once.\"\"\"\n979\t    terminal = {}\n980\t    for key in questions:\n981\t        path = []\n982\t        while key not in terminal and questions[key][\"superseded_by\"] is not None:\n983\t            path.append(key)\n984\t            key = questions[key][\"superseded_by\"]\n985\t        end = terminal.get(key, key)\n986\t        terminal.update(dict.fromkeys((*path, key), end))\n987\t    return terminal\n988\t\n989\t\n990\tdef _evaluate(inputs, budget, scenario, *, producer=None, retained=None, retained_pins=None,\n991\t              reviewer=None, document_budget=None, unavailable=(), live=False, live_review=False):\n992\t    profile = inputs.profile\n993\t    _need(type(budget) is int and 0 <= budget <= inputs.limits.max_budget and scenario in SCENARIOS,\n994\t          \"invalid reading settings\")\n995\t    retained = retained or {}\n996\t    if profile.caller:\n997\t        _need(scenario == \"full\", \"a caller run names its unavailable sections\")\n998\t        unavailable = set(unavailable)\n999\t    else:\n1000\t        unavailable = {\"study-methods\"} if scenario == \"unavailable\" else set()\n1001\t    with tempfile.TemporaryDirectory(prefix=\"gnd-reading-\") as temporary:\n1002\t        work = _extract(inputs, Path(temporary).resolve())\n1003\t        covers = work.covers if profile.caller else None\n1004\t        cap = None\n1005\t        if profile.caller:\n1006\t            _need(set(profile.base_facts) <= work.covers, \"profile base fact outside the model\")\n1007\t            cap = _retained_cap(inputs, work, unavailable, live)\n1008\t        counts = dict.fromkeys((STAGES[1], STAGES[3]), 0)\n1009\t        documents = dict.fromkeys(inputs.sources, document_budget) if document_budget is not None else None\n1010\t        opening = [name for name in inputs.selection(\"opening\") if name not in unavailable]\n1011\t        broad, left = _inspect(inputs, STAGES[1], opening, budget, producer, retained,\n1012\t                               documents=documents, covers=covers, counts=counts)\n1013\t        opened = {row[\"section\"]: row for row in broad[\"attempts\"]}\n1014\t        needed = {row[\"section\"] for row in inputs.questions.values() if row[\"superseded_by\"] is None\n1015\t                  and row[\"fact\"] not in opened.get(row[\"section\"], {}).get(\"response\", {}).get(\"facts\", {})}\n1016\t        planned_targeted = [name for name in inputs.selection(\"targeted\") if name in needed]\n1017\t        selected = [name for name in planned_targeted if name not in unavailable]\n1018\t        targeted, left = _inspect(inputs, STAGES[3], selected, left, producer, retained,\n1019\t                                  documents=documents, covers=covers, counts=counts)\n1020\t        attempts = [*broad[\"attempts\"], *targeted[\"attempts\"]]\n1021\t        attempted = {row[\"section\"]: row for row in attempts}\n1022\t        judgments, receipts = _review_attempts(inputs, attempts, reviewer)\n1023\t        coverage, questions = _outcomes(inputs, attempted, unavailable)\n1024\t        resolved = {row[\"id\"] for row in questions if row[\"outcome\"] == \"resolved\"}\n1025\t        terminal = _terminal(inputs.questions)\n1026\t        required = {terminal[key] for key, question in inputs.questions.items() if question[\"required\"]}\n1027\t        unavailable_reads = unavailable | {\n1028\t            row[\"section\"] for row in coverage if row[\"state\"] == \"unavailable\"\n1029\t        }\n1030\t        if required <= resolved:\n1031\t            stop = \"required-coverage-completed\"\n1032\t        elif broad[\"omitted\"] or targeted[\"omitted\"]:\n1033\t            stop = \"budget-exhausted\"\n1034\t        else:\n1035\t            stop = \"available-evidence-exhausted\"\n1036\t        proposed_keys = {key for row in targeted[\"attempts\"] for key in row[\"response\"][\"proposal_keys\"]}\n1037\t        earlier = {name: row for name, row in inputs.sections.items() if name in opened}\n1038\t        revisit = affected_sections(earlier, proposed_keys)\n1039\t        routes, artifacts, fidelity = _public_results(inputs, broad[\"attempts\"], attempts, work)\n1040\t    coverage_doc = {\"format\": \"literature-reading-coverage/1\", \"rows\": coverage}\n1041\t    artifacts[\"coverage.json\"] = canonical_json_bytes(coverage_doc)\n1042\t    if profile.absence:\n1043\t        artifacts.update({\"scope.json\": inputs.raw[\"scope.json\"], \"closure.json\": inputs.raw[\"closure.json\"]})\n1044\t    if not profile.caller or not live:\n1045\t        artifacts[\"producer-output-table.json\"] = inputs.raw[\"responses.json\"]\n1046\t    else:\n1047\t        artifacts[\"producer-output-table.json\"] = canonical_json_bytes(\n1048\t            {row[\"section\"]: row[\"response\"] for row in attempts})\n1049\t    if profile.caller and profile.review:\n1050\t        artifacts[\"reviews.json\"] = canonical_json_bytes(receipts) if live_review else inputs.raw[\"reviews.json\"]\n1051\t    artifacts.update({f\"fidelity-{name}.json\": result[0] for name, result in fidelity.items()})\n1052\t    absence = {}\n1053\t    for kind, (raw, _counts) in fidelity.items():\n1054\t        if not profile.absence:\n1055\t            break\n1056\t        scoped = {name: artifacts[name] for name in (\"scope.json\", \"closure.json\", \"coverage.json\")}\n1057\t        scoped[\"fidelity.json\"] = raw\n1058\t        source_pins = inputs.pins()\n1059\t        pins = {\"scope.json\": source_pins[\"scope.json\"], \"closure.json\": source_pins[\"closure.json\"]}\n1060\t        if retained_pins is None:\n1061\t            pins.update({\"coverage.json\": sha256_hex(artifacts[\"coverage.json\"]), \"fidelity.json\": sha256_hex(raw)})\n1062\t        else:\n1063\t            pins.update({\"coverage.json\": retained_pins[\"coverage.json\"],\n1064\t                         \"fidelity.json\": retained_pins[f\"fidelity-{kind}.json\"]})\n1065\t        if profile.caller:\n1066\t            gold_rows = sum(len(rows) for rows in inputs.gold.values())\n1067\t            absence[kind] = absence_status(scoped, pins, facts=frozenset(inputs.gold), predicate=inputs.predicate,\n1068\t                                           floor=(gold_rows, gold_rows))\n1069\t        else:\n1070\t            absence[kind] = absence_status(scoped, pins)\n1071\t    if not profile.absence:\n1072\t        absence = {\"high\": \"skipped\", \"low\": \"skipped\"}\n1073\t    measured = {name: val[1] for name, val in fidelity.items()} if profile.calibration is not None else None\n1074\t    payloads = (\n1075\t        {\"sources\": list(inputs.sources.values()), \"sections\": list(inputs.sections.values()), \"unavailable\": sorted(unavailable)},\n1076\t        broad, {\"selected\": selected, \"unresolved\": sorted(needed)}, targeted,\n1077\t        {\"coverage\": coverage, \"questions\": questions, \"semantic_reviews\": judgments,\n1078\t         \"vocabulary_proposals\": sorted(proposed_keys), \"revisit\": revisit},\n1079\t        {\"public_routes\": routes, \"fidelity\": measured, \"absence\": absence},\n1080\t    )\n1081\t    stages = []\n1082\t    predecessor = None\n1083\t    for i, (stage, purpose, payload) in enumerate(zip(STAGES, PURPOSES, payloads, strict=True)):\n1084\t        payload_name = f\"payload-{i}.json\"\n1085\t        artifacts[payload_name] = raw = canonical_json_bytes(payload)\n1086\t        record = {\n1087\t            \"stage\": stage, \"purpose\": purpose, \"inputs\": inputs.pins(),\n1088\t            \"predecessor_sha256\": predecessor, \"payload_sha256\": sha256_hex(raw),\n1089\t            \"inspected\": [row[\"section\"] for row in payload.get(\"attempts\", [])],\n1090\t            \"questions\": list(inputs.questions),\n1091\t        }\n1092\t        stages.append(record)\n1093\t        artifacts[f\"stage-{i}.json\"] = raw = canonical_json_bytes(record)\n1094\t        predecessor = sha256_hex(raw)\n1095\t    manifest = {\"format\": RUN_FORMAT, \"scenario\": scenario, \"budget_bytes\": budget,\n1096\t                \"inputs\": inputs.pins(), \"artifacts\": {name: sha256_hex(raw) for name, raw in artifacts.items()}}\n1097\t    settings = None\n1098\t    if profile.caller:\n1099\t        limits = {item.name: getattr(inputs.limits, item.name) for item in fields(ReadingLimits)}\n1100\t        limits[\"retained_bytes\"] = cap\n1101\t        settings = {\"document_budget_bytes\": document_budget, \"unavailable\": sorted(unavailable),\n1102\t                    \"limits\": limits, \"producer\": \"live\" if live else \"saved\",\n1103\t                    \"reviewer\": \"none\" if not profile.review else \"live\" if live_review else \"saved\"}\n1104\t        manifest.update({\"format\": CALLER_RUN_FORMAT, \"settings\": settings, \"steps\": profile.steps()})\n1105\t    broad_facts = _combined(broad[\"attempts\"], profile.base_facts)\n1106\t    final_facts = _combined(attempts, profile.base_facts)\n1107\t    report = {\n1108\t        \"format\": \"literature-reading-report/1\", \"stop\": stop, \"stages\": stages,\n1109\t        \"producer_calls\": counts,\n1110\t        \"coverage\": coverage, \"questions\": questions, \"revisit\": revisit,\n1111\t        \"inspections\": [{key: value for key, value in row.items() if key != \"response\"} for row in attempts],\n1112\t        \"reading_bytes\": budget - left, \"attempt_counts\": {kind: sum(row[\"outcome\"] == kind for row in attempts)\n1113\t                                                            for kind in (\"accepted\", \"empty\", \"refused\")},\n1114\t        \"omitted\": broad[\"omitted\"] + targeted[\"omitted\"],\n1115\t        \"read_denominator\": {\n1116\t            \"scheduled\": len(opening) + len(selected) + len(unavailable_reads),\n1117\t            \"attempted\": len(attempts),\n1118\t            \"omitted\": len(broad[\"omitted\"]) + len(targeted[\"omitted\"]),\n1119\t            \"unavailable\": len(unavailable_reads),\n1120\t        },\n1121\t        \"broad_fact_types\": sorted(broad_facts),\n1122\t        \"targeted_fact_types\": sorted(final_facts),\n1123\t        \"public_routes\": routes, \"fidelity\": measured,\n1124\t        \"absence\": {\"status\": absence[\"high\"], \"below_floor_status\": absence[\"low\"]},\n1125\t        \"evidence_sha256\": sha256_hex(canonical_json_bytes(manifest)),\n1126\t    }\n1127\t    report[\"supported_fact_gain\"] = sum(\n1128\t        len({canonical_json_bytes(row) for row in rows}\n1129\t            - {canonical_json_bytes(row) for row in broad_facts.get(fact, [])})\n1130\t        for fact, rows in final_facts.items()\n1131\t    )\n1132\t    report[\"newly_answered\"] = sum(\n1133\t        row[\"outcome\"] == \"resolved\" and inputs.questions[row[\"id\"]][\"section\"] not in opened\n1134\t        for row in questions\n1135\t    )\n1136\t    report[\"productivity\"] = {\n1137\t        \"new_facts_per_byte\": {\"numerator\": report[\"supported_fact_gain\"], \"denominator\": budget - left},\n1138\t        \"new_answers_per_byte\": {\"numerator\": report[\"newly_answered\"], \"denominator\": budget - left},\n1139\t    }\n1140\t    if profile.caller:\n1141\t        omitted = broad[\"omitted\"] + targeted[\"omitted\"]\n1142\t        stops = _stops(inputs, terminal, resolved, omitted)\n1143\t        tally = {source: {\"source\": source, \"stop\": stops[source], \"reading_bytes\": 0, \"attempted\": 0, \"omitted\": 0}\n1144\t                 for source in inputs.sources}\n1145\t        for row in attempts:\n1146\t            tally[row[\"source\"]][\"reading_bytes\"] += row[\"end\"] - row[\"start\"]\n1147\t            tally[row[\"source\"]][\"attempted\"] += 1\n1148\t        for name in omitted:\n1149\t            tally[inputs.sections[name][\"source\"]][\"omitted\"] += 1\n1150\t        report.update({\"settings\": settings, \"steps\": profile.steps(), \"documents\": list(tally.values())})\n1151\t    return manifest, artifacts, report\n1152\t\n1153\t\n1154\tdef run(out: Path, *, budget=DEFAULT_BUDGET, scenario=\"full\", fixture: Path = FIXTURE,\n1155\t        producer: Producer | None = None, reviewer: Reviewer | None = None,\n1156\t        document_budget: int | None = None, unavailable: Iterable[str] | None = None,\n1157\t        limits: ReadingLimits | None = None) -> dict:\n1158\t    \"\"\"Run the reading workflow over the packaged fixture or a caller's root, and retain its evidence.\"\"\"\n1159\t    checked = _checked_limits(limits if limits is not None else ReadingLimits())\n1160\t    _need(type(budget) is int and 0 <= budget <= checked.max_budget, \"invalid reading settings\")\n1161\t    _need(document_budget is None or type(document_budget) is int and 0 <= document_budget <= checked.max_budget,\n1162\t          \"invalid document budget\")\n1163\t    _need(not out.exists() and not out.is_symlink(), \"reading output already exists\")\n1164\t    if not _has_profile(fixture):\n1165\t        _need(all(value is None for value in (producer, reviewer, document_budget, unavailable, limits)),\n1166\t              \"caller arguments need profile.json\")\n1167\t        inputs = ReadingInputs(fixture)\n1168\t        manifest, artifacts, report = _evaluate(inputs, budget, scenario, producer=SavedProducer(inputs.responses))\n1169\t    else:\n1170\t        _need(scenario == \"full\", \"a caller run names its unavailable sections\")\n1171\t        names = list(unavailable) if unavailable is not None else []\n1172\t        inputs = ReadingInputs(fixture, limits=checked, live=producer is not None,\n1173\t                               live_review=reviewer is not None, unavailable=names)\n1174\t        manifest, artifacts, report = _evaluate(\n1175\t            inputs, budget, scenario, producer=producer if producer is not None else SavedProducer(inputs.responses),\n1176\t            reviewer=reviewer, document_budget=document_budget, unavailable=names, live=producer is not None,\n1177\t            live_review=reviewer is not None)\n1178\t    out.mkdir()\n1179\t    for name, raw in artifacts.items():\n1180\t        (out / name).write_bytes(raw)\n1181\t    (out / \"run.json\").write_bytes(canonical_json_bytes(manifest))\n1182\t    return report\n1183\t\n1184\t\n1185\tdef replay(folder: Path, *, fixture: Path = FIXTURE, vocabulary_fixture: Path = DEPTH_FIXTURE,\n1186\t           expected_evidence_sha256: str | None = None) -> dict:\n1187\t    \"\"\"Re-derive a reading result from retained evidence without invoking producers or reviewers.\n1188\t\n1189\t    A root that holds profile.json replays a caller run (literature-reading-run/2) with the settings\n1190\t    the run recorded; any other root replays a packaged run. Without ``expected_evidence_sha256`` a\n1191\t    folder rewritten consistently from end to end replays; with it, only the run that returned it does.\n1192\t    \"\"\"\n1193\t    if _has_profile(fixture):\n1194\t        manifest, artifacts, retained, limits, settings = _read_caller_retained(folder)\n1195\t        _expected(manifest, expected_evidence_sha256)\n1196\t        live, live_review = settings[\"producer\"] == \"live\", settings[\"reviewer\"] == \"live\"\n1197\t        inputs = ReadingInputs(\n1198\t            fixture, retained_responses=artifacts[\"producer-output-table.json\"], limits=limits, live=live,\n1199\t            live_review=live_review, unavailable=settings[\"unavailable\"],\n1200\t            retained_reviews=artifacts.get(\"reviews.json\") if live_review else None)\n1201\t        _need(manifest[\"steps\"] == inputs.profile.steps(), \"reading steps differ from the profile\")\n1202\t        _need(manifest.get(\"inputs\") == inputs.pins(), \"stale reading input\")\n1203\t        observed, actual, report = _evaluate(\n1204\t            inputs, manifest.get(\"budget_bytes\"), manifest.get(\"scenario\"), retained=retained,\n1205\t            retained_pins=manifest[\"artifacts\"], document_budget=settings[\"document_budget_bytes\"],\n1206\t            unavailable=settings[\"unavailable\"], live=live, live_review=live_review)\n1207\t    else:\n1208\t        manifest, artifacts, retained = _read_retained(folder)\n1209\t        _expected(manifest, expected_evidence_sha256)\n1210\t        inputs = ReadingInputs(fixture, retained_responses=artifacts[\"producer-output-table.json\"],\n1211\t                               vocabulary_fixture=vocabulary_fixture)\n1212\t        _need(manifest.get(\"inputs\") == inputs.pins(), \"stale reading input\")\n1213\t        observed, actual, report = _evaluate(inputs, manifest.get(\"budget_bytes\"),\n1214\t                                             manifest.get(\"scenario\"), retained=retained,\n1215\t                                             retained_pins=manifest[\"artifacts\"])\n1216\t    _need(manifest == observed and artifacts == actual, \"re-derived reading evidence differs\")\n1217\t    return report\n1218\t\n1219\t\n1220\tdef _expected(manifest: dict, expected_sha256: str | None) -> None:\n1221\t    _need(expected_sha256 is None or sha256_hex(canonical_json_bytes(manifest)) == expected_sha256,\n1222\t          \"reading evidence differs from the expected digest\")\n1223\t\n1224\t\n1225\tdef main(argv: list[str] | None = None) -> int:\n1226\t    parser = argparse.ArgumentParser(description=__doc__)\n1227\t    commands = parser.add_subparsers(dest=\"command\", required=True)\n1228\t    fresh = commands.add_parser(\"run\")\n1229\t    fresh.add_argument(\"--out\", type=Path, required=True)\n1230\t    fresh.add_argument(\"--budget-bytes\", type=int, default=DEF
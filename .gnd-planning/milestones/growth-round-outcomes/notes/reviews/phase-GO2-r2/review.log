+    moved = _with(subset, superset_role_seq=[{"fact_type": "order_has_memo", "role": "order"}])
+    operation = _op("modify", _constraint_locator(None, subset, "subset"), before=subset, after=moved)
+    preview = _preview(tmp_path, (operation,))

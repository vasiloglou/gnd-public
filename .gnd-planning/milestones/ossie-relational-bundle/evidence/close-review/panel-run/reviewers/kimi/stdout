{"role":"tool","tool_call_id":"tool_Za1J4V8CtllsKbyK2yohIpD8","content":"1\t\"\"\"Read a physical binding and bind a model's roles to a delivered relational schema.\n2\t\n3\tThe normative rules have one home: \"Physical binding\" under \"Ossie interchange\" in\n4\t``gnd-orm-core/references/representation-format.md``. The document's members are\n5\tdefined by the packaged schema ``gnd/schema/physical-binding.schema.json``.\n6\t\n7\tA binding is untrusted input. :func:`read_binding` is total over arbitrary bytes, and\n8\t:func:`bind` over any schema-valid document and admitted model: every refusal is a\n9\t:class:`BindingError` with a rule id. The checks run in one pinned order\n10\t(:data:`RULE_ORDER`), and within a rule the first violation in sorted order is\n11\treported, so a message never depends on the document's member order.\n12\t\n13\t:func:`bind` returns the same :class:`gnd.rmap.RelationalSchema` the Rmap returns, so\n14\tthe semantic model, the mapping and the one walk over fact types and constraints are\n15\tshared with the built-in path.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport hashlib\n21\timport json\n22\timport unicodedata\n23\tfrom collections.abc import Iterable, Mapping\n24\tfrom dataclasses import dataclass\n25\tfrom functools import lru_cache\n26\tfrom importlib.resources import files\n27\tfrom pathlib import Path\n28\tfrom typing import Any\n29\t\n30\tfrom jsonschema import Draft202012Validator\n31\t\n32\tfrom gnd.export.ossie_relational import OntologyView\n33\tfrom gnd.input_policy import MAX_BYTES, loads\n34\tfrom gnd.model_index import ModelIndex\n35\tfrom gnd.rmap import (\n36\t    Column,\n37\t    Identification,\n38\t    RelationalSchema,\n39\t    RolePlacement,\n40\t    Table,\n41\t    Unmapped,\n42\t    name_foreign_keys,\n43\t)\n44\tfrom gnd.safefs import NotRegularFileError, open_regular\n45\t\n46\t__all__ = [\"MAX_IDENTIFIER_DEPTH\", \"RULE_ORDER\", \"SQL_TYPES\", \"Binding\", \"BindingError\", \"bind\", \"normalize_role_name\", \"read_binding\", \"sql_datatype\"]\n47\t\n48\tSCHEMA_ID = \"gnd-physical-binding/1\"\n49\t\n50\t#: Every rule id, in the one order the checks run. The first three need only the\n51\t#: file; the fourth only the JSON; the rest need the model and the ontology view.\n52\tRULE_ORDER = (\n53\t    \"binding:not-a-file\",\n54\t    \"binding:size\",\n55\t    \"binding:syntax\",\n56\t    \"binding:schema\",\n57\t    \"binding:name-collision\",\n58\t    \"binding:unknown-table\",\n59\t    \"binding:unknown-column\",\n60\t    \"binding:ambiguous-column\",\n61\t    \"binding:unknown-fact-type\",\n62\t    \"binding:role-name\",\n63\t    \"binding:unknown-role\",\n64\t    \"binding:unknown-object-type\",\n65\t    \"binding:reference-group\",\n66\t    \"binding:reference-not-a-key\",\n67\t    \"binding:partial-fact-type\",\n68\t    \"binding:role-arity\",\n69\t    \"binding:target-mismatch\",\n70\t    \"binding:key-role\",\n71\t    \"binding:incompatible-keys\",\n72\t)\n73\t\n74\t#: An identifier nests one level per entity it is identified through. A deeper one is\n75\t#: not followed: the object type is then treated as one the ontology does not identify,\n76\t#: so every mapping document stays shallow whatever chain the model admits.\n77\tMAX_IDENTIFIER_DEPTH = 8\n78\t\n79\t#: Normalized SQL type name -> Ossie core-spec data type (OB4 D7). A type outside this\n80\t#: closed map leaves ``datatype`` absent.\n81\tSQL_TYPES: dict[str, str] = {\n82\t    **dict.fromkeys(\n83\t        (\"char\", \"character\", \"varchar\", \"character varying\", \"nchar\", \"nvarchar\", \"text\", \"string\", \"uuid\"), \"String\"),\n84\t    **dict.fromkeys(\n85\t        (\"smallint\", \"integer\", \"int\", \"bigint\", \"tinyint\", \"int2\", \"int4\", \"int8\", \"serial\", \"bigserial\",\n86\t         \"long\", \"short\", \"byte\"), \"Integer\"),\n87\t    **dict.fromkeys((\"numeric\", \"decimal\", \"dec\", \"number\"), \"Decimal\"),\n88\t    **dict.fromkeys((\"real\", \"float\", \"float4\", \"float8\", \"double\", \"double precision\"), \"Float\"),\n89\t    **dict.fromkeys((\"boolean\", \"bool\"), \"Boolean\"),\n90\t    \"date\": \"Date\",\n91\t    **dict.fromkeys((\"time\", \"time without time zone\"), \"Time\"),\n92\t    **dict.fromkeys((\"timestamp\", \"timestamp without time zone\", \"timestamp_ntz\", \"datetime\"), \"DateTime\"),\n93\t    **dict.fromkeys((\"timestamp with time zone\", \"timestamptz\", \"timestamp_ltz\"), \"DateTimeTz\"),\n94\t    **dict.fromkeys((\"bytea\", \"binary\", \"varbinary\", \"blob\", \"json\", \"jsonb\"), \"Opaque\"),\n95\t}\n96\t\n97\t_WORD = frozenset(\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\")\n98\t_DIGITS = frozenset(\"0123456789\")\n99\t\n100\t\n101\tclass BindingError(ValueError):\n102\t    \"\"\"A physical binding is refused. ``rule`` is one of :data:`RULE_ORDER`.\"\"\"\n103\t\n104\t    def __init__(self, rule: str, detail: str = \"\") -> None:\n105\t        assert rule in RULE_ORDER, rule\n106\t        self.rule = rule\n107\t        super().__init__(f\"{rule}: {detail}\" if detail else rule)\n108\t\n109\t\n110\t@dataclass(frozen=True)\n111\tclass Binding:\n112\t    \"\"\"A schema-valid binding document and the digest of the bytes it was read from.\"\"\"\n113\t\n114\t    document: Mapping[str, Any]\n115\t    sha256: str\n116\t\n117\t\n118\t@lru_cache(maxsize=1)\n119\tdef _validator() -> Draft202012Validator:\n120\t    schema = loads(files(\"gnd\").joinpath(\"schema\", \"physical-binding.schema.json\").read_bytes())\n121\t    return Draft202012Validator(schema)\n122\t\n123\t\n124\tdef read_binding(path: Path) -> Binding:\n125\t    \"\"\"Read and schema-check a binding. A missing file raises ``FileNotFoundError``.\"\"\"\n126\t    try:\n127\t        descriptor = open_regular(path)\n128\t    except NotRegularFileError as error:\n129\t        raise BindingError(\"binding:not-a-file\", \"the path is not a regular file\") from error\n130\t    with open(descriptor, \"rb\") as stream:\n131\t        raw = stream.read(MAX_BYTES + 1)\n132\t    if len(raw) > MAX_BYTES:\n133\t        raise BindingError(\"binding:size\", f\"the file is larger than {MAX_BYTES} bytes\")\n134\t    try:\n135\t        document = loads(raw, max_bytes=MAX_BYTES)\n136\t        # An escaped lone surrogate is JSON but not text: no output could carry it (r1 F1).\n137\t        json.dumps(document, ensure_ascii=False).encode(\"utf-8\")\n138\t    except (ValueError, RecursionError, OverflowError) as error:\n139\t        raise BindingError(\"binding:syntax\", \"the file is not JSON text within the input limits\") from error\n140\t    violations = sorted((_pointer(error.absolute_path), error.message) for error in _validator().iter_errors(document))\n141\t    if violations:\n142\t        pointer, message = violations[0]\n143\t        raise BindingError(\"binding:schema\", f\"at {pointer or 'the document root'}: {message[:200]}\")\n144\t    return Binding(document, hashlib.sha256(raw).hexdigest())\n145\t\n146\t\n147\tdef _pointer(parts: Iterable[Any]) -> str:\n148\t    \"\"\"An RFC 6901 JSON pointer; `~` and `/` in a member name are escaped (r1 F6).\"\"\"\n149\t    return \"\".join(\"/\" + str(part).replace(\"~\", \"~0\").replace(\"/\", \"~1\") for part in parts)\n150\t\n151\t\n152\tdef sql_datatype(sql_type: str) -> str | None:\n153\t    \"\"\"The Ossie data type of an SQL type, or None when the type is outside the map.\n154\t\n155\t    A type is words of letters, digits and underscores separated by spaces, with at\n156\t    most one parenthesized list of unsigned integers after a word. Its name is the\n157\t    words, casefolded and joined by one space.\n158\t    \"\"\"\n159\t    words: list[str] = []\n160\t    listed = False\n161\t    position = 0\n162\t    while position < len(sql_type):\n163\t        character = sql_type[position]\n164\t        if character == \" \":\n165\t            position += 1\n166\t        elif character in _WORD:\n167\t            end = position\n168\t            while end < len(sql_type) and sql_type[end] in _WORD:\n169\t                end += 1\n170\t            words.append(sql_type[position:end].casefold())\n171\t            position = end\n172\t        elif character == \"(\" and words and not listed:\n173\t            end = sql_type.find(\")\", position)\n174\t            if end < 0:\n175\t                return None\n176\t            items = [item.strip(\" \") for item in sql_type[position + 1:end].split(\",\")]\n177\t            if not all(item and set(item) <= _DIGITS for item in items):\n178\t                return None\n179\t            if sql_type[end + 1:end + 2] not in (\"\", \" \"):\n180\t                return None  # a word after the list is separated by a space, like any other (r1 F5)\n181\t            listed = True\n182\t            position = end + 1\n183\t        else:\n184\t            return None\n185\t    return SQL_TYPES.get(\" \".join(words))\n186\t\n187\t\n188\tdef normalize_role_name(name: str) -> str:\n189\t    \"\"\"A role name for matching (OB4 D8): NFKC, casefolded, letters and digits only.\"\"\"\n190\t    folded = unicodedata.normalize(\"NFKC\", name).casefold()\n191\t    return \"\".join(c for c in folded if unicodedata.category(c)[0] in \"LN\")\n192\t\n193\t\n194\tColumnRef = tuple[str, str]\n195\t_ROLE_SECTIONS = (\"roles\", \"extension_roles\")\n196\t\n197\t\n198\tclass _Binder:\n199\t    def __init__(self, model: Any, view: OntologyView, binding: Binding) -> None:\n200\t        self.model = model\n201\t        self.view = view\n202\t        self.sha256 = binding.sha256\n203\t        self.tables: Mapping[str, Any] = binding.document[\"tables\"]\n204\t        # The binding's two role sections, by member name. (The name is a variable so\n205\t        # that this is not read as a model query: the document is a binding, not a model.)\n206\t        self.role_sections: dict[str, Mapping[str, Any]] = {\n207\t            section: binding.document.get(section, {}) for section in _ROLE_SECTIONS\n208\t        }\n209\t        index = ModelIndex.for_model(model)\n210\t        self.objects = index.object_types_by_id()\n211\t        self.players: Mapping[str, Mapping[str, str]] = index.role_object_types()\n212\t        self.facts = list(index.iter_fact_types_shared())\n213\t        self.spelled: dict[str, list[ColumnRef]] = {}\n214\t        for table, body in self.tables.items():\n215\t            for column in body[\"columns\"]:\n216\t                self.spelled.setdefault(f\"{table}.{column}\", []).append((table, column))\n217\t        #: (section, fact type, model role name) -> columns, filled by the name checks.\n218\t        self.bound: dict[tuple[str, str, str], tuple[ColumnRef, ...]] = {}\n219\t        self._shape: dict[str, tuple[int, int] | None] = {}\n220\t\n221\t    # -- iteration in sorted order ------------------------------------------------------\n222\t\n223\t    def columns(self) -> Iterable[tuple[str, str, Mapping[str, Any]]]:\n224\t        for table in sorted(self.tables):\n225\t            for column in sorted(self.tables[table][\"columns\"]):\n226\t                yield table, column, self.tables[table][\"columns\"][column]\n227\t\n228\t    def role_entries(self) -> Iterable[tuple[str, str, str, list[Any]]]:\n229\t        \"\"\"(section, fact type, role name as written, column references).\"\"\"\n230\t        for section in (\"roles\", \"extension_roles\"):\n231\t            for fact in sorted(self.role_sections[section]):\n232\t                for role in sorted(self.role_sections[section][fact]):\n233\t                    yield section, fact, role, self.role_sections[section][fact][role]\n234\t\n235\t    def targets(self, kinds: tuple[str, ...]) -> Iterable[tuple[str, str, Mapping[str, str]]]:\n236\t        for table, column, body in self.columns():\n237\t            for target in body.get(\"targets\", ()):\n238\t                if target[\"kind\"] in kinds:\n239\t                    yield table, column, target\n240\t\n241\t    # -- step 5: names ---------------------------------------------------------------------\n242\t\n243\t    def check_names(self) -> None:\n244\t        # binding:name-collision. Expressions quote and uppercase every name.\n245\t        for label, names in [(\"tables\", sorted(self.tables)),\n246\t                             *((f\"columns of {t}\", sorted(self.tables[t][\"columns\"])) for t in sorted(self.tables))]:\n247\t            seen: dict[str, str] = {}\n248\t            for name in names:\n249\t                other = seen.setdefault(name.upper(), name)\n250\t                if other != name:\n251\t                    raise BindingError(\"binding:name-collision\", f\"{label}: {other!r} and {name!r} are one identifier\")\n252\t        # binding:unknown-table\n253\t        for table, column, body in self.columns():\n254\t            target = body.get(\"references\", {}).get(\"table\")\n255\t            if target is not None and target not in self.tables:\n256\t                raise BindingError(\"binding:unknown-table\", f\"{table}.{column} references table {target!r}\")\n257\t        for _section, fact, role, references in self.role_entries():\n258\t            for reference in references:\n259\t                if not isinstance(reference, str) and reference[\"table\"] not in self.tables:\n260\t                    raise BindingError(\"binding:unknown-table\", f\"{fact}.{role} names table {reference['table']!r}\")\n261\t        # binding:unknown-column\n262\t        for table in sorted(self.tables):\n263\t            body = self.tables[table]\n264\t            for key in [body.get(\"primary_key\", ()), *body.get(\"unique_keys\", ())]:\n265\t                for column in key:\n266\t                    if column not in body[\"columns\"]:\n267\t                        raise BindingError(\"binding:unknown-column\", f\"a key of {table} names column {column!r}\")\n268\t        for table, column, body in self.columns():\n269\t            reference = body.get(\"references\")\n270\t            if reference is not None:\n271\t                for name in reference[\"columns\"]:\n272\t                    if name not in self.tables[reference[\"table\"]][\"columns\"]:\n273\t                        raise BindingError(\n274\t                            \"binding:unknown-column\", f\"{table}.{column} references {reference['table']}.{name}\")\n275\t        for _section, fact, role, references in self.role_entries():\n276\t            for reference in references:\n277\t                if isinstance(reference, str):\n278\t                    if reference not in self.spelled:\n279\t                        raise BindingError(\"binding:unknown-column\", f\"{fact}.{role} names column {reference!r}\")\n280\t                elif reference[\"column\"] not in self.tables[reference[\"table\"]][\"columns\"]:\n281\t                    raise BindingError(\n282\t                        \"binding:unknown-column\", f\"{fact}.{role} names column {reference['table']}.{reference['column']}\")\n283\t        # binding:ambiguous-column. A string is looked up, never split on its dots.\n284\t        for _section, fact, role, references in self.role_entries():\n285\t            for reference in references:\n286\t                if isinstance(reference, str) and len(self.spelled[reference]) > 1:\n287\t                    raise BindingError(\n288\t                        \"binding:ambiguous-column\", f\"{fact}.{role}: {reference!r} spells more than one table and column\")\n289\t        # binding:unknown-fact-type\n290\t        for _section, fact, _role, _references in self.role_entries():\n291\t            if fact not in self.players:\n292\t                raise BindingError(\"binding:unknown-fact-type\", f\"{fact!r} is not a fact type of the model\")\n293\t        for table, column, target in self.targets((\"role\",)):\n294\t            if target[\"fact_type\"] not in self.players:\n295\t                raise BindingError(\"binding:unknown-fact-type\", f\"a target of {table}.{column} names {target['fact_type']!r}\")\n296\t        # binding:role-name, then binding:unknown-role. A name that normalizes to nothing,\n297\t        # or like another, cannot be looked up, so it is judged before the lookup.\n298\t        resolved: dict[tuple[str, str, str], str] = {}\n299\t        model_names: dict[str, dict[str, str]] = {}\n300\t        named_facts = sorted({fact for _s, fact, _r, _c in self.role_entries()}\n301\t                             | {target[\"fact_type\"] for _t, _c, target in self.targets((\"role\",))})\n302\t        for fact in named_facts:\n303\t            names: dict[str, str] = {}\n304\t            for role in self.players[fact]:\n305\t                normal = normalize_role_name(role)\n306\t                if not normal or normal in names:\n307\t                    raise BindingError(\"binding:role-name\", f\"the roles of {fact} cannot be told apart once normalized\")\n308\t                names[normal] = role\n309\t            model_names[fact] = names\n310\t        for section in (\"roles\", \"extension_roles\"):\n311\t            for fact in sorted(self.role_sections[section]):\n312\t                written: dict[str, str] = {}\n313\t                for role in sorted(self.role_sections[section][fact]):\n314\t                    normal = normalize_role_name(role)\n315\t                    if not normal:\n316\t                        raise BindingError(\"binding:role-name\", f\"{fact}: role name {role!r} has no letter or digit\")\n317\t                    if normal in written:\n318\t                        raise BindingError(\n319\t                            \"binding:role-name\", f\"{fact}: {written[normal]!r} and {role!r} are one role name\")\n320\t                    written[normal] = role\n321\t        for table, column, target in self.targets((\"role\",)):\n322\t            if not normalize_role_name(target[\"role\"]):\n323\t                raise BindingError(\"binding:role-name\", f\"a target of {table}.{column} names role {target['role']!r}\")\n324\t        for section, fact, role, _references in self.role_entries():\n325\t            match = model_names[fact].get(normalize_role_name(role))\n326\t            if match is None:\n327\t                raise BindingError(\"binding:unknown-role\", f\"{fact} has no role {role!r}\")\n328\t            resolved[(section, fact, role)] = match\n329\t        for table, column, target in self.targets((\"role\",)):\n330\t            if normalize_role_name(target[\"role\"]) not in model_names[target[\"fact_type\"]]:\n331\t                raise BindingError(\n332\t                    \"binding:unknown-role\", f\"a target of {table}.{column}: {target['fact_type']} has no role {target['role']!r}\")\n333\t        # binding:unknown-object-type\n334\t        for table, column, target in self.targets((\"identifier\", \"reference\")):\n335\t            if target[\"object_type\"] not in self.objects:\n336\t                raise BindingError(\"binding:unknown-object-type\", f\"a target of {table}.{column} names {target['object_type']!r}\")\n337\t        self.model_names = model_names\n338\t        for section, fact, role, references in self.role_entries():\n339\t            self.bound[(section, fact, resolved[(section, fact, role)])] = tuple(\n340\t                self.spelled[r][0] if isinstance(r, str) else (r[\"table\"], r[\"column\"]) for r in references)\n341\t\n342\t    # -- identification, as the ontology declares it ---------------------------------------\n343\t\n344\t    def components(self, object_type: str) -> list[tuple[str, str, str]] | None:\n345\t        \"\"\"(fact type, component role, component player) per identifying relationship of\n346\t        a composite identifier, in the ontology's order; None for any other object type.\"\"\"\n347\t        form, payload = self.view.identification.get(object_type, (None, None))\n348\t        if form != \"composite\":\n349\t            return None\n350\t        result = []\n351\t        for fact in payload:\n352\t            _owner, order, players = self.view.relations[fact]\n353\t            result.append((fact, order[1], players[order[1]]))\n354\t        return result\n355\t\n356\t    def arity(self, object_type: str) -> int | None:\n357\t        \"\"\"How many columns hold one object of the type; None when the ontology declares\n358\t        no identifier for it, or one nested deeper than MAX_IDENTIFIER_DEPTH (the mapping\n359\t        then lists it as identification-differs).\"\"\"\n360\t        shape = self.shape(object_type)\n361\t        return None if shape is None else shape[0]\n362\t\n363\t    def shape(self, start: str) -> tuple[int, int] | None:\n364\t        \"\"\"(column count, nesting depth) of an object type's identification.\n365\t\n366\t        Computed with an explicit stack, so a long chain of entities identified through\n367\t        one another cannot exhaust the interpreter's recursion (review r1 F2).\n368\t        \"\"\"\n369\t        stack = [start]\n370\t        open_types: set[str] = set()\n371\t        while stack:\n372\t            current = stack[-1]\n373\t            if current in self._shape:\n374\t                stack.pop()\n375\t                continue\n376\t            if self.objects[current][\"kind\"] == \"value\" or self.view.identification.get(current, (None,))[0] == \"simple\":\n377\t                self._shape[current] = (1, 0)\n378\t                continue\n379\t            components = self.components(current)\n380\t            if components is None:\n381\t                self._shape[current] = None\n382\t                continue\n383\t            waiting = [player for _fact, _role, player in components if player not in self._shape]\n384\t            if waiting and current in open_types:  # identified through itself\n385\t                self._shape[current] = None\n386\t                continue\n387\t            if waiting:\n388\t                open_types.add(current)\n389\t                stack.extend(waiting)\n390\t                continue\n391\t            parts = [self._shape[player] for _fact, _role, player in components]\n392\t            if any(part is None for part in parts):\n393\t                self._shape[current] = None\n394\t            else:\n395\t                depth = 1 + max(part[1] for part in parts)  # type: ignore[index]\n396\t                width = sum(part[0] for part in parts)  # type: ignore[index]\n397\t                self._shape[current] = (width, depth) if depth <= MAX_IDENTIFIER_DEPTH else None\n398\t        return self._shape[start]\n399\t\n400\t    def related(self, first: str, second: str) -> bool:\n401\t        \"\"\"The same object type, or one a subtype of the other.\"\"\"\n402\t        def ancestors(object_type: str) -> set[str]:\n403\t            seen, pending = set(), [object_type]\n404\t            while pending:\n405\t                current = pending.pop()\n406\t                if current not in seen:\n407\t                    seen.add(current)\n408\t                    pending += [str(parent) for parent in self.objects.get(current, {}).get(\"subtype_of\") or ()]\n409\t            return seen\n410\t\n411\t        return first in ancestors(second) or second in ancestors(first)\n412\t\n413\t    def declared_homes(self) -> list[tuple[str, str]]:\n414\t        \"\"\"(table, object type) wherever every primary-key column is marked as that\n415\t        object type's identifier, in sorted order.\"\"\"\n416\t        declared = []\n417\t        for table in sorted(self.tables):\n418\t            key = tuple(self.tables[table].get(\"primary_key\", ()))\n419\t            marked = [\n420\t                {t[\"object_type\"] for t in self.tables[table][\"columns\"][c].get(\"targets\", ()) if t[\"kind\"] == \"identifier\"}\n421\t                for c in key\n422\t            ]\n423\t            declared += [(table, object_type) for object_type in (sorted(set.intersection(*marked)) if marked else ())]\n424\t        return declared\n42
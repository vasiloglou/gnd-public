"""Normative ORM scalar identity for synthesis-side code.

This is deliberately independent of :mod:`gnd.checker`: the synthesis oracle
must not call the implementation it evaluates.  It nevertheless implements the
same specified domains: booleans are separate, all JSON numeric renderings
share one domain, strings are separate, and tuples are keyed component-wise.
"""

from __future__ import annotations

from typing import Any


def scalar_identity(value: Any) -> tuple[str, Any]:
    """Return the synthesis identity key for one interchange scalar."""
    if isinstance(value, bool):
        return ("boolean", value)
    if isinstance(value, (int, float)):
        return ("number", value)
    if isinstance(value, str):
        return ("string", value)
    if value is None:
        return ("null", None)
    return (f"python:{type(value).__qualname__}", repr(value))


def tuple_identity(values: tuple[Any, ...]) -> tuple[tuple[str, Any], ...]:
    """Return component-wise ORM identity for a projected tuple."""
    return tuple(scalar_identity(value) for value in values)
"""Bounded, no-follow artifact reads and publication primitives.

The helpers in this module deliberately know nothing about experiment sessions.
They provide the small filesystem vocabulary shared by session evidence and the
later recovery/evolution workflows: canonical tree identity, expected-identity
leaf replacement, and append-once manifest-last directory publication.
"""

from __future__ import annotations

import ctypes
import hashlib
import json
import os
import secrets
import stat
from collections.abc import Mapping, Sequence
from contextlib import suppress
from decimal import Decimal
from itertools import pairwise
from pathlib import Path, PurePosixPath, PureWindowsPath
from typing import Annotated, Any, Literal, Self

from pydantic import (
    BaseModel,
    ConfigDict,
    Field,
    StringConstraints,
    model_validator,
)

__all__ = [
    "ArtifactError",
    "ArtifactIdentityError",
    "LeafSnapshot",
    "Sha256",
    "TrackedRegularEntry",
    "TrackedSymlinkEntry",
    "TrackedTreeEntry",
    "TreeFile",
    "TreeInventory",
    "canonical_json_bytes",
    "canonical_json_text",
    "canonical_report_text",
    "inventory_tree",
    "is_sha256_hex",
    "publish_directory_once",
    "publish_leaf_atomic",
    "read_regular_bounded",
    "read_regular_bounded_at",
    "read_regular_file_bytes",
    "readlink_at",
    "reject_json_constant",
    "reject_json_duplicate_pairs",
    "reject_json_duplicate_pairs_result",
    "remove_regular_if_unchanged",
    "sha256_hex",

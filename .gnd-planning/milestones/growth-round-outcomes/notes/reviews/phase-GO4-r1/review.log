   293	    ("--require-documents", "--require-document", ""),                        # a misspelt option
   294	    ("additive --check-population FILE`", "additive --check-populations FILE`", ""),  # inside a wrapped span
   295	    ("--policy additive --shape-report", "--policy banana --shape-report", ""),        # a value the option refuses
   296	    (None, None, "\n`gnd evolv preview --policy additive`\n"),                       # an unknown command
   297	    (None, None, "\n```bash\ngnd validate MODEL --require-documentz\n```\n"),      # inside a fenced block
   298	    (None, None, "\n`gnd evolve apply --shape-report`\n"),                           # an option of the wrong command
   299	])
   300	def test_ug4_the_guard_can_fail(old: str | None, new: str | None, suffix: str) -> None:
   301	    """Mutation control (review finding 2): each planted drift is reported."""
   302	    text = REFERENCE.read_text(encoding="utf-8")
   303	    if old is not None:
   304	        assert old in text, old
   305	        text = text.replace(old, new, 1)
   306	    assert _drift(text + suffix)

381: def _public_results(inputs, broad, targeted):
382:     with tempfile.TemporaryDirectory(prefix="gnd-reading-") as temporary:
383:         folder = Path(temporary).resolve()
384:         for name in ("reading.orm.json", "vocabulary.orm.json"):
385:             (folder / name).write_bytes(inputs.raw[name])
386:         _route(folder, "extract", "reading.orm.json", "--out", "bundle")
387:         index = _decode(_read(folder, "bundle/reading.orm.artifacts.json"))
388:         header = index["header_template"]
389:         results, artifacts = {}, {}
390:         for name, attempts in (("broad", broad), ("targeted", targeted)):
391:             document = b"\n".join(inputs.source_range(inputs.sections[row["section"]]) for row in attempts)
392:             raw, results[name] = _checked(folder, name, header, index, document, _combined(attempts))
393:             _need(results[name] == {"verify": 0, "check": 0}, f"{name} extraction is unverified")
394:             artifacts[name + ".population.json"] = raw
395:         document = inputs.raw["conflict.txt"]
396:         conflict = _decode(inputs.raw["conflict.json"])
397:         facts = conflict["facts"]
398:         labels = facts.get("subject_label")
399:         _need(conflict.get("document_sha256") == sha256_hex(document)
400:               and isinstance(labels, list) and len(labels) == 2
401:               and all(isinstance(row, dict) and isinstance(row.get("label"), str)
402:                       and row["label"].encode() in document for row in labels),
403:               "stale reported conflict extraction")
404:         raw, results["reported-conflict"] = _checked(folder, "reported-conflict", header, index, document, facts)
405:         _need(results["reported-conflict"] == {"verify": 1, "check": 1},
406:               "the reported conflict was not preserved")
407:         artifacts["reported-conflict.population.json"] = raw
408:         artifacts["reported-conflict.source.txt"] = document
409:         fidelity = _calibrate(folder, inputs, header, index, targeted)
410:         return results, artifacts, fidelity

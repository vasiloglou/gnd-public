   411	    # -- building tables --------------------------------------------------------------
   412	
   413	    def build(self, derived, effective, placed, tabled) -> RelationalSchema:
   414	        tables = self.tables
   415	        unusable: set[str] = set()  # object types whose identification is unmatchable
   416	
   417	        def new_table(name, subject):
   418	            tables[name] = {"subject": subject, "columns": [], "names": set(), "pk": [], "uks": [], "fks": [], "groups": []}
   419	            return tables[name]
   420	
   421	        def add_column(table, base, datatype, nullable, origin):
   422	            name, n = base, 1
   423	            while name in table["names"]:
   424	                n += 1
   425	                name = f"{base}_{n}"
   426	            table["names"].add(name)
   427	            table["columns"].append(Column(name, datatype, nullable, origin))
   428	            return name
   429	
   430	        objectified_targets = {str(f.get("objectified_as")) for f in self.facts if f.get("objectified_as")}
   431	        # Object-type tables with their key columns first (A2).
   432	        for oid in sorted(tabled):
   433	            if oid in self.fact_by_id:
   434	                continue
   435	            key = self.key(oid)
   436	            if key is None and oid in objectified_targets:
   437	                key = None  # keyed by the objectified fact type below (A5)
   438	            elif key is None:
   439	                unusable.add(oid)
   440	                continue
   441	            table = new_table(oid, ("object_type", oid))
   442	            if key is not None:
   443	                names = [add_column(table, n, d, False, o) for n, d, o in zip(key.names, key.datatypes, key.origins)]
   444	                table["pk"] = names
   445	                self.add_component_groups(table, names, key)
   446	            supers = self.objects.get(oid, {}).get("subtype_of") or []
   447	            if (
   448	                self.variant is RmapVariant.ALTERNATE
   449	                and supers
   450	                and self.objects[oid].get("inherits_reference")
   451	            ):
   452	                table["groups"].append((tuple(table["pk"]), str(supers[0])))
   453	
   454	        # Placements in fact type id order, roles in role order (A2).
   455	        for fact in sorted(self.facts, key=lambda f: str(f.get("id"))):
   456	            fid = str(fact.get("id"))
   457	            if fid in derived:
   458	                self.unmapped[("fact_type", fid)] = ("derived-computed", "")
   459	                continue
   460	            p = placed[fid]
   461	            players = self.players(fact)
   462	            roles = self.roles(fact)
   463	            if p.rule != 6 and p.owner in unusable:
   464	                self.unmapped[("fact_type", fid)] = ("identification-unmatchable", "")
   465	                continue
   466	            unresolved = [
   467	                x for x in (players[r] for r in roles)
   468	                if self.objects.get(x, {}).get("kind") != "value" and self.key(x) is None
   469	            ]
   470	            if p.rule in (3, 5, 6) and unresolved:
   471	                unusable.update(unresolved)
   472	                self.unmapped[("fact_type", fid)] = ("identification-unmatchable", "")
   473	                continue
   474	            if p.rule in (1, 2):
   475	                key = self.key(p.owner)
   476	                table = tables[p.owner]
   477	                if p.rule == 1:
   478	                    cols = [table["pk"][0]]
   479	                else:
   480	                    cols = [n for n, o in zip(table["pk"], key.origins) if o[0] == fid]
   481	                self.carried[("fact_type", fid)] = ("key", p.owner, *cols)
   482	            elif p.rule == 3:

214: def _outcomes(inputs, attempted, unavailable):
215:     coverage, questions = [], []
216:     for name, question in inputs.questions.items():
217:         successor = question["superseded_by"]
218:         if successor is not None:
219:             questions.append({"id": name, "outcome": "superseded", "target": successor})
220:             continue
221:         section = question["section"]
222:         observation = attempted.get(section)
223:         facts = observation["response"]["facts"] if observation else {}
224:         if section in unavailable:
225:             state = "unavailable"
226:         elif inputs.sections[section]["span"] is None:
227:             state = inputs.sections[section]["reason"]
228:         elif observation is None:
229:             state = "omitted"
230:         elif observation["outcome"] == "refused":
231:             state = "producer-refused"
232:         elif observation["outcome"] == "empty":
233:             state = "empty-extraction"
234:         elif question["fact"] in facts:
235:             state = "explicitly-denied" if question["denial"] else "supported"
236:         else:
237:             state = "inspected-not-found"
238:         inspected = observation is not None
239:         coverage.append({"question": name, "source": inputs.sections[section]["source"],
240:                          "section": section, "state": state, "inspected": inspected})
241:         resolved = state in ("explicitly-denied", "supported")
242:         questions.append({"id": name, "outcome": "resolved" if resolved else "retained", "reason": state})
243:     return coverage, questions

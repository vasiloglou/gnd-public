+def snapshot_verdict(report: dict[str, Any]) -> dict[str, Any]:
+    """Interpret an existing versioned check report without evaluating a population."""
+    from copy import deepcopy
+
+    from jsonschema import Draft202012Validator
+
+    from gnd.disclosure import resolve
+    from gnd.payloads import _OUTCOMES
+    from gnd.report_schema import load_report_schema
+
+    result = {"status": "invalid-report", "exit_code": None, "constraints": [],
+              "derivations": [], "warnings": [], "diagnostics": []}
+    if not isinstance(report, dict) or report.get("command") != "check":
+        return result
+    version = report.get("schema_version")
+    if not isinstance(version, int) or isinstance(version, bool):
+        return result
+    version = int(version)
+    if version not in (7, 9, 10, 11, 12, 13, 14, 15, 16, 17):
+        result["status"] = "unsupported-schema"
+        return result
+    if not Draft202012Validator(load_report_schema()).is_valid(report):
+        return result
+    wrapped = version in (12, 14)
+    body = report["report"] if wrapped else report
+    code = report["exit_code"]
+    if (isinstance(code, bool) or report["outcome"] != _OUTCOMES.get(code)
+            or body.get("command") != "check"):
+        return result
+    if wrapped and ((version == 14 and int(body["schema_version"]) != 13)
+                    or (version == 12 and int(body["schema_version"]) not in (7, 9, 10, 11))):
+        result["status"] = "unsupported-schema"
+        return result
+    if code not in (3, 70) and (body["exit_code"] != code or body["outcome"] != report["outcome"]):
+        return result
+    result.update(exit_code=code, status={0: "accepted", 1: "violated", 2: "inadequate",
+                  3: "invalid-input", 4: "unchecked", 70: "internal-error"}[code])
+    # An outer failure cannot turn a nested successful check into acceptance.
+    if wrapped and code in (3, 70) and body["exit_code"] != code:
+        return result
+    if code == 2 and body["counts"]["vacuous"]:
+        result["status"] = "vacuous"
+    if resolve() == "customer":
+        # A supplied report may have been issued under a different disclosure mode.
+        # Project only closed schema verdict tags, never incoming messages or witnesses.
+        for field, source in (("constraints", "verdicts"), ("derivations", "derivations")):
+            result[field] = [{"verdict": item["verdict"]} for item in body.get(source, [])]
+        return result
+    result.update(constraints=deepcopy(body["verdicts"]), derivations=deepcopy(body.get("derivations", [])),

#!/usr/bin/env python3
"""handoff.py: hand a branch to another coding assistant, developer or machine, and take one over
(dev-handoff and dev-takeover skills).

Git carries the code; it does not carry what the current session knows. ``write`` puts that into
``<planning>/handoffs/``, one file per branch: a snapshot of the checkout that every run regenerates (branch,
head, commits, uncommitted files, stashes, ignored files, phase status) and sections the one who is
leaving fills (goal, done, next step, decisions, standing instructions, what lives outside git).

    handoff.py write [--to claude|codex|gemini|human|any] [--from WHO] [--machine same|new]
    handoff.py check                      what would be lost if this machine disappeared now
    handoff.py ignored [--all] [--include GLOB ...]   the files git ignores here, by kind
    handoff.py carry --dest PATH|HOST:PATH [--include GLOB ...] [--with-keys] [--all] [--yes]
    handoff.py list                       hand-offs on local and origin branches
    handoff.py takeover                   note, head, missing files, machine: ready or not
    handoff.py show                       print the branch's note, then check it (--json: one document)
    handoff.py pull --from-checkout PATH|HOST:PATH [--include GLOB ...] [--with-keys] [--all] [--yes]
    handoff.py doctor                     the machine checks alone

Common options: --base REF, --repo DIR, --json, --max-mb N.
Stdlib only; runs on the system python3 (3.9) with git. Nothing is committed, pushed or deleted,
and no key is read or printed. ``carry`` and ``pull`` are dry runs until ``--yes``.
Exit codes: 0; ``check`` exits 1 while a critical or major finding stands, and ``write`` when the
file in the note's place is not a note; 2 usage error.
"""

from __future__ import annotations

import argparse
import datetime
import fnmatch
import json
import os

   174	def check_with_receipt(
   175	    model: Model, population: Population, *, unredacted: bool = False
   176	) -> tuple[dict[str, Any], CheckReceipt]:
   177	    """Return the check payload and an opaque, in-process CheckReceipt."""
   178	    unredacted = _values_allowed(unredacted, "unredacted=True")
   179	    if not isinstance(model, Model) or not isinstance(population, Population):
   180	        raise TypeError("check_with_receipt requires loaded Model and Population objects")

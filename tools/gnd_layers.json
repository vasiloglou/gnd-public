{
  "allow_list": [],
  "declared_clean": [
    "infrastructure",
    "model",
    "checking",
    "semantics",
    "lanes",
    "entry"
  ],
  "excluded": [
    "src/gnd/examples/**",
    "src/gnd/skills/**"
  ],
  "helper_patterns": {
    "canonical_json": "^_?(canonical|canonical_json|canonical_bytes|canonical_json_bytes|canonical_json_text|json_bytes|evolve_json_bytes|canonical_payload)$",
    "file_digest": "^_?(sha256_file|digest_regular_path|tree_sha256|population_file_digest|final_record_file_sha256)$",
    "iso_datetime": "^_?(parse_datetime|is_datetime)$",
    "model_digest": "^_?(model_digest|reference_model_digest)$",
    "safe_filesystem": "^_?(descend|open_root|same_inode|atomic_write|safe_destination|reject_unsafe_relpath|write_new|write_new_file|write_new_file_at|unsafe_project_path|evolve_reject_unsafe_spelling)$",
    "sha256_hex": "^_?(sha256|sha|sha256_hex|digest|digest_text|content_digest)$",
    "strict_json": "^_?(strict_json|strict_json_object|strict_object|strict_object_bytes|strict_document|read_json_document)$",
    "validation_issues": "^_?(validation_issues|pydantic_issues|schema_issues)$",
    "yaml_guard": "^_?(load_yaml|load_yaml_static|preflight_yaml|yaml_stream_guard_error)$"
  },
  "lanes": [
    "codegen",
    "conformance",
    "discover",
    "evolve",
    "exp",
    "export",
    "extract",
    "fidelity",
    "measure",
    "recovery",
    "review",
    "synth",
    "witness"
  ],

357: def absence_status(artifacts, pins):
358:     """Qualify the declared fixture claim from four independently bound inputs."""
359:     names = ("scope.json", "closure.json", "coverage.json", "fidelity.json")
360:     if any(name not in artifacts or name not in pins or sha256_hex(artifacts[name]) != pins[name]
361:            for name in names):
362:         return "unavailable"
363:     try:
364:         scope, closure, coverage = (_decode(artifacts[name]) for name in names[:3])
365:         observed = {(row["question"], row["section"]) for row in coverage["rows"]
366:                     if row["state"] == "inspected-not-found" and row["inspected"] is True}
367:         scoped = set(zip(scope["questions"], scope["sections"], strict=True))
368:         ready = (
369:             scope["format"] == "literature-reading-scope/1"
370:             and closure["format"] == "literature-reading-closure/1"
371:             and coverage["format"] == "literature-reading-coverage/1"
372:             and bool(scoped) and scoped <= observed and _recall(artifacts["fidelity.json"]) == [2, 2]
373:             and scope["predicate"] == "alternative_integrator"
374:             and closure["scope_sha256"] == pins["scope.json"] and closure["sections"] == scope["sections"]
375:         )
376:     except (ValueError, KeyError, TypeError):
377:         return "unavailable"
378:     return "qualified" if ready else "unavailable"

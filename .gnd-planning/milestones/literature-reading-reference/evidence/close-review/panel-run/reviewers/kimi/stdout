{"role":"tool","tool_call_id":"tool_HbBiBznkKomM24Jr24jTltwI","content":"1\t\"\"\"Record LR3's one live reading run over the literature reference set.\n2\t\n3\tOwner rulings (milestone literature-reading-reference): producer Claude Sonnet\n4\tthrough the owner's Claude Code login (\"Claude CLI login\"), a USD 50 ceiling\n5\t(\"sonnet 50$\"). This tool is not part of any gate: it spends paid calls. The\n6\tgates replay the folder it writes with zero producer calls.\n7\t\n8\t    uv run python tools/record_lr3_reference_run.py --out DIR\n9\t\n10\twrites DIR/run (the literature-reading-run/2 folder), DIR/run-record.json and\n11\tDIR/score.json. Nothing is written into the package; copying the result in is\n12\ta separate, reviewed step.\n13\t\"\"\"\n14\tfrom __future__ import annotations\n15\t\n16\timport argparse\n17\timport hashlib\n18\timport json\n19\timport subprocess\n20\timport sys\n21\timport tempfile\n22\tfrom pathlib import Path\n23\t\n24\tfrom gnd.artifacts import canonical_json_bytes\n25\tfrom gnd.examples.literature import reading, reference_set\n26\t\n27\tMODEL_ID = \"claude-sonnet-5-5\"\n28\tCEILING_USD = 50.0\n29\tPER_CALL_USD = 1.0\n30\tCALL_SECONDS = 300\n31\tPROMPT = \"\"\"You read one section of a scientific paper and report the facts it states, in a fixed vocabulary.\n32\t\n33\tFact types (report only these):\n34\t{fact_types}\n35\t\n36\tRules:\n37\t- Report a fact only if this section itself states it. Do not use outside knowledge.\n38\t- Write each value as this section writes the name, without adding or changing words.\n39\t- A work is named by the identifier the section gives for it (for example an arXiv identifier).\n40\t- If the section states none of these facts, report no facts.\n41\t\n42\tSection {section} of source {source}:\n43\t<section>\n44\t{text}\n45\t</section>\n46\t\"\"\"\n47\tFIELDS = (\"{fact_types}\", \"{section}\", \"{source}\", \"{text}\")\n48\t\n49\t\n50\tdef _vocabulary(model: dict) -> list[dict]:\n51\t    \"\"\"The fact types a producer may report: the model's asserted ones, never a derived one.\"\"\"\n52\t    return [row for row in model[\"fact_types\"] if row.get(\"derivation\") is None]\n53\t\n54\t\n55\tdef _schema(fact_types: list[dict]) -> dict:\n56\t    properties = {}\n57\t    for row in fact_types:\n58\t        roles = [role[\"role_name\"] for role in row[\"roles\"]]\n59\t        properties[row[\"id\"]] = {\"type\": \"array\", \"items\": {\n60\t            \"type\": \"object\", \"properties\": {name: {\"type\": \"string\"} for name in roles},\n61\t            \"required\": roles, \"additionalProperties\": False}}\n62\t    return {\"type\": \"object\", \"properties\": {\"facts\": {\"type\": \"object\", \"properties\": properties,\n63\t                                                       \"additionalProperties\": False}},\n64\t            \"required\": [\"facts\"], \"additionalProperties\": False}\n65\t\n66\t\n67\tdef _fact_type_lines(fact_types: list[dict]) -> str:\n68\t    return \"\\n\".join(f\"- {row['id']}: \\\"{row['reading']}\\\", roles \" + \", \".join(\n69\t        role[\"role_name\"] for role in row[\"roles\"]) for row in fact_types)\n70\t\n71\t\n72\tdef _fill(template: str, values: dict[str, str]) -> str:\n73\t    \"\"\"Substitute each field of the template once; an inserted value is never searched again.\"\"\"\n74\t    parts, rest = [], template\n75\t    while True:\n76\t        found = [(rest.find(field), field) for field in FIELDS if rest.find(field) >= 0]\n77\t        if not found:\n78\t            return \"\".join([*parts, rest])\n79\t        index, field = min(found)\n80\t        parts += [rest[:index], values[field]]\n81\t        rest = rest[index + len(field):]\n82\t\n83\t\n84\tclass SpendError(RuntimeError):\n85\t    pass\n86\t\n87\t\n88\tclass ClaudeCliProducer:\n89\t    \"\"\"A reading producer that asks Claude Sonnet through the ``claude`` CLI, one call per section.\"\"\"\n90\t\n91\t    def __init__(self, model: dict, *, command: tuple[str, ...] = (\"claude\",), ceiling: float = CEILING_USD):\n92\t        self.fact_types = _vocabulary(model)\n93\t        self.roles = {row[\"id\"]: {role[\"role_name\"] for role in row[\"roles\"]} for row in self.fact_types}\n94\t        self.schema = _schema(self.fact_types)\n95\t        self.vocabulary = _fact_type_lines(self.fact_types)\n96\t        self.template = PROMPT.replace(\"{fact_types}\", self.vocabulary)\n97\t        self.command, self.ceiling = command, ceiling\n98\t        self.spent, self.calls, self.models = 0.0, [], set()\n99\t\n100\t    def _ask(self, prompt: str) -> dict:\n101\t        if self.spent + PER_CALL_USD > self.ceiling:\n102\t            raise SpendError(f\"the next call could pass the USD {self.ceiling} ceiling (spent {self.spent:.4f})\")\n103\t        argv = [*self.command, \"-p\", \"--model\", MODEL_ID, \"--safe-mode\", \"--tools\", \"\",\n104\t                \"--no-session-persistence\", \"--output-format\", \"json\", \"--max-budget-usd\", str(PER_CALL_USD),\n105\t                \"--json-schema\", json.dumps(self.schema)]\n106\t        with tempfile.TemporaryDirectory(prefix=\"lr3-producer-\") as empty:\n107\t            done = subprocess.run(argv, input=prompt, capture_output=True, text=True, cwd=empty,\n108\t                                  timeout=CALL_SECONDS, check=False)\n109\t        if done.returncode != 0:\n110\t            raise RuntimeError(f\"claude exited {done.returncode}: {done.stderr[-500:]}\")\n111\t        result = json.loads(done.stdout)\n112\t        self.spent += float(result.get(\"total_cost_usd\") or 0.0)\n113\t        models = set(result.get(\"modelUsage\") or {})\n114\t        self.models |= models\n115\t        if result.get(\"is_error\") or result.get(\"subtype\") != \"success\":\n116\t            raise RuntimeError(f\"claude returned {result.get('subtype')!r}\")\n117\t        if not models <= {MODEL_ID}:\n118\t            raise RuntimeError(f\"claude used models {sorted(models)}, not {MODEL_ID}\")\n119\t        output = result.get(\"structured_output\")\n120\t        if not isinstance(output, dict) or not isinstance(output.get(\"facts\"), dict):\n121\t            raise TypeError(\"claude returned no structured facts\")\n122\t        return output\n123\t\n124\t    def produce(self, call: reading.ProducerCall) -> dict:\n125\t        prompt = _fill(PROMPT, {\"{fact_types}\": self.vocabulary, \"{section}\": call.section,\n126\t                                \"{source}\": call.source, \"{text}\": call.excerpt.decode(\"utf-8\")})\n127\t        output = self._ask(prompt)\n128\t        facts = {}\n129\t        for fact_type, rows in output[\"facts\"].items():\n130\t            names = self.roles.get(fact_type)\n131\t            if names is None or not isinstance(rows, list):\n132\t                continue\n133\t            kept = [row for row in rows if isinstance(row, dict) and set(row) == names\n134\t                    and all(isinstance(value, str) and value.strip() for value in row.values())]\n135\t            if kept:\n136\t                facts[fact_type] = kept\n137\t        self.calls.append({\"stage\": call.stage, \"section\": call.section, \"excerpt_sha256\": call.excerpt_sha256,\n138\t                           \"spent_usd\": round(self.spent, 6)})\n139\t        if facts:\n140\t            return {\"outcome\": \"accepted\", \"facts\": facts, \"proposal_keys\": []}\n141\t        return {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []}\n142\t\n143\t\n144\tdef record(out: Path, root: Path = reference_set.ROOT, *, command: tuple[str, ...] = (\"claude\",)) -> dict:\n145\t    out.mkdir(parents=True, exist_ok=False)\n146\t    model = json.loads((root / reference_set.MODEL).read_bytes())\n147\t    producer = ClaudeCliProducer(model, command=command)\n148\t    budget = sum((root / f\"{source}.txt\").stat().st_size\n149\t                 for source in (row[\"id\"] for row in json.loads((root / \"roster.json\").read_bytes())[\"sources\"]))\n150\t    report = reading.run(out / \"run\", fixture=root, producer=producer, budget=budget)\n151\t    version = subprocess.run([*command, \"--version\"], capture_output=True, text=True, check=False).stdout.strip()\n152\t    run_record = {\n153\t        \"format\": \"literature-reference-run-record/1\",\n154\t        \"producer\": {\"transport\": \"claude CLI, the owner's login\", \"cli_version\": version,\n155\t                     \"model\": MODEL_ID, \"models_seen\": sorted(producer.models),\n156\t                     \"flags\": [\"--safe-mode\", \"--tools\", \"\", \"--no-session-persistence\",\n157\t                               \"--output-format\", \"json\", \"--max-budget-usd\", str(PER_CALL_USD), \"--json-schema\"]},\n158\t        \"prompt_template\": producer.template,\n159\t        \"prompt_template_sha256\": hashlib.sha256(producer.template.encode(\"utf-8\")).hexdigest(),\n160\t        \"schema\": producer.schema,\n161\t        \"budget\": {\"ceiling_usd\": CEILING_USD, \"spent_usd\": round(producer.spent, 6), \"calls\": len(producer.calls)},\n162\t        \"reading\": {\"budget_bytes\": budget, \"producer_calls\": report[\"producer_calls\"], \"stop\": report[\"stop\"],\n163\t                    \"read_denominator\": report[\"read_denominator\"]},\n164\t        \"evidence_sha256\": report[\"evidence_sha256\"],\n165\t        \"calls\": producer.calls,\n166\t    }\n167\t    (out / \"run-record.json\").write_bytes(canonical_json_bytes(run_record))\n168\t    (out / \"score.json\").write_bytes(canonical_json_bytes(reference_set.score(out / \"run\", root)))\n169\t    return run_record\n170\t\n171\t\n172\tdef main(argv: list[str] | None = None) -> int:\n173\t    parser = argparse.ArgumentParser(description=__doc__)\n174\t    parser.add_argument(\"--out\", type=Path, required=True)\n175\t    parser.add_argument(\"--root\", type=Path, default=reference_set.ROOT)\n176\t    args = parser.parse_args(argv)\n177\t    summary = record(args.out, args.root)\n178\t    print(json.dumps(summary[\"budget\"]), json.dumps(summary[\"reading\"]))\n179\t    return 0\n180\t\n181\t\n182\tif __name__ == \"__main__\":\n183\t    sys.exit(main())"}
{"role":"tool","tool_call_id":"tool_aEXTpcpC2dbVRmx2lMIoN80Q","content":"1\t\"\"\"A labelled reference set for the reading stages, and its scorer.\n2\t\n3\tThe set is an overlay on the literature regression corpus: the twelve\n4\tdevelopment documents as sectioned sources, the corpus model as JSON, and\n5\tthe answer key's gold facts as labels. ``build_root`` writes it from the\n6\tpackaged corpus, which it never changes. ``score`` compares a reading run's\n7\tproduced facts with the labels. The rule is in ``reference_fixture/README.md``.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport argparse\n12\timport sys\n13\timport unicodedata\n14\tfrom collections import Counter\n15\tfrom pathlib import Path\n16\t\n17\tfrom gnd.artifacts import canonical_json_bytes, read_regular_bounded\n18\tfrom gnd.model import parse_model_document\n19\t\n20\tfrom .depth import ExampleError, _decode\n21\t\n22\tHERE = Path(__file__).resolve().parent\n23\tROOT = HERE / \"reference_fixture\"\n24\tLABELS_FORMAT = \"literature-reference-labels/1\"\n25\tSCORE_FORMAT = \"literature-reference-score/1\"\n26\tSOURCE_VERSION = \"corpus-1\"\n27\tPRODUCER_LABEL = \"claude-sonnet-5-5\"\n28\tQUESTION_FACT = \"method_builds_on_method\"\n29\tMODEL = \"corpus.orm.json\"\n30\tSTAGE_PAYLOADS = ((\"broad\", \"payload-1.json\"), (\"targeted\", \"payload-3.json\"))\n31\tREAD_LIMIT = 1 << 20\n32\tLICENCE = (\"Synthetic paraphrases of public works, written for this repository's regression tests; \"\n33\t           \"no document is the text of its work (see the corpus README).\")\n34\t\n35\t\n36\tdef _json(path: Path) -> dict:\n37\t    return _decode(read_regular_bounded(path.parent, path.name, max_bytes=READ_LIMIT)[0], max_bytes=READ_LIMIT)\n38\t\n39\t\n40\tdef _section_id(passage: str) -> str:\n41\t    document, _, number = passage.rpartition(\".\")\n42\t    if not document or not number.startswith(\"p\") or not number[1:].isdigit():\n43\t        raise ExampleError(f\"unexpected corpus passage id {passage!r}\")\n44\t    return f\"{document}-{number}\"\n45\t\n46\t\n47\tdef _byte_offset(text: str, index: int) -> int:\n48\t    return len(text[:index].encode(\"utf-8\"))\n49\t\n50\t\n51\tdef build(corpus_root: Path = HERE) -> dict[str, bytes]:\n52\t    \"\"\"The reference root's files, by name, built from the packaged corpus.\"\"\"\n53\t    corpus = _json(corpus_root / \"corpus\" / \"corpus.json\")\n54\t    key = _json(corpus_root / \"answers\" / \"answer-key.json\")\n55\t    model_path = corpus_root / \"model.orm.yaml\"\n56\t    model = parse_model_document(read_regular_bounded(corpus_root, model_path.name, max_bytes=READ_LIMIT)[0],\n57\t                                 source=model_path)\n58\t    documents = [row for row in corpus[\"documents\"] if row[\"split\"] == \"dev\"]\n59\t    files: dict[str, bytes] = {MODEL: canonical_json_bytes(model)}\n60\t    sources, sections, questions, section_of = [], [], [], {}\n61\t    for document in documents:\n62\t        raw = read_regular_bounded(corpus_root, document[\"path\"], max_bytes=READ_LIMIT)[0]\n63\t        text = unicodedata.normalize(\"NFC\", raw.decode(\"utf-8\"))\n64\t        if text.encode(\"utf-8\") != raw:\n65\t            raise ExampleError(f\"corpus document {document['id']} is not NFC\")\n66\t        name = document[\"id\"]\n67\t        files[f\"{name}.txt\"] = raw\n68\t        sources.append({\"id\": name, \"version\": SOURCE_VERSION, \"path\": f\"{name}.txt\",\n69\t                        \"sha256\": document[\"sha256\"]})\n70\t        passages = [row for row in corpus[\"passages\"] if row[\"document\"] == name]\n71\t        for index, passage in enumerate(passages):\n72\t            section = _section_id(passage[\"id\"])\n73\t            section_of[passage[\"id\"]] = section\n74\t            start = 0 if index == 0 else _byte_offset(text, passage[\"span\"][\"start\"])\n75\t            end = _byte_offset(text, passage[\"span\"][\"end\"])\n76\t            sections.append({\"id\": section, \"source\": name, \"kind\": \"section\",\n77\t                             \"selection\": \"opening\" if index == 0 else \"targeted\", \"keys\": [],\n78\t                             \"span\": [start, end], \"reason\": None})\n79\t            if index:\n80\t                questions.append({\"id\": f\"q-{section}\", \"section\": section, \"fact\": QUESTION_FACT,\n81\t                                  \"required\": False, \"superseded_by\": None, \"denial\": False})\n82\t    files[\"roster.json\"] = canonical_json_bytes({\n83\t        \"format\": \"literature-reading-roster/1\", \"sources\": sources, \"sections\": sections,\n84\t        \"questions\": questions, \"revisit_keys\": [],\n85\t    })\n86\t    files[\"profile.json\"] = canonical_json_bytes({\n87\t        \"format\": \"literature-reading-profile/1\", \"model\": MODEL, \"includes\": [], \"producer_label\": PRODUCER_LABEL,\n88\t        \"base_facts\": {}, \"review\": False, \"calibration\": None, \"conflict\": None, \"absence\": False,\n89\t    })\n90\t    anchored: dict[tuple, set] = {}\n91\t    for row in key[\"anchored_facts\"]:\n92\t        fact = row[\"fact\"]\n93\t        identity = (fact[\"fact_type\"], tuple(sorted(fact[\"roles\"].items())))\n94\t        anchored.setdefault(identity, set()).add(section_of[row[\"passage\"]])\n95\t    derived = {row[\"id\"] for row in model[\"fact_types\"] if row.get(\"derivation\") is not None}\n96\t    labels = []\n97\t    for document in documents:\n98\t        gold = _json(corpus_root / \"answers\" / \"gold\" / f\"{document['id']}.population.json\")\n99\t        for fact_type in sorted(set(gold[\"facts\"]) - derived):\n100\t            for roles in gold[\"facts\"][fact_type]:\n101\t                identity = (fact_type, tuple(sorted(roles.items())))\n102\t                labels.append({\"document\": document[\"id\"], \"fact_type\": fact_type, \"roles\": roles,\n103\t                               \"sections\": sorted(anchored.get(identity, ()))})\n104\t    counts = Counter(label[\"fact_type\"] for label in labels)\n105\t    files[\"labels.json\"] = canonical_json_bytes({\n106\t        \"format\": LABELS_FORMAT, \"corpus_sha256\": key[\"corpus_sha256\"], \"licence\": LICENCE,\n107\t        \"derived_fact_types_left_out\": sorted(derived),\n108\t        \"counts\": dict(sorted(counts.items())), \"facts\": labels,\n109\t    })\n110\t    return files\n111\t\n112\t\n113\tdef build_root(out: Path, corpus_root: Path = HERE) -> None:\n114\t    \"\"\"Write the reference root's built files into ``out``.\"\"\"\n115\t    out.mkdir(parents=True, exist_ok=False)\n116\t    for name, raw in build(corpus_root).items():\n117\t        (out / name).write_bytes(raw)\n118\t\n119\t\n120\tdef _normal(value: object) -> str:\n121\t    if not isinstance(value, str):\n122\t        raise ExampleError(\"a scored role value is not a string\")\n123\t    return \" \".join(unicodedata.normalize(\"NFC\", value).casefold().split())\n124\t\n125\t\n126\tdef _values(roles: dict) -> tuple:\n127\t    return tuple(sorted((name, _normal(value)) for name, value in roles.items()))\n128\t\n129\t\n130\tdef _attempts(run: Path, payload: str) -> list[dict]:\n131\t    rows = _json(run / payload).get(\"attempts\")\n132\t    if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):\n133\t        raise ExampleError(f\"{payload} has no attempts list\")\n134\t    return rows\n135\t\n136\t\n137\tdef score(run: Path, root: Path = ROOT) -> dict:\n138\t    \"\"\"Score a reading run over the reference root against its labels.\"\"\"\n139\t    labels = _json(root / \"labels.json\")\n140\t    if labels.get(\"format\") != LABELS_FORMAT or not isinstance(labels.get(\"facts\"), list):\n141\t        raise ExampleError(\"invalid reference labels\")\n142\t    roster = _json(root / \"roster.json\")\n143\t    sections = {row[\"id\"]: row[\"source\"] for row in roster[\"sections\"]}\n144\t    gold = []\n145\t    for index, fact in enumerate(labels[\"facts\"]):\n146\t        scope = set(fact[\"sections\"]) or {name for name, source in sections.items() if source == fact[\"document\"]}\n147\t        gold.append((index, fact[\"fact_type\"], _values(fact[\"roles\"]), scope))\n148\t    found: set[int] = set()\n149\t    stages, recall = {}, {}\n150\t    for stage, payload in STAGE_PAYLOADS:\n151\t        produced = hit = wrong = outside = 0\n152\t        for attempt in _attempts(run, payload):\n153\t            section, response = attempt.get(\"section\"), attempt.get(\"response\")\n154\t            facts = response.get(\"facts\") if isinstance(response, dict) else None\n155\t            if not isinstance(section, str) or section not in sections or not isinstance(facts, dict):\n156\t                raise ExampleError(\"a scored attempt names no known section or facts\")\n157\t            for fact_type, rows in facts.items():\n158\t                if not isinstance(rows, list):\n159\t                    raise ExampleError(\"scored facts are not a list\")\n160\t                for row in rows:\n161\t                    if not isinstance(row, dict):\n162\t                        raise ExampleError(\"a scored fact row is not an object\")\n163\t                    produced += 1\n164\t                    values = _values(row)\n165\t                    in_scope = [g for g in gold if section in g[3]]\n166\t                    match = [g[0] for g in in_scope if g[1] == fact_type and g[2] == values]\n167\t                    if match:\n168\t                        hit += 1\n169\t                        found.update(match)\n170\t                    elif any(g[1] != fact_type and sorted(v for _, v in g[2]) == sorted(v for _, v in values)\n171\t                             for g in in_scope):\n172\t                        wrong += 1\n173\t                    if not in_scope:\n174\t                        outside += 1\n175\t        stages[stage] = {\"produced\": produced, \"found\": hit, \"wrong_predicate\": wrong,\n176\t                         \"outside_gold_scope\": outside, \"precision\": [hit, produced]}\n177\t        recall[stage] = [len(found), len(gold)]\n178\t    return {\"format\": SCORE_FORMAT, \"gold_facts\": len(gold), \"stages\": stages, \"recall_after\": recall}\n179\t\n180\t\n181\tdef main(argv: list[str] | None = None) -> int:\n182\t    parser = argparse.ArgumentParser(description=__doc__)\n183\t    commands = parser.add_subparsers(dest=\"command\", required=True)\n184\t    built = commands.add_parser(\"build\", help=\"write the reference root's built files\")\n185\t    built.add_argument(\"--out\", type=Path, required=True)\n186\t    scored = commands.add_parser(\"score\", help=\"score a reading run over the reference root\")\n187\t    scored.add_argument(\"run\", type=Path)\n188\t    scored.add_argument(\"--root\", type=Path, default=ROOT)\n189\t    args = parser.parse_args(argv)\n190\t    try:\n191\t        if args.command == \"build\":\n192\t            build_root(args.out)\n193\t        else:\n194\t            sys.stdout.buffer.write(canonical_json_bytes(score(args.run, args.root)) + b\"\\n\")\n195\t    except (ExampleError, OSError) as error:\n196\t        print(f\"error: {error}\", file=sys.stderr)\n197\t        return 3\n198\t    return 0\n199\t\n200\t\n201\tif __name__ == \"__main__\":\n202\t    raise SystemExit(main())"}

n379\t        f\"a verify payload must never carry a rate-shaped key (R-03″); \"\n380\t        f\"found {sorted(overlap)}\"\n381\t    )\n382\t\n383\t\n384\t# --- the payload contract ---\n385\t\n386\t\n387\tdef test_verify_payload_validates_against_report_schema(\n388\t    validator: Draft202012Validator, tmp_path: Path\n389\t) -> None:\n390\t    \"\"\"Every verify exit path emits a payload that validates against\n391\t    ``report.schema.json`` with ``command == \"verify\"`` — the exact sweep\n392\t    ``test_report_json.py`` runs for check/validate, extended to verify.\"\"\"\n393\t    pop = _write_population(tmp_path, _conforming_population())\n394\t    orphan = _write_population("}
+{"role":"tool","tool_call_id":"tool_GPw4xeJZzrxbTtIDuGS38uGj","content":"95\tLX2_FLATTENING_EDGE = (\n96\t    'gnd-export/references/witness-contract.md',\n97\t    '../../gnd-orm-core/references/representation-format.md#extraction-flattening-record',\n98\t)\n99\t\n100\t\n101\tdef test_every_relative_skill_link_resolves_inside_the_resource_tree() -> None:\n102\t    root = _skills_root()\n103\t    assert root.is_dir(), 'gnd/skills resource directory is absent (see the sibling test)'\n104\t    entries = {rel for rel, _ in iter_skill_files(root)}\n105\t    directories = set()\n106\t    for rel in entries:\n107\t        parts = rel.split('/')\n108\t        for depth in range(1, len(parts)):\n109\t            directories.add('/'.join(parts[:depth]))\n110\t    checked = 0\n111\t    edges: set[tuple[str, str]] = set()\n112\t    unresolved: list[str] = []\n113\t    for rel, resource in iter_skill_files(root):\n114\t        if not rel.endswith('.md'):\n115\t            continue\n116\t        parent = posixpath.dirname(rel)\n117\t        for match in RELATIVE_LINK_RE.finditer(resource.read_bytes()):\n118\t            target = match.group(1).decode('utf-8')\n119\t            checked += 1\n120\t            edges.add((rel, target))\n121\t            target_path = target.partition('#')[0]\n122\t            resolved = posixpath.normpath(posixpath.join(parent, target_path))\n123\t            if resolved not in entries and resolved not in directories:\n124\t                unresolved.append(f'{rel} -> {target} (resolved: {resolved})')\n125\t    assert not unresolved, 'cross-skill relative links point nowhere:\\n  ' + '\\n  '.join(unresolved)\n126\t    expected = GC4_RELATIVE_LINKS | {LX2_FLATTENING_EDGE}\n127\t    missing = sorted(expected - edges)\n128\t    extra = sorted(edges - expected)\n129\t    assert not missing and (not extra), f'the skill routing graph is not the pinned inventory.\\n  missing ({len(missing)}): ' + ', '.join((f'{s} -> {t}' for s, t in missing)) + f'\\n  extr
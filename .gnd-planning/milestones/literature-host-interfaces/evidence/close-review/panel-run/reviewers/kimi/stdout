\n134\t    assert {frozenset(row) for row in coverage} == {frozenset(row) for row in packaged_coverage}\n135\t    for name, raw in _files(out).items():\n136\t        for word in PACKAGED_NAMES:\n137\t            assert word.encode() not in raw, (name, word)\n138\t\n139\t\n140\tdef test_t2_calls_carry_the_section_bytes(plain):\n141\t    _, report, producer = plain\n142\t    roster = json.loads((CALLER / \"roster.json\").read_bytes())\n143\t    sections = {row[\"id\"]: row for row in roster[\"sections\"]}\n144\t    attempts = {row[\"section\"]: row for row in report[\"inspections\"]}\n145\t    for call in producer.seen:\n146\t        document = (CALLER / f\"{call.source}.txt\").read_bytes()\n147\t        start, end = sections[call.section][\"span\"]\n148\t        assert call.excerpt == document[start:end]\n149\t        assert call.excerpt_sha256 == sha256_hex(call.excerpt) == attempts[call.section][\"excerpt_sha256\"]\n150\t    seen = {stage: sum(call.stage == stage for call in producer.seen)\n151\t            for stage in (\"broad-extraction\", \"targeted-extraction\")}\n152\t    assert report[\"producer_calls\"] == seen\n153\t    method = next(call for call in producer.seen if call.section == \"a-methods\")\n154\t    assert {question[\"id\"] for question in method.questions} == {\"a-method\", \"a-baseline\"}\n155\t\n156\t\n157\tdef test_t3_live_responses_and_receipts_are_retained(tmp_path):\n158\t    root = _root(tmp_path, profile=_profile(review=True))\n159\t    out = tmp_path / \"run\"\n160\t    reading.run(out, fixture=root, producer=Producer(), reviewer=Reviewer())\n161\t    manifest = json.loads((out / \"run.json\").read_bytes())\n162\t    table = json.loads((out / \"producer-output-table.json\").read_bytes())\n163\t    assert table == {name: ANSWERS[name] for name in table}\n164\t    assert set(table) == {\"a-opening\", \"a-methods\", \"a-results\", \"b-opening\", \"b-methods\"}\n165\t    receipts = json.loads((out / \"reviews.json\").read_bytes())\n166\t    a
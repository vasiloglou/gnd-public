   297	    return {item["id"]: {role["role_name"] for role in item["roles"]} for item in model.get("fact_types", [])
   298	            if any(role["object_type"] == assertion for role in item["roles"])}
   299	
   300	
   301	def project_shaped(subject: Any, targets: Any, model: dict, shape: Any, max_rows: int = MAX_ROWS, *,
   302	                   requirements: list[dict] | None = None) -> tuple[dict, dict]:
   303	    """Admit the assertions of a caller-named entity type, with every attached and followed row they keep."""
   304	    assertion, follow = _shape(shape)
   305	    kinds = {item["id"]: item["kind"] for item in model.get("object_types", [])}
   306	    if kinds.get(assertion) != "entity":
   307	        raise Refusal("shape:unknown-assertion")
   308	    if any(kinds.get(name) != "entity" for name in follow):
   309	        raise Refusal("shape:unknown-follow")
   310	    fact_types = model.get("fact_types", [])
   311	    if any(item.get("objectified_as") == assertion for item in fact_types):
   312	        raise Refusal("shape:objectified-assertion")
   313	    roles = {item["id"]: [(role["role_name"], role["object_type"]) for role in item["roles"]] for item in fact_types}
   314	    attached = [name for name, pairs in roles.items() if any(kind == assertion for _, kind in pairs)]
   315	    if not attached:
   316	        raise Refusal("shape:no-attached-facts")
   317	    followed = set(follow)
   318	    attached_names = set(attached)
   319	    covers = [name for name, pairs in roles.items()
   320	              if name in attached_names or any(kind in followed for _, kind in pairs)]
   321	    if not isinstance(subject, dict) or not isinstance(subject.get("population"), dict):
   322	        raise Refusal("input:invalid-contextual-population")
   323	    facts = subject.get("facts")
   324	    if not isinstance(facts, dict):
   325	        raise Refusal("input:invalid-contextual-population")
   326	    rows = {}
   327	    for name in covers:
   328	        value = facts.get(name, [])
   329	        names = {role for role, _ in roles[name]}
   330	        if not isinstance(value, list) or not all(isinstance(row, dict) and set(row) == names for row in value):
   331	            raise Refusal("input:invalid-contextual-population")
   332	        rows[name] = value
   333	    if sum(map(len, rows.values())) > max_rows:
   334	        raise Refusal("input:row-cap")
   335	    if not isinstance(targets, list) or len(targets) > MAX_TARGETS:
   336	        raise Refusal("judgments:invalid-result")
   337	    seen, by_assertion, order, owned = set(), {}, {}, {}
   338	    holders = {name: [role for role, kind in roles[name] if kind == assertion] for name in covers}
   339	    for name in attached:
   340	        for row in rows[name]:
   341	            for role in holders[name]:
   342	                key = _identity(row[role])
   343	                order.setdefault(key, (len(order), row[role]))
   344	                owned.setdefault((key, name), []).append(row)
   345	    for item in targets:
   346	        if not isinstance(item, dict) or item.get("fact_type") not in roles:
   347	            raise Refusal("judgments:invalid-result")
   348	        name, index, judgments = item["fact_type"], item.get("index"), item.get("judgments")
   349	        if name not in attached_names:
   350	            raise Refusal("judgments:target-outside-shape")
   351	        if (type(index) is not int or not 0 <= index < len(rows[name]) or (name, index) in seen
   352	                or type(item.get("admitted")) is not bool or not isinstance(judgments, list) or len(judgments) > 32
   353	                or not all(isinstance(j, dict) and j.get("verdict") in ("approve", "reject", "abstain", "missing")
   354	                           for j in judgments)):
   355	            raise Refusal("judgments:invalid-result")
   356	        seen.add((name, index))
   357	        for role in holders[name]:
   358	            by_assertion.setdefault(_identity(rows[name][index][role]), []).append(item)
   359	    reasons, policy = {}, {}
   360	    for key in sorted(order, key=lambda item: order[item][0]):
   361	        found = by_assertion.get(key)
   362	        reasons[key] = "missing" if not found else next(
   363	            (reason for reason in map(_target_reason, found) if reason is not None), None)
   364	        if reasons[key] is None and requirements is not None:
   365	            policy[key] = _evaluate_rules(requirements, lambda name, key=key: owned.get((key, name), []))
   366	    admitted = {key for key, reason in reasons.items() if reason is None and policy.get(key) is None}
   367	    index = {}
   368	    for name in covers:
   369	        for position, row in enumerate(rows[name]):
   370	            for role, kind in roles[name]:
   371	                if kind in followed:
   372	                    index.setdefault((kind, _identity(row[role])), []).append((name, position))
   373	    kept, queue = set(), deque()
   374	
   375	    def keep(name, position):
   376	        row = rows[name][position]
   377	        if (name, position) in kept or any(_identity(row[role]) not in admitted for role in holders[name]):
   378	            return
   379	        kept.add((name, position))
   380	        queue.extend((kind, _identity(row[role])) for role, kind in roles[name] if kind in followed)
   381	
   382	    for name in attached:
   383	        for position in range(len(rows[name])):
   384	            keep(name, position)
   385	    visited = set()
   386	    while queue:
   387	        instance = queue.popleft()
   388	        if instance in visited:
   389	            continue
   390	        visited.add(instance)
   391	        for name, position in index.get(instance, ()):
   392	            keep(name, position)
   393	    population = {
   394	        **({"format_version": subject["format_version"]} if "format_version" in subject else {}),
   395	        "population": {**subject["population"], "source": "tool-output", "producer": SHAPED_SCHEMA, "covers": covers},
   396	        "instances": {},
   397	        "facts": {name: [row for position, row in enumerate(rows[name]) if (name, position) in kept] for name in covers},
   398	    }
   399	    stages = {"semantic-support": [{"assertion": order[key][1], "status": "pass" if reason is None else "fail",
   400	                                    "reason": reason} for key, reason in reasons.items()]}
   401	    if requirements is not None:
   402	        stages["admission-rules"] = [
   403	            {"assertion": order[key][1], "status": "fail", "reason": reason} if reason is not None
   404	            else {"assertion": order[key][1], "status": "pass" if policy[key] is None else "policy-refused",
   405	                  "reason": policy[key]}
   406	            for key, reason in reasons.items()]
   407	    return population, stages
   408	
   409	
   410	def _judgments(snapshots: dict[str, bytes], trusted_root: Path) -> tuple[dict, bytes]:
   411	    """Run the standard judgment route with the immutable input snapshot."""
   412	    with tempfile.TemporaryDirectory(prefix="gnd-assertions-") as folder:
   413	        cwd = Path(folder).resolve()
   414	        for name, raw in snapshots.items():
   415	            (cwd / name).parent.mkdir(parents=True, exist_ok=True)
   416	            (cwd / name).write_bytes(raw)
   417	        argv = (sys.executable, "-m", "gnd", "judgments", "check", MODEL, RAW,
   418	                "--policy", POLICY, "--receipts", RECEIPTS, "--trusted-root", str(trusted_root.absolute()),
   419	                "--format", "json")
   420	        environment = ({} if DISCLOSURE_ENV not in os.environ else {DISCLOSURE_ENV: os.environ[DISCLOSURE_ENV]})
   421	        done = asyncio.run(run_bounded_process(argv, cwd=cwd, env=environment, limits=LIMITS,
   422	                                               disclosed_names=frozenset({DISCLOSURE_ENV})))
   423	    if done.return_code not in (0, 1) or done.stdout_truncated or not done.process_group_cleaned:
   424	        raise Refusal("judgments:refused")
   425	    report = strict_json(done.stdout, max_bytes=REPORT_CAP, too_large="judgments:report-cap")
   426	    if (not isinstance(report, dict) or report.get("command") != "judgments"
   427	            or type(report.get("outcome")) is not int or report["outcome"] != done.return_code
   428	            or report.get("error") is not None or not isinstance(report.get("judgment_policy"), dict)):
   429	        raise Refusal("judgments:invalid-result")
   430	    judgment = report["judgment_policy"]
   431	    if judgment.get("verification_contract") != "consumer-pinned-bytes-v1":
   432	        raise Refusal("judgments:consumer-pins-required")
   433	    _verify_report_inputs(judgment, snapshots)
   434	    return judgment, done.stdout
   435	
   436	
   437	def _verify_report_inputs(judgment: dict, snapshots: dict[str, bytes]) -> None:
   438	    policy = strict_json(snapshots[POLICY], max_bytes=1 << 20, too_large="input:policy-cap")
   439	    receipt_bytes = snapshots[RECEIPTS]
   440	    receipts = strict_json(receipt_bytes, max_bytes=CAP, too_large="input:receipt-cap")
   441	    if not receipts["receipts"]:
   442	        receipt_bytes = canonical_json_bytes({"schema_version": 1, "receipts": []})
   443	    targets = judgment.get("targets")
   444	    if (judgment.get("policy_sha256") != sha256_hex(snapshots[POLICY])
   445	            or judgment.get("receipts_sha256") != sha256_hex(receipt_bytes)
   446	            or not isinstance(targets, list)
   447	            or not all(isinstance(item, dict) for item in targets)
   448	            or [{"fact_type": item.get("fact_type"), "index": item.get("index")} for item in targets] != policy["targets"]):
   449	        raise Refusal("judgments:binding-mismatch")
   450	
   451	
   452	def admit(model: Path, raw: Path, policy: Path, receipts: Path, trusted_root: Path, out: Path, *,
   453	          shape: dict | None = None, rules: dict | None = None, max_targets: int | None = None,
   454	          max_rows: int | None = None) -> dict:
   455	    """Check saved opinion bytes, project supported rows and publish one bound result.
   456	
   457	    With ``shape`` (``{"format": SHAPE_FORMAT, "assertion": ENTITY, "follow": [ENTITY, ...]}``) the
   458	    assertions are the instances of a caller-named entity type, identified by their own handle, and a
   459	    ``literature-assertion-admission/2`` record is written; without it, the packaged shape. ``rules``
   460	    (``literature-admission-rules/1``) replace the packaged comparison, and ``max_targets`` (1 to 1,024)
   461	    lowers the target cap; either one also writes ``/2``.
   462	    """
   463	    out = out.absolute()
   464	    if out.exists() or out.is_symlink():
   465	        raise Refusal("output:exists")
   466	    if shape is None and max_rows is not None:
   467	        raise Refusal("input:max-rows")
   468	    if shape is not None:
   469	        _shape(shape)
   470	    rows_cap = _max_rows(max_rows)
   471	    if max_targets is not None and (type(max_targets) is not int or not 1 <= max_targets <= MAX_TARGETS):
   472	        raise Refusal("input:max-targets")
   473	    shaped = any(value is not None for value in (shape, rules, max_targets, max_rows))
   474	    try:
   475	        snapshots = {
   476	            name: read_regular_path(path, label=name, max_bytes=(1 << 20) if name == POLICY else CAP)
   477	            for name, path in ((MODEL, model), (RAW, raw), (POLICY, policy), (RECEIPTS, receipts))
   478	        }
   479	    except (ArtifactError, OSError) as error:
   480	        if shape is None:
   481	            raise
   482	        raise Refusal("input:read") from error
   483	    includes = {}
   484	    if shape is not None:
   485	        base = Path(model).absolute().parent
   486	        try:
   487	            includes = {path: read_regular_path(base / path, label="include", max_bytes=CAP)
   488	                        for path in _include_paths(snapshots[MODEL])}
   489	        except (ArtifactError, OSError) as error:
   490	            raise Refusal("input:include-read") from error
   491	    document = _model_document(snapshots, includes) if shape is not None else None
   492	    requirements = None
   493	    if rules is not None:
   494	        allowed = {STATEMENT: ROLES} if shape is None else _attached_roles(document, shape)
   495	        requirements = _rules(rules, allowed)
   496	    if max_targets is not None:
   497	        targets = strict_json(snapshots[POLICY], max_bytes=1 << 20, too_large="input:policy-cap")
   498	        if not isinstance(targets, dict) or not isinstance(targets.get("targets"), list) \
   499	                or len(targets["targets"]) > max_targets:
   500	            raise Refusal("input:max-targets")
   501	    judgment, report_raw = _judgments({**snapshots, **includes}, trusted_root)
   502	    subject = strict_json(snapshots[RAW], max_bytes=CAP, too_large="input:population-cap")
   503	    if shape is None:
   504	        population, stages = project(subject, judgment.get("targets"), requirements=requirements,
   505	                                     policy_status="policy-refused" if shaped else "fail")
   506	    else:
   507	        population, stages = project_shaped(subject, judgment.get("targets"), document, shape, rows_cap,
   508	                                            requirements=requirements)
   509	    admitted_raw = canonical_json_bytes(population)
   510	    record = {
   511	        "schema": SCHEMA, "model_sha256": sha256_hex(snapshots[MODEL]), "raw_sha256": sha256_hex(snapshots[RAW]),
   512	        "policy_sha256": sha256_hex(snapshots[POLICY]), "receipts_sha256": sha256_hex(snapshots[RECEIPTS]),
   513	        "judgment_report_sha256": sha256_hex(report_raw), "admitted_sha256": sha256_hex(admitted_raw), "stages": stages,
   514	    }
   515	    if shaped:
   516	        record.update({
   517	            "schema": SHAPED_SCHEMA, "includes": {path: sha256_hex(raw) for path, raw in includes.items()},
   518	            "shape": "packaged" if shape is None else "caller",
   519	            "shape_sha256": None if shape is None else sha256_hex(canonical_json_bytes(shape)),
   520	            "rules_sha256": None if rules is None else sha256_hex(canonical_json_bytes(rules)),
   521	            "max_targets": MAX_TARGETS if max_targets is None else max_targets,
   522	            "max_rows": None if shape is None else rows_cap,
   523	        })
   524	    publish_directory_once(
   525	        out.parent, out.name, {RAW: snapshots[RAW], REPORT: report_raw, ADMITTED: admitted_raw,
   526	                               RECORD: canonical_json_bytes(record)},
   527	        manifest_name=RECORD, max_file_bytes=REPORT_CAP, max_total_bytes=4 * REPORT_CAP,
   528	    )
   529	    return record
   530	
   531	
   532	def main(argv: list[str] | None = None) -> int:
   533	    parser = argparse.ArgumentParser(description=__doc__)
   534	    for label in ("model", "raw", "policy", "receipts", "trusted_root"):
   535	        parser.add_argument(label, type=Path)
   536	    parser.add_argument("--out", required=True, type=Path)
   537	    args = parser.parse_args(argv)
   538	    try:
   539	        admit(args.model, args.raw, args.policy, args.receipts, args.trusted_root, args.out)
   540	    except Refusal as error:
   541	        print(json.dumps({"exit_code": 3, "reason": error.reason}))
   542	        return 3
   543	    except (ArtifactError, OSError, ValueError, UnicodeError, RecursionError):
   544	        print(json.dumps({"exit_code": 3, "reason": "input-or-output:invalid"}))
   545	        return 3
   546	    print(json.dumps({"exit_code": 0}))
   547	    return 0
   548	
   549	
   550	if __name__ == "__main__":
   551	    raise SystemExit(main())


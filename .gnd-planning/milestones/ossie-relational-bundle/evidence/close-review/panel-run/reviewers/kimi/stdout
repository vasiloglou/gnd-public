{"role":"tool","tool_call_id":"tool_8U8rdOvQNuhtUP5MNE9mnYcA","content":"1\t\"\"\"Build the Ossie semantic model and mapping that accompany an exported ontology.\n2\t\n3\tThe normative rules have one home: \"Semantic model and mapping\" under \"Ossie\n4\tinterchange\" in ``gnd-orm-core/references/representation-format.md``. This module\n5\tturns a :class:`gnd.rmap.RelationalSchema` into an Ossie core-spec semantic model,\n6\tand maps the ontology's concepts and relationships onto it. It builds documents\n7\tonly; :func:`gnd.export.ossie.render_ossie` encodes and binds them.\n8\t\n9\tNothing here refuses a model. A fact type the relational layer cannot express is\n10\tlisted in the mapping's ``GND`` extension with a closed reason.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport itertools\n16\tfrom collections.abc import Callable, Mapping, Sequence\n17\tfrom dataclasses import dataclass\n18\tfrom functools import lru_cache\n19\tfrom importlib.resources import files\n20\tfrom typing import Any\n21\t\n22\tfrom jsonschema import Draft202012Validator\n23\tfrom referencing import Registry, Resource\n24\tfrom referencing.jsonschema import DRAFT202012\n25\t\n26\tfrom gnd.artifacts import canonical_json_bytes\n27\tfrom gnd.input_policy import loads\n28\tfrom gnd.rmap import Disposition, Identification, RelationalSchema, RolePlacement\n29\t\n30\t__all__ = [\n31\t    \"DATATYPES\",\n32\t    \"EXTENSION_SCHEMA\",\n33\t    \"MAX_LINK_ARITY\",\n34\t    \"OntologyView\",\n35\t    \"build_mapping\",\n36\t    \"build_semantic_model\",\n37\t    \"extension_data\",\n38\t    \"validate_relational\",\n39\t]\n40\t\n41\tVERSION = \"0.3.0.dev0\"\n42\tVENDOR = \"GND\"\n43\tEXTENSION_SCHEMA = \"gnd-ossie-relational/1\"\n44\t_UPSTREAM = \"https://raw.githubusercontent.com/apache/ossie/main/\"\n45\t\n46\t#: A link mapping nests one level per role. A fact type with more roles than this is\n47\t#: listed, not nested: the bound keeps every mapping document shallow enough for a\n48\t#: recursive reader, whatever arity the model admits.\n49\tMAX_LINK_ARITY = 32\n50\t\n51\t#: GND value primitive -> Ossie core-spec data type (OB3 E6). ``Opaque`` keeps the\n52\t#: primitive in the field's ``GND`` extension.\n53\tDATATYPES: dict[str, str] = {\n54\t    \"String\": \"String\",\n55\t    \"Integer\": \"Integer\",\n56\t    \"Float\": \"Float\",\n57\t    \"Boolean\": \"Boolean\",\n58\t    \"Date\": \"Date\",\n59\t    \"DateTime\": \"DateTime\",\n60\t    \"Number\": \"Decimal\",\n61\t    \"Binary\": \"Opaque\",\n62\t    \"Duration\": \"Opaque\",\n63\t}\n64\t\n65\t\n66\t@dataclass(frozen=True)\n67\tclass OntologyView:\n68\t    \"\"\"What the mapping reads from the ontology the same export run built.\n69\t\n70\t    ``identification`` gives, per object type id, how the ontology identifies it:\n71\t    ``(\"simple\", relationship)`` or ``(\"composite\", (relationship, ...))`` in\n72\t    ``identify_by`` order. ``relations`` gives, per fact type id, the concept that\n73\t    owns its relationship and its roles in the relationship's order.\n74\t    \"\"\"\n75\t\n76\t    name: str\n77\t    concepts: Mapping[str, str]  # object type id -> concept, in component order\n78\t    kinds: Mapping[str, str]  # object type id -> \"entity\" | \"value\"\n79\t    identification: Mapping[str, tuple[str, Any]]\n80\t    relations: Mapping[str, tuple[str, tuple[str, ...], Mapping[str, str]]]\n81\t\n82\t\n83\tdef extension_data(payload: Any) -> str:\n84\t    \"\"\"An extension's ``data``: canonical JSON without its trailing newline.\"\"\"\n85\t    return canonical_json_bytes(payload).decode(\"utf-8\").removesuffix(\"\\n\")\n86\t\n87\t\n88\t#: ASCII punctuation that cannot stand in an unquoted identifier: all of it but ``$`` and ``_``.\n89\t_NOT_IN_REGULAR = frozenset(\"!\\\"#%&'()*+,-./:;<=>?@[\\\\]^`{|}~\")\n90\t#: The two words Ossie's reader never takes as an unquoted name, in any case.\n91\t_NEVER_REGULAR = frozenset({\"NOT\", \"SELECT\"})\n92\t\n93\t\n94\tdef is_regular_identifier(name: str) -> bool:\n95\t    \"\"\"Whether Ossie reads NAME as a regular identifier, one that can be written unquoted.\n96\t\n97\t    Ossie compares a regular identifier by its uppercased form and keeps any other\n98\t    name exactly as written (core-spec expression_language.md, \"normalized\n99\t    identifier\"). The class is the pinned validator's, measured over every character\n100\t    (OB5): no white space, no ASCII punctuation but ``$`` and ``_``, no leading ASCII\n101\t    digit, and not the word NOT or SELECT.\n102\t    \"\"\"\n103\t    return (\n104\t        bool(name)\n105\t        and name[0] not in \"0123456789\"\n106\t        and not any(character.isspace() or character in _NOT_IN_REGULAR for character in name)\n107\t        and name.upper() not in _NEVER_REGULAR\n108\t    )\n109\t\n110\t\n111\tdef _quoted(identifier: str) -> str:\n112\t    \"\"\"One SQL identifier, quoted, in Ossie's normalized form: a regular identifier\n113\t    uppercased, so that it never reads as a keyword (OB3 E5), and any other name as\n114\t    written, which is the only form that names it (OB5).\"\"\"\n115\t    name = identifier.upper() if is_regular_identifier(identifier) else identifier\n116\t    return '\"' + name.replace('\"', '\"\"') + '\"'\n117\t\n118\t\n119\tdef _extension(payload: Any) -> list[dict[str, str]]:\n120\t    return [{\"vendor_name\": VENDOR, \"data\": extension_data(payload)}]\n121\t\n122\t\n123\tdef build_semantic_model(\n124\t    schema: RelationalSchema, name: str,\n125\t    *, physical: Mapping[tuple[str, str], tuple[str | None, str | None]] | None = None,\n126\t) -> dict[str, Any]:\n127\t    \"\"\"One dataset per table, one field per column, one relationship per foreign key.\n128\t\n129\t    ``physical`` is given for a delivered schema (a physical binding): per\n130\t    (table, column), the Ossie data type or None, and the raw SQL type or None.\n131\t    \"\"\"\n132\t    datasets = []\n133\t    relationships = []\n134\t    for table in schema.tables:\n135\t        dataset: dict[str, Any] = {\"name\": table.name, \"source\": table.name}\n136\t        if table.primary_key:\n137\t            dataset[\"primary_key\"] = list(table.primary_key)\n138\t        if table.unique_keys:\n139\t            dataset[\"unique_keys\"] = [list(key) for key in table.unique_keys]\n140\t        fields = []\n141\t        for column in table.columns:\n142\t            field: dict[str, Any] = {\"name\": column.name, \"expression\": {\"sql\": _quoted(column.name)}}\n143\t            if physical is not None:\n144\t                datatype, sql_type = physical[(table.name, column.name)]\n145\t                if datatype is not None:\n146\t                    field[\"datatype\"] = datatype\n147\t                if sql_type is not None:\n148\t                    field[\"custom_extensions\"] = _extension({\"sql_type\": sql_type})\n149\t            elif column.datatype is not None:\n150\t                field[\"datatype\"] = DATATYPES[column.datatype]\n151\t                if field[\"datatype\"] == \"Opaque\":\n152\t                    field[\"custom_extensions\"] = _extension({\"gnd_primitive\": column.datatype})\n153\t            fields.append(field)\n154\t        dataset[\"fields\"] = fields\n155\t        dataset[\"custom_extensions\"] = _extension({\"source_kind\": \"logical\" if physical is None else \"physical\"})\n156\t        datasets.append(dataset)\n157\t        relationships += [\n158\t            {\n159\t                \"name\": key.name,\n160\t                \"from\": table.name,\n161\t                \"to\": key.target_table,\n162\t                \"from_columns\": list(key.columns),\n163\t                \"to_columns\": list(key.target_columns),\n164\t            }\n165\t            for key in table.foreign_keys\n166\t        ]\n167\t    document: dict[str, Any] = {\"version\": VERSION, \"name\": name, \"datasets\": datasets}\n168\t    if relationships:\n169\t        document[\"relationships\"] = relationships\n170\t    return document\n171\t\n172\t\n173\tclass _Mapping:\n174\t    def __init__(self, schema: RelationalSchema, view: OntologyView) -> None:\n175\t        self.view = view\n176\t        self.tables = {table.name for table in schema.tables}\n177\t        self.identifications: dict[str, Identification] = {i.object_type: i for i in schema.identifications}\n178\t        self.placements: dict[tuple[str, str], RolePlacement] = {(p.fact_type, p.role): p for p in schema.roles}\n179\t\n180\t    def referents(\n181\t        self, object_type: str, table: str, columns: Sequence[str], wrap: Callable[[str], str]\n182\t    ) -> list[dict[str, Any]] | None:\n183\t        \"\"\"Referent mappings that find one object of an entity type from ``columns`` of\n184\t        ``table``, or None when the ontology does not identify it as the Rmap does.\"\"\"\n185\t        rmap = self.identifications.get(object_type)\n186\t        ontology = self.view.identification.get(object_type)\n187\t        if rmap is None or ontology is None or len(columns) != len(rmap.columns):\n188\t            return None\n189\t        form, payload = ontology\n190\t        if rmap.kind == \"direct\" and form == \"simple\":\n191\t            return [{\"relationship\": payload, \"expression\": wrap(self.reference(table, columns[0]))}]\n192\t        if rmap.kind != \"composite\" or form != \"composite\":\n193\t            return None\n194\t        by_fact: dict[str, tuple[str, list[str]]] = {}\n195\t        for column, component in zip(columns, rmap.components):\n196\t            assert component is not None\n197\t            by_fact.setdefault(component[0], (component[1], []))[1].append(column)\n198\t        if set(by_fact) != set(payload):\n199\t            return None\n200\t        result = []\n201\t        for relationship in payload:  # the ontology's identify_by order\n202\t            role, held = by_fact[relationship]\n203\t            player = self.view.relations[relationship][2][role]\n204\t            if self.view.kinds[player] == \"value\":\n205\t                result.append({\"relationship\": relationship, \"expression\": wrap(self.reference(table, held[0]))})\n206\t                continue\n207\t            nested = self.referents(player, table, held, wrap)\n208\t            if nested is None:\n209\t                return None\n210\t            result.append({\"relationship\": relationship, \"referent_mappings\": nested})\n211\t        return result\n212\t\n213\t    @staticmethod\n214\t    def reference(table: str, column: str) -> str:\n215\t        return f\"{_quoted(table)}.{_quoted(column)}\"\n216\t\n217\t    def object_mapping(\n218\t        self, object_type: str, table: str, columns: Sequence[str], *,\n219\t        named: bool, wrap: Callable[[str], str] = str,\n220\t    ) -> dict[str, Any] | None:\n221\t        \"\"\"How ``columns`` of ``table`` give one object of ``object_type``.\"\"\"\n222\t        node: dict[str, Any] = {\"concept\": self.view.concepts[object_type]} if named else {}\n223\t        if self.view.kinds[object_type] == \"value\":\n224\t            if len(columns) != 1:\n225\t                return None\n226\t            node[\"expression\"] = wrap(self.reference(table, columns[0]))\n227\t            return node\n228\t        referents = self.referents(object_type, table, columns, wrap)\n229\t        if referents is None:\n230\t            return None\n231\t        if self.identifications[object_type].kind == \"direct\":\n232\t            node[\"expression\"] = referents[0][\"expression\"]\n233\t        else:\n234\t            node[\"referent_mappings\"] = referents\n235\t        return node\n236\t\n237\t    def link_tree(self, fact_type: str) -> dict[str, Any] | str:\n238\t        \"\"\"One tree per fact type: a node per role in the relationship's order, the\n239\t        last one naming the relationship. Otherwise the reason there is no tree.\"\"\"\n240\t        _, order, players = self.view.relations[fact_type]\n241\t        if len(order) > MAX_LINK_ARITY:\n242\t            return \"arity-over-limit\"\n243\t        # A unary stored as a Boolean flag: a row is a link only where the flag is true.\n244\t        first = self.placements[(fact_type, order[0])]\n245\t        flag = self.reference(first.table, first.flag) if first.flag is not None else None\n246\t\n247\t        def wrap(expression: str) -> str:\n248\t            return expression if flag is None else f\"CASE WHEN {flag} THEN {expression} END\"\n249\t\n250\t        nodes = []\n251\t        for level, role in enumerate(order):\n252\t            placement = self.placements[(fact_type, role)]\n253\t            node = self.object_mapping(\n254\t                players[role], placement.table, placement.columns, named=level > 0, wrap=wrap)\n255\t            if node is None:\n256\t                return \"identification-differs\"\n257\t            nodes.append({\"object_mapping\": node})\n258\t        nodes[-1][\"relationship\"] = fact_type\n259\t        for parent, child in itertools.pairwise(nodes):\n260\t            parent[\"children\"] = [child]\n261\t        return nodes[0]\n262\t\n263\t\n264\tdef build_mapping(\n265\t    schema: RelationalSchema,\n266\t    dispositions: Sequence[Disposition],\n267\t    view: OntologyView,\n268\t    *,\n269\t    name: str,\n270\t    ontology_iri: str,\n271\t    semantic_model_name: str,\n272\t    semantic_model_iri: str,\n273\t    bindings: Mapping[str, str],\n274\t    extra: Mapping[str, Any] | None = None,\n275\t) -> dict[str, Any]:\n276\t    \"\"\"Map the ontology's concepts and relationships onto the semantic model.\n277\t\n278\t    ``bindings`` are the digests and identity the ``GND`` extension carries. Every\n279\t    disposition is listed there, so a reader can check from the file alone that each\n280\t    fact type and constraint is carried or has a reason.\n281\t    \"\"\"\n282\t    mapper = _Mapping(schema, view)\n283\t    trees: dict[str, list[dict[str, Any]]] = {}\n284\t    unmapped_links = []\n285\t    carried = {d.id for d in dispositions if d.kind == \"fact_type\" and d.reason is None}\n286\t    for fact_type, (owner, _order, _players) in view.relations.items():  # the ontology's relationship order\n287\t        if fact_type not in carried:\n288\t            continue\n289\t        tree = mapper.link_tree(fact_type)\n290\t        if isinstance(tree, str):\n291\t            unmapped_links.append({\"fact_type\": fact_type, \"reason\": tree})\n292\t        else:\n293\t            trees.setdefault(owner, []).append(tree)\n294\t\n295\t    concept_mappings = []\n296\t    concepts = []\n297\t    for object_type, concept in view.concepts.items():\n298\t        entry: dict[str, Any] = {\"concept\": concept}\n299\t        identification = mapper.identifications.get(object_type)\n300\t        table = identification.table if identification is not None else None\n301\t        if view.kinds[object_type] == \"entity\" and table is not None:\n302\t            if identification.absorbed:\n303\t                concepts.append({\"concept\": concept, \"reason\": \"subtype-absorbed\"})\n304\t            else:\n305\t                node = mapper.object_mapping(object_type, table, identification.columns, named=False)\n306\t                if node is None:\n307\t                    concepts.append({\"concept\": concept, \"reason\": \"identification-differs\"})\n308\t                else:\n309\t                    entry[\"object_mappings\"] = [node]\n310\t        if object_type in trees:\n311\t            entry[\"link_mappings\"] = trees[object_type]\n312\t        if len(entry) > 1:\n313\t            concept_mappings.append(entry)\n314\t\n315\t    payload: dict[str, Any] = {\n316\t        \"schema\": EXTENSION_SCHEMA,\n317\t        **bindings,\n318\t        **({\"rmap_variant\": schema.variant.value} if schema.variant is not None else {}),\n319\t        \"dispositions\": [\n320\t            {\"kind\": d.kind, \"id\": d.id, \"carried_as\": list(d.carried_as), \"reason\": d.reason}\n321\t            for d in dispositions\n322\t        ],\n323\t        \"concepts\": concepts,\n324\t        **(extra or {}),\n325\t    }\n326\t    if unmapped_links:\n327\t        payload[\"unmapped_links\"] = sorted(unmapped_links, key=lambda row: row[\"fact_type\"])\n328\t    return {\n329\t        \"version\": VERSION,\n330\t        \"name\": name,\n331\t        \"ontology_ref\": {\"name\": view.name, \"iri\": ontology_iri},\n332\t        \"semantic_model_ref\": {\"name\": semantic_model_name, \"iri\": semantic_model_iri},\n333\t        \"concept_mappings\": concept_mappings,\n334\t        \"custom_extensions\": _extension(payload),\n335\t    }\n336\t\n337\t\n338\t@lru_cache(maxsize=1)\n339\tdef _validators() -> tuple[Draft202012Validator, Draft202012Validator]:\n340\t    root = files(\"gnd\").joinpath(\"schema\", \"ossie\")\n341\t    core = loads(root.joinpath(\"core-spec.json\").read_bytes())\n342\t    ontology = loads(root.joinpath(\"ontology.json\").read_bytes())\n343\t    mapping = loads(root.joinpath(\"mapping.json\").read_bytes())\n344\t    # The pinned schemas reference each other through upstream URLs. Registry() refuses\n345\t    # any retrieval that is not registered here, so validation never opens a connection.\n346\t    registry = Registry().with_resources([\n347\t        (_UPSTREAM + \"core-spec/ossie-schema.json\", Resource.from_contents(core, default_specification=DRAFT202012)),\n348\t        (_UPSTREAM + \"ontology/ontology.json\", Resource.from_contents(ontology, default_specification=DRAFT202012)),\n349\t    ])\n350\t    return Draft202012Validator(core, registry=registry), Draft202012Validator(mapping, registry=registry)\n351\t\n352\t\n353\tdef validate_relational(semantic_model: Mapping[str, Any], mapping: Mapping[str, Any]) -> None:\n354\t    \"\"\"Check both documents against the pinned schemas; a failure is a renderer defect.\"\"\"\n355\t    semantic_validator, mapping_validator = _validators()\n356\t    semantic_validator.validate(semantic_model)\n357\t    mapping_validator.validate(mapping)"}

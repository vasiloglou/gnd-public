      - { type: mandatory, role: movie, source: explicit, status: confirmed, modality: alethic, provenance: { csdp_step: 5, dialogue_turn: 24, user_quote: "Yes." } }

  - id: movie_directed_by_director
    reading: "{Movie} directed by {Director}"

   225	
   226	def _parsers() -> dict[tuple[str, ...], Any]:
   227	    import test_rf1_cli_pins as pins
   228	
   229	    with pytest.MonkeyPatch.context() as monkeypatch:
   230	        found: dict[str, Any] = {}
   231	        pins._walk(pins._root(monkeypatch), ("gnd",), found)
   232	    return {tuple(path.split()[1:]): parser for path, parser in found.items()}
   233	
   234	
   235	def _actions(parser: Any) -> dict[str, Any]:
   236	    return {option: action for action in parser._actions for option in action.option_strings}
   237	
   238	
   239	def _invocations(text: str) -> list[str]:
   240	    """Every code span and every fenced line, whitespace-normalized (a span may wrap)."""
   241	    fenced = [line for block in _FENCE.findall(text) for line in block.splitlines()]
   242	    unfenced = _FENCE.sub("", text)
   243	    return [" ".join(chunk.split()) for chunk in (*_CODE_SPAN.findall(unfenced), *fenced) if chunk.strip()]
   244	
   245	
   246	def _option_problems(span: str, words: list[str], actions: dict[str, Any]) -> list[str]:
   247	    problems = []
   248	    for index, word in enumerate(words):
   249	        if not word.startswith("--"):
   250	            continue
   251	        action = actions.get(word)
   252	        if action is None:
   253	            problems.append(f"{span}: unknown option {word}")
   254	            continue
   255	        value = words[index + 1] if index + 1 < len(words) else None
   256	        # A value the reference spells literally (lowercase, not a placeholder) must be one the option accepts.
   257	        if action.choices is not None and value is not None and value.islower() and value not in action.choices:
   258	            problems.append(f"{span}: {word} does not accept {value}")
   259	    return problems
   260	
   261	
   262	def _drift(text: str) -> list[str]:
   263	    """Every `gnd ...` invocation whose command, options or literal choices do not exist, and every
   264	    bare option that none of the driven commands has."""
   265	    parsers = _parsers()
   266	    known = {option: action for command in _COMMANDS for option, action in _actions(parsers[command]).items()}
   267	    problems = []
   268	    for span in _invocations(text):
   269	        words = span.split()
   270	        if words[:1] == ["gnd"]:
   271	            command = next((key for key in (tuple(words[1:3]), tuple(words[1:2])) if key in parsers), None)
   272	            if command is None:
   273	                problems.append(f"no such command: {span}")
   274	                continue
   275	            problems += _option_problems(span, words, _actions(parsers[command]))
   276	        elif words[0].startswith("--"):
   277	            problems += _option_problems(span, words, known)
   278	    return problems

+@pytest.fixture(scope='module')
+def published_0_4_0(tmp_path_factory):
+    python, env = published_wheel(tmp_path_factory, '0.4.0')
+    assert gnd(python, [], env, python.parent, '--version', expected=0).stdout.strip() == 'gnd 0.4.0'
+    return python, env

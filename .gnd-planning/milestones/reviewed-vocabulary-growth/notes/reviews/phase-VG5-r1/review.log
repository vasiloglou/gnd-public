def _enforce_d12(before: dict[str, Any], candidate: dict[str, Any]) -> None:
    before_hosted = [
        (host, canonical_json_text(item), item) for host, item in _constraints(before, hosted=True)
    ]
    before_counts = Counter(rendered for _, rendered, _ in before_hosted)
    candidates = [
        (host, canonical_json_text(item), item) for host, item in _constraints(candidate, hosted=True)
    ]
    # IK2: the proposed induced constraints a reviewed status change may claim
    # are those left over once every unchanged candidate copy has consumed its
    # exact match, so two candidates can never confirm one predecessor and an
    # unchanged copy can never be confirmed a second time. A claim is keyed by
    # the predecessor's host, so confirmation cannot also move the rule to
    # another fact type or the top level (review R3). Computed up front so the
    # single in-order pass below keeps every pre-IK2 refusal order.
    leftover = before_counts - Counter(rendered for _, rendered, _ in candidates)
    claimable: Counter[tuple[str | None, str]] = Counter()
    for host, rendered, item in before_hosted:
        if (
            leftover[rendered]
            and item.get("source") == "induced"
            and item.get("status") == "proposed"
        ):
            leftover[rendered] -= 1
            claimable[(host, canonical_json_text(_without_review(item)))] += 1

    for host, rendered, constraint in candidates:
        if _contains_audit_key(constraint.get("provenance", {})):
            raise EvolutionError(
                "operation audit actor/origin/time fields cannot enter constraint provenance"
            )
        if before_counts[rendered]:
            before_counts[rendered] -= 1
            continue

        source = constraint.get("source")
        status = constraint.get("status")
        modality = constraint.get("modality")
        provenance = constraint.get("provenance")
        if not isinstance(provenance, dict):
            provenance = {}
        if source != "induced" and "induction" in provenance:
            raise EvolutionError("provenance.induction is allowed only under source induced (D-12)")
        if source == "induced":
            if (status, modality) == ("proposed", "deontic"):
                if "reviewed_in" in provenance:
                    raise EvolutionError(
                        "new induced constraints cannot carry provenance.reviewed_in (D-12)"
                    )
                continue
            if status == "confirmed":
                reviewed_in = provenance.get("reviewed_in")
                predecessor = (host, canonical_json_text(_without_review(constraint)))
                if isinstance(reviewed_in, str) and reviewed_in.strip() and claimable[predecessor]:
                    claimable[predecessor] -= 1
                    continue
                raise EvolutionError(
                    "induced constraints become confirmed only as a reviewed status change "
                    "of an existing proposed induced constraint (D-12)"
                )
            raise EvolutionError("new induced constraints must be proposed/deontic (D-12)")
        if source == "llm-inferred":
            if (status, modality) != ("proposed", "deontic"):
                raise EvolutionError(
                    "new llm-inferred constraints must remain proposed/deontic (D-12)"
                )
        elif source in ("sample", "common-sense"):
            # VG2 (issue 218): row evidence and library evidence, as the growth
            # document has the host write them; never confirmed, never alethic.
            if (status, modality) != ("proposed", "deontic"):
                raise EvolutionError(
                    "new sample and common-sense constraints must be proposed/deontic (D-12)"
                )
        elif source == "user-supplied":
            if status != "confirmed":
                raise EvolutionError(
                    "owner-approved user-supplied constraints must be confirmed (D-12)"
                )
        else:
            raise EvolutionError(
                "new or changed constraints must be llm-inferred/proposed/deontic "
                "or user-supplied/confirmed (D-12)"
            )


def _json_ready(value: Any) -> Any:
"""MG5 unattended source mode (model-growth-guardrails milestone).

A separate home inside the ``gnd.model`` package so ``_validation`` stays under
its RF6 size ceiling. ``_rule_unattended`` is registered last in
``gnd.model._validation._SEMANTIC_RULES`` and ``unattended_span_issues`` is
re-exported by ``gnd.model``. ``_validation`` registers its constraint and
provenance walks here at import time, so this module never imports
``_validation`` back.

One rule family, one walk (MG-R2). Gated on ``source.mode: unattended``, so no
model without the mode gains or loses an issue (MG-R1). The rule table is
normative in gnd-orm-core/references/representation-format.md ("Unattended
source").
"""

from __future__ import annotations

import hashlib
import re
from collections.abc import Callable, Iterator, Mapping
from contextvars import ContextVar
from dataclasses import dataclass
from typing import Any, Literal

from gnd.errors import ValidationIssue

#: The shared walks and the element label, registered by
#: ``gnd.model._validation`` once they are defined. This home never imports
#: ``_validation``: even a per-call import is a runtime edge, and the two
#: would form the cycle the RF8 graph check forbids.
_constraint_walk: Callable[[dict[str, Any]], Iterator[tuple[str, dict[str, Any]]]] | None = None
_provenance_walk: Callable[[dict[str, Any]], Iterator[tuple[str, dict[str, Any]]]] | None = None
_provenance_label: Callable[[dict[str, Any]], str] | None = None


def _iter_constraints(doc: dict[str, Any]):
    if _constraint_walk is None:
        raise RuntimeError("gnd.model._validation has not registered the constraint walk")
    return _constraint_walk(doc)


def _iter_provenance_bearing(doc: dict[str, Any]):
    if _provenance_walk is None:
        raise RuntimeError("gnd.model._validation has not registered the provenance walk")
    return _provenance_walk(doc)


def _provenance_bearing_label(element: dict[str, Any]) -> str:
    if _provenance_label is None:
        raise RuntimeError("gnd.model._validation has not registered the provenance label")
    return _provenance_label(element)


UNATTENDED_MODE = "unattended"
_SHA256_HEX = re.compile(r"[0-9a-f]{64}")  # always fullmatch: `$` admits a trailing newline (review R-F1)
_SPAN_KEYS = frozenset({"document_sha256", "start", "end", "excerpt_sha256"})
_UNATTENDED_SPANLESS_SOURCE = "common-sense"
_UNATTENDED_INDUCED_SOURCE = "induced"
_UNATTENDED_ALETHIC_SOURCES = ("sample", "llm-inferred", "common-sense", "induced")

#: VG3: ``id()`` of the composed document's elements whose origin is an
#: include, set by ``gnd.model._model_warnings`` around ``semantic_validate``
#: and by nothing else (``gnd.model._includes.included_rows`` computes it).
#: Every other caller sees the empty set, and so today's rules.
_INCLUDED: ContextVar[frozenset[int]] = ContextVar("gnd_unattended_included", default=frozenset())


def _declared_spans(owner: Any, declared: set[str], *, samples: bool) -> Iterator[tuple[str, Any]]:
    """(suffix, span) for each span an included element carries over a document the root declares.

    D14 (a): such a span is the root's business and keeps U7's shape check;
    any other span an included element carries is read by no rule.
    """
    provenance = owner.get("provenance") if isinstance(owner, Mapping) else None
    if not isinstance(provenance, Mapping):
        return
    for index, span in enumerate(_listed(provenance.get("spans"))):
        if isinstance(span, Mapping) and isinstance(span.get("document_sha256"), str) \
                and span["document_sha256"] in declared:
            yield f".provenance.spans[{index}]", span
    # Sample spans belong to fact types, the one place the span walk visits them
    # (VG3 review r1, F1).
    for index, entry in enumerate(_listed(provenance.get("sample_spans")) if samples else []):
        span = entry.get("span") if isinstance(entry, Mapping) else None
        if isinstance(span, Mapping) and isinstance(span.get("document_sha256"), str) \
                and span["document_sha256"] in declared:
            yield f".provenance.sample_spans[{index}].span", span


def _unattended_source(doc: dict[str, Any]) -> dict[str, Any] | None:
    source = doc.get("source")
    if isinstance(source, Mapping) and source.get("mode") == UNATTENDED_MODE:
        return dict(source)
    return None


def _listed(value: Any) -> list[Any]:
    """A collection the rule may walk: a list, else nothing (review R-F14)."""
    return value if isinstance(value, list) else []


def _is_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _declared_documents(source: dict[str, Any], issues: list[ValidationIssue], *, rule_id: str,
                        first_document_pending: bool = False) -> set[str]:
    def issue(path: str, message: str) -> None:
        issues.append(ValidationIssue(path=path, message=message, rule_id=rule_id))



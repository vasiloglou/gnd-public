{"role":"tool","tool_call_id":"tool_vRQ7qzwxkiRsl8RtqRUBDJhF","content":"1\tfrom __future__ import annotations\n2\t\n3\timport gnd.export.verification_service as _handler_export_verification_service\n4\tfrom gnd.commands._arguments import _add_format_argument, _add_unredacted_argument\n5\t\n6\t\n7\tdef _register_verify(subparsers):\n8\t    verify_parser = subparsers.add_parser(\n9\t        \"verify\",\n10\t        help=\"run the full derived verifier over a pre-extracted population (VER-01, VER-02)\",\n11\t        description=(\n12\t            \"Run the full derived verifier: popvalidate then check over a \"\n13\t            \"PRE-EXTRACTED population file. This command never calls a model \"\n14\t            \"and never orchestrates extraction (R-03''): the executing agent \"\n15\t            \"running the gnd-extract skill writes the population and its \"\n16\t            \"<population>.extraction.json sidecar, and verify validates the \"\n17\t            \"handoff before composing the checker. Exit bands are REUSED \"\n18\t            \"unchanged with precedence 3 > 1 > 4 > 2 > 0: 3 ill-formed \"\n19\t            \"(including an ill-formed extraction handoff), 1 alethic fail, 4 \"\n20\t            \"indeterminate, 2 vacuous, 0 pass. The payload's extraction block \"\n21\t            \"carries the machine-readable state (ran | skipped | failed + \"\n22\t            \"reason); a missing sidecar is extraction:sidecar-missing, a \"\n23\t            \"malformed one extraction:sidecar-invalid, and a digest that does \"\n24\t            \"not match the file bytes extraction:binding-mismatch — all exit \"\n25\t            \"3, state failed. skipped is written ONLY by --no-extraction. \"\n26\t            \"Never a fidelity rate in this payload: a checker pass over an \"\n27\t            \"uncalibrated extraction is checker acceptance, not proof of \"\n28\t            \"faithfulness.\"\n29\t        ),\n30\t    )\n31\t    verify_parser.add_argument(\"model\", help=\"path t
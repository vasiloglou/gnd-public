                issues.append(
                    ValidationIssue(
                        path=f"$.object_types[id={object_type_id}].subtype_of",
                        message=(f"'{object_type_id}' declares undeclared supertype '{supertype}'"),
                        rule_id="semantic:subtype-ref",
                    )
                )
    return issues



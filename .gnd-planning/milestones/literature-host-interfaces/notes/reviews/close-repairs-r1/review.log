\"run\"\n729\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden()))\n730\t\n731\t\n732\tdef test_r6_a_correct_saved_receipt_runs(tmp_path):\n733\t    root = _root(tmp_path, profile=_profile(review=True))\n734\t    _saved_review(root)\n735\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Producer(ONLY_TITLE))\n736\t    assert report[\"settings\"][\"reviewer\"] == \"saved\"\n737\t\n738\t\n739\t@pytest.mark.parametrize(\"case\", [\"invalid-byte\", \"split-character\"])\n740\tdef test_r7_a_source_that_is_not_utf8_refuses(tmp_path, case):\n741\t    root = _root(tmp_path)\n742\t    path = root / \"survey-a.txt\"\n743\t    if case == \"invalid-byte\":\n744\t        path.write_bytes(b\"\\xff\" + path.read_bytes()[1:])\n745\t    else:\n746\t        path.write_bytes(\"é\".encode() + path.read_bytes()[2:])\n747\t\n748\t    def repin(roster):\n749\t        roster[\"sources\"][0][\"sha256\"] = sha256_hex(path.read_bytes())\n750\t        if case == \"split-character\":\n751\t            roster[\"sections\"][0][\"span\"] = [0, 1]\n752\t\n753\t    _edit(root, \"roster.json\", repin)\n754\t    out = tmp_path / \"run\"\n755\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden()))\n756\t\n757\t\n758\t@pytest.mark.parametrize((\"kind\", \"key\"), [(\"questions\", \"superseded_by\"), (\"sections\", \"selection\"),\n759\t                                           (\"sources\", \"version\"), (\"sections\", \"reason\")])\n760\tdef test_r8_a_roster_row_missing_a_key_refuses(tmp_path, kind, key):\n761\t    root = _root(tmp_path)\n762\t    _edit(root, \"roster.json\", lambda roster: roster[kind][-1].pop(key))\n763\t    out = tmp_path / \"run\"\n764\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden()))\n765\t\n766\t\n767\tdef test_r9_the_retained_ceiling_is_the_json_read_cap():\n768\t    from gnd import input_policy\n769\t\n770\t    assert reading.LIMIT_CEILINGS[\"retained_bytes\"] == input_policy.MAX_BYTES\n771\t    with pytest.raises(ValueError):\n772\t        input_policy.loads(b\"[\" + b\" \" * input_policy.MAX_BYTES + b\"]\")"}

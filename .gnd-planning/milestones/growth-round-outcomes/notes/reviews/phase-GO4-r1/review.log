   383	def additive_policy_issues(
   384	    before: Model,
   385	    proposal: EvolutionProposal,
   386	    *,
   387	    populated: frozenset[str],
   388	    population_outcomes: Mapping[int, str] | None = None,
   389	) -> tuple[PolicyIssue, ...]:
   390	    """Every operation the additive policy refuses, in proposal order.
   391	
   392	    ``before`` is the current model; ``populated`` is ``effective_populated``'s
   393	    result. Operations on the ``operations`` collection are the operations
   394	    gate's (exit 18) and are admitted here. The policy walks the proposal once
   395	    and never reads a population.
   396	
   397	    ``population_outcomes`` (UG2, ``--check-population``) maps an operation
   398	    index to the population check's outcome word. ``None`` is the policy as
   399	    before. Otherwise a populated-constraint refusal is cleared when the
   400	    constraint after the operation is ``proposed`` and ``deontic``, a MODIFY
   401	    only strengthens, and the outcome is ``pass``; every other refusal gains a
   402	    ``; population: <outcome>`` (or ``not eligible``) suffix.
   403	    """

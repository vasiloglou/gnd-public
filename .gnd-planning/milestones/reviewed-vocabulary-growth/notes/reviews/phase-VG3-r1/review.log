    assert definition["required"] == ["document_sha256", "start", "end", "excerpt_sha256"]
    assert definition["additionalProperties"] is False
    exit_code, rule_ids, _payload = _validate(_doc(), tmp_path)
    assert (exit_code, rule_ids) == (0, [])



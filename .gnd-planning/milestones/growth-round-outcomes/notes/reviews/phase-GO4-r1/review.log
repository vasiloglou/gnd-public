    33	def _span(raw: bytes, quote: str, occurrence: int | None = None) -> dict[str, Any]:
    34	    """The host's job: locate a verbatim quote in the NFC text; refuse a missing or ambiguous one."""
    35	    text = unicodedata.normalize("NFC", raw.decode("utf-8"))
    36	    starts = [m.start() for m in re.finditer(re.escape(quote), text)]
    37	    if occurrence is None:
    38	        assert len(starts) == 1, f"quote {quote!r} must occur exactly once, found {len(starts)}"
    39	        start = starts[0]
    40	    else:
    41	        start = starts[occurrence]
    42	    end = start + len(quote)
    43	    return {
    44	        "document_sha256": hashlib.sha256(raw).hexdigest(),
    45	        "start": start,
    46	        "end": end,
    47	        "excerpt_sha256": hashlib.sha256(text[start:end].encode("utf-8")).hexdigest(),
    48	    }
    49	

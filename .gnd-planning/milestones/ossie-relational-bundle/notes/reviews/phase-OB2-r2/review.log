   166	    # -- identification -------------------------------------------------------------
   167	
   168	    def primitive(self, value_type: str) -> str | None:
   169	        if value_type not in self._primitive:
   170	            self._primitive[value_type] = primitive_for(value_type, self.objects, variant="strict")
   171	        return self._primitive[value_type]
   172	
   173	    def identity(self, oid: str) -> tuple[str, Any]:
   174	        if oid not in self._identity:
   175	            obj = self.objects.get(oid, {})
   176	            if obj.get("kind") == "value":
   177	                self._identity[oid] = ("value", oid)
   178	            elif (obj.get("reference") or {}).get("mode") == "unit-based":
   179	                self._identity[oid] = ("unit", oid)  # A3: before refscheme
   180	            elif (direct := self.index.reference_value_types().get(oid)) is not None:
   181	                # ModelIndex's documented cache of gnd.universe's reference resolver:
   182	                # one walk per model instead of one per entity.
   183	                self._identity[oid] = ("direct", direct)
   184	            elif oid in self.identifiers:
   185	                # The preferred, confirmed alethic external uniqueness anchored on oid
   186	                # (review r1 F1: never the first one declared, never a deontic one).
   187	                _, refs = self.identifiers[oid]
   188	                self._identity[oid] = ("composite", [
   189	                    {"fact_type": fact, "role": role, "object_type": self.role_players[fact][role]}
   190	                    for fact, role in refs
   191	                ])
   192	            else:
   193	                self._identity[oid] = ("unmatchable", oid)
   194	        return self._identity[oid]
   195	
   196	    def refs(self, constraint: dict[str, Any]) -> list[tuple[str, str]]:
   197	        return [(str(r.get("fact_type")), str(r.get("role"))) for r in constraint.get("role_refs") or ()]
   198	
   199	    def anchor(self, refs: list[tuple[str, str]]) -> str | None:
   200	        """The one object type every referenced binary's other role is played by, else None."""
   201	        anchors = set()
   202	        for fact_type, role in refs:
   203	            players = self.role_players.get(fact_type, {})
   204	            if len(players) != 2 or role not in players:
   205	                return None
   206	            anchors.update(player for name, player in players.items() if name != role)
   207	        return next(iter(anchors)) if len(anchors) == 1 else None
   208	
   209	    def key(self, oid: str) -> _Key | None:
   210	        """Key columns of an object type, or None when its identification is unmatchable."""
   211	        if oid in self._keys:
   212	            return self._keys[oid]
   213	        self._keys[oid] = None  # a re-entrant request is unmatchable
   214	        kind, payload = self.identity(oid)
   215	        result: _Key | None
   216	        if kind == "value":
   217	            result = _Key([oid], [self.primitive(oid)], [("reference", oid)], [None])
   218	        elif kind == "unit":
   219	            result = _Key([f"{oid}_value"], ["Number"], [("reference", oid)], [None])
   220	        elif kind == "direct":
   221	            result = _Key([str(payload)], [self.primitive(str(payload))], [("reference", oid)], [None])
   222	        elif kind == "composite":
   223	            result = _Key([], [], [], [])
   224	            for entry in payload:
   225	                role, player = str(entry["role"]), str(entry["object_type"])
   226	                origin = (str(entry["fact_type"]), role)
   227	                if self.objects.get(player, {}).get("kind") == "value":
   228	                    result.names.append(role)
   229	                    result.datatypes.append(self.primitive(player))
   230	                    result.origins.append(origin)
   231	                    result.components.append(None)
   232	                    continue
   233	                inner = self.key(player) if self.identity(player)[0] != "composite" else None
   234	                if inner is None:  # a composite inside a composite is not resolved
   235	                    result = None
   236	                    break
   237	                for name, datatype in zip(inner.names, inner.datatypes):
   238	                    result.names.append(f"{role}_{name}")
   239	                    result.datatypes.append(datatype)
   240	                    result.origins.append(origin)
   241	                    result.components.append((role, player))
   242	        else:
   243	            result = None
   244	        self._keys[oid] = result
   245	        return result

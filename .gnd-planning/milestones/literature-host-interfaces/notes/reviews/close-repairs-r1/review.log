+{"role":"tool","tool_call_id":"tool_geD9KXyxk7u1c5QhMfy309Lv","content":"1\t\"\"\"Run the three source-scoped literature competency examples offline.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport asyncio\n6\timport sys\n7\tfrom decimal import Decimal\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tfrom gnd.anchors import recognised_ranges, recognition_index, strict_json\n12\tfrom gnd.artifacts import (\n13\t    ArtifactError,\n14\t    canonical_json_bytes,\n15\t    read_regular_bounded,\n16\t    sha256_hex,\n17\t)\n18\tfrom gnd.process import BoundedProcessResult, ProcessLimits, run_bounded_process\n19\t\n20\tFIXTURE = Path(__file__).parent / \"depth_fixture\"\n21\tINPUT_LIMIT = 128 * 1024\n22\tPROCESS_LIMIT = 1 << 20\n23\tPROCESS_LIMITS = ProcessLimits(\n24\t    timeout_seconds=30,\n25\t    terminate_grace_seconds=1,\n26\t    stdin_limit_bytes=0,\n27\t    stdout_limit_bytes=PROCESS_LIMIT,\n28\t    stderr_limit_bytes=INPUT_LIMIT,\n29\t    total_output_limit_bytes=PROCESS_LIMIT,\n30\t)\n31\tCASES = (\"dynamics\", \"molecular\", \"algorithms\")\n32\tCASES_SHA = \"366dee9620694a6037496f51247248e8f937feae04939778b0cfce0d99327d70\"\n33\tSUPPORT_SHA = \"8d697a5a169d6dfa27a0dacb498df9e86bd78f1ffbd5365ea82f38264333ed59\"\n34\tCONTEXT = {\n35\t    \"dataset_version\": \"experiment_dataset\",\n36\t    \"split\": \"experiment_split\",\n37\t    \"metric\": \"experiment_metric\",\n38\t    \"units\": \"experiment_units\",\n39\t    \"conditions\": \"experiment_conditions\",\n40\t}\n41\tRELATIONS = (\"subject_specializes\", \"subject_has_component\", \"subject_influenced_by\")\n42\tEXPERIMENT_FIELDS = {\n43\t    **CONTEXT,\n44\t    \"score\": \"experiment_score\",\n45\t    \"baseline\": \"experiment_baseline\",\n46\t    \"configuration\": \"experiment_configuration\",\n47\t    \"uncertainty\": \"experiment_uncertainty\",\n48\t}\n49\t\n50\t\n51\tclass ExampleError(ValueError):\n52\t    \"\"\"The worked example cannot establish the requested output.\"\"\"\n53\t\n54\t\n55\tdef _read(root: Path, name: str) -> bytes:\n56\t    return read_regular_bounded(root, name, max_bytes=INPUT_LIMIT)[0]\n57\t\n58\t\n59\tdef _decode(data: bytes, *, max_bytes: int = PROCESS_LIMIT) -> dict:\n60\t    try:\n61\t        value = strict_json(data, max_bytes=max_bytes, too_large=\"example JSON exceeds its cap\")\n62\t    except (ValueError, RecursionError) as error:\n63\t        raise ExampleError(\"invalid example JSON\") from error\n64\t    if not isinstance(value, dict):\n65\t        raise ExampleError(\"expected an example JSON object\")\n66\t    return value\n67\t\n68\t\n69\tdef _write(out: Path, name: str, data: Any) -> bytes:\n70\t    raw = canonical_json_bytes(data)\n71\t    (out / name).write_bytes(raw)\n72\t    return raw\n73\t\n74\t\n75\tdef _command(out: Path, *args: str, limits: ProcessLimits = PROCESS_LIMITS) -> BoundedProcessResult:\n76\t    result = asyncio.run(run_bounded_process(\n77\t        (sys.executable, \"-m\", \"gnd\", *args), cwd=out, env={}, limits=limits,\n78\t    ))\n79\t    if (result.status not in {\"succeeded\", \"failed\"} or result.stdout_truncated\n80\t            or result.stderr_truncated or not result.process_group_cleaned):\n81\t        raise ExampleError(f\"{args[0]} failed to finish its bounded run\")\n82\t    return result\n83\t\n84\t\n85\tdef _success(out: Path, *args: str) -> bytes:\n86\t    result = _command(out, *args)\n87\t    if result.return_code != 0:\n88\t        raise ExampleError(f\"{args[0]} exited {result.return_code}\")\n89\t    return result.stdout\n90\t\n91\t\n92\tdef _load_reviewed(fixture: Path, name: str, expected_sha: str) -> dict:\n93\t    raw = _read(fixture, name)\n94\t    document = _decode(raw)\n95\t    if sha256_hex(raw) != expected_sha:\n96\t        raise ExampleError(f\"reviewed {name} binding differs\")\n97\t    return document\n98\t\n99\t\n100\tdef _fact_rows(facts: dict) -> None:\n101\t    if not all(\n102\t        isinstance(rows, list) and all(\n103\t            isinstance(row, dict) and all(isinstance(value, str) for value in row.values())\n104\t            for row in rows\n105\t        ) for rows in facts.values()\n106\t    ):\n107\t        raise ExampleError(\"invalid example fact rows\")\n108\t\n109\t\n110\tdef _question_rows(case: dict, support: dict, document: bytes, facts: dict) -> list[dict]:\n111\t    if sha256_hex(document) != support[\"document_sha256\"]:\n112\t        raise ExampleError(\"reviewed source document binding differs\")\n113\t    text = document.decode(\"utf-8\")\n114\t    _fact_rows(facts)\n115\t    by_fact = {\n116\t        fact: [row for row in rows if row.get(\"subject\") == case[\"subject\"]]\n117\t        for fact, rows in facts.items()\n118\t    }\n119\t    answers = []\n120\t    for question, evidence in zip(case[\"questions\"], support[\"rows\"], strict=True):\n121\t        if question[\"id\"] != evidence[\"id\"]:\n122\t            raise ExampleError(\"reviewed question roster differs\")\n123\t        primary = evidence[\"primary\"]\n124\t        claimed_locator = {key: value for key, value in primary.items() if key != \"evidence_form\"}\n125\t        if claimed_locator != question[\"primary\"]:\n126\t            raise ExampleError(f\"reviewed primary locator differs for {question['id']}\")\n127\t        start, end = evidence[\"span\"]\n128\t        excerpt = text[start:end]\n129\t        if not (0 <= start < end <= len(text)) or sha256_hex(excerpt.encode()) != evidence[\"span_sha256\"]:\n130\t            raise ExampleError(\"reviewed source span differs\")\n131\t        selected = {fact: by_fact.get(fact, []) for fact in question[\"requires\"]}\n132\t        reviewed = evidence[\"facts\"]\n133\t        for fact, rows in selected.items():\n134\t            if rows and rows != reviewed.get(fact):\n135\t                raise ExampleError(f\"unreviewed facts for {question['id']}\")\n136\t        supported = all(selected.values()) and evidence[\"decision\"] == \"supported\"\n137\t        answers.append({\n138\t            \"id\": question[\"id\"],\n139\t            \"status\": \"supported\" if supported else \"unknown\",\n140\t            \"claim_kind\": question[\"claim_kind\"],\n141\t            \"facts\": selected if supported else {},\n142\t            \"missing\": [fact for fact, rows in selected.items() if not rows],\n143\t            \"evidence\": {\n144\t                **primary,\n145\t                \"review\": evidence[\"decision\"],\n146\t                \"document_sha256\": support[\"document_sha256\"],\n147\t                \"span\": evidence[\"span\"],\n148\t                \"span_sha256\": evidence[\"span_sha256\"],\n149\t                \"excerpt\": excerpt,\n150\t            },\n151\t        })\n152\t    return answers\n153\t\n154\t\n155\tdef _check_case(out: Path, model: str, document: bytes, facts: dict) -> dict:\n156\t    (out / \"document.txt\").write_bytes(document)\n157\t    _success(out, \"extract\", model, \"--out\", \"bundle\")\n158\t    stem = model.removesuffix(\".json\")\n159\t    index_raw = _read(out, f\"bundle/{stem}.artifacts.json\")\n160\t    index = _decode(index_raw)\n161\t    population = \"population.json\"\n162\t    raw = _write(out, population, {\"population\": index[\"header_template\"], \"facts\": facts})\n163\t    sidecar = _write(out, \"population.extraction.json\", {\n164\t        \"schema_version\": 1,\n165\t        \"model\": model,\n166\t        \"model_sha256\": index[\"model\"][\"sha256\"],\n167\t        \"population\": population,\n168\t        \"population_sha256\": sha256_hex(raw),\n169\t        \"document\": \"document.txt\",\n170\t        \"document_sha256\": sha256_hex(document),\n171\t        \"projection_sha256\": index[\"artifacts\"][f\"{stem}.projection.schema.json\"][\"sha256\"],\n172\t        \"skill\": \"gnd-extract\",\n173\t        \"skill_version\": \"1\",\n174\t        \"executing_model\": \"saved-public-fixture\",\n175\t    })\n176\t    verified = _success(out, \"verify\", model, population, \"--artifacts\", \"bundle\", \"--format\", \"json\")\n177\t    checked = _success(out, \"check\", model, population, \"--format\", \"json\")\n178\t    return {\n179\t        \"model_sha256\": index[\"model\"][\"sha256\"],\n180\t        \"population_sha256\": sha256_hex(raw),\n181\t        \"extraction_sha256\": sha256_hex(sidecar),\n182\t        \"bundle_index_sha256\": sha256_hex(index_raw),\n183\t        \"verification\": _decode(verified)[\"outcome\"],\n184\t        \"check\": _decode(checked)[\"outcome\"],\n185\t    }\n186\t\n187\t\n188\tdef compare_scores(left: dict[str, str], right: dict[str, str]) -> tuple[str, list[str]]:\n189\t    \"\"\"Compare scores by the declared evidence context.\"\"\"\n190\t    mismatches = [name for name in CONTEXT if name in left and name in right and left[name] != right[name]]\n191\t    if mismatches:\n192\t        return \"incompatible\", mismatches\n193\t    missing = [name for name in (*CONTEXT, \"score\") if name not in left or name not in right]\n194\t    return (\"unknown\", missing) if missing else (\"comparable\", [])\n195\t\n196\t\n197\tdef _comparison_inputs(raw: bytes) -> tuple[dict, list[dict], dict[str, dict[str, str]]]:\n198\t    fixture = _decode(raw)\n199\t    if (fixture.get(\"origin\") != \"synthetic\" or not isinstance(fixture.get(\"facts\"), dict)\n200\t            or not isinstance(fixture.get(\"pairs\"), list)):\n201\t        raise ExampleError(\"invalid synthetic comparison corpus\")\n202\t    facts, pairs = fixture[\"facts\"], fixture[\"pairs\"]\n203\t    _fact_rows(facts)\n204\t    by_experiment: dict[str, dict[str, str]] = {}\n205\t    for field, fact in EXPERIMENT_FIELDS.items():\n206\t        for row in facts.get(fact, []):\n207\t            if set(row) != {\"experiment\", field}:\n208\t                raise ExampleError(f\"invalid synthetic experiment field {field}\")\n209\t            record = by_experiment.setdefault(row[\"experiment\"], {})\n210\t            if field in record:\n211\t                raise ExampleError(f\"ambiguous synthetic experiment field {field}\")\n212\t            record[field] = row[field]\n213\t    ids = set()\n214\t    for pair in pairs:\n215\t        if (not isinstance(pair, dict) or set(pair) != {\"id\", \"left\", \"right\"}\n216\t                or any(not isinstance(value, str) for value in pair.values())\n217\t                or pair[\"id\"] in ids or pair[\"left\"] not in by_experiment or pair[\"right\"] not in by_experiment):\n218\t            raise ExampleError(\"invalid synthetic comparison pair\")\n219\t        ids.add(pair[\"id\"])\n220\t    return facts, pairs, by_experiment\n221\t\n222\t\n223\tdef _checked_comparisons(out: Path, facts: dict, pairs: list[dict],\n224\t                         experiments: dict[str, dict[str, str]]) -> tuple[list[dict], str]:\n225\t    population = _write(out, \"comparison.population.json\", {\n226\t        \"population\": {\"model\": \"vocabulary.orm.json\", \"source\": \"fixture\"},\n227\t        \"facts\": facts,\n228\t    })\n229\t    _success(out, \"check\", \"vocabulary.orm.json\", \"comparison.population.json\", \"--format\", \"json\")\n230\t    rows = []\n231\t    for pair in pairs:\n232\t        status, fields = compare_scores(experiments[pair[\"left\"]], experiments[pair[\"right\"]])\n233\t        rows.append({**pair, \"origin\": \"synthetic\", \"status\": status, \"fields\": fields})\n234\t    return rows, sha256_hex(population)\n235\t\n236\t\n237\tdef _dimension_probe() -> dict:\n238\t    reported, equivalent, energy = \"2 fs\", \"0.002 ps\", \"2 eV\"\n239\t    text = f\"{reported}\\n{equivalent}\\n{energy}\"\n240\t    index = recognition_index(text, {\"integer\", \"decimal\"})\n241\t    magnitude = int(reported.split()[0])\n242\t    integer_ranges = recognised_ranges(index, \"integer\", magnitude)\n243\t    equivalent_start = len(reported) + 1\n244\t    energy_start = equivalent_start + len(equivalent) + 1\n245\t    equivalent_magnitude = Decimal(equivalent.split()[0])\n246\t    equivalent_range = (equivalent_start, equivalent_start + len(str(equivalent_magnitude)))\n247\t    recognized_equivalent = equivalent_range in recognised_ranges(index, \"decimal\", equivalent_magnitude)\n248\t    normalized_equivalent = equivalent_range in integer_ranges\n249\t    energy_matches = (energy_start, energy_start + len(str(magnitude))) in integer_ranges\n250\t    return {\n251\t        \"axis\": \"dimensions\",\n252\t        \"observed\": {\n253\t            \"time\": {\"reported\": reported, \"equivalent\": equivalent},\n254\t            \"energy\": energy,\n255\t            \"reported_matches_checked_magnitude\": (0, len(str(magnitude))) in integer_ranges,\n256\t            \"equivalent_recognized_as_decimal\": recognized_equivalent,\n257\t            \"equivalent_matches_checked_magnitude\": normalized_equivalent,\n258\t            \"energy_matches_checked_magnitude\": energy_matches,\n259\t        },\n260\t        \"opens_ld2\": not normalized_equivalent or energy_matches,\n261\t        \"requirement\": \"Accept an equivalent time step and refuse the same magnitude in energy units.\",\n262\t    }\n263\t\n264\t\n265\tdef _percentage_probe() -> dict:\n266\t    before, after = Decimal(40), Decimal(45)\n267\t    absolute = after - before\n268\t    relative = (absolute / before * 100).normalize()\n269\t    values = (before, after, relative)\n270\t    text = f\"From {before}% to {after}%: {absolute} percentage points, or a relative change of {relative}%.\"\n271\t    index = recognition_index(text, {\"percent\"})\n272\t    recognized = [value for value in values if recognised_ranges(index, \"percent\", value)]\n273\t    points_as_percent = bool(recognised_ranges(index, \"percent\", absolute))\n274\t    return {\n275\t        \"axis\": \"percent-versus-points\",\n276\t        \"observed\": {\n277\t            \"recognized_percentages\": [float(value) if value % 1 else int(value) for value in recognized],\n278\t            \"absolute_change_points\": str(absolute),\n279\t            \"relative_change_percent\": str(relative),\n280\t            \"points_recognized_as_percent\": points_as_percent,\n281\t        },\n282\t        \"opens_ld2\": recognized != list(values) or points_as_percent,\n283\t        \"requirement\": \"Keep the absolute change in percentage points separate from the relative percent change.\",\n284\t    }\n285\t\n286\t\n287\tdef _decimal_probe(out: Path) -> dict:\n288\t    args = (\"decimal.orm.json\", \"decimal.population.json\")\n289\t    _success(out, \"check\", *args, \"--format\", \"json\")\n290\t    population = _decode(_read(out, args[1]))\n291\t    target = _decode(_read(out, \"decimal.targets.json\"))[\"targets\"][0]\n292\t    checked_value = population[\"facts\"][\"reported_decimal\"][0][\"value\"]\n293\t    cell = target[\"tuple\"][0]\n294\t    if cell[\"value\"] != checked_value:\n295\t        raise ExampleError(\"decimal witness target differs from the checked value\")\n296\t    witness = _command(out, \"witness\", *args, \"--targets\", \"decimal.targets.json\", \"--raw\", \"--out\", \"decimal.witness.json\")\n297\t    result = _decode(witness.stdout)\n298\t    results = result.get(\"results\")\n299\t    observed = {\"primitive\": cell[\"primitive\"], \"checked_value\": str(checked_value)}\n300\t    if witness.return_code == 2 and results and results[0][\"reason\"] == \"fragment-unsupported\":\n301\t        native_exact = False\n302\t        observed.update(exit=2, reason=\"fragment-unsupported\")\n303\t    elif witness.return_code == 0:\n304\t        _success(out, \"replay\", *args, \"decimal.witness.json\", \"--raw\")\n305\t        native_exact = True\n306\t        observed.update(exit=0, replay=\"accepted\")\n307\t    else:\n308\t        raise ExampleError(\"unexpected decimal witness probe outcome\")\n309\t    return {\n310\t        \"axis\": \"exact-decimal-witness\",\n311\t        \"observed\": observed,\n312\t        \"opens_ld2\": not native_exact,\n313\t        \"requirement\": \"Reproduce the checked decimal time step in a witness.\",\n314\t    }\n315\t\n316\t\n317\tdef _subject_occurrence(facts: dict, subject: str) -> tuple[str, dict]:\n318\t    labels = facts.get(\"subject_label\", [])\n319\t    for index, row in enumerate(labels):\n320\t        if row[\"subject\"] == subject:\n321\t            return row[\"subject\"], {\"fact_type\": \"subject_label\", \"fact_index\": index, \"role\": \"subject\"}\n322\t    raise ExampleError(f\"case subject {subject} has no checked label occurrence\")\n323\t\n324\t\n325\tdef build(out: Path, *, fixture: Path = FIXTURE) -> dict:\n326\t    \"\"\"Materialize a fresh packaged run and return its competency report.\"\"\"\n327\t    cases = _load_reviewed(fixture, \"cases.json\", CASES_SHA)\n328\t    evidence = _load_reviewed(fixture, \"support.json\", SUPPORT_SHA)\n329\t    inputs = {\n330\t        case: (_read(fixture, f\"{case}.txt\"), _decode(_read(fixture, f\"{case}.facts.json\")))\n331\t        for case in CASES\n332\t    }\n333\t    answers = {\n334\t        case: _question_rows(cases[case], evidence[case], *inputs[case]) for case in CASES\n335\t    }\n336\t    comparison_facts, pairs, experiments = _comparison_inputs(_read(fixture, \"comparison.json\"))\n337\t    out.mkdir()\n338\t    vocabulary = _read(fixture, \"vocabulary.orm.json\")\n339\t    (out / \"vocabulary.orm.json\").write_bytes(vocabulary)\n340\t    case_outputs = {}\n341\t    for case, (document, facts) in inputs.items():\n342\t        folder = out / case\n343\t        folder.mkdir()\n344\t        (folder / \"vocabulary.orm.json\").write_bytes(vocabulary)\n345\t        (folder / \"root.orm.json\").write_bytes(_read(fixture, f\"{case}.orm.json\"))\n346\t        binding = _check_case(folder, \"root.orm.json\", document, facts)\n347\t        subject, occurrence = _subject_occurrence(facts, cases[case][\"subject\"])\n348\t        case_outputs[case] = {\n349\t            \"subject\": subject,\n350\t            \"subject_occurrence\": occurrence,\n351\t            \"labels\": facts.get(\"subject_label\", []),\n352\t            \"relationships\": {relation: facts[relation] for relation in RELATIONS if relation in facts},\n353\t            \"questions\": answers[case],\n354\t            \"binding\": binding,\n355\t        }\n356\t    comparisons, comparison_sha = _checked_comparisons(out, comparison_facts, pairs, experiments)\n357\t    for suffix in (\"orm\", \"population\", \"targets\"):\n358\t        name = f\"decimal.{suffix}.json\"\n359\t        (out / name).write_bytes(_read(fixture, name))\n360\t    report = {\n361\t        \"format\": \"literature-depth/1\",\n362\t        \"cases\": case_outputs,\n363\t        \"comparisons\": comparisons,\n364\t        \"synthetic_experiments\": experiments,\n365\t        \"synthetic_relationships\": {\n366\t            relation: comparison_facts[relation] for relation in RELATIONS if relation in comparison_facts\n367\t        },\n368\t        \"quantities\": [_dimension_probe(), _percentage_probe(), _decimal_probe(out)],\n369\t        \"bindings\": {\"case_sha256\": CASES_SHA, \"support_sha256\": SUPPORT_SHA,\n370\t                     \"comparison_population_sha256\": comparison_sha},\n371\t    }\n372\t    _write(out, \"report.json\", report)\n373\t    return report\n374\t\n375\t\n376\tdef main(argv: list[str] | None = None) -> int:\n377\t    parser = argparse.ArgumentParser(description=__doc__)\n378\t    parser.add_argument(\"--out\", type=Path, required=True)\n379\t    args = parser.parse_args(argv)\n380\t    try:\n381\t        build(args.out)\n382\t    except (ArtifactError, OSError, ExampleError, UnicodeError) as error:\n383\t        print(f\"literature-depth: {error}\", file=sys.stderr)\n384\t        return 3\n385\t    return 0\n386\t\n387\t\n388\tif __name__ == \"__main__\":\n389\t    raise SystemExit(main())"}

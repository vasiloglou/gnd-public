    keyed = GOLDENS / lane / f"{stem}.{minor_tag()}.json"
    if keyed.is_file():
        return keyed
    if any((GOLDENS / lane / f"{stem}.{tag}.json").is_file() for tag in MINORS):
        return None
    raise AssertionError(f"RF1 golden missing: {lane}/{stem}.json")



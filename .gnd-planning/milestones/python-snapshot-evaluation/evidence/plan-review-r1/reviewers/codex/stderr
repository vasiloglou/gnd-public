   182	        anchored = any(c.get("type") == "anchored"
   183	                       for ft in ModelIndex.for_model(model).iter_fact_types_shared()
   184	                       for c in ft.get("constraints") or [])
   185	        # The direct route pre-runs the transition's own pre-check once and feeds that
   186	        # report to the api.check builder. Anything that cannot yield a reusable receipt
   187	        # (an anchored model, an unvalidated population, or a pre-run that raises) takes
   188	        # the normal api.check route instead, so the payload always equals api.check's.
   189	        direct = not anchored and population.matches_validation_marker(model)
   190	        report = None
   191	        failure = None
   192	        if direct:
   193	            try:
   194	                with capture_branches() as branches:
   195	                    report = checker_module.check(model, population)
   196	            except Exception as error:  # noqa: BLE001 -- api.check maps the same failure to a payload
   197	                direct = False
   198	                failure = error
   199	        if direct:
   200	            def precomputed(_model, _population):
   201	                # Re-record the pre-run's branch ids inside the builder's own trace capture,
   202	                # so assurance certification sees the same trace as api.check (TP3 review B1).
   203	                for branch_id in branches:
   204	                    record_branch(branch_id)
   205	                return report
   206	
   207	            result = _run_check(model, population, unredacted=unredacted,
   208	                                evaluator=precomputed)
   209	        else:
   210	            fallback = {}
   211	            if failure is not None:
   212	                def failed(_model, _population, branch_ids=tuple(branches)):
   213	                    for branch_id in branch_ids:
   214	                        record_branch(branch_id)
   215	                    raise failure
   216	                fallback["evaluator"] = failed
   217	            with capture_branches() as branches:
   218	                result = _run_check(model, population, unredacted=unredacted, **fallback)
   219	            report = result.report
   220	        key = ModelIndex.for_model(model).digest
   221	        receipt = object.__new__(CheckReceipt)
   222	        try:
   223	            private_report = copy.deepcopy(report)
   224	        except Exception:  # noqa: BLE001 -- check payload still owns normal error mapping
   225	            private_report = None
   226	        for name, value in {
   227	            "model": model, "model_key": key, "population_digest": _content_digest(population),
   228	            "options": (), "report": report, "branches": frozenset(branches),
   229	            "reusable": direct and result.exit_code in (0, 2) and key is not None and private_report is not None,
   230	            "_token": _RECEIPT_TOKEN, "_checked_report": private_report,
   231	        }.items():
   232	            object.__setattr__(receipt, name, value)
   233	    return result.payload, receipt

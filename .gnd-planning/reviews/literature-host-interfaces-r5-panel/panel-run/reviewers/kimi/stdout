{"role":"tool","tool_call_id":"tool_zRB46WbULCSIOBTI0qQEQdaF","content":"1\t\"\"\"Replay a bounded literature reading run with typed coverage and fidelity.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport re\n6\timport sys\n7\timport tempfile\n8\tfrom pathlib import Path\n9\t\n10\tfrom gnd.artifacts import ArtifactError, canonical_json_bytes, sha256_hex\n11\t\n12\tfrom .depth import FIXTURE as DEPTH_FIXTURE\n13\tfrom .depth import ExampleError, _command, _decode, _read\n14\t\n15\tFIXTURE = Path(__file__).parent / \"reading_fixture\"\n16\tSTAGES = (\n17\t    \"inventory\", \"broad-extraction\", \"selection\", \"targeted-extraction\", \"review\", \"recheck\",\n18\t)\n19\tPURPOSES = (\n20\t    \"Identify available source versions and sections\",\n21\t    \"Read opening material and retain unanswered questions\",\n22\t    \"Select available ranges for unresolved questions\",\n23\t    \"Recover targeted facts and identify earlier material to revisit\",\n24\t    \"Resolve source coverage and review reported assertions\",\n25\t    \"Check affected facts and measure held-back fidelity\",\n26\t)\n27\tINPUTS = (\n28\t    \"roster.json\", \"producer-pin.json\", \"reviews.json\", \"gold.json\", \"calibration.json\",\n29\t    \"calibration.txt\", \"conflict.json\", \"conflict.txt\", \"scope.json\", \"closure.json\", \"reading.orm.json\",\n30\t)\n31\tEVIDENCE = (\n32\t    \"coverage.json\", \"scope.json\", \"closure.json\", \"fidelity-high.json\", \"fidelity-low.json\",\n33\t    \"reported-conflict.population.json\", \"reported-conflict.source.txt\", \"broad.population.json\",\n34\t    \"targeted.population.json\", \"producer-output-table.json\",\n35\t)\n36\tFILES = (*EVIDENCE, *(f\"stage-{i}.json\" for i in range(6)), *(f\"payload-{i}.json\" for i in range(6)))\n37\tIDENTIFIER = re.compile(r\"[a-z][a-z0-9-]{0,63}\\Z\")\n38\tSCENARIOS = (\"full\", \"unavailable\")\n39\tDEFAULT_BUDGET = 4096\n40\tMAX_BUDGET = 1 << 20\n41\tROSTER_LIMIT = 128\n42\tCALIBRATION_FACTS = frozenset({\"approximation\", \"alternative_integrator\"})\n43\tCOVERAGE_STATES = (\n44\t    \"supported\", \"explicitly-denied\", \"inspected-not-found\", \"unavailable\",\n45\t    \"not-applicable\", \"omitted\", \"producer-refused\", \"empty-extraction\",\n46\t)\n47\tSUBJECT = \"alanine-in-vacuum\"\n48\tLABEL = {\"subject\": SUBJECT, \"label\": \"Alanine dipeptide observation\"}\n49\t\n50\t\n51\tdef _need(condition: bool, reason: str) -> None:\n52\t    if not condition:\n53\t        raise ExampleError(reason)\n54\t\n55\t\n56\tdef _rows_by_id(rows: list) -> dict:\n57\t    _need(isinstance(rows, list) and 0 < len(rows) <= ROSTER_LIMIT, \"invalid reading roster size\")\n58\t    indexed = {}\n59\t    for row in rows:\n60\t        id_ = row.get(\"id\") if isinstance(row, dict) else None\n61\t        _need(isinstance(id_, str) and IDENTIFIER.fullmatch(id_) is not None and id_ not in indexed,\n62\t              \"invalid or duplicate reading roster ID\")\n63\t        indexed[id_] = row\n64\t    return indexed\n65\t\n66\t\n67\tclass ReadingInputs:\n68\t    \"\"\"Read and validate the declared source, section and question inventories.\"\"\"\n69\t\n70\t    def __init__(self, root: Path, *, retained_responses: bytes | None = None,\n71\t                 vocabulary_fixture: Path = DEPTH_FIXTURE) -> None:\n72\t        self.raw = {name: _read(root, name) for name in INPUTS}\n73\t        responses = _read(root, \"responses.json\") if retained_responses is None else retained_responses\n74\t        producer_pin = _decode(self.raw[\"producer-pin.json\"])\n75\t        _need(producer_pin == {\"sha256\": sha256_hex(responses)}, \"saved producer table differs from its pin\")\n76\t        self.raw[\"responses.json\"] = responses\n77\t        roster = _decode(self.raw[\"roster.json\"])\n78\t        _need(roster.get(\"format\") == \"literature-reading-roster/1\", \"invalid reading roster format\")\n79\t        self.sources = _rows_by_id(roster.get(\"sources\"))\n80\t        self.sections = _rows_by_id(roster.get(\"sections\"))\n81\t        self.questions = _rows_by_id(roster.get(\"questions\"))\n82\t        self.responses = _decode(self.raw[\"responses.json\"])\n83\t        self.reviews = _decode(self.raw[\"reviews.json\"])\n84\t        self.documents = {}\n85\t        for name, source in self.sources.items():\n86\t            _need(source.get(\"path\") == f\"{name}.txt\" and isinstance(source.get(\"version\"), str),\n87\t                  \"invalid reading source location\")\n88\t            document = _read(root, source[\"path\"])\n89\t            _need(sha256_hex(document) == source.get(\"sha256\"), \"stale reading source\")\n90\t            document.decode(\"utf-8\")\n91\t            self.documents[name] = document\n92\t            self.raw[source[\"path\"]] = document\n93\t        last_end: dict[str, int] = {}\n94\t        response_sections = set()\n95\t        for section in self.sections.values():\n96\t            source, span, selection = section.get(\"source\"), section.get(\"span\"), section.get(\"selection\")\n97\t            _need(isinstance(source, str) and source in self.documents\n98\t                  and section.get(\"kind\") in (\"section\", \"equation\", \"table\"),\n99\t                  \"invalid source section\")\n100\t            if span is None:\n101\t                _need(selection is None and section.get(\"reason\") in (\"unavailable\", \"not-applicable\"),\n102\t                      \"invalid unavailable section\")\n103\t            else:\n104\t                _need(isinstance(span, list) and len(span) == 2 and all(type(x) is int for x in span)\n105\t                      and last_end.get(source, 0) <= span[0] < span[1] <= len(self.documents[source])\n106\t                      and selection in (\"opening\", \"targeted\"), \"invalid reading span\")\n107\t                self.documents[source][span[0]:span[1]].decode(\"utf-8\")\n108\t                last_end[source] = span[1]\n109\t                response_sections.add(section[\"id\"])\n110\t            keys = section.get(\"keys\")\n111\t            _need(isinstance(keys, list) and all(isinstance(key, str) for key in keys),\n112\t                  \"invalid section dependency keys\")\n113\t        _need(set(self.responses) == response_sections, \"saved response roster differs\")\n114\t        for question in self.questions.values():\n115\t            section = question.get(\"section\")\n116\t            successor = question.get(\"superseded_by\")\n117\t            _need(isinstance(section, str) and section in self.sections\n118\t                  and isinstance(question.get(\"fact\"), str) and type(question.get(\"required\")) is bool\n119\t                  and type(question.get(\"denial\")) is bool,\n120\t                  \"invalid question evidence selector\")\n121\t            _need(successor is None or isinstance(successor, str) and successor in self.questions,\n122\t                  \"unknown superseding question\")\n123\t        settled = set()\n124\t        for question in self.questions:\n125\t            seen = set()\n126\t            successor = question\n127\t            while successor is not None and successor not in settled:\n128\t                _need(successor not in seen, \"cyclic question supersession\")\n129\t                seen.add(successor)\n130\t                successor = self.questions[successor][\"superseded_by\"]\n131\t            settled.update(seen)\n132\t        keys = roster.get(\"revisit_keys\")\n133\t        _need(isinstance(keys, list) and all(isinstance(key, str) for key in keys), \"invalid revisit keys\")\n134\t        self.revisit_keys = set(keys)\n135\t        self.raw[\"vocabulary.orm.json\"] = _read(vocabulary_fixture, \"vocabulary.orm.json\")\n136\t        self.input_pins = {name: sha256_hex(raw) for name, raw in self.raw.items()}\n137\t\n138\t    def selection(self, kind: str) -> list[str]:\n139\t        return [name for name, section in self.sections.items() if section[\"selection\"] == kind]\n140\t\n141\t    def source_range(self, section: dict) -> bytes:\n142\t        first, last = section[\"span\"]\n143\t        return self.documents[section[\"source\"]][first:last]\n144\t\n145\t    def pins(self) -> dict:\n146\t        return dict(self.input_pins)\n147\t\n148\t\n149\tclass SavedProducer:\n150\t    \"\"\"Local saved-response adapter with observed invocation counts.\"\"\"\n151\t\n152\t    def __init__(self, responses: dict) -> None:\n153\t        self.responses = responses\n154\t        self.calls = dict.fromkeys((STAGES[1], STAGES[3]), 0)\n155\t\n156\t    def produce(self, stage: str, section: str) -> dict:\n157\t        self.calls[stage] += 1\n158\t        return self.responses[section]\n159\t\n160\t\n161\tdef affected_sections(sections: dict, changed_keys: set[str]) -> list[str]:\n162\t    \"\"\"Return available earlier section IDs sharing a changed dependency key.\"\"\"\n163\t    return [name for name, row in sections.items()\n164\t            if row[\"span\"] is not None and changed_keys.intersection(row[\"keys\"])]\n165\t\n166\t\n167\tdef _inspect(inputs, stage, selected, remaining, producer, retained):\n168\t    attempts, omitted = [], []\n169\t    for name in selected:\n170\t        row = inputs.sections[name]\n171\t        excerpt = inputs.source_range(row)\n172\t        if len(excerpt) > remaining:\n173\t            omitted.append(name)\n174\t            continue\n175\t        if producer is not None:\n176\t            response = producer.produce(stage, name)\n177\t        else:\n178\t            response = retained.get(name)\n179\t            _need(response == inputs.responses[name], \"retained producer response differs\")\n180\t        outcome = response.get(\"outcome\") if isinstance(response, dict) else None\n181\t        facts = response.get(\"facts\") if isinstance(response, dict) else None\n182\t        proposed = response.get(\"proposal_keys\") if isinstance(response, dict) else None\n183\t        _need(isinstanc
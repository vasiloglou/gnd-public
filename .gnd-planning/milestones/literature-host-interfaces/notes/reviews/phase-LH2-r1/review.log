    review: bool
    calibration: dict | None
    conflict: dict | None
    absence: bool
    exits: tuple[int, ...]
    caller: bool

    def steps(self) -> dict:
        return {name: "ran" if getattr(self, name) not in (False, None) else "skipped" for name in STEPS}



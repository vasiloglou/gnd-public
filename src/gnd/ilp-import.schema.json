{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnd.dev/schemas/ilp-import.schema.json",
  "title": "GND ILP import report (gnd-ilp-import/1)",
  "description": "IK5. What gnd import ilp-rules admitted: the inputs and their digests, and per clause its ref, the covered and reported counts, the vacuous and unchecked example ids and the computed support.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "command",
    "target",
    "learner",
    "export_sha256",
    "inputs",
    "clauses",
    "proposal",
    "work"
  ],
  "properties": {
    "schema_version": {
      "const": "gnd-ilp-import/1"
    },
    "tool": {
      "const": "gnd"
    },
    "command": {
      "const": "import ilp-rules"
    },
    "target": {
      "enum": [
        "popper",
        "neutral",
        "ilasp"
      ]
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        }
      }
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "manifest",
        "clauses",
        "run"
      ],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "clauses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "ref",
          "covered",
          "reported",
          "vacuous",
          "unchecked",
          "support"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "ref": {
            "type": "string"
          },
          "covered": {
            "type": "integer",
            "minimum": 0
          },
          "reported": {
            "type": "integer",
            "minimum": 0
          },
          "vacuous": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]{0,63}$"
            }
          },
          "unchecked": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]{0,63}$"
            }
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "proposal": {
      "type": "string"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export",
        "checks",
        "verdicts",
        "total",
        "ceiling"
      ],
      "properties": {
        "export": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "verdicts": {
          "type": "integer",
          "minimum": 0
        },
        "reloads": {
          "description": "IK5-Q6: candidate models loaded by check 10 and the final checks, K + 2 for K clauses. Optional, so reports written before it stay valid.",
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ceiling": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

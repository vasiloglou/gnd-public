_EVOLUTION_CLAIM_MAX_BYTES = 10 * 1024 * 1024

def _evolve_reject_unsafe_spelling(value: str, *, label: str) -> None:
    from pathlib import PurePosixPath, PureWindowsPath

    if not value or "\x00" in value:
        raise _EvolutionCLIError(EXIT_IO, f"{label} is empty or contains a NUL byte")
    posix = PurePosixPath(value)
    windows = PureWindowsPath(value)
    if ".." in posix.parts or ".." in windows.parts:
        raise _EvolutionCLIError(EXIT_IO, f"{label} contains a refused '..' component")
    if windows.drive and not windows.is_absolute():
        raise _EvolutionCLIError(EXIT_IO, f"{label} is a refused drive-relative path")

def _evolve_absolute_path(value: str, *, label: str) -> Path:
    _evolve_reject_unsafe_spelling(value, label=label)
    supplied = Path(value)
    return supplied if supplied.is_absolute() else Path.cwd() / supplied

def _evolve_reject_existing_symlinks(path: Path, *, label: str) -> None:
    """Reject every existing symlink component in one argv-supplied path."""

    current = Path(path.anchor)
    parts = path.parts[1:] if path.anchor else path.parts
    for part in parts:
        current = current / part
        try:
            info = current.lstat()
        except FileNotFoundError:
            return
        except OSError as error:
            raise _EvolutionCLIError(
                EXIT_IO, f"{label} could not be inspected at {current}: {error}"
            ) from error
        if stat.S_ISLNK(info.st_mode):
            raise _EvolutionCLIError(EXIT_IO, f"{label} crosses symlink {current}")

def _evolve_workspace(value: str) -> Path:
    workspace = _evolve_absolute_path(value, label="workspace")
    _evolve_reject_existing_symlinks(workspace, label="workspace")
    try:
        info = workspace.lstat()
    except FileNotFoundError as error:
        raise _EvolutionCLIError(EXIT_NO_INPUT, f"workspace {workspace} does not exist") from error
    except OSError as error:
        raise _EvolutionCLIError(
            EXIT_IO, f"workspace {workspace} could not be inspected: {error}"
        ) from error
    if not stat.S_ISDIR(info.st_mode):
        raise _EvolutionCLIError(EXIT_IO, f"workspace {workspace} is not a real directory")
    try:
        return workspace.resolve(strict=True)
    except OSError as error:
        raise _EvolutionCLIError(
            EXIT_IO, f"workspace {workspace} could not be resolved: {error}"
        ) from error

def _evolve_rooted_path(
    root: Path,
    value: str,
    *,
    root_label: str,
    label: str,
    required: bool,
    regular: bool = True,
) -> tuple[Path, str]:
    candidate = _evolve_absolute_path(value, label=label)
    try:
        relative = candidate.relative_to(root)
    except ValueError as error:
        raise _EvolutionCLIError(
            EXIT_IO, f"{label} {candidate} is outside {root_label} {root}"
        ) from error
    if not relative.parts:
        raise _EvolutionCLIError(EXIT_IO, f"{label} cannot be the {root_label}")

    current = root
    missing = False
    for part in relative.parts:
        current = current / part
        try:
            info = current.lstat()
        except FileNotFoundError:
            missing = True
            break
        except OSError as error:
            raise _EvolutionCLIError(
                EXIT_IO, f"{label} could not be inspected at {current}: {error}"
            ) from error
        if stat.S_ISLNK(info.st_mode):
            raise _EvolutionCLIError(EXIT_IO, f"{label} crosses symlink {current}")

    try:
        resolved = candidate.resolve(strict=False)
    except OSError as error:
        raise _EvolutionCLIError(
            EXIT_IO, f"{label} {candidate} could not be resolved: {error}"
        ) from error
    if not resolved.is_relative_to(root):
        raise _EvolutionCLIError(
            EXIT_IO, f"{label} {candidate} resolves outside {root_label} {root}"
def _cmd_evolve_preview(
    model_path: str,
    proposal_path: str,
    workspace_path: str,
    records_path: str,
    preview_path: str,
    output_format: str,
    *,
    policy: str | None = None,
    populated: list[str] | None = None,
    shape_report: bool = False,
    check_population: str | None = None,
    previous_include: list[str] | None = None,
) -> int:
    """Validate one proposal through ``EvolutionService.preview`` and publish its claim.

    Under ``--policy additive`` the preview is published even when the policy
    refuses operations, so the issues are reviewable; the exit is then 3.
    """

    from gnd.evolve import EvolutionIncludeAnalysis, EvolutionService, read_evolution_proposal

    try:
        _evolve_policy_arguments(policy, populated, check_population)
        workspace = _evolve_workspace(workspace_path)
        model, _model_relative = _evolve_workspace_path(
            workspace, model_path, label="model", required=True
        )
        population_relative = _evolve_population_relative(workspace, check_population)
        proposal_file, proposal_relative = _evolve_workspace_path(
            workspace, proposal_path, label="proposal", required=True
        )
        preview_file, preview_relative = _evolve_workspace_path(
            workspace, preview_path, label="preview output", required=False
        )
        records = _evolve_records_root(records_path)
        proposal = read_evolution_proposal(
            proposal_file,
            anchor=workspace,
            relative=proposal_relative,
        )
        _evolve_validate_proposal_roots(proposal)
        service = EvolutionService(
            model_path=model,
            evidence_root=records,
            allowed_project_root=workspace,
        )
        history = _evolve_previous_includes(workspace, model, _model_relative, proposal, previous_include)
        try:
            preview = service.preview(
                proposal, policy=policy, populated=populated or (), shape_report=shape_report,
                check_population=population_relative, previous_includes=history,
            )
        except EvolutionIncludeAnalysis as error:
            from gnd.evolve._includes import exclude_input_outputs
            from gnd.evolve.service import _include_input

            _include_input(exclude_input_outputs, model, error.inputs, (preview_file,))
            from gnd.evolve.service import _include_claim_cap
            from gnd.verbalize import line_text

            rendered = _evolve_json_bytes(error.radius)
            _include_claim_cap(rendered)
            _evolve_publish_preview(workspace, preview_file, preview_relative, rendered)
            if output_format == 'json':
                print(rendered.decode('utf-8'), end='')
            else:
                print(str(error))
                for entry in error.radius.entries:
                    print(line_text(entry.reference))
            return 3
        rendered = _evolve_json_bytes(preview)
        if preview.before_includes is not None:
            from gnd.evolve._includes import exclude_input_outputs
            from gnd.evolve.service import _include_claim_cap, _include_input

            _include_input(exclude_input_outputs, model,
                           (*preview.before_includes, *preview.candidate_includes), (preview_file,))
            _include_claim_cap(rendered)
        _evolve_publish_preview(workspace, preview_file, preview_relative, rendered)
        _evolve_emit_claim(preview, output_format, stage="preview")
        if preview.policy_issues:
            print(
                f"EVOLUTION PREVIEW REFUSED (3): {policy} policy refused "
                f"{len(preview.policy_issues)} operation(s); see policy_issues in {preview_file}",
                file=sys.stderr,
            )
            return 3
        return 0
    except Exception as error:  # noqa: BLE001 -- preserve predecessor refusal contract
        return _evolve_fail(error, stage="preview")

"""Export an include root through its flat model (include-root-routes IR3).

Both PyRel renderers, the default checker program (``emit.render_pyrel``) and
the rules programs (``pyrel_rules.render``), call ``flatten_for_export``. It
cannot live in ``pyrel_runtime.py``, which is embedded verbatim in every
default program, nor in ``emit.py``, which ``pyrel_rules`` would then import
in a cycle.
"""
from __future__ import annotations

import hashlib
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class FlatExport:
    """An include root's flat model, as ``gnd flatten`` would write it."""

    model_bytes: bytes
    record_sha256: str
    includes: tuple


def flatten_for_export(model_path: Path, raw: bytes):
    """The flat model to export for an include root, or None for any other model.

    A model that declares no includes keeps its one-read path: nothing is
    loaded here. An include root is composed by the loader ``gnd check`` uses
    and flattened; every refusal becomes ``ExportInputError`` (exit 3).
    """
    from gnd.errors import ModelLoadError, ModelValidationError, ReferenceInputError
    from gnd.model._includes import bytes_declare_includes

    from .pyrel_runtime import ExportInputError

    if not bytes_declare_includes(raw, source=str(model_path)):
        return None
    import gnd.model
    from gnd.model.flattening import FlatteningError, flatten_model

    try:
        model = gnd.model.load_model(Path(model_path))
        if model._authored_sha256 != hashlib.sha256(raw).hexdigest():
            raise ExportInputError("include:hash-mismatch: the root changed while it was read")
        flat = flatten_model(model)
    except ExportInputError:
        raise
    except ModelValidationError as error:
        code = next((i.rule_id for i in error.issues if i.rule_id.startswith("include:")), None)
        raise ExportInputError(code or str(error)) from error
    # ValueError covers UnicodeError from an include path that cannot be encoded;
    # gnd check and gnd flatten refuse the same root with exit 3.
    except (ModelLoadError, ReferenceInputError, FlatteningError, OSError, ValueError) as error:
        raise ExportInputError(str(error)) from error
    return FlatExport(
        model_bytes=flat.model_bytes,
        record_sha256=hashlib.sha256(flat.record_bytes).hexdigest(),
        includes=tuple((entry.id, entry.path, entry.sha256) for entry in model._included),
    )


def flattening_constants(flat) -> str:
    """The two program lines that record an exported flattening; empty for None."""
    if flat is None:
        return ""
    return (f"FLATTENING_RECORD_SHA256 = {flat.record_sha256!r}\n"
            f"MODEL_INCLUDES = {flat.includes!r}\n")


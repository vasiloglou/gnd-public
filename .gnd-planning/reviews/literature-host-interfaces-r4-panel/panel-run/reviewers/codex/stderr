167: def _inspect(inputs, stage, selected, remaining, producer, retained):
168:     attempts, omitted = [], []
169:     for name in selected:
170:         row = inputs.sections[name]
171:         excerpt = inputs.source_range(row)
172:         if len(excerpt) > remaining:
173:             omitted.append(name)
174:             continue
175:         if producer is not None:
176:             response = producer.produce(stage, name)
177:         else:
178:             response = retained.get(name)
179:             _need(response == inputs.responses[name], "retained producer response differs")
180:         outcome = response.get("outcome") if isinstance(response, dict) else None
181:         facts = response.get("facts") if isinstance(response, dict) else None
182:         proposed = response.get("proposal_keys") if isinstance(response, dict) else None
183:         _need(isinstance(proposed, list) and all(isinstance(key, str) and key in inputs.revisit_keys for key in proposed),
184:               "invalid vocabulary proposal")
185:         _need(outcome in ("accepted", "empty", "refused") and isinstance(facts, dict)
186:               and bool(facts) == (outcome == "accepted"), "invalid saved producer response")
187:         first, last = row["span"]
188:         attempts.append({
189:             "section": name, "source": row["source"], "start": first, "end": last,
190:             "source_version": inputs.sources[row["source"]]["version"],
191:             "excerpt_sha256": sha256_hex(excerpt), "response_sha256": sha256_hex(canonical_json_bytes(response)),
192:             "outcome": outcome, "response": response,
193:         })
194:         remaining -= len(excerpt)
195:     return {"attempts": attempts, "omitted": omitted, "original_producer_calls": len(attempts)}, remaining
196: 

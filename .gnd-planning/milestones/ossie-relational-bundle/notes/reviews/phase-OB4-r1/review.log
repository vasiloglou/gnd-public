    77	        ("char", "character", "varchar", "character varying", "nchar", "nvarchar", "text", "string", "uuid"), "String"),
    78	    **dict.fromkeys(
    79	        ("smallint", "integer", "int", "bigint", "tinyint", "int2", "int4", "int8", "serial", "bigserial",
    80	         "long", "short", "byte"), "Integer"),
    81	    **dict.fromkeys(("numeric", "decimal", "dec", "number"), "Decimal"),
    82	    **dict.fromkeys(("real", "float", "float4", "float8", "double", "double precision"), "Float"),
    83	    **dict.fromkeys(("boolean", "bool"), "Boolean"),
    84	    "date": "Date",
    85	    **dict.fromkeys(("time", "time without time zone"), "Time"),
    86	    **dict.fromkeys(("timestamp", "timestamp without time zone", "timestamp_ntz", "datetime"), "DateTime"),
    87	    **dict.fromkeys(("timestamp with time zone", "timestamptz", "timestamp_ltz"), "DateTimeTz"),
    88	    **dict.fromkeys(("bytea", "binary", "varbinary", "blob", "json", "jsonb"), "Opaque"),
    89	}
    90	
    91	_WORD = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")
    92	_DIGITS = frozenset("0123456789")
    93	
    94	
    95	class BindingError(ValueError):
    96	    """A physical binding is refused. ``rule`` is one of :data:`RULE_ORDER`."""
    97	
    98	    def __init__(self, rule: str, detail: str = "") -> None:
    99	        assert rule in RULE_ORDER, rule
   100	        self.rule = rule
   101	        super().__init__(f"{rule}: {detail}" if detail else rule)
   102	
   103	
   104	@dataclass(frozen=True)
   105	class Binding:
   106	    """A schema-valid binding document and the digest of the bytes it was read from."""
   107	
   108	    document: Mapping[str, Any]
   109	    sha256: str
   110	
   111	
   112	@lru_cache(maxsize=1)
   113	def _validator() -> Draft202012Validator:
   114	    schema = loads(files("gnd").joinpath("schema", "physical-binding.schema.json").read_bytes())
   115	    return Draft202012Validator(schema)
   116	
   117	
   118	def read_binding(path: Path) -> Binding:
   119	    """Read and schema-check a binding. A missing file raises ``FileNotFoundError``."""
   120	    try:
   121	        descriptor = open_regular(path)
   122	    except NotRegularFileError as error:
   123	        raise BindingError("binding:not-a-file", "the path is not a regular file") from error
   124	    with open(descriptor, "rb") as stream:
   125	        raw = stream.read(MAX_BYTES + 1)
   126	    if len(raw) > MAX_BYTES:
   127	        raise BindingError("binding:size", f"the file is larger than {MAX_BYTES} bytes")
   128	    try:
   129	        document = loads(raw, max_bytes=MAX_BYTES)
   130	    except (ValueError, RecursionError, OverflowError) as error:
   131	        raise BindingError("binding:syntax", "the file is not JSON within the input limits") from error
   132	    violations = sorted(
   133	        ("/" + "/".join(str(part) for part in error.absolute_path) if error.absolute_path else "", error.message)
   134	        for error in _validator().iter_errors(document)
   135	    )
   136	    if violations:
   137	        pointer, message = violations[0]
   138	        raise BindingError("binding:schema", f"at {pointer or 'the document root'}: {message[:200]}")
   139	    return Binding(document, hashlib.sha256(raw).hexdigest())
   140	
   141	
   142	def sql_datatype(sql_type: str) -> str | None:
   143	    """The Ossie data type of an SQL type, or None when the type is outside the map.
   144	
   145	    A type is words of letters, digits and underscores separated by spaces, with at
   146	    most one parenthesized list of unsigned integers after a word. Its name is the
   147	    words, casefolded and joined by one space.
   148	    """
   149	    words: list[str] = []
   150	    listed = False
   151	    position = 0
   152	    while position < len(sql_type):
   153	        character = sql_type[position]
   154	        if character == " ":
   155	            position += 1
   156	        elif character in _WORD:
   157	            end = position
   158	            while end < len(sql_type) and sql_type[end] in _WORD:
   159	                end += 1
   160	            words.append(sql_type[position:end].casefold())
   161	            position = end
   162	        elif character == "(" and words and not listed:
   163	            end = sql_type.find(")", position)
   164	            if end < 0:
   165	                return None
   166	            items = [item.strip(" ") for item in sql_type[position + 1:end].split(",")]
   167	            if not all(item and set(item) <= _DIGITS for item in items):
   168	                return None
   169	            listed = True
   170	            position = end + 1
   171	        else:
   172	            return None
   173	    return SQL_TYPES.get(" ".join(words))
   174	
   175	
   176	def normalize_role_name(name: str) -> str:
   177	    """A role name for matching (OB4 D8): NFKC, casefolded, letters and digits only."""
   178	    folded = unicodedata.normalize("NFKC", name).casefold()
   179	    return "".join(c for c in folded if unicodedata.category(c)[0] in "LN")

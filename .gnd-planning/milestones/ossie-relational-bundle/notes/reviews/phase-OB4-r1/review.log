     3	The normative rules have one home: "Semantic model and mapping" under "Ossie
     4	interchange" in ``gnd-orm-core/references/representation-format.md``. This module
     5	turns a :class:`gnd.rmap.RelationalSchema` into an Ossie core-spec semantic model,
     6	and maps the ontology's concepts and relationships onto it. It builds documents
     7	only; :func:`gnd.export.ossie.render_ossie` encodes and binds them.
     8	
     9	Nothing here refuses a model. A fact type the relational layer cannot express is
    10	listed in the mapping's ``GND`` extension with a closed reason.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import itertools
    16	from collections.abc import Callable, Mapping, Sequence
    17	from dataclasses import dataclass
    18	from functools import lru_cache
    19	from importlib.resources import files
    20	from typing import Any
    21	
    22	from jsonschema import Draft202012Validator
    23	from referencing import Registry, Resource
    24	from referencing.jsonschema import DRAFT202012
    25	
    26	from gnd.artifacts import canonical_json_bytes
    27	from gnd.input_policy import loads
    28	from gnd.rmap import Disposition, Identification, RelationalSchema, RolePlacement
    29	
    30	__all__ = [
    31	    "DATATYPES",
    32	    "EXTENSION_SCHEMA",
    33	    "MAX_LINK_ARITY",
    34	    "OntologyView",
    35	    "build_mapping",
    36	    "build_semantic_model",
    37	    "extension_data",
    38	    "validate_relational",
    39	]
    40	
    41	VERSION = "0.3.0.dev0"
    42	VENDOR = "GND"
    43	EXTENSION_SCHEMA = "gnd-ossie-relational/1"
    44	_UPSTREAM = "https://raw.githubusercontent.com/apache/ossie/main/"
    45	
    46	#: A link mapping nests one level per role. A fact type with more roles than this is
    47	#: listed, not nested: the bound keeps every mapping document shallow enough for a
    48	#: recursive reader, whatever arity the model admits.
    49	MAX_LINK_ARITY = 32
    50	
    51	#: GND value primitive -> Ossie core-spec data type (OB3 E6). ``Opaque`` keeps the
    52	#: primitive in the field's ``GND`` extension.
    53	DATATYPES: dict[str, str] = {
    54	    "String": "String",
    55	    "Integer": "Integer",
    56	    "Float": "Float",
    57	    "Boolean": "Boolean",
    58	    "Date": "Date",
    59	    "DateTime": "DateTime",
    60	    "Number": "Decimal",
    61	    "Binary": "Opaque",
    62	    "Duration": "Opaque",
    63	}
    64	
    65	
    66	@dataclass(frozen=True)
    67	class OntologyView:
    68	    """What the mapping reads from the ontology the same export run built.
    69	
    70	    ``identification`` gives, per object type id, how the ontology identifies it:
    71	    ``("simple", relationship)`` or ``("composite", (relationship, ...))`` in
    72	    ``identify_by`` order. ``relations`` gives, per fact type id, the concept that
    73	    owns its relationship and its roles in the relationship's order.
    74	    """
    75	
    76	    name: str
    77	    concepts: Mapping[str, str]  # object type id -> concept, in component order
    78	    kinds: Mapping[str, str]  # object type id -> "entity" | "value"
    79	    identification: Mapping[str, tuple[str, Any]]
    80	    relations: Mapping[str, tuple[str, tuple[str, ...], Mapping[str, str]]]
    81	
    82	
    83	def extension_data(payload: Any) -> str:
    84	    """An extension's ``data``: canonical JSON without its trailing newline."""
    85	    return canonical_json_bytes(payload).decode("utf-8").removesuffix("\n")
    86	
    87	
    88	def _quoted(identifier: str) -> str:
    89	    """One SQL identifier, quoted and uppercased, so that it matches the regular
    90	    identifier of the same spelling and never reads as a keyword (OB3 E5)."""
    91	    return '"' + identifier.upper().replace('"', '""') + '"'
    92	
    93	
    94	def _extension(payload: Any) -> list[dict[str, str]]:
    95	    return [{"vendor_name": VENDOR, "data": extension_data(payload)}]
    96	
    97	
    98	def build_semantic_model(
    99	    schema: RelationalSchema, name: str,
   100	    *, physical: Mapping[tuple[str, str], tuple[str | None, str | None]] | None = None,
   101	) -> dict[str, Any]:
   102	    """One dataset per table, one field per column, one relationship per foreign key.
   103	
   104	    ``physical`` is given for a delivered schema (a physical binding): per
   105	    (table, column), the Ossie data type or None, and the raw SQL type or None.
   106	    """
   107	    datasets = []
   108	    relationships = []
   109	    for table in schema.tables:
   110	        dataset: dict[str, Any] = {"name": table.name, "source": table.name}
   111	        if table.primary_key:
   112	            dataset["primary_key"] = list(table.primary_key)
   113	        if table.unique_keys:
   114	            dataset["unique_keys"] = [list(key) for key in table.unique_keys]
   115	        fields = []
   116	        for column in table.columns:
   117	            field: dict[str, Any] = {"name": column.name, "expression": {"sql": _quoted(column.name)}}
   118	            if physical is not None:
   119	                datatype, sql_type = physical[(table.name, column.name)]
   120	                if datatype is not None:
   121	                    field["datatype"] = datatype
   122	                if sql_type is not None:
   123	                    field["custom_extensions"] = _extension({"sql_type": sql_type})
   124	            elif column.datatype is not None:
   125	                field["datatype"] = DATATYPES[column.datatype]
   126	                if field["datatype"] == "Opaque":
   127	                    field["custom_extensions"] = _extension({"gnd_primitive": column.datatype})
   128	            fields.append(field)
   129	        dataset["fields"] = fields
   130	        dataset["custom_extensions"] = _extension({"source_kind": "logical" if physical is None else "physical"})
   131	        datasets.append(dataset)
   132	        relationships += [
   133	            {
   134	                "name": key.name,
   135	                "from": table.name,
   136	                "to": key.target_table,
   137	                "from_columns": list(key.columns),
   138	                "to_columns": list(key.target_columns),
   139	            }
   140	            for key in table.foreign_keys
   141	        ]
   142	    document: dict[str, Any] = {"version": VERSION, "name": name, "datasets": datasets}
   143	    if relationships:
   144	        document["relationships"] = relationships
   145	    return document
   146	
   147	
   148	class _Mapping:
   149	    def __init__(self, schema: RelationalSchema, view: OntologyView) -> None:
   150	        self.view = view
   151	        self.tables = {table.name for table in schema.tables}
   152	        self.identifications: dict[str, Identification] = {i.object_type: i for i in schema.identifications}
   153	        self.placements: dict[tuple[str, str], RolePlacement] = {(p.fact_type, p.role): p for p in schema.roles}
   154	
   155	    def referents(
   156	        self, object_type: str, table: str, columns: Sequence[str], wrap: Callable[[str], str]
   157	    ) -> list[dict[str, Any]] | None:
   158	        """Referent mappings that find one object of an entity type from ``columns`` of
   159	        ``table``, or None when the ontology does not identify it as the Rmap does."""
   160	        rmap = self.identifications.get(object_type)
   161	        ontology = self.view.identification.get(object_type)
   162	        if rmap is None or ontology is None or len(columns) != len(rmap.columns):
   163	            return None
   164	        form, payload = ontology
   165	        if rmap.kind == "direct" and form == "simple":
   166	            return [{"relationship": payload, "expression": wrap(self.reference(table, columns[0]))}]
   167	        if rmap.kind != "composite" or form != "composite":
   168	            return None
   169	        by_fact: dict[str, tuple[str, list[str]]] = {}
   170	        for column, component in zip(columns, rmap.components):
   171	            assert component is not None
   172	            by_fact.setdefault(component[0], (component[1], []))[1].append(column)
   173	        if set(by_fact) != set(payload):
   174	            return None
   175	        result = []
   176	        for relationship in payload:  # the ontology's identify_by order
   177	            role, held = by_fact[relationship]
   178	            player = self.view.relations[relationship][2][role]
   179	            if self.view.kinds[player] == "value":
   180	                result.append({"relationship": relationship, "expression": wrap(self.reference(table, held[0]))})
   181	                continue
   182	            nested = self.referents(player, table, held, wrap)
   183	            if nested is None:
   184	                return None
   185	            result.append({"relationship": relationship, "referent_mappings": nested})
   186	        return result
   187	
   188	    @staticmethod
   189	    def reference(table: str, column: str) -> str:
   190	        return f"{_quoted(table)}.{_quoted(column)}"
   191	
   192	    def object_mapping(
   193	        self, object_type: str, table: str, columns: Sequence[str], *,
   194	        named: bool, wrap: Callable[[str], str] = str,
   195	    ) -> dict[str, Any] | None:
   196	        """How ``columns`` of ``table`` give one object of ``object_type``."""
   197	        node: dict[str, Any] = {"concept": self.view.concepts[object_type]} if named else {}
   198	        if self.view.kinds[object_type] == "value":
   199	            if len(columns) != 1:
   200	                return None
   201	            node["expression"] = wrap(self.reference(table, columns[0]))
   202	            return node
   203	        referents = self.referents(object_type, table, columns, wrap)
   204	        if referents is None:
   205	            return None
   206	        if self.identifications[object_type].kind == "direct":
   207	            node["expression"] = referents[0]["expression"]
   208	        else:
   209	            node["referent_mappings"] = referents
   210	        return node
   211	
   212	    def link_tree(self, fact_type: str) -> dict[str, Any] | str:
   213	        """One tree per fact type: a node per role in the relationship's order, the
   214	        last one naming the relationship. Otherwise the reason there is no tree."""
   215	        _, order, players = self.view.relations[fact_type]
   216	        if len(order) > MAX_LINK_ARITY:
   217	            return "arity-over-limit"
   218	        # A unary stored as a Boolean flag: a row is a link only where the flag is true.
   219	        first = self.placements[(fact_type, order[0])]
   220	        flag = self.reference(first.table, first.flag) if first.flag is not None else None
   221	
   222	        def wrap(expression: str) -> str:
   223	            return expression if flag is None else f"CASE WHEN {flag} THEN {expression} END"
   224	
   225	        nodes = []
   226	        for level, role in enumerate(order):
   227	            placement = self.placements[(fact_type, role)]
   228	            node = self.object_mapping(
   229	                players[role], placement.table, placement.columns, named=level > 0, wrap=wrap)
   230	            if node is None:
   231	                return "identification-differs"
   232	            nodes.append({"object_mapping": node})
   233	        nodes[-1]["relationship"] = fact_type
   234	        for parent, child in itertools.pairwise(nodes):
   235	            parent["children"] = [child]
   236	        return nodes[0]
   237	
   238	
   239	def build_mapping(
   240	    schema: RelationalSchema,
   241	    dispositions: Sequence[Disposition],
   242	    view: OntologyView,
   243	    *,
   244	    name: str,
   245	    ontology_iri: str,
   246	    semantic_model_name: str,
   247	    semantic_model_iri: str,
   248	    bindings: Mapping[str, str],
   249	    extra: Mapping[str, Any] | None = None,
   250	) -> dict[str, Any]:
   251	    """Map the ontology's concepts and relationships onto the semantic model.
   252	
   253	    ``bindings`` are the digests and identity the ``GND`` extension carries. Every
   254	    disposition is listed there, so a reader can check from the file alone that each
   255	    fact type and constraint is carried or has a reason.
   256	    """
   257	    mapper = _Mapping(schema, view)
   258	    trees: dict[str, list[dict[str, Any]]] = {}
   259	    unmapped_links = []
   260	    carried = {d.id for d in dispositions if d.kind == "fact_type" and d.reason is None}
   261	    for fact_type, (owner, _order, _players) in view.relations.items():  # the ontology's relationship order
   262	        if fact_type not in carried:
   263	            continue
   264	        tree = mapper.link_tree(fact_type)
   265	        if isinstance(tree, str):
   266	            unmapped_links.append({"fact_type": fact_type, "reason": tree})
   267	        else:
   268	            trees.setdefault(owner, []).append(tree)
   269	
   270	    concept_mappings = []
   271	    concepts = []
   272	    for object_type, concept in view.concepts.items():
   273	        entry: dict[str, Any] = {"concept": concept}
   274	        identification = mapper.identifications.get(object_type)
   275	        table = identification.table if identification is not None else None
   276	        if view.kinds[object_type] == "entity" and table is not None:
   277	            if identification.absorbed:
   278	                concepts.append({"concept": concept, "reason": "subtype-absorbed"})
   279	            else:
   280	                node = mapper.object_mapping(object_type, table, identification.columns, named=False)
   281	                if node is None:
   282	                    concepts.append({"concept": concept, "reason": "identification-differs"})
   283	                else:
   284	                    entry["object_mappings"] = [node]
   285	        if object_type in trees:
   286	            entry["link_mappings"] = trees[object_type]
   287	        if len(entry) > 1:
   288	            concept_mappings.append(entry)
   289	
   290	    payload: dict[str, Any] = {
   291	        "schema": EXTENSION_SCHEMA,
   292	        **bindings,
   293	        **({"rmap_variant": schema.variant.value} if schema.variant is not None else {}),
   294	        "dispositions": [
   295	            {"kind": d.kind, "id": d.id, "carried_as": list(d.carried_as), "reason": d.reason}
   296	            for d in dispositions
   297	        ],
   298	        "concepts": concepts,
   299	        **(extra or {}),
   300	    }
   301	    if unmapped_links:
   302	        payload["unmapped_links"] = sorted(unmapped_links, key=lambda row: row["fact_type"])
   303	    return {
   304	        "version": VERSION,
   305	        "name": name,
   306	        "ontology_ref": {"name": view.name, "iri": ontology_iri},
   307	        "semantic_model_ref": {"name": semantic_model_name, "iri": semantic_model_iri},
   308	        "concept_mappings": concept_mappings,
   309	        "custom_extensions": _extension(payload),
   310	    }
   311	
   312	
   313	@lru_cache(maxsize=1)
   314	def _validators() -> tuple[Draft202012Validator, Draft202012Validator]:
   315	    root = files("gnd").joinpath("schema", "ossie")
   316	    core = loads(root.joinpath("core-spec.json").read_bytes())
   317	    ontology = loads(root.joinpath("ontology.json").read_bytes())
   318	    mapping = loads(root.joinpath("mapping.json").read_bytes())
   319	    # The pinned schemas reference each other through upstream URLs. Registry() refuses
   320	    # any retrieval that is not registered here, so validation never opens a connection.
   321	    registry = Registry().with_resources([
   322	        (_UPSTREAM + "core-spec/ossie-schema.json", Resource.from_contents(core, default_specification=DRAFT202012)),
   323	        (_UPSTREAM + "ontology/ontology.json", Resource.from_contents(ontology, default_specification=DRAFT202012)),
   324	    ])
   325	    return Draft202012Validator(core, registry=registry), Draft202012Validator(mapping, registry=registry)
   326	
   327	
   328	def validate_relational(semantic_model: Mapping[str, Any], mapping: Mapping[str, Any]) -> None:
   329	    """Check both documents against the pinned schemas; a failure is a renderer defect."""
   330	    semantic_validator, mapping_validator = _validators()
   331	    semantic_validator.validate(semantic_model)
   332	    mapping_validator.validate(mapping)


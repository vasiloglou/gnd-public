   305	class ConstraintSubjects:
   306	    """The fact types a constraint operation ranges over, before and after (MG2).
   307	
   308	    One definition, shared by the policy walk and the population check (UG2),
   309	    so "populated subject" means the same thing in both. A constraint's
   310	    subjects are its host fact type, if it has one, plus the fact types its
   311	    role references and rule atoms name, plus every fact type played by an
   312	    object type it ranges over without a role.
   313	    """
   314	
   315	    def __init__(self, index: ModelIndex) -> None:
   316	        self._index = index
   317	        self._players: dict[str, set[str]] | None = None
   318	
   319	    def _playing(self, object_types: set[str]) -> set[str]:
   320	        """Fact types with a role played by one of `object_types` or a subtype of one."""
   321	        if self._players is None:
   322	            players: dict[str, set[str]] = {}
   323	            # A value type that identifies an entity constrains that entity's
   324	            # reference values, so the entity's roles count too.
   325	            identifies: dict[str, set[str]] = {}
   326	            for object_type_id, row in self._index.object_types_by_id().items():
   327	                reference = _lookup(row, "reference")
   328	                value_type = _lookup(reference, "value_type") if isinstance(reference, dict) else None
   329	                if isinstance(value_type, str):
   330	                    identifies.setdefault(object_type_id, set()).add(value_type)
   331	            for fact_type_id, roles in self._index.role_object_types().items():
   332	                for player in roles.values():
   333	                    kinds = {player, *self._index.supertype_closure(player)}
   334	                    for kind_of in set(kinds):
   335	                        kinds |= identifies.get(kind_of, set())
   336	                    for kind_of in kinds:
   337	                        players.setdefault(kind_of, set()).add(fact_type_id)
   338	            self._players = players
   339	        found: set[str] = set()
   340	        for object_type in object_types:
   341	            found |= self._players.get(object_type, set())
   342	        return found
   343	
   344	    def of(self, operation: Any) -> set[str]:
   345	        locator = operation.locator

+    added = {entry["id"] for entry in example["fact_types"] + example["derived_fact_types"]}
+    hosts = {entry["host"] for entry in example["constraints"]} - {"model"}
+    if not hosts - added:
+        problems.append("the example names no fact type the model already has")
+    return problems

+{"role":"tool","tool_call_id":"tool_aWy2u8xlL9U0Hzj8LDOCYKhY","content":"1\t\"\"\"LH1: a caller's producer drives the reading stages over a caller's root.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport copy\n5\timport json\n6\timport shutil\n7\timport sys\n8\timport time\n9\tfrom pathlib import Path\n10\t\n11\timport pytest\n12\tfrom support.recorded_version import tree_as_recorded\n13\t\n14\tfrom gnd.artifacts import ArtifactError, canonical_json_bytes, read_regular_bounded, sha256_hex\n15\tfrom gnd.examples.literature import reading\n16\tfrom gnd.examples.literature.reading import ReadingLimits\n17\t\n18\tFIXTURES = Path(__file__).parent / \"fixtures/lh1-reading\"\n19\tCALLER = FIXTURES / \"caller\"\n20\tPACKAGED = FIXTURES / \"packaged\"\n21\tRECORDED_AT = \"0.4.0\"\n22\tP3 = {\n23\t    \"full\": \"ee67e13c082c340052cd37b09c77f2feb90c124b633738b8863bcd3d22b8fd1c\",\n24\t    \"unavailable\": \"d4010f94712aa9bd46bf6f62f148a05f22e7f88acf9bc82d7c736d4cb9ba6ddf\",\n25\t    \"budget-0\": \"7dcf43ecab3a6c7d3a1d0b8dbe3b503a28e698fed170506469cad4820a37a071\",\n26\t}\n27\tANSWERS = {\n28\t    \"a-opening\": {\"outcome\": \"accepted\", \"proposal_keys\": [],\n29\t                  \"facts\": {\"paper_title\": [{\"paper\": \"paper-a\", \"title\": \"Graph sampling at scale\"}]}},\n30\t    \"a-methods\": {\"outcome\": \"accepted\", \"proposal_keys\": [\"method\"],\n31\t                  \"facts\": {\"paper_method\": [{\"paper\": \"paper-a\", \"value\": \"stratified sampling over 40 graphs\"}]}},\n32\t    \"a-results\": {\"outcome\": \"accepted\", \"proposal_keys\": [],\n33\t                  \"facts\": {\"paper_finding\": [{\"paper\": \"paper-a\", \"value\": \"sampling cuts cost by half\"}]}},\n34\t    \"b-opening\": {\"outcome\": \"accepted\", \"proposal_keys\": [],\n35\t                  \"facts\": {\"paper_title\": [{\"paper\": \"paper-b\", \"title\": \"Sparse retrieval revisited\"}]}},\n36\t    \"b-methods\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []},\n37\t}\n38\tPACKAGED_NAMES = (\"study-methods\", \"alanine\", \"approximation\", \"alternative_integrator\", \"subject_label\",\n39\t                  \"saved-public-fixture\")\n40\t\n41\t\n42\tclass Producer:\n43\t    \"\"\"A host's producer: only ``produce``, and its own record of every call.\"\"\"\n44\t\n45\t    def __init__(self, answers=None):\n46\t        self.answers = answers if answers is not None else ANSWERS\n47\t        self.seen = []\n48\t\n49\t    def produce(self, call):\n50\t        self.seen.append(call)\n51\t        return copy.deepcopy(self.answers[call.section])\n52\t\n53\t\n54\tclass Forbidden:\n55\t    def produce(self, call):\n56\t        pytest.fail(f\"producer called for {call.section}\")\n57\t\n58\t\n59\tclass Reviewer:\n60\t    def __init__(self, decision=\"supported\"):\n61\t        self.decision = decision\n62\t\n63\t    def review(self, call):\n64\t        if self.decision == \"list\":\n65\t            return [\"supported\"]\n66\t        return {\"decision\": self.decision, \"basis\": f\"the excerpt states it ({call.section})\"}\n67\t\n68\t\n69\tdef _root(tmp_path, *, declared=False, profile=None, name=\"root\"):\n70\t    root = tmp_path / name\n71\t    shutil.copytree(CALLER, root)\n72\t    if declared:\n73\t        shutil.copyfile(root / \"profile-declared.json\", root / \"profile.json\")\n74\t    if profile is not None:\n75\t        (root / \"profile.json\").write_bytes(canonical_json_bytes(profile))\n76\t    return root\n77\t\n78\t\n79\tdef _profile(**changes):\n80\t    value = json.loads((CALLER / \"profile.json\").read_bytes())\n81\t    value.update(changes)\n82\t    return value\n83\t\n84\t\n85\tdef _edit(root, name, change):\n86\t    value = json.loads((root / name).read_bytes())\n87\t    change(value)\n88\t    (root / name).write_bytes(canonical_json_bytes(value))\n89\t\n90\t\n91\tdef _refuses(out, call, match=None):\n92\t    with pytest.raises((reading.ExampleError, ArtifactError), match=match):\n93\t        call()\n94\t    assert not out.exists()\n95\t\n96\t\n97\tdef _files(folder):\n98\t    return {path.relative_to(folder).as_posix(): path.read_bytes()\n99\t            for path in sorted(folder.rglob(\"*\")) if path.is_file()}\n100\t\n101\t\n102\t@pytest.fixture(scope=\"module\")\n103\tdef plain(tmp_path_factory):\n104\t    base = tmp_path_factory.mktemp(\"lh1\")\n105\t    producer = Producer()\n106\t    out = base / \"run\"\n107\t    report = reading.run(out, fixture=CALLER, producer=producer)\n108\t    return out, report, producer\n109\t\n110\t\n111\t@pytest.fixture(scope=\"module\")\n112\tdef packaged_run(tmp_path_factory):\n113\t    base = tmp_path_factory.mktemp(\"lh1-packaged\")\n114\t    reading.run(base / \"full\")\n115\t    return base / \"full\"\n116\t\n117\t\n118\tdef test_t1_caller_run_drives_six_stages(plain, packaged_run):\n119\t    out, report, _ = plain\n120\t    manifest = json.loads((out / \"run.json\").read_bytes())\n121\t    assert manifest[\"format\"] == \"literature-reading-run/2\"\n122\t    assert [row[\"stage\"] for row in report[\"stages\"]] == list(reading.STAGES)\n123\t    assert report[\"public_routes\"][\"broad\"] == {\"verify\": 0, \"check\": 0}\n124\t    assert report[\"public_routes\"][\"targeted\"] == {\"verify\": 0, \"check\": 0}\n125\t    for index in range(6):\n126\t        ours = json.loads((out / f\"stage-{index}.json\").read_bytes())\n127\t        theirs = json.loads((packaged_run / f\"stage-{index}.json\").read_bytes())\n128\t        assert set(ours) == set(theirs)\n129\t    attempts = json.loads((out / \"payload-1.json\").read_bytes())[\"attempts\"]\n130\t    packaged_attempts = json.loads((packaged_run / \"payload-1.json\").read_bytes())[\"attempts\"]\n131\t    assert {frozenset(row) for row in attempts} == {frozenset(row) for row in packaged_attempts}\n132\t    coverage = json.loads((out / \"coverage.json\").read_bytes())[\"rows\"]\n133\t    packaged_coverage = json.loads((packaged_run / \"coverage.json\").read_bytes())[\"rows\"]\n134\t    assert {frozenset(row) for row in coverage} == {frozenset(row) for row in packaged_coverage}\n135\t    for name, raw in _files(out).items():\n136\t        for word in PACKAGED_NAMES:\n137\t            assert word.encode() not in raw, (name, word)\n138\t\n139\t\n140\tdef test_t2_calls_carry_the_section_bytes(plain):\n141\t    _, report, producer = plain\n142\t    roster = json.loads((CALLER / \"roster.json\").read_bytes())\n143\t    sections = {row[\"id\"]: row for row in roster[\"sections\"]}\n144\t    attempts = {row[\"section\"]: row for row in report[\"inspections\"]}\n145\t    for call in producer.seen:\n146\t        document = (CALLER / f\"{call.source}.txt\").read_bytes()\n147\t        start, end = sections[call.section][\"span\"]\n148\t        assert call.excerpt == document[start:end]\n149\t        assert call.excerpt_sha256 == sha256_hex(call.excerpt) == attempts[call.section][\"excerpt_sha256\"]\n150\t    seen = {stage: sum(call.stage == stage for call in producer.seen)\n151\t            for stage in (\"broad-extraction\", \"targeted-extraction\")}\n152\t    assert report[\"producer_calls\"] == seen\n153\t    method = next(call for call in producer.seen if call.section == \"a-methods\")\n154\t    assert {question[\"id\"] for question in method.questions} == {\"a-method\", \"a-baseline\"}\n155\t\n156\t\n157\tdef test_t3_live_responses_and_receipts_are_retained(tmp_path):\n158\t    root = _root(tmp_path, profile=_profile(review=True))\n159\t    out = tmp_path / \"run\"\n160\t    reading.run(out, fixture=root, producer=Producer(), reviewer=Reviewer())\n161\t    manifest = json.loads((out / \"run.json\").read_bytes())\n162\t    table = json.loads((out / \"producer-output-table.json\").read_bytes())\n163\t    assert table == {name: ANSWERS[name] for name in table}\n164\t    assert set(table) == {\"a-opening\", \"a-methods\", \"a-results\", \"b-opening\", \"b-methods\"}\n165\t    receipts = json.loads((out / \"reviews.json\").read_bytes())\n166\t    assert set(receipts) == {\"a-opening\", \"a-methods\", \"a-results\", \"b-opening\"}\n167\t    assert all(row[\"decision\"] == \"supported\" for row in receipts.values())\n168\t    for name in (\"producer-output-table.json\", \"reviews.json\"):\n169\t        assert manifest[\"artifacts\"][name] == sha256_hex((out / name).read_bytes())\n170\t    assert manifest[\"settings\"][\"reviewer\"] == \"live\"\n171\t\n172\t\n173\tdef test_t4_undeclared_steps_are_skipped(plain):\n174\t    out, report, _ = plain\n175\t    assert report[\"steps\"] == dict.fromkeys((\"review\", \"calibration\", \"conflict\", \"absence\"), \"skipped\")\n176\t    assert report[\"fidelity\"] is None\n177\t    assert report[\"absence\"] == {\"status\": \"skipped\", \"below_floor_status\": \"skipped\"}\n178\t    assert report[\"public_routes\"][\"reported-conflict\"] == \"skipped\"\n179\t    payload = json.loads((out / \"payload-5.json\").read_bytes())\n180\t    assert payload[\"fidelity\"] is None and payload[\"absence\"] == {\"high\": \"skipped\", \"low\": \"skipped\"}\n181\t    assert json.loads((out / \"payload-4.json\").read_bytes())[\"semantic_reviews\"] == []\n182\t    names = set(_files(out))\n183\t    assert not names & {\"fidelity-high.json\", \"fidelity-low.json\", \"reported-conflict.population.json\",\n184\t                        \"reported-conflict.source.txt\", \"scope.json\", \"closure.json\", \"reviews.json\"}\n185\t\n186\t\n187\tdef test_t5_declared_steps_run_on_the_callers_files(tmp_path):\n188\t    root = _root(tmp_path, declared=True)\n189\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Producer(), reviewer=Reviewer())\n190\t    assert report[\"steps\"] == dict.fromkeys((\"review\", \"calibration\", \"conflict\", \"absence\"), \"ran\")\n191\t    high, low = report[\"fidelity\"][\"high\"], report[\"fidelity\"][\"low\"]\n192\t    assert high[0] == high[1] and low[0] < low[1] == high[1]\n193\t    assert report[\"public_routes\"][\"reported-conflict\"] == {\"verify\": 1, \"check\": 1}\n194\t    assert report[\"absence\"] == {\"status\": \"qualified\", \"below_floor_status\": \"unavailable\"}\n195\t    population = json.loads((tmp_path / \"run/broad.population.json\").read_bytes())\n196\t    assert population[\"facts\"][\"paper_venue\"] == [{\"paper\": \"paper-a\", \"value\": \"Host workshop\"}]\n197\t\n198\t\n199\t@pytest.mark.parametrize(\"missing\", [\"gold.json\", \"calibration.json\", \"calibration.txt\", \"conflict.json\",\n200\t                                     \"conflict.txt\", \"scope.json\", \"closure.json\"])\n201\tdef test_t6_a_declared_file_that_is_missing_refuses(tmp_path, missing):\n202\t    root = _root(tmp_path, declared=True)\n203\t    (root / missing).unlink()\n204\t    out = tmp_path / \"run\"\n205\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden(), reviewer=Reviewer()))\n206\t\n207\t\n208\tdef test_t7_a_document_budget_ends_one_document(tmp_path):\n209\t    report = reading.run(tmp_path / \"run\", fixture=CALLER, producer=Producer(), document_budget=72)\n210\t    documents = {row[\"source\"]: row for row in report[\"documents\"]}\n211\t    assert \"a-methods\" in report[\"omitted\"]\n212\t    assert {row[\"section\"] for row in report[\"inspections\"]} >= {\"a-opening\", \"a-results\"}\n213\t    assert documents[\"survey-a\"][\"stop\"] == \"budget-exhausted\" and documents[\"survey-a\"][\"omitted\"] == 1\n214\t    assert documents[\"survey-b\"][\"omitted\"] == 0 and documents[\"survey-b\"][\"attempted\"] == 2\n215\t    assert documents[\"survey-b\"][\"stop\"] == \"available-evidence-exhausted\"\n216\t    assert report[\"stop\"] == \"budget-exhausted\"\n217\t    assert sum(row[\"reading_bytes\"] for row in documents.values()) == report[\"reading_bytes\"]\n218\t\n219\t\n220\tdef test_t7_a_source_with_nothing_required_is_complete(tmp_path):\n221\t    root = _root(tmp_path)\n222\t\n223\t    def relax(roster):\n224\t        for question in roster[\"questions\"]:\n225\t            if question[\"id\"].startswith(\"b-\"):\n226\t                question[\"required\"] = False\n227\t\n228\t    _edit(root, \"roster.json\", relax)\n229\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Producer(), document_budget=72)\n230\t    documents = {row[\"source\"]: row for row in report[\"documents\"]}\n231\t    assert documents[\"survey-b\"][\"stop\"] == \"required-coverage-completed\"\n232\t\n233\t\n234\tdef test_t7_resolved_required_questions_do_not_end_a_document(tmp_path):\n235\t    root = _root(tmp_path)\n236\t\n237\t    def relax(roster):\n238\t        next(row for row in roster[\"questions\"] if row[\"id\"] == \"a-method\")[\"required\"] = False\n239\t\n240\t    _edit(root, \"roster.json\", relax)\n241\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Producer())\n242\t    documents = {row[\"source\"]: row for row in report[\"documents\"]}\n243\t    assert documents[\"survey-a\"][\"stop\"] == \"required-coverage-completed\"\n244\t    assert {\"a-methods\", \"a-results\"} <= {row[\"section\"] for row in report[\"inspections\"]}\n245\t\n246\t\n247\tdef test_t8_lowered_limits_are_honoured(tmp_path):\n248\t    out = tmp_path / \"run\"\n249\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(), limits=ReadingLimits(roster=2)))\n250\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(), budget=5000,\n251\t                                      limits=ReadingLimits(max_budget=4096)))\n252\t\n253\t\n254\tdef test_t8_a_raised_input_cap_admits_a_large_source(tmp_path):\n255\t    root = _root(tmp_path)\n256\t    path = root / \"survey-a.txt\"\n257\t    path.write_bytes(path.read_bytes() + b\"x\" * (200 * 1024))\n258\t\n259\t    def repin(roster):\n260\t        roster[\"sources\"][0][\"sha256\"] = sha256_hex(path.read_bytes())\n261\t\n262\t    _edit(root, \"roster.json\", repin)\n263\t    out = tmp_path / \"run\"\n264\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden()))\n265\t    limits = ReadingLimits(input_bytes=1 << 20)\n266\t    reading.run(out, fixture=root, producer=Producer(), limits=limits)\n267\t    settings = json.loads((out / \"run.json\").read_bytes())[\"settings\"]\n268\t    assert settings[\"limits\"][\"input_bytes\"] == 1 << 20\n269\t    assert settings[\"limits\"][\"roster\"] == reading.ROSTER_LIMIT\n270\t\n271\t\n272\t@pytest.mark.parametrize(\"field\", sorted(reading.LIMIT_CEILINGS))\n273\tdef test_t8_a_limit_above_its_ceiling_refuses(tmp_path, field):\n274\t    out = tmp_path / \"run\"\n275\t    limits = ReadingLimits(**{field: reading.LIMIT_CEILINGS[field] + 1})\n276\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(), limits=limits))\n277\t\n278\t\n279\t@pytest.mark.parametrize(\"value\", [0, True, 1.5])\n280\tdef test_t8_a_limit_must_be_a_positive_int(tmp_path, value):\n281\t    out = tmp_path / \"run\"\n282\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(),\n283\t                                      limits=ReadingLimits(roster=value)))\n284\t\n285\t\n286\tdef _deep(depth):\n287\t    value = []\n288\t    for _ in range(depth):\n289\t        value = [value]\n290\t    return value\n291\t\n292\t\n293\tMALFORMED = {\n294\t    \"not-a-mapping\": [\"accepted\"],\n295\t    \"key-missing\": {\"outcome\": \"empty\", \"facts\": {}},\n296\t    \"outcome\": {\"outcome\": \"maybe\", \"facts\": {}, \"proposal_keys\": []},\n297\t    \"accepted-empty\": {\"outcome\": \"accepted\", \"facts\": {}, \"proposal_keys\": []},\n298\t    \"empty-with-facts\": {\"outcome\": \"empty\", \"facts\": {\"paper_title\": []}, \"proposal_keys\": []},\n299\t    \"facts-list\": {\"outcome\": \"accepted\", \"facts\": [], \"proposal_keys\": []},\n300\t    \"fact-not-list\": {\"outcome\": \"accepted\", \"facts\": {\"paper_title\": {}}, \"proposal_keys\": []},\n301\t    \"row-not-mapping\": {\"outcome\": \"accepted\", \"facts\": {\"paper_title\": [\"x\"]}, \"proposal_keys\": []},\n302\t    \"nested-row-value\": {\"outcome\": \"accepted\", \"facts\": {\"paper_title\": [{\"paper\": {\"id\": \"a\"}}]},\n303\t                         \"proposal_keys\": []},\n304\t    \"nan\": {\"outcome\": \"accepted\", \"facts\": {\"paper_title\": [{\"paper\": float(\"nan\")}]}, \"proposal_keys\": []},\n305\t    \"object\": {\"outcome\": \"accepted\", \"facts\": {\"paper_title\": [{\"paper\": object()}]}, \"proposal_keys\": []},\n306\t    \"integer-key\": {\"outcome\": \"accepted\", \"facts\": {1: [{\"paper\": \"a\"}]}, \"proposal_keys\": []},\n307\t    \"deep\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": _deep(100_000)},\n308\t    \"oversized\": {\"outcome\": \"accepted\", \"proposal_keys\": [],\n309\t                  \"facts\": {\"paper_title\": [{\"paper\": \"a\", \"title\": \"x\" * (128 * 1024)}]}},\n310\t    \"proposal-not-string\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": [1]},\n311\t    \"proposal-outside-roster\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": [\"unknown\"]},\n312\t    \"fact-type-outside-covers\": {\"outcome\": \"accepted\", \"facts\": {\"paper_author\": [{\"paper\": \"a\"}]},\n313\t                                 \"proposal_keys\": []},\n314\t}\n315\t\n316\t\n317\t@pytest.mark.parametrize(\"case\", sorted(MALFORMED))\n318\tdef test_t9_a_malformed_response_refuses(tmp_path, case):\n319\t    answers = {**ANSWERS, \"a-opening\": MALFORMED[case]}\n320\t    out = tmp_path / \"run\"\n321\t    with pytest.raises(reading.ExampleError):\n322\t        reading.run(out, fixture=CALLER, producer=Producer(answers))\n323\t    assert not out.exists()\n324\t\n325\t\n326\tdef test_t10_a_raising_producer_refuses_naming_the_section(tmp_path):\n327\t    class Raising(Producer):\n328\t        def produce(self, call):\n329\t            if len(self.seen) == 1:\n330\t                raise RuntimeError(\"provider down\")\n331\t            return super().produce(call)\n332\t\n333\t    out = tmp_path / \"run\"\n334\t    with pytest.raises(reading.ExampleError, match=\"producer failed at broad-extraction b-opening\") as caught:\n335\t        reading.run(out, fixture=CALLER, producer=Raising())\n336\t    assert isinstance(caught.value.__cause__, RuntimeError)\n337\t    assert not out.exists()\n338\t\n339\t\n340\t@pytest.mark.parametrize((\"name\", \"args\"), [\n341\t    (\"full\", {}), (\"unavailable\", {\"scenario\": \"unavailable\"}), (\"budget-0\", {\"budget\": 0}),\n342\t])\n343\tdef test_t11_packaged_runs_keep_their_bytes(tmp_path, name, args):\n344\t    out = tmp_path / name\n345\t    reading.run(out, **args)\n346\t    recorded = _files(PACKAGED / name)\n347\t    assert tree_as_recorded(_files(out), RECORDED_AT) == recorded\n348\t    assert sha256_hex(recorded[\"run.json\"]) == P3[name]\n349\t\n350\t\n351\tdef _wide_root(tmp_path, count, *, chain=False, span=1, response_sections=None):\n352\t    \"\"\"A caller root with ``count`` sources, sections and questions, one section each.\"\"\"\n353\t    root = tmp_path / f\"wide-{count}\"\n354\t    root.mkdir()\n355\t    for name in (\"survey.orm.json\", \"terms.orm.json\"):\n356\t        shutil.copyfile(CALLER / name, root / name)\n357\t    (root / \"profile.json\").write_bytes(canonical_json_bytes(_profile()))\n358\t    sources, sections, questions = [], [], []\n359\t    for index in range(count):\n360\t        document = b\"x\" * span\n361\t        (root / f\"s{index}.txt\").write_bytes(document)\n362\t        sources.append({\"id\": f\"s{index}\", \"version\": \"1\", \"path\": f\"s{index}.txt\", \"sha256\": sha256_hex(document)})\n363\t        eligible = response_sections is None or index < response_sections\n364\t        sections.append({\"id\": f\"c{index}\", \"source\": f\"s{index}\", \"kind\": \"section\",\n365\t                         \"selection\": \"opening\" if eligible else None, \"keys\": [],\n366\t                         \"span\": [0, span] if eligible else None, \"reason\": None if eligible else \"unavailable\"})\n367\t        questions.append({\"id\": f\"q{index}\", \"section\": f\"c{index}\", \"fact\": \"paper_finding\", \"required\": True,\n368\t                          \"superseded_by\": f\"q{index + 1}\" if chain and index + 1 < count else None,\n369\t                          \"denial\": False})\n370\t    roster = {\"format\": \"literature-reading-roster/1\", \"sources\": sources, \"sections\": sections,\n371\t              \"questions\": questions, \"revisit_keys\": [\"k\" * 1000]}\n372\t    (root / \"roster.json\").write_bytes(canonical_json_bytes(roster))\n373\t    return root\n374\t\n375\t\n376\tdef test_t12_inputs_at_each_roster_ceiling_load_in_time(tmp_path):\n377\t    root = _wide_root(tmp_path, 4096, chain=True)\n378\t    limits = ReadingLimits(roster=4096, input_bytes=8 << 20)\n379\t    started = time.monotonic()\n380\t    inputs = reading.ReadingInputs(root, limits=limits, live=True)\n381\t    assert time.monotonic() - started < 10\n382\t    assert len(inputs.sources) == len(inputs.sections) == len(inputs.questions) == 4096\n383\t    assert reading._terminal(inputs.questions)[\"q0\"] == \"q4095\"\n384\t\n385\t\n386\tdef test_t12_a_run_at_the_roster_ceiling_finishes_in_time(tmp_path):\n387\t    root = _wide_root(tmp_path, 4096, chain=True)\n388\t    limits = ReadingLimits(roster=4096, input_bytes=8 << 20, response_bytes=1024)\n389\t\n390\t    class Empty:\n391\t        def produce(self, call):\n392\t            return {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []}\n393\t\n394\t    started = time.monotonic()\n395\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Empty(), limits=limits)\n396\t    assert time.monotonic() - started < 90\n397\t    assert report[\"producer_calls\"][\"broad-extraction\"] == 4096\n398\t\n399\t\n400\tdef test_t12_input_response_and_budget_ceilings_run_in_time(tmp_path):\n401\t    root = _root(tmp_path)\n402\t    path = root / \"survey-a.txt\"\n403\t    path.write_bytes(path.read_bytes() + b\"x\" * ((8 << 20) - len(path.read_bytes())))\n404\t\n405\t    def repin(roster):\n406\t        roster[\"sources\"][0][\"sha256\"] = sha256_hex(path.read_bytes())\n407\t\n408\t    _edit(root, \"roster.json\", repin)\n409\t    title = \"y\" * ((1 << 20) - 200)\n410\t    answers = {**ANSWERS, \"a-opening\": {\"outcome\": \"accepted\", \"proposal_keys\": [],\n411\t                                        \"facts\": {\"paper_title\": [{\"paper\": \"paper-a\", \"title\": title}]}}}\n412\t    assert len(canonical_json_bytes(answers[\"a-opening\"])) <= 1 << 20\n413\t    limits = ReadingLimits(input_bytes=8 << 20, response_bytes=1 << 20, max_budget=1 << 26)\n414\t    started = time.monotonic()\n415\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Producer(answers), limits=limits,\n416\t                         budget=1 << 26)\n417\t    assert time.monotonic() - started < 60\n418\t    assert report[\"public_routes\"][\"broad\"][\"verify\"] in reading.CALLER_EXITS\n419\t\n420\t\n421\tdef test_t12_a_route_held_past_its_timeout_refuses_in_time(tmp_path, monkeypatch):\n422\t    from gnd.examples.literature import depth\n423\t\n424\t    real = depth.run_bounded_process\n425\t\n426\t    def sleeping(argv, **kwargs):\n427\t        return real((sys.executable, \"-c\", \"import time; time.sleep(30)\"), **kwargs)\n428\t\n429\t    monkeypatch.setattr(depth, \"run_bounded_process\", sleeping)\n430\t    out = tmp_path / \"run\"\n431\t    started = time.monotonic()\n432\t    with pytest.raises(reading.ExampleError, match=\"extract failed to finish\"):\n433\t        reading.run(out, fixture=CALLER, producer=Forbidden(), limits=ReadingLimits(route_seconds=1))\n434\t    assert time.monotonic() - started < 1 + 2\n435\t    assert not out.exists()\n436\t\n437\t\n438\tdef test_t12_route_output_at_its_ceiling_is_read_in_time(tmp_path):\n439\t    from gnd.examples.literature import depth\n440\t\n441\t    limits = reading._route_limits(ReadingLimits(route_output_bytes=16 << 20))\n442\t    script = \"import sys; sys.stdout.write('x' * (16 << 20))\"\n443\t    started = time.monotonic()\n444\t    import asyncio\n445\t\n446\t    from gnd.process import run_bounded_process\n447\t    result = asyncio.run(run_bounded_process((sys.executable, \"-c\", script), cwd=tmp_path, env={}, limits=limits))\n448\t    assert time.monotonic() - started < 60\n449\t    assert result.status == \"succeeded\" and not result.stdout_truncated and len(result.stdout) == 16 << 20\n450\t    smaller = reading._route_limits(ReadingLimits(route_output_bytes=1 << 20))\n451\t    result = asyncio.run(run_bounded_process((sys.executable, \"-c\", script), cwd=tmp_path, env={}, limits=smaller))\n452\t    assert result.status not in {\"succeeded\", \"failed\"} or result.stdout_truncated\n453\t    assert depth.PROCESS_LIMITS.stdout_limit_bytes == 1 << 20\n454\t\n455\t\n456\tdef test_t13_refusals_before_any_producer_call(tmp_path):\n457\t    root = _root(tmp_path)\n458\t    _edit(root, \"survey.orm.json\", lambda model: model[\"fact_types\"][0][\"roles\"][0].update(object_type=\"absent\"))\n459\t    out = tmp_path / \"run\"\n460\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden()), \"extract exited\")\n461\t    _refuses(out, lambda: reading.run(out, producer=Forbidden()), \"need profile.json\")\n462\t    for argument in ({\"reviewer\": Reviewer()}, {\"document_budget\": 10}, {\"unavailable\": []},\n463\t                     {\"limits\": ReadingLimits()}):\n464\t        _refuses(out, lambda argument=argument: reading.run(out, **argument), \"need profile.json\")\n465\t\n466\t\n467\tdef test_t15_an_empty_constrained_fact_type_completes_with_exit_2(tmp_path):\n468\t    answers = {**ANSWERS,\n469\t               \"a-opening\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []},\n470\t               \"b-opening\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []},\n471\t               \"a-methods\": {\"outcome\": \"accepted\", \"proposal_keys\": [], \"facts\": {\n472\t                   **ANSWERS[\"a-methods\"][\"facts\"],\n473\t                   \"paper_title\": [{\"paper\": \"paper-a\", \"title\": \"Graph sampling at scale\"}]}}}\n474\t    report = reading.run(tmp_path / \"run\", fixture=CALLER, producer=Producer(answers))\n475\t    assert report[\"public_routes\"][\"broad\"] == {\"verify\": 2, \"check\": 2}\n476\t    assert report[\"public_routes\"][\"targeted\"] == {\"verify\": 0, \"check\": 0}\n477\t\n478\t\n479\tdef test_t15_a_violated_constraint_completes_with_exit_1(tmp_path):\n480\t    answers = {**ANSWERS, \"a-results\": {\"outcome\": \"accepted\", \"proposal_keys\": [], \"facts\": {\n481\t        \"paper_title\": [{\"paper\": \"paper-a\", \"title\": \"Sampling graphs at scale\"}]}}}\n482\t    report = reading.run(tmp_path / \"run\", fixture=CALLER, producer=Producer(answers))\n483\t    assert report[\"public_routes\"][\"targeted\"] == {\"verify\": 1, \"check\": 1}\n484\t\n485\t\n486\tdef test_t15_an_unchecked_rule_completes_with_exit_4(tmp_path):\n487\t    root = _root(tmp_path)\n488\t\n489\t    def textual(model):\n490\t        model[\"constraints\"] = [{\"id\": \"host_note\", \"type\": \"textual\", \"source\": \"explicit\", \"status\": \"confirmed\",\n491\t                                 \"modality\": \"alethic\", \"provenance\": {\"user_quote\": \"host_note\"},\n492\t                                 \"expression\": \"every finding is reproducible\"}]\n493\t\n494\t    _edit(root, \"survey.orm.json\", textual)\n495\t    report = reading.run(tmp_path / \"run\", fixture=root, producer=Producer())\n496\t    assert report[\"public_routes\"][\"targeted\"][\"check\"] == 4\n497\t    assert reading.CALLER_EXITS == (0, 1, 2, 4)\n498\t\n499\t\n500\tdef test_t15_any_other_route_exit_refuses(tmp_path, monkeypatch):\n501\t    original = reading._command\n502\t\n503\t    def exit_five(out, *args, limits=None):\n504\t        result = original(out, *args, limits=limits)\n505\t        return re
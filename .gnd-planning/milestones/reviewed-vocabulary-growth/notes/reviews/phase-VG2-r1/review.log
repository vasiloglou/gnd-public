def _document(n: int) -> bytes:
    return (FIXTURES / f"round-{n}.txt").read_bytes()


def _operations(reply: dict[str, Any], raw: bytes) -> tuple[Any, ...]:
    """The reply as additive operations: elements first, then each constraint with its host."""
    model = growth._translate(reply, raw)
    operations: list[Any] = []

    def add(locator: Any, after: dict[str, Any]) -> None:
        operations.append(policy._op("add", locator, after=after, operation_id=f"op-{len(operations)}"))

    for element in model["object_types"]:
        add(policy._element("object_types", element["id"]), element)
    for fact in model["fact_types"]:
        element = {key: value for key, value in fact.items() if key != "constraints"}
        for key in ("sample_population",):
            if not element.get(key):
                element.pop(key, None)
        if not element["provenance"].get("sample_spans"):
            element["provenance"].pop("sample_spans", None)
        add(policy._element("fact_types", fact["id"]), element)
    for fact in model["fact_types"]:
        for constraint in fact.get("constraints", []):
            add(policy._constraint_locator(fact["id"], None, constraint["type"]), constraint)
    for constraint in model["constraints"]:
        add(policy._constraint_locator(None, None, constraint["type"]), constraint)
    return tuple(operations)


# --- the replay driver: one workspace, one proposal and preview path per round --------------------


def _workspace(root: Path) -> dict[str, Path]:
    root.mkdir(parents=True, exist_ok=True)
    (root / "records").mkdir(exist_ok=True)
    model = root / "model.orm.yaml"
    model.write_text(SEED.read_text(encoding="utf-8"), encoding="utf-8")
    (root / "model.verbalization.txt").write_text("pre-existing\n", encoding="utf-8")
    return {"workspace": root, "model": model, "records": root / "records"}


def _declare(model_path: Path, raw: bytes, label: str) -> None:
    """Declare a document in the model file, outside `evolve` (the O20 gap: UG3 (i) retires this)."""
    yaml = YAML()
    yaml.preserve_quotes = True
    document = yaml.load(model_path.read_text(encoding="utf-8"))
    document["source"]["documents"].append({"sha256": sha256_bytes(raw), "label": label})
    with model_path.open("w", encoding="utf-8") as handle:
        yaml.dump(document, handle)


def _round_paths(ws: dict[str, Path], tag: str) -> dict[str, Path]:
    return {**ws, "proposal": ws["workspace"] / f"proposal-{tag}.json", "preview": ws["workspace"] / f"preview-{tag}.json"}


def _write_proposal(ws: dict[str, Path], tag: str, operations: tuple[Any, ...]) -> dict[str, Path]:
    paths = _round_paths(ws, tag)
    text = ws["model"].read_text(encoding="utf-8")
    proposal = policy._proposal(text, operations, proposal_id=f"ug1-{tag}")
    paths["proposal"].write_text(json.dumps(proposal.model_dump(mode="json"), indent=2, sort_keys=True) + "\n",
                                 encoding="utf-8")
    return paths


def _preview(paths: dict[str, Path], *extra: str, expect: int = 0) -> tuple[dict[str, Any] | None, Any]:
    """Run preview with `extra` flags; assert the exit before reading the preview file."""
    result = run_main(policy._preview_argv(paths, *extra))
    assert result.returncode == expect, (result.returncode, result.stderr.decode())
    document = json.loads(paths["preview"].read_text(encoding="utf-8")) if paths["preview"].exists() else None
    return document, result


def _validate(model: Path, documents: tuple[Path, ...] = (), *, expect: int = 0) -> dict[str, Any]:
    argv = ["validate", str(model), "--format", "json"]
    for document in documents:
        argv += ["--document", str(document)]
    result = run_main(argv)
    assert result.returncode == expect, (result.returncode, result.stderr.decode(), result.stdout.decode()[:400])
    return json.loads(result.stdout)


def _round(ws: dict[str, Path], n: int, reply: dict[str, Any]) -> dict[str, Any]:
    """Declare the round's document, preview with the additive policy and shape report, apply."""
    raw = _document(n)
    _declare(ws["model"], raw, f"round-{n}.txt")
    paths = _write_proposal(ws, f"r{n}", _operations(reply, raw))
    preview, _result = _preview(paths, "--policy", "additive", "--shape-report")
    result = run_main(policy._apply_argv(paths, "--policy", "additive"))
    assert result.returncode == 0, (result.returncode, result.stderr.decode())
    return preview


def _shape_groups(preview: dict[str, Any]) -> list[dict[str, Any]]:
    return preview["shape_matches"]


# --- T1: three rounds, three documents, no reviewer -----------------------------------------------

"""The unattended-growth guidance in gnd-model-from-text, held to the code.

Reference: src/gnd/skills/gnd-model-from-text/references/unattended-growth.md.
The reference makes two kinds of claim that can drift: what `--policy additive`
admits, and that its reply shape is enough to build a model that passes
`gnd validate --document`. The translator below is a test-only reading of the
reply shape's mapping table, not a shipped API.
"""

from __future__ import annotations

import copy
import hashlib
import io
import json
import re
import unicodedata
from pathlib import Path
from typing import Any

import pytest
import test_evolve_additive_policy as policy
from ruamel.yaml import YAML
from support.cli_runner import run_main

REPO_ROOT = Path(__file__).resolve().parent.parent
REFERENCE = REPO_ROOT / "src/gnd/skills/gnd-model-from-text/references/unattended-growth.md"
FIXTURES = REPO_ROOT / "tests" / "fixtures" / "unattended-growth"
DOCUMENT = FIXTURES / "policy.txt"
REPLY = FIXTURES / "reply.json"


def _span(raw: bytes, quote: str, occurrence: int | None = None) -> dict[str, Any]:
    """The host's job: locate a verbatim quote in the NFC text; refuse a missing or ambiguous one."""
    text = unicodedata.normalize("NFC", raw.decode("utf-8"))
    starts = [m.start() for m in re.finditer(re.escape(quote), text)]
    if occurrence is None:
        assert len(starts) == 1, f"quote {quote!r} must occur exactly once, found {len(starts)}"
        start = starts[0]
    else:
        start = starts[occurrence]
    end = start + len(quote)
    return {
        "document_sha256": hashlib.sha256(raw).hexdigest(),
        "start": start,
        "end": end,
        "excerpt_sha256": hashlib.sha256(text[start:end].encode("utf-8")).hexdigest(),
    }


_SOURCE_BY_BASIS = {"text-cue": "llm-inferred", "rows": "sample", "library": "common-sense"}


def _translate(reply: dict[str, Any], raw: bytes) -> dict[str, Any]:
    digest = hashlib.sha256(raw).hexdigest()

    def spans(entry: dict[str, Any]) -> list[dict[str, Any]]:
        return [_span(raw, entry["quote"], entry.get("quote_occurrence"))]

    object_types: list[dict[str, Any]] = []
    for entry in reply["object_types"]:
        element = {k: v for k, v in entry.items() if k != "quote"}
        element["provenance"] = {"spans": spans(entry)}
        object_types.append(element)
    by_id = {element["id"]: element for element in object_types}
    for link in reply["subtype_links"]:
        subtype = by_id[link["subtype"]]
        subtype["subtype_of"] = [link["supertype"]]
        subtype["inherits_reference"] = link["inherits_reference"]
        subtype["provenance"]["spans"].append(_span(raw, link["quote"]))
        subtype["provenance"]["rationale"] = link["rationale"]

    fact_types: list[dict[str, Any]] = []
    for entry in reply["fact_types"]:
        element = {k: v for k, v in entry.items() if k not in {"quote", "rows"}}
        element["sample_population"] = [row["values"] for row in entry["rows"]]
        element["provenance"] = {
            "spans": spans(entry),
            "sample_spans": [{"row": i, "span": _span(raw, row["quote"])} for i, row in enumerate(entry["rows"])],
        }
        fact_types.append(element)

    for entry in reply.get("derived_fact_types", ()):   # the acceptance replay builds replies without it
        # A derived fact type is the model's own fact type shape with a structured rule. It
        # holds no rows: its facts follow from the rule, so there is nothing to sample.
        assert isinstance(entry["derivation_rule"], dict), "an opaque rule is an open question, not a proposal"
        assert "rows" not in entry
        element = {k: v for k, v in entry.items() if k not in {"quote", "rationale"}}
        element["provenance"] = {"spans": spans(entry), "rationale": entry["rationale"]}
        fact_types.append(element)

    top_level: list[dict[str, Any]] = []
    for entry in reply["constraints"]:
        constraint = copy.deepcopy(entry["constraint"])
        constraint.update(
            source=_SOURCE_BY_BASIS[entry["basis"]], status="proposed", modality="deontic",
            rationale=entry["rationale"],
        )
        if entry["basis"] == "library":
            constraint["provenance"] = {"library_entry": entry["library_entry"]}
        else:
            constraint["provenance"] = {"spans": spans(entry)}
            if entry["basis"] == "text-cue":
                constraint["provenance"]["rationale_world_fact"] = entry["cue"]
        if entry["host"] == "model":
            top_level.append(constraint)
        else:
            next(f for f in fact_types if f["id"] == entry["host"]).setdefault("constraints", []).append(constraint)

    return {
        "version": 1,
        "model_id": "unattended-growth-example",
        "source": {"kind": "prose", "mode": "unattended", "reviewer": "none",
                   "documents": [{"sha256": digest, "label": reply["document"]}]},
        "object_types": object_types,
        "fact_types": fact_types,
        "constraints": top_level,
    }


def _validate(model: dict[str, Any], tmp_path: Path) -> tuple[int, dict[str, Any]]:
    buffer = io.StringIO()
    YAML().dump(model, buffer)
    path = tmp_path / "model.orm.yaml"
    path.write_text(buffer.getvalue(), encoding="utf-8")
    result = run_main(["validate", str(path), "--document", str(DOCUMENT), "--format", "json"])
    return result.returncode, json.loads(result.stdout)


def test_the_reply_shape_builds_a_model_that_validates(tmp_path: Path) -> None:
    """Subtype link, uniqueness, mandatory, enumeration and a library hit, all `proposed` and `deontic`."""
    reply = json.loads(REPLY.read_text(encoding="utf-8"))
    model = _translate(reply, DOCUMENT.read_bytes())
    exit_code, payload = _validate(model, tmp_path)
    assert exit_code == 0, payload.get("issues")
    constraints = [c for f in model["fact_types"] for c in f.get("constraints", [])] + model["constraints"]
    assert {(c["status"], c["modality"]) for c in constraints} == {("proposed", "deontic")}
    assert {c["source"] for c in constraints} == {"llm-inferred", "common-sense"}
    # Issue 104, ask 4: a derived fact type travels in the same reply, with its quote.
    (derived,) = [f for f in model["fact_types"] if f.get("derivation") == "derived"]
    assert derived["id"] == "policy_is_covered" and isinstance(derived["derivation_rule"], dict)
    assert len(derived["provenance"]["spans"]) == 1 and "sample_population" not in derived


def test_a_derived_fact_type_without_its_quote_does_not_validate(tmp_path: Path) -> None:
    """The quote is what `gnd validate --document` holds a derived fact type to, like any element."""
    reply = json.loads(REPLY.read_text(encoding="utf-8"))
    model = _translate(reply, DOCUMENT.read_bytes())
    (derived,) = [f for f in model["fact_types"] if f.get("derivation") == "derived"]
    del derived["provenance"]["spans"]
# MG2 additive-policy fixture (spec §Tests). No `operations`, so the
# operations gate (exit 18) never pre-empts a policy cell.
#
# customer_places_order is POPULATED (two sample rows); order_has_amount is
# the unpopulated control with the same constraint shapes. Constraints that
# the cases modify are user-supplied/confirmed or llm-inferred/proposed/
# deontic, the two shapes D-12 admits for a changed constraint.
version: 1
model_id: evolve-policy-base
source: { kind: fixture }
object_types:
  - id: customer
    name: Customer
    kind: entity
    reference: { mode: popular, value_type: customer_id }
    description: { summary: "A party that places orders." }
    provenance: { rationale: "Named in the brief." }
  - id: customer_id
    name: CustomerId
    kind: value
    primitive: Integer
  - id: order
    name: Order
    kind: entity
    reference: { mode: popular, value_type: order_id }
  - id: order_id
    name: OrderId
    kind: value
    primitive: Integer
  - id: amount
    name: Amount
    kind: value
    primitive: Integer
  - id: channel
    name: Channel
    kind: value
    primitive: String
  # Unreferenced by any constraint: the subject of the RENAME and DELETE cells,
  # whose candidates stay valid without touching anything else.
  - id: note
    name: Note
    kind: value
    primitive: String
  - id: memo
    name: Memo
    kind: value
    primitive: String
fact_types:
  - id: customer_places_order
    reading: "{Customer} places {Order} via {Channel}"
    roles:
      - { object_type: customer, role_name: customer }
      - { object_type: order, role_name: order }
      - { object_type: channel, role_name: channel }
    sample_population:
      - { customer: 1, order: 10, channel: web }
      - { customer: 2, order: 11, channel: web }
    provenance: { rationale: "Populated by the first extraction round." }
    constraints:
      - type: uniqueness
        roles: [order, channel]
        source: user-supplied
        status: confirmed
        modality: alethic
        provenance: { user_quote: "An order is placed once per channel." }
      - type: value
        object_type: channel
        role_ref: { fact_type: customer_places_order, role: channel }
        allowed: [web, phone, store]
        source: user-supplied
        status: confirmed
        modality: alethic
        provenance: { user_quote: "Orders arrive by web, phone or in store." }
      - type: frequency
        scope: internal
        roles: [customer]
        bound: { min: 1, max: 10 }
        source: user-supplied
        status: confirmed
        modality: deontic
        provenance: { user_note: "A customer places at most ten orders." }
      - type: value
        object_type: order
        role_ref: { fact_type: customer_places_order, role: order }
        range: { min: 1, max: 1000, min_inclusive: true, max_inclusive: true }
        source: llm-inferred
        status: proposed
        modality: deontic
        rationale: "Order numbers are small positive integers."
        provenance: { rationale_world_fact: "Order numbers are assigned sequentially from one." }
  - id: order_has_amount
    reading: "{Order} has {Amount}"
    roles:
      - { object_type: order, role_name: order }
      - { object_type: amount, role_name: amount }
    constraints:
      - type: uniqueness
        roles: [order]
        source: user-supplied
        status: confirmed
        modality: alethic
        provenance: { user_quote: "An order has one amount." }
      - type: value
        object_type: amount
        role_ref: { fact_type: order_has_amount, role: amount }
        range: { min: 0, max: 100000 }
        source: llm-inferred
        status: proposed
        modality: deontic
        rationale: "Amounts are non-negative and bounded."
        provenance: { rationale_world_fact: "Retail amounts are bounded." }
  # No constraints and unreferenced by hosted constraints: the subject of the
  # fact-type RENAME/DELETE and role MODIFY/RENAME cells.
  - id: order_has_memo
    reading: "{Order} has {Memo}"
    roles:
      - { object_type: order, role_name: order }
      - { object_type: memo, role_name: memo }
constraints:
  # An induced, proposed rule spanning the populated fact type: the one shape
  # whose proposed -> confirmed transition D-12 admits as a reviewed status
  # change, so the policy's (p1) F ruling is reachable at the service level.
  - type: guarded
    antecedent:
      - { fact_type: customer_places_order, bind: { customer: $c, order: $o, channel: $ch } }
      - { fact_type: order_has_amount, bind: { order: $o, amount: $a } }
    consequent: { comparison: { left: $a, operator: "<=", right: 100000 } }
    source: induced
    status: proposed
    modality: deontic
    rationale: "learned by popper 0.0.0+authored from manifest dbec4c36, clause 0"
    provenance:
      induction:
        method: ilp-neutral
        inducer: { name: popper, version: 0.0.0+authored }
        manifest_sha256: dbec4c367f7b912c1c92b0ad73b037c9d7dc2b5c7003838e3b1d8cd2970d9bf5
        support: { numerator: 2, denominator: 2 }
        examples: [n1, n2]
        counterexamples: []
        evidence:
          - { ref: ilp/export.json, sha256: 3274fb8975386692226bbdf52186163d4493cfa36bd5cf3b266fe5d7f6a1fc61 }
          - { ref: ilp/clauses, sha256: 52066321e4d1ea260fd16803b796485ba168c436bc36b5a5b973c93107972fa8 }
          - { ref: ilp/run, sha256: cc981d873c7125b9d9078c8d2c912da37acf680793e6caead6095f6cd70174a6 }
  # Spans only unpopulated fact types: the subject of review F1's retarget case.
  - type: exclusion
    role_seq_a:
      - { fact_type: order_has_memo, role: order }
    role_seq_b:
      - { fact_type: order_has_amount, role: order }
    source: user-supplied
    status: confirmed
    modality: deontic
    provenance: { user_note: "An order carries a memo or an amount, not both." }
  - type: subset
    subset_role_seq:
      - { fact_type: order_has_amount, role: order }
    superset_role_seq:
      - { fact_type: customer_places_order, role: order }
    source: user-supplied
    status: confirmed
    modality: deontic
    provenance: { user_note: "An order with an amount was placed by someone." }
[project]
# D-01: `gnd` has been taken on PyPI since 2022, so the DISTRIBUTION is
# `get-nick-done`. The import package and the console script both stay `gnd` —
# only the name users type after `uv tool install` changes.
name = "get-nick-done"
version = "0.4.0"
description = "GND — Get Nick Done: ORM-grounded agentic development runtime (model authoring, population checking)"
# Issue 175: without this key the wheel and sdist carry no long description and
# the PyPI project page shows no text. PYPI.md is a short description written
# for that page: every link in it is absolute, because PyPI does not resolve the
# repository README's relative links or its image, and it names no version, so a
# release does not edit it. tests/test_package_description.py holds both rules.
readme = "PYPI.md"
authors = [
    { name = "Nikolaos Vasiloglou", email = "nvasil@gmail.com" }
]
requires-python = ">=3.11"
license = "Apache-2.0"
license-files = ["LICENSE", "NOTICE"]
# D-18: the base install stays these three. Phase 2's synthetic-data stack
# (polyfactory / faker / hypothesis) lands behind an optional extra when there is
# something to put in it — do NOT scaffold an empty extra now. A fourth entry
# here fails tests/test_packaged_skills.py::test_base_dependency_set_is_frozen,
# which is the mechanical form of this policy.
dependencies = [
    "jsonschema==4.26.0",
    "pydantic==2.13.4",
    "ruamel-yaml==0.19.1",
]

# D-18: the base install above is deliberately untouched. Phase 2's synthetic-data
# stack lands here, behind an OPTIONAL extra, so a user who only runs `gnd check`
# never receives it. `faker` was cleared through the phase's blocking-human
# package-legitimacy gate (02-02 Task 1) before being pinned: PyPI `Faker`, first
# released 2010-12-23, 503 releases, repo github.com/joke2k/faker. Polyfactory and
# Hypothesis are NOT installed — Polyfactory was refuted by measurement (D-17,
# 0/8 ages in a declared 18..65 range; 8/8 distinct entities forcing zero-row
# joins) and Hypothesis is deferred. Adding either here, or promoting faker into
# [project.dependencies], fails tests/test_packaged_skills.py.
[project.optional-dependencies]
synth = ["faker==40.36.0"]

[project.urls]
Repository = "https://github.com/vasiloglou/gnd-public"
Issues = "https://github.com/vasiloglou/gnd-public/issues"

[project.scripts]
# PKG-01. The generated wrapper wraps the call in `sys.exit()`, so `main`'s
# existing `int` return IS the process exit code and the 0-4/64/70 band contract
# in gnd/cli.py survives untouched. `python -m gnd` keeps working (D-03) as a
# development convenience; this is the documented interface.
gnd = "gnd.cli:main"

[build-system]
requires = ["uv_build>=0.10.10,<0.11.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
# The ONLY key this project may set here, and it is mandatory: `uv_build` derives
# the module name from the distribution name, so renaming to `get-nick-done`
# (D-01) makes it look for `src/get_nick_done/`. Without this it fails loudly —
# "Expected a Python module at: src/get_nick_done/__init__.py" — which is why
# this key is safe to rely on where the include keys are not.
#
# Do NOT add `source-include`, `data`, or a `force-include` stanza here to get
# the skills into the wheel. All three were measured and refuted: `source-include`
# is sdist-only, `data.purelib` lands at the site-packages root rather than
# `gnd/skills/`, and `force-include` is not a key this backend has. Worse, the
# backend SILENTLY IGNORES unrecognised keys — a typo yields a clean
# "Successfully built" and a skill-less wheel, which is exactly how this defect
# shipped. The skill tree ships because it physically lives under the module
# root at `src/gnd/skills/`; that is the whole mechanism. Verify artifacts with
# `pytest -m distribution`, never a green build message.
module-name = "gnd"

[tool.pytest.ini_options]
testpaths = ["tests"]
norecursedirs = ["fixtures"]
addopts = "-m 'not derivation_oracle and not pyrel_oracle and not ossie_oracle and not distribution and not network and not slow and not live and not review_runner and not proof and not evidence and not census'"
markers = [
  "proof: opt-in proof lane; not selected by the default public development gate",
  "derivation_oracle: opt-in derivation_oracle lane; not selected by the default public development gate",
  "ossie_oracle: opt-in pinned Ossie validator and parser lane",
  "pyrel_oracle: opt-in pyrel_oracle lane; not selected by the default public development gate",
  "distribution: opt-in distribution lane; not selected by the default public development gate",
  "evidence: opt-in evidence lane; not selected by the default public development gate",
  "census: opt-in census lane; not selected by the default public development gate",
  "live: opt-in live lane; not selected by the default public development gate",
  "network: opt-in network lane; not selected by the default public development gate",
  "review_runner: opt-in review_runner lane; not selected by the default public development gate",
  "slow: opt-in slow lane; not selected by the default public development gate",
]

[tool.ruff]
line-length = 100
target-version = "py311"
# An experiment's retained attempts and its accepted candidate are EVIDENCE:
# they record what a session actually produced, and reformatting them would
# forge that record the same way editing a retained agent stream would. They are
# excluded from linting because their bytes are not ours to change -- not
# because their style is acceptable.
#
# This exemption deliberately does NOT cover the shipped product. The BookRec
# package that ships lives at examples/bookrec/project/bookrec/, is copied from
# the accepted gate candidate, and is linted like any other source here. If the
# copy is dirty, the fix belongs in the session that produced it, never in a
# post-hoc edit that would break the byte-for-byte copy claim.
#
# proof/v6/phase1/generated/ is the contract-carrying copy of the Phase 1 kernel.
# Its bytes are produced by proof/v6/phase1/generate_proof_source.py, and they
# are held to something far stricter than a linter: proof/v6/phase1/erasure.py
# proves that erasing its contract-only calls returns it to
# src/gnd/proof_kernel.py statement for statement, and that file IS linted. A
# ruff autofix here would break that identity, which is the whole gate.
#

exec

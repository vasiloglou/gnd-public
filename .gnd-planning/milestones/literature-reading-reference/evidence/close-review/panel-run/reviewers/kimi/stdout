{"role":"tool","tool_call_id":"tool_vGIqy4Gzj3jL8lrdYMKvfwtP","content":"1\t\"\"\"LR2: a span may lie anywhere in the document its anchor sidecar names.\n2\t\n3\tOne source has two sections; the quoted value is in the second. The rule is\n4\theld from both sides through the real ``gnd check --anchors --document``, and\n5\tthe refusal is pinned to the span branch, not the digest check.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport hashlib\n10\timport json\n11\timport os\n12\timport subprocess\n13\timport sys\n14\timport unicodedata\n15\tfrom pathlib import Path\n16\t\n17\tfrom gnd.anchors import vocabulary_digest\n18\tfrom gnd.model import load_model\n19\t\n20\tROOT = Path(__file__).resolve().parents[1]\n21\tRULE = \"A span may lie anywhere in the document whose SHA-256 is `document_sha256`.\"\n22\tLINK = \"../reference/anchors.md#where-a-span-may-lie\"\n23\tSECTION_A = \"Section A. The study introduces record R-1 and its scope.\\n\"\n24\tSECTION_B = \"Section B. Record R-1 bears the label Beta Harbor in the methods.\\n\"\n25\tVALUE = \"Beta Harbor\"\n26\tMODEL = (\n27\t    \"version: 2\\nmodel_id: urn:gnd-fixture:lr2-quote-scope@1\\n\"\n28\t    \"source: {kind: text-conversation, confidence: standard, mode: one-shot}\\n\"\n29\t    \"object_types:\\n  - {id: record, name: Record, kind: value, primitive: String}\\n\"\n30\t    \"  - {id: label, name: Label, kind: value, primitive: String}\\n\"\n31\t    \"fact_types:\\n  - id: record_has_label\\n    reading: \\\"{Record} has label {Label}\\\"\\n\"\n32\t    \"    roles: [{object_type: record, role_name: record}, {object_type: label, role_name: label}]\\n\"\n33\t    \"    constraints:\\n      - {type: anchored, role: label, source: explicit, status: confirmed,\"\n34\t    \" modality: alethic, provenance: {user_quote: x}}\\n\"\n35\t    \"constraints: []\\nrejected_proposals: []\\n\"\n36\t)\n37\t\n38\t\n39\tdef _sha(raw: bytes) -> str:\n40\t    return hashlib.sha256(raw).hexdigest()\n41\t\n42\t\n43\tdef _case(tmp_path: Path, *, document: str, named: str) -> subprocess.CompletedProcess:\n44\t    \"\"\"Write the model, population, the document checked and a sidecar naming ``named``.\"\"\"\n45\t    (tmp_path / \"model.orm.yaml\").write_text(MODEL, encoding=\"utf-8\")\n46\t    population = json.dumps({\n47\t        \"population\": {\"model\": \"model.orm.yaml\", \"model_id\": \"urn:gnd-fixture:lr2-quote-scope@1\",\n48\t                       \"label\": \"conforming\", \"source\": \"fixture\", \"covers\": [\"record_has_label\"]},\n49\t        \"instances\": {},\n50\t        \"facts\": {\"record_has_label\": [{\"record\": \"R-1\", \"label\": VALUE}]},\n51\t    }).encode(\"utf-8\")\n52\t    (tmp_path / \"population.json\").write_bytes(population)\n53\t    (tmp_path / \"document.txt\").write_bytes(document.encode(\"utf-8\"))\n54\t    whole = unicodedata.normalize(\"NFC\", SECTION_A + SECTION_B)\n55\t    start = whole.index(VALUE)\n56\t    end = start + len(VALUE)\n57\t    sidecar = {\n58\t        \"schema_version\": 2,\n59\t        \"population_sha256\": _sha(population),\n60\t        \"vocabulary_digest\": vocabulary_digest(load_model(tmp_path / \"model.orm.yaml\")),\n61\t        \"document_sha256\": _sha(named.encode(\"utf-8\")),\n62\t        \"anchors\": [{\n63\t            \"fact_key\": {\"fact_type\": \"record_has_label\", \"roles\": {\"record\": \"R-1\", \"label\": VALUE}},\n64\t            \"role\": \"label\",\n65\t            \"span\": {\"start\": start, \"end\": end},\n66\t            \"occurrence\": 0,\n67\t            \"excerpt_sha256\": _sha(whole[start:end].encode(\"utf-8\")),\n68\t            \"block_id\": \"section-a\",\n69\t        }],\n70\t    }\n71\t    (tmp_path / \"population.json.anchors.json\").write_text(json.dumps(sidecar), encoding=\"utf-8\")\n72\t    env = {key: value for key, value in os.environ.items() if key != \"GND_DISCLOSURE\"}\n73\t    return subprocess.run(\n74\t        [sys.executable, \"-m\", \"gnd\", \"check\", \"model.orm.yaml\", \"population.json\", \"--anchors\",\n75\t         \"population.json.anchors.json\", \"--document\", \"document.txt\", \"--format\", \"json\"],\n76\t        cwd=tmp_path, env=env, capture_output=True, text=True, check=False)\n77\t\n78\t\n79\tdef test_t1_a_quote_from_another_section_binds_against_the_whole_source(tmp_path: Path) -> None:\n80\t    done = _case(tmp_path, document=SECTION_A + SECTION_B, named=SECTION_A + SECTION_B)\n81\t    assert done.returncode == 0, done.stdout + done.stderr\n82\t    report = json.loads(done.stdout)\n83\t    (anchored,) = [v for v in report[\"verdicts\"] if v[\"constraint_type\"] == \"anchored\"]\n84\t    assert anchored[\"verdict\"] == \"pass\"\n85\t\n86\t\n87\tdef test_t2_the_span_rule_refuses_when_the_document_is_the_shown_section(tmp_path: Path) -> None:\n88\t    done = _case(tmp_path, document=SECTION_A, named=SECTION_A)\n89\t    assert done.returncode == 3\n90\t    assert \"anchor:binding-mismatch: source span or excerpt differs\" in done.stdout + done.stderr\n91\t    assert \"digest differs\" not in done.stdout + done.stderr\n92\t\n93\t\n94\tdef test_t3_a_sidecar_naming_another_document_is_the_digest_refusal(tmp_path: Path) -> None:\n95\t    done = _case(tmp_path, document=SECTION_A, named=SECTION_A + SECTION_B)\n96\t    assert done.returncode == 3\n97\t    assert \"anchor:binding-mismatch: digest differs\" in done.stdout + done.stderr\n98\t\n99\t\n100\tdef test_t4_the_rule_has_one_home_and_the_literature_pages_cite_it() -> None:\n101\t    pages = [*sorted((ROOT / \"docs\").rglob(\"*.md\")), *sorted((ROOT / \"src\" / \"gnd\" / \"skills\").rglob(\"*.md\"))]\n102\t    homes = [page.relative_to(ROOT).as_posix() for page in pages if RULE in page.read_text(encoding=\"utf-8\")]\n103\t    assert homes == [\"docs/reference/anchors.md\"]\n104\t    for page in (\"docs/literature/index.md\", \"docs/literature/commands.md\"):\n105\t        assert LINK in (ROOT / page).read_text(encoding=\"utf-8\"), page\n106\t\n107\t\n108\tdef test_t5_the_example_readme_says_what_it_verifies() -> None:\n109\t    text = \" \".join((ROOT / \"src/gnd/examples/literature/README.md\").read_text(encoding=\"utf-8\").split())\n110\t    for claim in (\"the attempted sections of that pass joined with newlines\",\n111\t                  \"for the reported conflict, `conflict.txt`\",\n112\t                  \"binds its document by digest in an extraction sidecar\",\n113\t                  \"writes no anchor sidecar\"):\n114\t        assert claim in text, claim\n115\t    assert \"https://vasiloglou.github.io/gnd-public/reference/anchors/#where-a-span-may-lie\" in text"}
{"role":"tool","tool_call_id":"tool_jycWjLVVMoGSHER42bqJ9WY7","content":"1\t\"\"\"LR1: the documented steps list why `gnd verify` fails a source.\n2\t\n3\tThe steps live in ``docs/guides/documents.md``, \"Reading a failed verification\".\n4\t``listing`` below is the page's own ``failed`` function, read out of the page's\n5\trunnable block by the tutorial runner's block reader and ``ast``, so every case\n6\texercises the documented code. Every case runs the real CLI in a subprocess,\n7\twith ``GND_DISCLOSURE`` removed unless the case sets it.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport ast\n12\timport hashlib\n13\timport importlib.util\n14\timport json\n15\timport os\n16\timport shutil\n17\timport subprocess\n18\timport sys\n19\tfrom importlib.resources import files\n20\tfrom pathlib import Path\n21\t\n22\timport pytest\n23\t\n24\tfrom gnd.redaction import INSTANCE_DETAIL\n25\t\n26\tROOT = Path(__file__).resolve().parents[1]\n27\tGUIDE = ROOT / \"docs\" / \"guides\" / \"documents.md\"\n28\tSCHEMA = ROOT / \"src\" / \"gnd\" / \"report.schema.json\"\n29\tSKELETON = ROOT / \"tests\" / \"fixtures\" / \"skeleton\"\n30\tEXAMPLE = files(\"gnd\").joinpath(\"examples\", \"literature\")\n31\t\n32\t# The field names the documented steps use, by the level they sit at. The page's\n33\t# code reads all of them but `message`, which the prose names and the code does not print.\n34\tREPORT_FIELDS = (\"verdicts\", \"derivations\", \"outcome\")\n35\tVERDICT_FIELDS = (\"verdict\", \"modality\", \"constraint_ref\", \"constraint_type\", \"message\", \"offending_facts\")\n36\tDERIVATION_FIELDS = (\"verdict\", \"derivation_ref\", \"findings\")\n37\tPROSE_ONLY = {\"message\"}\n38\t\n39\t# Default `gnd verify` output at the phase base (11a7ebf7), staged as `staged` does,\n40\t# run from the staged folder with relative paths (LR1-C5, R0.1).\n41\tBASE_DIGESTS = {\n42\t    (\"reported-conflict\", \"text\"): \"14abf8f84fdb624c5489e6ac265399f3d9246fdd310999469cc1362d0dff9c4b\",\n43\t    (\"reported-conflict\", \"json\"): \"54f103b14b8e7834c6702df285580251c0a45bec834266e53948fdbd0ac47ca5\",\n44\t    (\"broad\", \"text\"): \"0114303b483a0f2104c77b80a9d5b10ca76a10fa5dcf915ac6ad4b3f065e0ce5\",\n45\t    (\"broad\", \"json\"): \"06245aceda3e535708f28fb134a490be2541e97396959955deba7e223e0fadaf\",\n46\t}\n47\t\n48\t\n49\tdef _page_block() -> ast.Module:\n50\t    spec = importlib.util.spec_from_file_location(\"run_tutorials\", ROOT / \"tools\" / \"run_tutorials.py\")\n51\t    runner = importlib.util.module_from_spec(spec)\n52\t    spec.loader.exec_module(runner)\n53\t    (block,) = [code for language, _, code, _ in runner.parsed_blocks(GUIDE) if language == \"python\"]\n54\t    return ast.parse(block)\n55\t\n56\t\n57\tdef _page_failed():\n58\t    module = _page_block()\n59\t    (function,) = [node for node in module.body if isinstance(node, ast.FunctionDef) and node.name == \"failed\"]\n60\t    namespace: dict = {}\n61\t    exec(compile(ast.Module(body=[function], type_ignores=[]), str(GUIDE), \"exec\"), namespace)  # noqa: S102 -- the repository page's one function only\n62\t    return namespace[\"failed\"]\n63\t\n64\t\n65\tFAILED = _page_failed()\n66\t\n67\t\n68\tdef listing(report: dict) -> list[dict]:\n69\t    \"\"\"The page's documented steps 1 and 3, as its own code applies them.\"\"\"\n70\t    constraints, derivations = FAILED(report)\n71\t    return [*constraints, *derivations]\n72\t\n73\t\n74\tdef _keys_read(module: ast.Module) -> set[str]:\n75\t    \"\"\"Every string key the page's code reads with a subscript.\"\"\"\n76\t    return {node.slice.value for node in ast.walk(module)\n77\t            if isinstance(node, ast.Subscript) and isinstance(node.slice, ast.Constant)\n78\t            and isinstance(node.slice.value, str)}\n79\t\n80\t\n81\tdef _env(disclosure: str | None = None) -> dict:\n82\t    env = {key: value for key, value in os.environ.items() if key != \"GND_DISCLOSURE\"}\n83\t    if disclosure is not None:\n84\t        env[\"GND_DISCLOSURE\"] = disclosure\n85\t    return env\n86\t\n87\t\n88\tdef _gnd(cwd: Path, *args: str, disclosure: str | None = None) -> subprocess.CompletedProcess:\n89\t    return subprocess.run([sys.executable, \"-m\", \"gnd\", *args], cwd=cwd, env=_env(disclosure),\n90\t                          capture_output=True, check=False)\n91\t\n92\t\n93\tdef _verify_json(cwd: Path, model: str, population: str, *extra: str,\n94\t                 disclosure: str | None = None) -> tuple[dict, int]:\n95\t    done = _gnd(cwd, \"verify\", model, population, \"--no-extraction\", \"--format\", \"json\", *extra,\n96\t                disclosure=disclosure)\n97\t    return json.loads(done.stdout), done.returncode\n98\t\n99\t\n100\t@pytest.fixture(scope=\"module\")\n101\tdef staged(tmp_path_factory) -> Path:\n102\t    \"\"\"The packaged reading run, with the model and its included vocabulary beside it.\"\"\"\n103\t    root = tmp_path_factory.mktemp(\"lr1\")\n104\t    subprocess.run([sys.executable, \"-m\", \"gnd.examples.literature.reading\", \"run\", \"--out\", \"run\"],\n105\t                   cwd=root, env=_env(), capture_output=True, check=True)\n106\t    run = root / \"run\"\n107\t    for part, name in ((\"reading_fixture\", \"reading.orm.json\"), (\"depth_fixture\", \"vocabulary.orm.json\")):\n108\t        shutil.copyfile(EXAMPLE.joinpath(part, name), run / name)\n109\t    return run\n110\t\n111\t\n112\tdef test_t1_reported_conflict_lists_one_constraint_and_its_rows(staged: Path) -> None:\n113\t    report, code = _verify_json(staged, \"reading.orm.json\", \"reported-conflict.population.json\")\n114\t    assert code == 1 and report[\"outcome\"] == \"violated\"\n115\t    (entry,) = listing(report)\n116\t    assert entry[\"constraint_ref\"] == \"fact_types[subject_label].constraints[0]\"\n117\t    assert entry[\"constraint_type\"] == \"uniqueness\"\n118\t    rows = entry[\"offending_facts\"]\n119\t    assert len(rows) == 2\n120\t    assert rows[0][\"subject\"] == rows[1][\"subject\"] and rows[0][\"label\"] != rows[1][\"label\"]\n121\t    # Step 2: the flattening record maps the composed address back to its declaration.\n122\t    flat = staged.parent / \"t1-flat\"\n123\t    assert _gnd(staged, \"flatten\", \"reading.orm.json\", \"--out\", str(flat)).returncode == 0\n124\t    (record,) = flat.glob(\"*.flattening.json\")\n125\t    origins = json.loads(record.read_text(encoding=\"utf-8\"))[\"origins\"]\n126\t    (fact_type,) = [o for o in origins if o[\"element_id\"] == \"subject_label\"]\n127\t    (constraint,) = [o for o in origins if o[\"composed_address\"] == fact_type[\"composed_address\"] + \".constraints[0]\"]\n128\t    assert constraint[\"element_id\"] == \"subject_has_one_label\"\n129\t    assert constraint[\"origin\"] == \"includes[scientific-vocabulary]\"\n130\t\n131\t\n132\tdef test_t2_broad_population_lists_nothing(staged: Path) -> None:\n133\t    report, code = _verify_json(staged, \"reading.orm.json\", \"broad.population.json\")\n134\t    assert code == 0 and listing(report) == []\n135\t\n136\t\n137\tdef test_t3_every_field_the_steps_use_is_in_the_schema_and_the_report(staged: Path) -> None:\n138\t    page = GUIDE.read_text(encoding=\"utf-8\")\n139\t    listed = {*REPORT_FIELDS, *VERDICT_FIELDS, *DERIVATION_FIELDS}\n140\t    read = _keys_read(_page_block()) - {\"facts\"}\n141\t    assert read == listed - PROSE_ONLY, read ^ (listed - PROSE_ONLY)\n142\t    defs = json.loads(SCHEMA.read_text(encoding=\"utf-8\"))[\"$defs\"]\n143\t    levels = (\n144\t        (REPORT_FIELDS, defs[\"legacy_reference_report\"][\"properties\"]),\n145\t        (VERDICT_FIELDS, defs[\"verdict\"][\"properties\"]),\n146\t        (DERIVATION_FIELDS, defs[\"derivation_verdict\"][\"properties\"]),\n147\t    )\n148\t    for names, properties in levels:\n149\t        for name in names:\n150\t            assert f\"`{name}`\" in page, name\n151\t            assert name in properties, name\n152\t    report, _ = _verify_json(staged, \"reading.orm.json\", \"reported-conflict.population.json\")\n153\t    assert set(REPORT_FIELDS) <= report.keys()\n154\t    assert set(VERDICT_FIELDS) <= listing(report)[0].keys()\n155\t    derivation = _derivation_failure_report(staged.parent / \"t3-derivation\")[0]\n156\t    assert set(DERIVATION_FIELDS) <= listing(derivation)[0].keys()\n157\t\n158\t\n159\tdef test_t4_deontic_only_violation_is_a_warning_and_not_listed(tmp_path: Path) -> None:\n160\t    population = {\n161\t        \"population\": {\"model\": \"model.orm.yaml\", \"source\": \"agent-output\",\n162\t                       \"covers\": [\"movie_has_title\", \"movie_released_in_year\", \"movie_sequel_of_movie\"]},\n163\t        \"instances\": {\"movie\": [1, 2]},\n164\t        \"facts\": {\n165\t            \"movie_has_title\": [{\"movie\": 1, \"title\": \"The Departed\"}, {\"movie\": 2, \"title\": \"Infernal Affairs\"}],\n166\t            \"movie_released_in_year\": [{\"movie\": 1, \"year\": 1520}, {\"movie\": 2, \"year\": 2002}],\n167\t            \"movie_sequel_of_movie\": [{\"sequel\": 1, \"original\": 2}],\n168\t        },\n169\t    }\n170\t    shutil.copyfile(SKELETON / \"model.orm.yaml\", tmp_path / \"model.orm.yaml\")\n171\t    (tmp_path / \"pop.json\").write_text(json.dumps(population), encoding=\"utf-8\")\n172\t    report, code = _verify_json(tmp_path, \"model.orm.yaml\", \"pop.json\")\n173\t    assert code == 0 and listing(report) == []\n174\t    warnings = [v for v in report[\"verdicts\"] if v[\"verdict\"] == \"warning\"]\n175\t    assert len(warnings) == 1 and warnings[0][\"modality\"] == \"deontic\"\n176\t\n177\t\n178\tdef _redacting_copy(staged: Path, folder: Path) -> Path:\n179\t    folder.mkdir()\n180\t    vocabulary = json.loads((staged / \"vocabulary.orm.json\").read_text(encoding=\"utf-8\"))\n181\t    (fact_type,) = [ft for ft in vocabulary[\"fact_types\"] if ft[\"id\"] == \"subject_label\"]\n182\t    fact_type[\"redact\"] = True\n183\t    raw = json.dumps(vocabulary, indent=2).encode(\"utf-8\")\n184\t    (folder / \"vocabulary.orm.json\").write_bytes(raw)\n185\t    model = json.loads((staged / \"reading.orm.json\").read_text(encoding=\"utf-8\"))\n186\t    (include,) = [row for row in model[\"includes\"] if row[\"path\"] == \"vocabulary.orm.json\"]\n187\t    include[\"sha256\"] = hashlib.sha256(raw).hexdigest()\n188\t    (folder / \"reading.orm.json\").write_text(json.dumps(model, indent=2), encoding=\"utf-8\")\n189\t    shutil.copyfile(staged / \"reported-conflict.population.json\", folder / \"pop.json\")\n190\t    return folder\n191\t\n192\t\n193\tdef test_t5_redacting_model_lists_the_constraint_with_markers(staged: Path, tmp_path: Path) -> None:\n194\t    folder = _redacting_copy(staged, tmp_path / \"redacting\")\n195\t    labels = {row[\"label\"] for row in listing(_verify_json(staged, \"reading.orm.json\",\n196\t                                                           \"reported-conflict.population.json\")[0])[0][\"offending_facts\"]}\n197\t    report, code = _verify_json(folder, \"reading.orm.json\", \"pop.json\")\n198\t    assert code == 1\n199\t    (entry,) = listing(report)\n200\t    assert entry[\"constraint_ref\"] == \"fact_types[subject_label].constraints[0]\"\n201\t    assert entry[\"message\"] == INSTANCE_DETAIL\n202\t    (marker,) = entry[\"offending_facts\"]\n203\t    assert marker[\"redacted\"] is True\n204\t    assert marker[\"roles\"] and all(role.startswith(\"subject_label.\") for role in marker[\"roles\"])\n205\t    payload = json.dumps(report)\n206\t    assert not any(label in payload for label in labels)\n207\t    for extra, disclosure in (((\"--unredacted\",), None), ((), \"internal\")):\n208\t        shown, code = _verify_json(folder, \"reading.orm.json\", \"pop.json\", *extra, disclosure=disclosure)\n209\t        assert code == 1\n210\t        assert {row[\"label\"] for row in listing(shown)[0][\"offending_facts\"]} == labels\n211\t\n212\t\n213\t@pytest.mark.parametrize((\"population\", \"fmt\"), sorted(BASE_DIGESTS))\n214\tdef test_t6_default_verify_output_is_unchanged(staged: Path, population: str, fmt: str) -> None:\n215\t    done = _gnd(staged, \"verify\", \"reading.orm.json\", f\"{population}.population.json\", \"--no-extraction\",\n216\t                \"--format\", fmt)\n217\t    assert hashlib.sha256(done.stdout).hexdigest() == BASE_DIGESTS[(population, fmt)]\n218\t\n219\t\n220\tdef test_t7_the_steps_have_one_home_and_two_citations() -> None:\n221\t    sentence = \"record whose `origins` map each composed\"\n222\t    pages = [*sorted((ROOT / \"docs\").rglob(\"*.md\")), *sorted((ROOT / \"src\" / \"gnd\" / \"skills\").rglob(\"*.md\"))]\n223\t    homes = [page for page in pages if sentence in page.read_text(encoding=\"utf-8\")]\n224\t    assert homes == [GUIDE]\n225\t    contract = (ROOT / \"src/gnd/skills/gnd-extract/references/extraction-contract.md\").read_text(encoding=\"utf-8\")\n226\t    assert contract.count(\"https://vasiloglou.github.io/gnd-public/guides/documents/#reading-a-failed-verification\") == 1\n227\t    commands = (ROOT / \"docs/literature/commands.md\").read_text(encoding=\"utf-8\")\n228\t    assert commands.count(\"../guides/documents.md#reading-a-failed-verification\") == 1\n229\t\n230\t\n231\tdef _derivation_failure_report(folder: Path) -> tuple[dict, int]:\n232\t    shutil.copytree(files(\"gnd\").joinpath(\"examples\", \"bookrec\"), folder)\n233\t    population = json.loads((folder / \"complete.population.json\").read_text(encoding=\"utf-8\"))\n234\t    population[\"facts\"][\"book_is_eligible\"].remove({\"user\": \"ada\", \"book\": \"river\"})\n235\t    (folder / \"missing.json\").write_text(json.dumps(population), encoding=\"utf-8\")\n236\t    return _verify_json(folder, \"complete.orm.yaml\", \"missing.json\")\n237\t\n238\t\n239\tdef test_t8_derivation_failure_is_listed(tmp_path: Path) -> None:\n240\t    report, code = _derivation_failure_report(tmp_path / \"bookrec\")\n241\t    assert code == 1\n242\t    assert [v for v in report[\"verdicts\"] if v[\"verdict\"] == \"fail\"] == []\n243\t    (entry,) = listing(report)\n244\t    assert entry[\"derivation_ref\"] == \"derivation:book_is_eligible\"\n245\t    assert entry[\"findings\"]\n246\t\n247\t\n248\tdef test_t10_a_mandatory_failure_lists_bare_instance_witnesses(tmp_path: Path) -> None:\n249\t    \"\"\"The steps hold for a witness that is not a row object (review finding F1).\"\"\"\n250\t    for name in (\"model.orm.yaml\", \"population.bad.yaml\"):\n251\t        shutil.copyfile(SKELETON / name, tmp_path / name)\n252\t    report, code = _verify_json(tmp_path, \"model.orm.yaml\", \"population.bad.yaml\")\n253\t    assert code == 1\n254\t    by_kind = {entry[\"constraint_type\"]: entry[\"offending_facts\"] for entry in listing(report)}\n255\t    assert by_kind[\"mandatory\"] == [3]\n256\t    assert all(isinstance(row, dict) for row in by_kind[\"uniqueness\"])\n257\t\n258\t\n259\tdef test_t11_a_ring_failure_lists_its_positional_witness(tmp_path: Path) -> None:\n260\t    \"\"\"A witness that is neither a row object nor a bare instance (review round 2, F2).\"\"\"\n261\t    shutil.copyfile(SKELETON / \"model.orm.yaml\", tmp_path / \"model.orm.yaml\")\n262\t    population = {\n263\t        \"population\": {\"model\": \"model.orm.yaml\", \"source\": \"agent-output\",\n264\t                       \"covers\": [\"movie_has_title\", \"movie_released_in_year\", \"movie_sequel_of_movie\"]},\n265\t        \"instances\": {\"movie\": [1, 2]},\n266\t        \"facts\": {\n267\t            \"movie_has_title\": [{\"movie\": 1, \"title\": \"A\"}, {\"movie\": 2, \"title\": \"B\"}],\n268\t            \"movie_released_in_year\": [{\"movie\": 1, \"year\": 2006}, {\"movie\": 2, \"year\": 2002}],\n269\t            \"movie_sequel_of_movie\": [{\"sequel\": 1, \"original\": 2}, {\"sequel\": 2, \"original\": 1}],\n270\t        },\n271\t    }\n272\t    (tmp_path / \"pop.json\").write_text(json.dumps(population), encoding=\"utf-8\")\n273\t    report, code = _verify_json(tmp_path, \"model.orm.yaml\", \"pop.json\")\n274\t    assert code == 1\n275\t    witnesses = [w for entry in listing(report) for w in entry[\"offending_facts\"]]\n276\t    assert any(isinstance(w, list) for w in witnesses), witnesses"}
{"role":"tool","tool_call_id":"tool_f8YDQAt8VCX9GUDfc2fKAhZM","content":"1\t\"\"\"LR3: the literature reference set, its recorded Sonnet run and its score.\n2\t\n3\tThe recorded run replays with zero producer calls; every gate here calls no\n4\tmodel. The producer adapter is tested against a fake ``claude``.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\timport importlib.util\n9\timport json\n10\timport shutil\n11\timport sys\n12\tfrom pathlib import Path\n13\t\n14\timport pytest\n15\t\n16\tfrom gnd.artifacts import canonical_json_bytes\n17\tfrom gnd.examples.literature import reading, reference_set\n18\tfrom gnd.examples.literature.depth import ExampleError\n19\t\n20\tROOT = Path(__file__).resolve().parents[1]\n21\tFIXTURE = reference_set.ROOT\n22\tCORPUS = ROOT / \"src\" / \"gnd\" / \"examples\" / \"literature\"\n23\tRUN = FIXTURE / \"run\"\n24\tPAGE = ROOT / \"docs\" / \"literature\" / \"index.md\"\n25\t\n26\t\n27\tdef _load_tool():\n28\t    spec = importlib.util.spec_from_file_location(\"record_lr3_reference_run\", ROOT / \"tools\" / \"record_lr3_reference_run.py\")\n29\t    module = importlib.util.module_from_spec(spec)\n30\t    spec.loader.exec_module(module)\n31\t    return module\n32\t\n33\t\n34\tTOOL = _load_tool()\n35\t\n36\t\n37\tdef _record() -> dict:\n38\t    return json.loads((FIXTURE / \"run-record.json\").read_bytes())\n39\t\n40\t\n41\t# --- T1: the root is the corpus overlay, built and unchanged ---------------------------------\n42\t\n43\tdef test_t1_the_committed_root_is_the_build_and_the_corpus_is_untouched() -> None:\n44\t    built = reference_set.build()\n45\t    for name, raw in built.items():\n46\t        assert (FIXTURE / name).read_bytes() == raw, name\n47\t    corpus = json.loads((CORPUS / \"corpus\" / \"corpus.json\").read_bytes())\n48\t    dev = [row for row in corpus[\"documents\"] if row[\"split\"] == \"dev\"]\n49\t    assert len(dev) == 12\n50\t    for row in dev:\n51\t        assert (FIXTURE / f\"{row['id']}.txt\").read_bytes() == (CORPUS / row[\"path\"]).read_bytes()\n52\t    labels = json.loads(built[\"labels.json\"])\n53\t    assert labels[\"counts\"] == {\"method_builds_on_method\": 8, \"method_is_used_in_field\": 12,\n54\t                                \"work_introduces_method\": 11}\n55\t    assert labels[\"derived_fact_types_left_out\"] == [\"work_builds_on_method\"]\n56\t    assert labels[\"licence\"] and all(fact[\"sections\"] for fact in labels[\"facts\"])\n57\t\n58\t\n59\t# --- T2, T3: the recorded run replays and scores byte for byte -------------------------------\n60\t\n61\tdef test_t2_the_recorded_run_replays_with_zero_producer_calls(monkeypatch: pytest.MonkeyPatch) -> None:\n62\t    \"\"\"A producer call is built only as a ProducerCall; replay must build none (review finding codex-4).\"\"\"\n63\t    def no_call(*_args, **_kwargs):\n64\t        raise AssertionError(\"replay offered a section to a producer\")\n65\t\n66\t    monkeypatch.setattr(reading, \"ProducerCall\", no_call)\n67\t    record = _record()\n68\t    replayed = reading.replay(RUN, fixture=FIXTURE, expected_evidence_sha256=record[\"evidence_sha256\"])\n69\t    assert replayed[\"evidence_sha256\"] == record[\"evidence_sha256\"]\n70\t    assert replayed[\"read_denominator\"] == record[\"reading\"][\"read_denominator\"]\n71\t\n72\t\n73\tdef test_t3_the_score_and_the_record_name_what_produced_the_figures() -> None:\n74\t    assert canonical_json_bytes(reference_set.score(RUN, FIXTURE)) == (FIXTURE / \"score.json\").read_bytes()\n75\t    record = _record()\n76\t    assert record[\"producer\"][\"model\"] == \"claude-sonnet-5-5\"\n77\t    assert record[\"producer\"][\"models_seen\"] == [\"claude-sonnet-5-5\"]\n78\t    assert record[\"budget\"][\"ceiling_usd\"] == 50.0\n79\t    assert 0 < record[\"budget\"][\"spent_usd\"] <= 50.0\n80\t    assert record[\"reading\"][\"read_denominator\"][\"attempted\"] == 46\n81\t    score = json.loads((FIXTURE / \"score.json\").read_bytes())\n82\t    assert set(score[\"stages\"]) == {\"broad\", \"targeted\"}\n83\t    assert score[\"gold_facts\"] == 31\n84\t\n85\t\n86\t# --- T4: the scoring rule ----------------------------------------------------------------------\n87\t\n88\tdef _root_with_labels(tmp_path: Path, facts: list[dict]) -> Path:\n89\t    root = tmp_path / \"root\"\n90\t    root.mkdir()\n91\t    shutil.copyfile(FIXTURE / \"roster.json\", root / \"roster.json\")\n92\t    labels = json.loads((FIXTURE / \"labels.json\").read_bytes())\n93\t    labels[\"facts\"] = facts\n94\t    (root / \"labels.json\").write_bytes(canonical_json_bytes(labels))\n95\t    return root\n96\t\n97\t\n98\tdef _run_with(tmp_path: Path, broad: list[dict], targeted: list[dict]) -> Path:\n99\t    run = tmp_path / \"run\"\n100\t    run.mkdir(parents=True)\n101\t    for name, attempts in ((\"payload-1.json\", broad), (\"payload-3.json\", targeted)):\n102\t        (run / name).write_bytes(canonical_json_bytes({\"attempts\": attempts}))\n103\t    return run\n104\t\n105\t\n106\tdef _attempt(section: str, facts: dict) -> dict:\n107\t    return {\"section\": section, \"response\": {\"outcome\": \"accepted\" if facts else \"empty\", \"facts\": facts,\n108\t                                             \"proposal_keys\": []}}\n109\t\n110\t\n111\tGOLD = {\"document\": \"vampnet\", \"fact_type\": \"method_builds_on_method\",\n112\t        \"roles\": {\"method\": \"VampNet\", \"base_method\": \"bidirectional transformer\"}, \"sections\": [\"vampnet-p2\"]}\n113\t\n114\t\n115\tdef test_t4_found_wrong_predicate_and_wrong_section_are_told_apart(tmp_path: Path) -> None:\n116\t    root = _root_with_labels(tmp_path, [GOLD])\n117\t    right = {\"method_builds_on_method\": [{\"method\": \"vampnet\", \"base_method\": \"Bidirectional  Transformer\"}]}\n118\t    swapped = {\"method_is_used_in_field\": [{\"method\": \"VampNet\", \"field\": \"bidirectional transformer\"}]}\n119\t    run = _run_with(tmp_path, [_attempt(\"vampnet-p1\", right)],\n120\t                    [_attempt(\"vampnet-p2\", swapped), _attempt(\"vampnet-p3\", right)])\n121\t    score = reference_set.score(run, root)\n122\t    assert score[\"stages\"][\"broad\"] == {\"produced\": 1, \"found\": 0, \"wrong_predicate\": 0,\n123\t                                        \"outside_gold_scope\": 1, \"precision\": [0, 1]}\n124\t    assert score[\"stages\"][\"targeted\"][\"wrong_predicate\"] == 1\n125\t    assert score[\"stages\"][\"targeted\"][\"found\"] == 0\n126\t    assert score[\"recall_after\"] == {\"broad\": [0, 1], \"targeted\": [0, 1]}\n127\t    reversed_roles = {\"method_builds_on_method\": [{\"method\": \"bidirectional transformer\", \"base_method\": \"VampNet\"}]}\n128\t    neither = reference_set.score(_run_with(tmp_path / \"c\", [], [_attempt(\"vampnet-p2\", reversed_roles)]), root)\n129\t    assert neither[\"stages\"][\"targeted\"][\"wrong_predicate\"] == 0\n130\t    assert neither[\"stages\"][\"targeted\"][\"found\"] == 0\n131\t    found = _run_with(tmp_path / \"b\", [], [_attempt(\"vampnet-p2\", right)])\n132\t    assert reference_set.score(found, root)[\"recall_after\"][\"targeted\"] == [1, 1]\n133\t\n134\t\n135\tdef test_t4_a_gold_fact_counts_once_and_every_row_counts_in_precision(tmp_path: Path) -> None:\n136\t    root = _root_with_labels(tmp_path, [GOLD])\n137\t    right = {\"method_builds_on_method\": [{\"method\": \"VampNet\", \"base_method\": \"bidirectional transformer\"}] * 2}\n138\t    score = reference_set.score(_run_with(tmp_path, [], [_attempt(\"vampnet-p2\", right)]), root)\n139\t    assert score[\"stages\"][\"targeted\"][\"precision\"] == [2, 2]\n140\t    assert score[\"recall_after\"][\"targeted\"] == [1, 1]\n141\t\n142\t\n143\t# --- T6, T7: what changes the figure, what refuses -------------------------------------------\n144\t\n145\tdef test_t6_a_changed_gold_fact_changes_the_figure(tmp_path: Path) -> None:\n146\t    labels = json.loads((FIXTURE / \"labels.json\").read_bytes())\n147\t    found = reference_set.score(RUN, FIXTURE)[\"recall_after\"][\"targeted\"][0]\n148\t    if found == 0:\n149\t        pytest.skip(\"the recorded run found no gold fact to change\")\n150\t    original = reference_set.score(RUN, FIXTURE)\n151\t    for index in range(len(labels[\"facts\"])):\n152\t        changed = json.loads(json.dumps(labels))\n153\t        role = min(changed[\"facts\"][index][\"roles\"])\n154\t        changed[\"facts\"][index][\"roles\"][role] += \" (changed)\"\n155\t        root = tmp_path / f\"r{index}\"\n156\t        root.mkdir()\n157\t        shutil.copyfile(FIXTURE / \"roster.json\", root / \"roster.json\")\n158\t        (root / \"labels.json\").write_bytes(canonical_json_bytes(changed))\n159\t        if reference_set.score(RUN, root) != original:\n160\t            return\n161\t    pytest.fail(\"no single changed gold fact changed the score\")\n162\t\n163\t\n164\tdef _copy_run(tmp_path: Path) -> tuple[Path, Path]:\n165\t    root, run = tmp_path / \"root\", tmp_path / \"root\" / \"run\"\n166\t    shutil.copytree(FIXTURE, root)\n167\t    return root, run\n168\t\n169\t\n170\tdef test_t7_a_changed_response_refuses_replay(tmp_path: Path) -> None:\n171\t    root, run = _copy_run(tmp_path)\n172\t    table = json.loads((run / \"producer-output-table.json\").read_bytes())\n173\t    section = min(table)\n174\t    table[section] = {\"outcome\": \"refused\", \"facts\": {}, \"proposal_keys\": []}\n175\t    (run / \"producer-output-table.json\").write_bytes(canonical_json_bytes(table))\n176\t    with pytest.raises(ExampleError):\n177\t        reading.replay(run, fixture=root, expected_evidence_sha256=_record()[\"evidence_sha256\"])\n178\t\n179\t\n180\tdef test_t7_a_changed_source_byte_refuses_replay(tmp_path: Path) -> None:\n181\t    root, run = _copy_run(tmp_path)\n182\t    source = root / \"vampnet.txt\"\n183\t    raw = bytearray(source.read_bytes())\n184\t    raw[-2] = ord(\"X\") if raw[-2] != ord(\"X\") else ord(\"Y\")\n185\t    source.write_bytes(bytes(raw))\n186\t    with pytest.raises(ExampleError):\n187\t        reading
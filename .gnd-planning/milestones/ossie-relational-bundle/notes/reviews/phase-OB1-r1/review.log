+    try:
+        actual = _baseline_entry(render_ossie(ROOT / relative, output_format=encoding))
+    except Exception as error:  # noqa: BLE001 -- the baseline records refusals by type and text
+        actual = {"refused": f"{type(error).__name__}: {error}"}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "probabilities",
            "confidence",
            "confidence_semantics"
          ],
          "properties": {
            "kind": {
              "const": "choice"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "probabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "probability"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "minItems": 1,
              "maxItems": 64
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence_semantics": {
              "enum": [
                "distribution-concentration",
                null
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "confidence": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "confidence_semantics": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "confidence_semantics": {
                    "const": "distribution-concentration"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "legend",
            "probabilities",
            "confidence",
            "confidence_semantics"
          ],
          "properties": {
            "kind": {
              "const": "score"
            },
            "value": {
              "type": "number"
            },
            "legend": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "level"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "level": {
                    "type": "number"
                  }
                }
              },
              "minItems": 1,
              "maxItems": 64
            },
            "probabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "probability"
                ],
                "properties": {
                  "level": {
                    "type": "number"
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "minItems": 1,
              "maxItems": 64
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence_semantics": {
              "enum": [
                "distribution-concentration",
                null
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "confidence": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "confidence_semantics": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "confidence_semantics": {
                    "const": "distribution-concentration"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "confidence",
            "confidence_semantics"
          ],
          "properties": {
            "kind": {
              "const": "binary-probability"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "type": "null"
            },
            "confidence_semantics": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "confidence",
            "confidence_semantics"
          ],
          "properties": {
            "kind": {
              "const": "verdict-confidence"
            },
            "value": {
              "enum": [
                "approve",
                "reject",
                "abstain"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence_semantics": {
              "enum": [
                "provider-defined",
                "estimated-verdict-correctness"
              ]
            }
          }
        }
      ]
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "semantics",
        "minimum"
      ],
      "properties": {
        "metric": {
          "enum": [
            "reported-confidence",
            "verdict-probability"
          ]
        },
        "semantics": {
          "enum": [
            "distribution-concentration",
            "provider-defined",
            "estimated-verdict-correctness",
            "mapped-verdict-probability"
          ]
        },
        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric": {
                "const": "verdict-probability"
              }
            }
          },
          "then": {
            "properties": {
              "semantics": {
                "const": "mapped-verdict-probability"
              }
            }
          },
          "else": {
            "properties": {
              "semantics": {
                "enum": [
                  "distribution-concentration",
                  "provider-defined",
                  "estimated-verdict-correctness"
                ]
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_type",
        "index"
      ],
      "properties": {
        "fact_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "quote"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quote": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "sha256"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "normalization_contract",
        "answer",
        "calibration_claim"
      ],
      "properties": {
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "model",
            "version"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "normalization_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "calibration_claim": {
          "enum": [
            "unspecified",
            "provider-reported"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "trust_mode",
        "judges",
        "targets",
        "admission",
        "repair",
        "trusted_receipts"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trust_mode": {
          "enum": [
            "consumer-pinned",
            "self-asserted"
          ]
        },
        "judges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 32
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_approvals",
            "evidence_floor"
          ],
          "properties": {
            "minimum_approvals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "evidence_floor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/floor"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_rejections",
            "evidence_floor"
          ],
          "properties": {
            "minimum_rejections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "evidence_floor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/floor"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "trusted_receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "judge_id",
              "receipt_sha256"
            ],
            "properties": {
              "judge_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 0,
          "maxItems": 8192
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "judge_id",
        "verdict",
        "trust",
        "subject",
        "sources",
        "external_evidence"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "judge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verdict": {
          "enum": [
            "approve",
            "reject",
            "abstain"
          ]
        },
        "trust": {
          "enum": [
            "consumer-pinned",
            "self-asserted"
          ]
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_sha256",
            "population_sha256",
            "reference_identity",
            "fact_type",
            "index",
            "fact_sha256"
          ],
          "properties": {
            "model_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "population_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reference_identity": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "identity_version",
                    "references"
                  ],
                  "properties": {
                    "identity_version": {
                      "const": 1
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "sha256"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      },
                      "minItems": 0,
                      "maxItems": 1024
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "fact_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "fact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "external_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/external"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipts"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          },
          "minItems": 0,
          "maxItems": 4096
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance",
        "policy_id",
        "policy_sha256",
        "receipts_sha256",
        "verification_contract",
        "admission",
        "repair",
        "review_required",
        "targets"
      ],
      "properties": {
        "assurance": {
          "const": "none"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_contract": {
          "enum": [
            "consumer-pinned-bytes-v1",
            "self-asserted"
          ]
        },
        "admission": {
          "type": "boolean"
        },
        "repair": {
          "type": "boolean"
        },
        "review_required": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_type",
              "index",
              "opinion_admission",
              "admitted",
              "repair",
              "judgments"
            ],
            "properties": {
              "fact_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "opinion_admission": {
                "type": "boolean"
              },
              "admitted": {
                "type": "boolean"
              },
              "repair": {
                "type": "boolean"
              },
              "judgments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "judge_id",
                    "receipt_id",
                    "receipt_sha256",
                    "verdict",
                    "trust",
                    "external_evidence",
                    "admission_qualification",
                    "repair_qualification"
                  ],
                  "properties": {
                    "judge_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "receipt_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "receipt_sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "verdict": {
                      "enum": [
                        "approve",
                        "reject",
                        "abstain",
                        "missing"
                      ]
                    },
                    "trust": {
                      "enum": [
                        "consumer-pinned",
                        "self-asserted",
                        null
                      ]
                    },
                    "external_evidence": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/external"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "admission_qualification": {
                      "enum": [
                        "not-applicable",
                        "qualified",
                        "below-evidence-floor",
                        "evidence-unavailable",
                        "missing"
                      ]
                    },
                    "repair_qualification": {
                      "enum": [
                        "not-applicable",
                        "qualified",
                        "below-evidence-floor",
                        "evidence-unavailable",
                        "missing"
                      ]
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 32
              }
            }
          },
          "minItems": 1,
          "maxItems": 1024
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command",
        "outcome",
        "error",
        "mechanical_report",
        "judgment_policy"
      ],
      "properties": {
        "schema_version": {
          "const": 15
        },
        "command": {
          "const": "judgments"
        },
        "outcome": {
          "enum": [
            0,
            1,
            3,
            4
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "message"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "shape",
                    "binding",
                    "trust",
                    "limit",
                    "unsupported",
                    "io"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanical_report": {
          "anyOf": [
            {
              "$ref": "report.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "judgment_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/bundle"
    },
    {
      "$ref": "#/$defs/report"
    }
  ]
}

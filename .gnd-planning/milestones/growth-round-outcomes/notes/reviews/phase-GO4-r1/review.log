   282	def _object_scoped_types(value: Any) -> set[str]:
   283	    """The object types a model-hosted constraint ranges over without a role.
   284	
   285	    A `value` or `cardinality` constraint with an `object_type` and no
   286	    `role_ref` constrains every instance of that object type, and a
   287	    `subtype-partition` constrains its `supertype` and `subtypes`. Their
   288	    subjects are then every fact type such an instance plays a role in
   289	    (close review R1-F1); a role-scoped constraint keeps its role refs.
   290	    """

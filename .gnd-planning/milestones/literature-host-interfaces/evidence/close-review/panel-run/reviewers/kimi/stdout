1\"}, {\"claim\": \"c3\", \"quantity\": \"q2\"},\n37\t                       {\"claim\": \"c4\", \"quantity\": \"q1\"}],\n38\t    \"claim_paper\": [{\"claim\": \"c1\", \"paper\": \"w1\"}],\n39\t    \"claim_supports\": [{\"claim\": \"c1\", \"other\": \"c2\"}, {\"claim\": \"c1\", \"other\": \"c4\"}],\n40\t    \"quantity_value\": [{\"quantity\": \"q1\", \"value\": \"12\"}, {\"quantity\": \"q2\", \"value\": \"3\"}],\n41\t    \"quantity_unit\": [{\"quantity\": \"q1\", \"unit\": \"percent\"}, {\"quantity\": \"q2\", \"unit\": \"dB\"}],\n42\t    \"quantity_source\": [{\"quantity\": \"q1\", \"claim\": \"c4\"}, {\"quantity\": \"q2\", \"claim\": \"c3\"}],\n43\t    \"paper_title\": [{\"paper\": \"w1\", \"title\": \"Quartz study\"}],\n44\t}\n45\tVERDICTS = {(\"claim_passage\", 0): \"approve\", (\"claim_passage\", 1): \"approve\",\n46\t            (\"claim_passage\", 2): \"approve\", (\"claim_passage\", 3): \"reject\"}\n47\t\n48\t\n49\tdef _sha(raw: bytes) -> str:\n50\t    return hashlib.sha256(raw).hexdigest()\n51\t\n52\t\n53\tdef _case(tmp_path, *, rows=None, verdicts=None, name=\"case\", model=\"claims.orm.json\", edit_model=None):\n54\t    \"\"\"A caller's admission inputs: model and include, raw population, policy, saved receipts, evidence.\"\"\"\n55\t    root = tmp_path / name\n56\t    root.mkdir()\n57\t    for file in (\"claims.orm.json\", \"terms.orm.json\"):\n58\t        shutil.copyfile(FIXTURE / file, root / file)\n59\t    if edit_model is not None:\n60\t        document = json.loads((root / \"claims.orm.json\").read_bytes())\n61\t        edit_model(document)\n62\t        (root / \"claims.orm.json\").write_bytes(canonical_json_bytes(document))\n63\t    shutil.copytree(FIXTURE / \"evidence\", root / \"evidence\")\n64\t    rows = ROWS if rows is None else rows\n65\t    verdicts = VERDICTS if verdicts is None else verdicts\n66\t    model_raw = (root / model).read_bytes()\n67\t    population = {\"population\": {\"covers\": sorted(rows), \"model\": admission.MODEL,\n68\t                                 \"model_id\": \"urn:gnd-test:lh3-claims@1\", \"source\": \"fixture\"},\n69\t                  \"instances\": {}, \"facts\": rows}\n70\t    raw = canonical_json_bytes(population)\n71\t    (root / \"raw.population.json\").write_bytes(raw)\n72\t    evidence = (root / \"evidence/passages.txt\").read_bytes()\n73\t    receipts = []\n74\t    for number, ((fact_type, index), verdict) in enumerate(verdicts.items()):\n75\t        receipts.append({\n76\t            \"receipt_id\": f\"opinion-{number:04d}\", \"judge_id\": \"corpus-author\", \"verdict\": verdict,\n77\t            \"trust\": \"consumer-pinned\", \"external_evidence\": None,\n78\t            \"subject\": {\"model_sha256\": _sha(model_raw), \"population_sha256\": _sha(raw), \"reference_identity\": None,\n79\t                        \"fact_type\": fact_type, \"index\": index,\n80\t                        \"fact_sha256\": judgment_fact_digest(fact_type, index, rows[fact_type][index])},\n81\t            \"sources\": [{\"path\": \"passages.txt\", \"sha256\": _sha(evidence),\n82\t                         \"quote\": {\"start\": 0, \"end\": 10, \"sha256\": _sha(evidence[:10])}}],\n83\t        })\n84\t    policy = json.loads((PACKAGED / \"policy.json\").read_bytes())\n85\t    policy[\"targets\"] = [{\"fact_type\": fact_type, \"index\": index} for fact_type, index in verdicts]\n86\t    policy[\"trusted_receipts\"] = [{\"judge_id\": \"corpus-author\", \"receipt_sha256\": judgment_receipt_digest(item)}\n87\t                                  for item in receipts]\n88\t    (root / \"policy.json\").write_bytes(canonical_json_bytes(policy))\n89\t    (root / \"receipts.json\").write_bytes(canonical_json_bytes({\"schema_version\": 1, \"receipts\": receipts}))\n90\t    return root\n91\t\n92\t\n93\tdef _admit(root, out=None, **kwargs):\n94\t    out = out or root.parent / f\"{root.name}-out\"\n95\t    record = admission.admit(root / \"claims.orm.json\", root / \"raw.population.json\", root / \"policy.json\",\n96\t                             root / \"receipts.json\", root / \"evidence\", out, **kwargs)\n97\t    return record, out\n98\t\n99\t\n100\tdef _admitted(out):\n101\t    return json.loads((out / \"admitted.population.json\").read_bytes())\n102\t\n103\t\n104\tdef _refuses(call, reason):\n105\t    with pytest.raises(Refusal) as caught:\n106\t        call()\n107\t    assert caught.value.reason == reason\n108\t\n109\t\n110\t@pytest.fixture(scope=\"module\")\n111\tdef shaped(tmp_path_factory):\n112\t    root = _case(tmp_path_factory.mktemp(\"lh3\"))\n113\t    record, out = _admit(root, shape=SHAPE)\n114\t    return root, record, out\n115\t\n116\t\n117\tdef test_t1_every_attached_and_followed_row_of_an_admitted_claim(shaped):\n118\t    root, record, out = shaped\n119\t    facts = _admitted(out)[\"facts\"]\n120\t    assert facts[\"claim_passage\"] == ROWS[\"claim_passage\"][:3]\n121\t    assert facts[\"claim_actor\"] == ROWS[\"claim_actor\"][:3]\n122\t    assert facts[\"claim_object\"] == ROWS[\"claim_object\"]\n123\t    assert facts[\"claim_condition\"] == ROWS[\"claim_condition\"]\n124\t    assert facts[\"claim_quantity\"] == ROWS[\"claim_quantity\"][:2]\n125\t    assert facts[\"claim_paper\"] == ROWS[\"claim_paper\"]\n126\t    assert facts[\"quantity_value\"] == ROWS[\"quantity_value\"]\n127\t    assert facts[\"quantity_unit\"] == ROWS[\"quantity_unit\"]\n128\t    assert all(\"c4\" not in json.dumps(rows) for rows in facts.values())\n129\t    assert record[\"schema\"] == admission.SHAPED_SCHEMA\n130\t    assert record[\"shape_sha256\"] == _sha(canonical_json_bytes(SHAPE))\n131\t    assert {row[\"assertion\"]: row[\"status\"] for row in record[\"stages\"][\"semantic-support\"]} == {\n132\t        \"c1\": \"pass\", \"c2\": \"pass\", \"c3\": \"pass\", \"c4\": \"fail\"}\n133\t    check = root.parent / \"check\"\n134\t    check.mkdir()\n135\t    for file in (\"terms.orm.json\",):\n136\t        shutil.copyfile(root / file, check / file)\n137\t    shutil.copyfile(root / \"claims.orm.json\", check / admission.MODEL)\n138\t    shutil.copyfile(out / \"admitted.population.json\", check / \"admitted.population.json\")\n139\t    done = subprocess.run([sys.executable, \"-m\", \"gnd\", \"check\", admission.MODEL, \"admitted.population.json\"],\n140\t                          cwd=check, capture_output=True, check=False)\n141\t    assert done.returncode == 0, done.stdout.decode()[-600:]\n142\t\n143\t\n144\tdef test_t1_covers_lists_attached_and_followed_fact_types(shaped):\n145\t    _, _, out = shaped\n146\t    covers = _admitted(out)[\"population\"][\"covers\"]\n147\t    assert set(covers) == set(ROWS) - {\"paper_title\"}\n148\t    assert \"paper_title\" not in _admitted(out)[\"facts\"]\n149\t\n150\t\n151\tdef test_t2_an_entity_that_objectifies_a_fact_type_refuses(tmp_path):\n152\t    out = tmp_path / \"out\"\n153\t    shape = {\"format\": admission.SHAPE_FORMAT, \"assertion\": \"assertion\", \"follow\": []}\n154\t    _refuses(lambda: admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\",\n155\t                                     PACKAGED / \"policy.json\", PACKAGED / \"receipts.json\", PACKAGED / \"evidence\",\n156\t                                     out, shape=shape), \"shape:objectified-assertion\")\n157\t    assert not out.exists()\n158\t\n159\t\n160\tdef test_t3_support_is_every_target_admitted_and_at_least_one(tmp_path):\n161\t    verdicts = {**VERDICTS, (\"claim_actor\", 1): \"reject\"}\n162\t    del verdicts[(\"claim_passage\", 2)]\n163\t    record, out = _admit(_case(tmp_path, verdicts=verdicts), shape=SHAPE)\n164\t    reasons = {row[\"assertion\"]: row[\"reason\"] for row in record[\"stages\"][\"semantic-support\"]}\n165\t    assert reasons == {\"c1\": \"rejected\", \"c2\": None, \"c3\": \"missing\", \"c4\": \"rejected\"}\n166\t    facts = _admitted(out)[\"facts\"]\n167\t    assert facts[\"claim_condition\"] == ROWS[\"claim_condition\"]\n168\t    assert facts[\"claim_passage\"] == [ROWS[\"claim_passage\"][1]]\n169\t\n170\t\n171\tdef test_t4_a_row_between_two_claims_needs_both_admitted(shaped):\n172\t    _, _, out = shaped\n173\t    assert _admitted(out)[\"facts\"][\"claim_supports\"] == [{\"claim\": \"c1\", \"other\": \"c2\"}]\n174\t\n175\t\n176\tdef test_t5_an_include_root_admits_and_binds_its_include(shaped, tmp_path):\n177\t    root, record, _ = shaped\n178\t    assert record[\"includes\"] == {\"terms.orm.json\": _sha((root / \"terms.orm.json\").read_bytes())}\n179\t    edited = _case(tmp_path)\n180\t    path = edited / \"terms.orm.json\"\n181\t    path.write_bytes(path.read_bytes() + b\"\\n\")\n182\t    out = tmp_path / \"out\"\n183\t    _refuses(lambda: _admit(edited, out, shape=SHAPE), \"input:model\")\n184\t    assert not out.exists()\n185\t\n186\t\n187\tdef _shape(**changes):\n188\t    return {**SHAPE, **changes}\n189\t\n190\t\n191\tREFUSALS = {\n192\t    \"shape-not-object\": ([\"claim\"], \"shape:invalid\"),\n193\t    \"shape-key-missing\": ({\"format\": admission.SHAPE_FORMAT, \"assertion\": \"claim\"}, \"shape:invalid\"),\n194\t    \"shape-extra-key\": (_shape(stop=True), \"shape:invalid\"),\n195\t    \"unknown-assertion\": (_shape(assertion=\"author\"), \"shape:unknown-assertion\"),\n196\t    \"value-type-assertion\": (_shape(assertion=\"note\"), \"shape:unknown-assertion\"),\n197\t    \"unknown-follow\": (_shape(follow=[\"author\"]), \"shape:unknown-follow\"),\n198\t    \"duplicate-follow\": (_shape(follow=[\"quantity\", \"quantity\"]), \"shape:invalid\"),\n199\t    \"no-attached-facts\": (_shape(assertion=\"venue\", follow=[]), \"shape:no-attached-facts\"),\n200\t}\n201\t\n202\t\n203\t@pytest.mark.parametrize(\"case\", sorted(REFUSALS))\n204\tdef test_t6_a_shape_refusal_publishes_nothing(tmp_path, case):\n205\t    shape, reason = REFUSALS[case]\n206\t    root = _case(tmp_path)\n207\t    out = tmp_path / \"out\"\n208\t    _refuses(lambda: _admit(root, out, shape=shape), reason)\n209\t    assert not out.exists()\n210\t\n211\t\n212\tdef test_t6_a_target_outside_the_shape_refuses(tmp_path):\n213\t    verdicts = {**VERDICTS, (\"quantity_value\", 0): \"approve\"}\n214\t    out = tmp_path / \"out\"\n215\t    _refuses(lambda: _admit(_case(tmp_path, verdicts=verdicts), out, shape=SHAPE), \"judgments:target-outside-shape\")\n216\t    assert not out.exists()\n217\t\n218\t\n219\tdef test_t6_an_include_path_outside_the_root_refuses(tmp_path):\n220\t    root = _case(tmp_path)\n221\t    model = json.loads((root / \"claims.orm.json\").read_bytes())\n222\t    model[\"includes\"][0][\"path\"] = \"../terms.orm.json\"\n223\t    (root / \"claims.orm.json\").write_bytes(canonical_json_bytes(model))\n224\t    out = tmp_path / \"out\"\n225\t    _refuses(lambda: _admit(root, out, shape=SHAPE), \"input:include-path\")\n226\t    assert not out.exists()\n227\t\n228\t\n229\t@pytest.mark.parametrize(\"value\", [0, 65537, True])\n230\tdef test_t6_max_rows_out_of_range_refuses(tmp_path, value):\n231\t    out = tmp_path / \"out\"\n232\t    _refuses(lambda: _admit(_case(tmp_path), out, shape=SHAPE, max_rows=value), \"input:max-rows\")\n233\t    assert not out.exists()\n234\t\n235\t\n236\tdef test_t6_max_rows_without_a_shape_refuses(tmp_path):\n237\t    out = tmp_path / \"out\"\n238\t    _refuses(lambda: admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\",\n239\t                                     PACKAGED / \"policy.json\", PACKAGED / \"receipts.json\", PACKAGED / \"evidence\",\n240\t                                     out, max_rows=100), \"input:max-rows\")\n241\t    assert not out.exists()\n242\t\n243\t\n244\tdef test_t7_the_value_none_is_ordinary(shaped):\n245\t    _, _, out = shaped\n246\t    assert {\"claim\": \"c2\", \"condition\": \"none\"} in _admitted(out)[\"facts\"][\"claim_condition\"]\n247\t\n248\t\n249\tdef test_t8_the_packaged_call_keeps_its_bytes(tmp_path):\n250\t    out = tmp_path / \"packaged\"\n251\t    record = admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\",\n252\t                             PACKAGED / \"policy.json\", PACKAGED / \"receipts.json\", PACKAGED / \"evidence\", out)\n253\t    assert record[\"schema\"] == admission.SCHEMA and \"shape_sha256\" not in record\n254\t    for name, prefix in H18.items():\n255\t        assert _sha((out / name).read_bytes()).startswith(prefix), name\n256\t    reasons = {row[\"index\"]: row[\"reason\"] for row in record[\"stages\"][\"positive-own-findings\"]}\n257\t    assert [reasons[index] for index in (3, 4, 5, 6)] == [\"negated\", \"baseline-comparison\", \"speculation\",\n258\t                                                           \"cites-other-work\"]\n259\t\n260\t\n261\tdef _wide(count, rows_per_claim):\n262\t    rows = {name: [] for name in ROWS}\n263\t    for number in range(count):\n264\t        claim = f\"c{number}\"\n265\t        rows[\"claim_passage\"].append({\"claim\": claim, \"passage\": \"p\"})\n266\t        rows[\"claim_quantity\"].append({\"claim\": claim, \"quantity\": f\"q{number}\"})\n267\t        rows[\"quantity_value\"].append({\"quantity\": f\"q{number}\", \"value\": str(number)})\n268\t        for extra in range(rows_per_claim):\n269\t            rows[\"claim_actor\"].append({\"claim\": claim, \"actor\": f\"a{extra}\"})\n270\t    return rows\n271\t\n272\t\n273\tdef test_t9_the_row_ceiling_in_time_and_one_over_refuses(tmp_path):\n274\t    count, per = 1024, 61\n275\t    rows = _wide(count, per)\n276\t    total = sum(len(value) for name, value in rows.items() if name != \"paper_title\")\n277\t    assert total == admission.MAX_ROWS_CEILING\n278\t    verdicts = {(\"claim_passage\", index): \"approve\" for index in range(count)}\n279\t    root = _case(tmp_path, rows=rows, verdicts=verdicts)\n280\t    started = time.monotonic()\n281\t    record, out = _admit(root, shape=SHAPE, max_rows=total)\n282\t    assert time.monotonic() - started < 60\n283\t    assert len(_admitted(out)[\"facts\"][\"claim_actor\"]) == count * per\n284\t    assert all(row[\"status\"] == \"pass\" for row in record[\"stages\"][\"semantic-support\"])\n285\t    second = tmp_path / \"again\"\n286\t    _refuses(lambda: _admit(root, second, shape=SHAPE, max_rows=total - 1), \"input:row-cap\")\n287\t    assert not second.exists()\n288\t\n289\t\n290\tdef test_t10_shared_and_unlisted_entities(shaped):\n291\t    _, _, out = shaped\n292\t    facts = _admitted(out)[\"facts\"]\n293\t    assert facts[\"quantity_value\"].count({\"quantity\": \"q1\", \"value\": \"12\"}) == 1\n294\t    assert {\"claim\": \"c4\", \"quantity\": \"q1\"} not in facts[\"claim_quantity\"]\n295\t    assert facts[\"quantity_source\"] == [{\"quantity\": \"q2\", \"claim\": \"c3\"}]\n296\t    assert \"paper_title\" not in facts\n297\t\n298\t\n299\tdef test_t10_with_an_empty_follow_list_nothing_is_followed(tmp_path):\n300\t    record, out = _admit(_case(tmp_path), shape=_shape(follow=[]))\n301\t    facts = _admitted(out)[\"facts\"]\n302\t    assert \"quantity_value\" not in facts and \"quantity_unit\" not in facts\n303\t    assert facts[\"claim_quantity\"] == ROWS[\"claim_quantity\"][:2]\n304\t    assert record[\"schema\"] == admission.SHAPED_SCHEMA\n305\t\n306\t\n307\tdef _model(*fact_types):\n308\t    return {\"object_types\": [{\"id\": \"claim\", \"kind\": \"entity\"}, {\"id\": \"passage\", \"kind\": \"entity\"},\n309\t                             {\"id\": \"note\", \"kind\": \"value\"}],\n310\t            \"fact_types\": [{\"id\": name, \"roles\": [{\"role_name\": role, \"object_type\": kind} for role, kind in roles]}\n311\t                           for name, roles in fact_types]}\n312\t\n313\t\n314\tdef _target(fact_type, index, admitted=True):\n315\t    return {\"fact_type\": fact_type, \"index\": index, \"admitted\": admitted,\n316\t            \"judgments\": [{\"verdict\": \"approve\" if admitted else \"reject\"}]}\n317\t\n318\t\n319\tCLAIM_SEEN = (\"claim_seen\", [(\"claim\", \"claim\"), (\"passage\", \"passage\")])\n320\tLONE_SHAPE = {\"format\": admission.SHAPE_FORMAT, \"assertion\": \"claim\", \"follow\": []}\n321\t\n322\t\n323\tdef test_r1_a_boolean_handle_is_not_a_number(tmp_path):\n324\t    subject = {\"population\": {}, \"facts\": {\"claim_seen\": [{\"claim\": True, \"passage\": \"p\"},\n325\t                                                           {\"claim\": 1, \"passage\": \"p\"}]}}\n326\t    population, stages = admission.project_shaped(subject, [_target(\"claim_seen\", 0)], _model(CLAIM_SEEN),\n327\t                                                   LONE_SHAPE)\n328\t    assert population[\"facts\"][\"claim_seen\"] == [{\"claim\": True, \"passage\": \"p\"}]\n329\t    assert [row[\"status\"] for row in stages[\"semantic-support\"]] == [\"pass\", \"fail\"]\n330\t\n331\t\n332\tdef test_r1_one_and_one_point_zero_are_one_number():\n333\t    subject = {\"population\": {}, \"facts\": {\"claim_seen\": [{\"claim\": 1, \"passage\": \"p\"},\n334\t                                                           {\"claim\": 1.0, \"passage\": \"q\"}]}}\n335\t    population, stages = admission.project_shaped(subject, [_target(\"claim_seen\", 0)], _model(CLAIM_SEEN),\n336\t                                                   LONE_SHAPE)\n337\t    assert len(population[\"facts\"][\"claim_seen\"]) == 2 and len(stages[\"semantic-support\"]) == 1\n338\t\n339\t\n340\t@pytest.mark.parametrize(\"includes\", [1, True, [1], [{\"path\": 3}]])\n341\tdef test_r2_a_malformed_include_list_refuses(includes):\n342\t    raw = canonical_json_bytes({\"version\": 5, \"object_types\": [], \"fact_types\": [], \"includes\": includes})\n343\t    _refuses(lambda: admission._include_paths(raw), \"input:include-path\")\n344\t\n345\t\n346\tdef test_r2_a_missing_include_refuses(tmp_path):\n347\t    root = _case(tmp_path)\n348\t    (root / \"terms.orm.json\").unlink()\n349\t    out = tmp_path / \"out\"\n350\t    _refuses(lambda: _admit(root, out, shape=SHAPE), \"input:include-read\")\n351\t    assert not out.exists()\n352\t\n353\t\n354\tdef test_r3_an_opaque_value_is_an_ordinary_value():\n355\t    subject = {\"format_version\": 2, \"population\": {}, \"facts\": {\n356\t        \"claim_seen\": [{\"claim\": \"c1\", \"passage\": \"p\"}],\n357\t        \"claim_note\": [{\"claim\": \"c1\", \"note\": {\"$opaque\": \"unreadable-note\"}}]}}\n358\t    model = _model(CLAIM_SEEN, (\"claim_note\", [(\"claim\", \"claim\"), (\"note\", \"note\")]))\n359\t    population, _ = admission.project_shaped(subject, [_target(\"claim_seen\", 0)], model, LONE_SHAPE)\n360\t    assert population[\"facts\"][\"claim_note\"] == subject[\"facts\"][\"claim_note\"]\n361\t\n362\t\n363\tdef test_r4_covers_is_linear_in_the_fact_types():\n364\t    count = 40_000\n365\t    names = [f\"seen_{index}\" for index in range(count)]\n366\t    model = _model(*[(name, [(\"claim\", \"claim\")]) for name in names])\n367\t    subject = {\"population\": {}, \"facts\": {name: [{\"claim\": \"c1\"}] for name in names}}\n368\t    started = time.monotonic()\n369\t    admission.project_shaped(subject, [_target(names[0], 0)], model, LONE_SHAPE, max_rows=65536)\n370\t    assert time.monotonic() - started < 1.5\n371\t\n372\t\n373\t@pytest.mark.parametrize(\"missing\", [\"claims.orm.json\", \"raw.population.json\", \"policy.json\", \"receipts.json\"])\n374\tdef test_r5_a_missing_primary_input_refuses_without_its_path(tmp_path, missing):\n375\t    root = _case(tmp_path)\n376\t    (root / missing).unlink()\n377\t    out = tmp_path / \"out\"\n378\t    _refuses(lambda: _admit(root, out, shape=SHAPE), \"input:read\")\n379\t    assert not out.exists()"}

+def _root(tmp_path, *, declared=False, profile=None, name="root"):
+    root = tmp_path / name
+    shutil.copytree(CALLER, root)
+    if declared:
+        shutil.copyfile(root / "profile-declared.json", root / "profile.json")
+    if profile is not None:

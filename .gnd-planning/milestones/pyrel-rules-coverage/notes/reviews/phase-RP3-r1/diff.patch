+def _canonical(value):
+    """GND's numeric identity in a witness: 1 and 1.0 are one number (the programs print Float values as
+    floats, GND echoes the input's form), so an integral float compares as its integer."""
+    if isinstance(value, float) and value.is_integer():
+        return int(value)
+    if isinstance(value, list):
+        return [_canonical(v) for v in value]
+    if isinstance(value, dict):
+        return {k: _canonical(v) for k, v in value.items()}
+    return value
+

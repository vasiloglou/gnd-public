            key=repr,
        )
    if component == "purely-reflexive":
        return sorted(((a, b) for a, b in pair_set if a != b), key=repr)
    if component == "reflexive":
        return sorted(((a,) for a in elements if (a, a) not in pair_set), key=repr)

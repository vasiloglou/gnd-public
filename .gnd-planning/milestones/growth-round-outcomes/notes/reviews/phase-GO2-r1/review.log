# MG2 additive-policy fixture (spec §Tests). No `operations`, so the
# operations gate (exit 18) never pre-empts a policy cell.
#
# customer_places_order is POPULATED (two sample rows); order_has_amount is
# the unpopulated control with the same constraint shapes. Constraints that
# the cases modify are user-supplied/confirmed or llm-inferred/proposed/
# deontic, the two shapes D-12 admits for a changed constraint.
version: 1
model_id: evolve-policy-base
source: { kind: fixture }
object_types:
  - id: customer
    name: Customer
    kind: entity
    reference: { mode: popular, value_type: customer_id }
    description: { summary: "A party that places orders." }
    provenance: { rationale: "Named in the brief." }
  - id: customer_id
    name: CustomerId
    kind: value
    primitive: Integer
  - id: order
    name: Order
    kind: entity
    reference: { mode: popular, value_type: order_id }
  - id: order_id
    name: OrderId
    kind: value
    primitive: Integer
  - id: amount
    name: Amount
    kind: value
    primitive: Integer
  - id: channel
    name: Channel
    kind: value
    primitive: String
  # Unreferenced by any constraint: the subject of the RENAME and DELETE cells,
  # whose candidates stay valid without touching anything else.
  - id: note
    name: Note
    kind: value
    primitive: String
  - id: memo
    name: Memo
    kind: value
    primitive: String
fact_types:
  - id: customer_places_order
    reading: "{Customer} places {Order} via {Channel}"
    roles:
      - { object_type: customer, role_name: customer }
      - { object_type: order, role_name: order }
      - { object_type: channel, role_name: channel }
    sample_population:
      - { customer: 1, order: 10, channel: web }
      - { customer: 2, order: 11, channel: web }
    provenance: { rationale: "Populated by the first extraction round." }
    constraints:
      - type: uniqueness
        roles: [order, channel]
        source: user-supplied
        status: confirmed
        modality: alethic
        provenance: { user_quote: "An order is placed once per channel." }
      - type: value
        object_type: channel
        role_ref: { fact_type: customer_places_order, role: channel }
        allowed: [web, phone, store]
        source: user-supplied
        status: confirmed
        modality: alethic
        provenance: { user_quote: "Orders arrive by web, phone or in store." }
      - type: frequency
        scope: internal
        roles: [customer]
        bound: { min: 1, max: 10 }
        source: user-supplied
        status: confirmed
        modality: deontic
        provenance: { user_note: "A customer places at most ten orders." }
      - type: value
        object_type: order
        role_ref: { fact_type: customer_places_order, role: order }
        range: { min: 1, max: 1000, min_inclusive: true, max_inclusive: true }
        source: llm-inferred
        status: proposed
        modality: deontic
        rationale: "Order numbers are small positive integers."
        provenance: { rationale_world_fact: "Order numbers are assigned sequentially from one." }
  - id: order_has_amount
    reading: "{Order} has {Amount}"
    roles:
      - { object_type: order, role_name: order }
      - { object_type: amount, role_name: amount }
    constraints:
      - type: uniqueness
        roles: [order]
        source: user-supplied
        status: confirmed
def remap_issues(issues, origins):
    addresses = {entry.composed_address: entry for entry in origins}
    # An issue may name an element by id: ``$.fact_types[id=X]`` or, since VG3,
    # ``$.object_types[id=X]`` (plan H17). The selector is matched as the whole
    # text the rules write for a declared element, never parsed, so an id holding
    # a newline or a bracket is still found (VG3 review r1, F2).
    selectors = {}
    for entry in origins:
        for section in ('$.fact_types', '$.object_types'):
            if re.fullmatch(re.escape(section) + r'\[\d+\]', entry.composed_address):
                selectors[f'{section}[id={entry.element_id}]'] = entry
    result = []
    for issue in issues:
        path = issue.path
        selector = max((text for text in selectors if path.startswith(text)), key=len, default=None)
        if selector is not None:
            path = selectors[selector].composed_address + path[len(selector):]
        candidates = re.findall(r'\$\.[a-z_]+\[\d+\](?:\.constraints\[\d+\])?', path)
        address = candidates[0] if candidates else ''
        entry = addresses.get(address)
        if entry is None and '.constraints[' in address:
            address = address.split('.constraints[')[0]
            entry = addresses.get(address)
        if entry is not None:
            if entry.origin == 'model' and entry.original_address == entry.composed_address:
                result.append(issue)
                continue
            prefix = '' if entry.origin == 'model' else entry.origin + ':'
            original = entry.original_address
            host = selectors[selector] if selector is not None else None
            if host is not None and entry.origin != 'model' and original.startswith(host.original_address):
                original = selector + original[len(host.original_address):]
            path = prefix + original + path[len(address):]
            issue = issue.model_copy(update={'path': path})
        result.append(issue)
    return result



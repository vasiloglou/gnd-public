++def _rule_issues(doc: dict, included: frozenset[int]) -> list[tuple[str, str]]:
++    token = _INCLUDED.set(included)
++    try:
++        return [(issue.rule_id, issue.message) for issue in _rule_unattended(doc)]
++    finally:
++        _INCLUDED.reset(token)

   156	def _ordered(before: Any, after: Any, *, tightens_when_raised: bool) -> str:
   157	    """Classify a numeric bound change.
   158	
   159	    A lower bound tightens when raised, an upper bound when lowered; an added
   160	    bound always tightens and a removed one always loosens.
   161	    """
   162	
   163	    if before is None and _is_number(after):
   164	        return _STRENGTHENING
   165	    if _is_number(before) and after is None:
   166	        return _WEAKENING
   167	    if _is_number(before) and _is_number(after):
   168	        raised = after > before
   169	        return _STRENGTHENING if raised == tightens_when_raised else _WEAKENING
   170	    return _NEITHER

+def readme_commands(folder, commands):
+    """COMMANDS, after checking that the packaged README lists each one as written here."""
+    readme = (folder / 'README.md').read_text(encoding='utf-8')
+    for command in commands:
+        assert 'gnd ' + ' '.join(command) + '\n' in readme, command
+    return commands
+

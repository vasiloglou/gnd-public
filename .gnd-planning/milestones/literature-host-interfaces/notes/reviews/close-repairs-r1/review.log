+{"role":"tool","tool_call_id":"tool_XJDHl8Njtla4dffCnfFGK4Ir","content":"700\t    \"\"\"The composition record names exactly the run's sources (review finding R1).\"\"\"\n701\t    entries = record.get(\"sources\") if isinstance(record, dict) else None\n702\t    if not isinstance(entries, list):\n703\t        return False\n704\t    ids = [e.get(\"id\") for e in entries if isinstance(e, dict)]\n705\t    return len(ids) == len(entries) and sorted(map(str, ids)) == sorted(inputs.sources)\n706\t\n707\t\n708\tdef _record_fresh(inputs: Inputs, record: dict) -> bool:\n709\t    if record.get(\"population_sha256\") != _file_sha(inputs.run_dir / \"composed\" / \"population.json\"):\n710\t        return False\n711\t    for entry in record.get(\"sources\") or []:\n712\t        if not isinstance(entry, dict) or not isinstance(entry.get(\"id\"), str) or entry[\"id\"] not in inputs.sources:\n713\t            return False\n714\t        folder = inputs.source_dir(entry[\"id\"])\n715\t        if (entry.get(\"population_sha256\") != _file_sha(folder / \"population.json\")\n716\t                or entry.get(\"document_sha256\") != _file_sha(folder / \"document.txt\")\n717\t                or entry.get(\"sidecar_sha256\") != _file_sha(folder / \"population.json.anchors.json\")):\n718\t            return False\n719\t    return True\n720\t\n721\t\n722\tdef _coverage_units(rows, sections):\n723\t    from .reading import COVERAGE_STATES\n724\t\n725\t    _need(isinstance(rows, list) and 0 < len(rows) <= 128)\n726\t    question_ids = set()\n727\t    result = set()\n728\t    for row in rows:\n729\t        _need(isinstance(row, dict) and set(row) == {\"question\", \"source\", \"section\", \"state\", \"inspected\"})\n730\t        qid, source, section, state, inspected = (\n731\t            row[field] for field in (\"question\", \"source\", \"section\", \"state\", \"inspected\")\n732\t        )\n733\t        _need(all(_is_str(value) for value in (qid, source, section, state))\n734\t              and qid not in question_ids and sections.get(section) == source\n735\t              and state in COVERAGE_STATES and type(inspected) is bool)\n736\t        _need(inspected == (state not in (\"unavailable\", \"not-applicable\", \"omitted\")))\n737\t        question_ids.add(qid)\n738\t        result.add((qid, source, section, state, inspected))\n739\t    return result\n740\t\n741\t\n742\tdef _coverage_result(expected_rows, observed_rows, sections):\n743\t    floors = {\"precision\": (1, 1), \"recall\": (1, 1)}\n744\t    try:\n745\t        expected = _coverage_units(expected_rows, sections)\n746\t        observed = _coverage_units(observed_rows, sections)\n747\t    except Refusal:\n748\t        return _stage(\"coverage\", metrics={}, floors=floors, route_present=True, route_refused=True)\n749\t    matched = len(expected & observed)\n750\t    return _stage(\"coverage\", metrics={\"precision\": (matched, len(observed)), \"recall\": (matched, len(expected))},\n751\t                  floors=floors, route_present=True, sample_size=len(expected),\n752\t                  disagreements={\"count\": len(expected ^ observed), \"units\": sorted({row[0] for row in expected ^ observed})})\n753\t\n754\t\n755\tdef score_reading_coverage(run_dir: Path, expected_rows: list[dict], *, fixture: Path | None = None) -> dict:\n756\t    \"\"\"Score exact replayable reading rows against a caller-owned answer roster.\n757\t\n758\t    ``fixture`` is the reading root a caller run replays against; without it the packaged root is used.\n759\t    \"\"\"\n760\t    from .reading import ArtifactError, replay\n761\t\n762\t    try:\n763\t        report = replay(run_dir) if fixture is None else replay(run_dir, fixture=fixture)\n764\t    except (OSError, ArtifactError, ValueError, KeyError, TypeError, AttributeError, IndexError):\n765\t        return _coverage_result(expected_rows, None, {})\n766\t    rows = report[\"coverage\"]\n767\t    sections = {row[\"section\"]: row[\"source\"] for row in rows}\n768\t    return _coverage_result(expected_rows, rows, sections)\n769\t\n770\t\n771\tdef _coverage(inputs: Inputs) -> dict:\n772\t    \"\"\"Score the opt-in reading coverage evidence against an independent roster.\"\"\"\n773\t    if \"coverage\" not in inputs.run and \"coverage\" not in inputs.key:\n774\t        return _dormant(\"coverage\")\n775\t\n776\t    from .reading import read_coverage_rows\n777\t\n778\t    declaration = inputs.run.get(\"coverage\")\n779\t    expected = inputs.key.get(\"coverage\")\n780\t    try:\n781\t        _need(isinstance(declaration, dict) and set(declaration) == {\"sha256\"})\n782\t        observed = read_coverage_rows(inputs.run_dir, declaration[\"sha256\"])\n783\t    except (OSError, Refusal, ValueError):\n784\t        observed = None\n785\t    sources = set(inputs.sources)\n786\t    sections = {key: row[\"document\"] for key, row in inputs.passages.items() if row[\"document\"] in sources}\n787\t    return _coverage_result(expected, observed, sections)\n788\t\n789\t\n790\tdef _dormant(name: str) -> dict:\n791\t    return {\"stage\": name, \"active\": False, \"owner\": DORMANT[name], \"status\": \"not-measured\",\n792\t            \"failed_floors\": [], \"unit\": UNITS[name], \"sample_size\": 0}\n793\t\n794\t\n795\tdef _run_sha(run_dir: Path) -> str:\n796\t    listing = []\n797\t    for path in sorted(p for p in run_dir.rglob(\"*\") if p.is_file()):\n798\t        listing.append([path.relative_to(run_dir).as_posix(), _file_sha(path)])\n799\t    return _sha(json.dumps(listing, separators=(\",\", \":\")).encode(\"utf-8\"))\n800\t\n801\t\n802\tdef _gnd_version(results: dict) -> str:\n803\t    \"\"\"The gnd version as the fidelity route reports it (review finding R5: CLI only).\"\"\"\n804\t    for result in results.values():\n805\t        payload = result.get(\"payload\")\n806\t        if isinstance(payload, dict) and isinstance(payload.get(\"gnd_version\"), str):\n807\t            return payload[\"gnd_version\"]\n808\t    return \"unknown\"\n809\t\n810\t\n811\tdef refused_report(reason: str) -> dict:\n812\t    return {\"schema\": SCHEMA, \"exit_code\": 3, \"reason\": reason, \"stages\": [], \"failed_stages\": [],\n813\t            \"not_measured\": []}\n814\t\n815\t\n816\tdef _routes(inputs: Inputs, gnd: tuple[str, ...], work: Path):\n817\t    model, artifacts = str(inputs.model_path), str(inputs.root / inputs.corpus[\"artifacts\"][\"path\"])\n818\t    shown_model = inputs.corpus[\"model\"]\n819\t    jobs = {}"}

from __future__ import annotations

from pathlib import Path
from typing import Any

import pytest

from gnd.exp.frontmatter import read_frontmatter

COMPLETED_FIELD = "requirements-completed"
PHASES_ROOT = Path(__file__).parent
pinning = pytest.mark.skipif(not PHASES_ROOT.is_dir(), reason="the public fixture parent is absent")

def _frontmatter(path: Path) -> dict[str, Any]:
    """The document's frontmatter through the SHIPPED reader.

    Not ``yaml.safe_load`` over a hand-split file: ``read_frontmatter`` applies
    the byte cap before the read and refuses anchors and aliases, and running
    phase 3's own parser over this project's own artifacts is the dogfooding the
    plan asked for.
    """
    mapping, _body = read_frontmatter(path)
    return mapping


def _declares(mapping: dict[str, Any], field: str) -> bool:
    """Is ``field`` DECLARED — present with a value that is not empty?

    ``requirements-completed: []`` is not a claim of completion, and treating it
    as one would make the gate fire on a plan that completed nothing. Absent and
    empty are the same state for this rule, and saying so once here is what keeps
    the call sites from disagreeing about it.
    """
    value = mapping.get(field)
    if value is None:
        return False
    if isinstance(value, (list, tuple, set, dict, str)):
        return len(value) > 0
    return bool(value)


@pinning
def test_a_body_mention_is_not_a_declaration(tmp_path):
    """A grep-based gate would flag the closing plan's own prose.

    ``03-07-PLAN.md`` writes ``requirements-completed`` ten times in its body
    while explaining the rule, so a text scan cannot tell an explanation from a
    declaration. This test builds both documents and asserts the reader
    separates them — and asserts the NAIVE SCAN fires on both, so the test
    cannot pass over a gate that stopped distinguishing anything.
    """
    body_only = tmp_path / "03-99-PLAN.md"
    body_only.write_text(
        "---\n"
        "phase: 03-experiments-codegen-conformance\n"
        "plan: 99\n"
        "requirements: [EXP-01]\n"
        "requirements-partial: [EXP-01]\n"
        "---\n\n"
        "This plan explains that only the closing plan may record\n"
        "`requirements-completed`, and this plan is not it.\n",
        encoding="utf-8",
    )
    declaring = tmp_path / "03-98-PLAN.md"
    declaring.write_text(
        "---\n"
        "phase: 03-experiments-codegen-conformance\n"
        "plan: 98\n"
        "requirements: [EXP-01]\n"
        "requirements-completed: [EXP-01]\n"
        "---\n\nNo prose at all.\n",
        encoding="utf-8",
    )

    assert not _declares(_frontmatter(body_only), COMPLETED_FIELD), (
        "a body mention was read as a declaration — the gate is scanning text"
    )
    assert _declares(_frontmatter(declaring), COMPLETED_FIELD), (
        "a real frontmatter declaration was not seen — the gate reads nothing"
    )

    # The negative control: the naive scan this gate replaces fires on BOTH, so
    # the distinction above is a property of the reader and not of the fixtures.
    naive = [
        path.name
        for path in (body_only, declaring)
        if COMPLETED_FIELD in path.read_text(encoding="utf-8")
    ]
    assert naive == [body_only.name, declaring.name], (
        f"the naive text scan did not fire on both documents ({naive}); the "
        f"fixtures no longer demonstrate the difference the reader makes"
    )


@pinning
def test_an_empty_completion_list_is_not_a_completion(tmp_path):
    """``requirements-completed: []`` claims nothing, and must not be a finding.

    Stated as its own test because the alternative reading — presence is the
    declaration — makes the gate fire on a plan that completed nothing, and a
    gate that fires on a compliant document is one somebody switches off.
    """
    empty = tmp_path / "03-97-PLAN.md"
    empty.write_text(
        "---\nphase: p\nplan: 97\nrequirements-completed: []\n---\n\nbody\n",
        encoding="utf-8",
    )
    assert not _declares(_frontmatter(empty), COMPLETED_FIELD)
from __future__ import annotations

import re
from importlib.resources import files
from importlib.resources.abc import Traversable
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
AGENTS_MD = REPO_ROOT / "AGENTS.md"


def _skills_root() -> Traversable:
    return files('gnd') / 'skills'


def _packaged_skill_names() -> set[str]:
    return {entry.name for entry in _skills_root().iterdir() if entry.is_dir()}


def test_agents_md_table_names_every_packaged_skill() -> None:
    text = AGENTS_MD.read_text(encoding='utf-8')
    listed = set(re.findall('\\]\\(src/gnd/skills/([a-z0-9-]+)/SKILL\\.md\\)', text))
    packaged = _packaged_skill_names()
    missing = sorted(packaged - listed)
    extra = sorted(listed - packaged)
    assert not missing and (not extra), f"AGENTS.md's skill table is not the packaged tree.\n  missing from the table ({len(missing)}): " + ', '.join(missing) + f'\n  listed but not packaged ({len(extra)}): ' + ', '.join(extra) + '\nThe table routes agents; a packaged skill it omits is a skill nobody is routed to (this is how gnd-new-project went missing), and a listed skill that does not ship is a route to nowhere.'












from __future__ import annotations

from pathlib import Path

import pytest

from gnd.exp.frontmatter import (
    MAX_DOCUMENT_BYTES,
    FrontmatterError,
    read_frontmatter,
    render_frontmatter,
)

SPEC = """---
id: EXP-001-probe
kind: codegen
questions:
  - id: Q1
    text: Does the emitter agree with the model?
---

# EXP-001-probe

Body prose the reader must hand back untouched.
"""


def _write(path: Path, text: str) -> Path:
    path.write_text(text, encoding="utf-8")
    return path


def test_a_fenced_document_yields_its_mapping_and_its_body(tmp_path: Path) -> None:

    mapping, body = read_frontmatter(_write(tmp_path / "SPEC.md", SPEC))

    assert mapping["id"] == "EXP-001-probe"
    assert mapping["kind"] == "codegen"
    assert [q["id"] for q in mapping["questions"]] == ["Q1"]
    assert "Body prose the reader must hand back untouched." in body
    assert "kind: codegen" not in body, (
        "the frontmatter block leaked into the body — a reader that hands the "
        "fence back as prose makes every downstream body check meaningless"
    )


def test_a_document_with_no_opening_fence_is_refused(tmp_path: Path) -> None:






    path = _write(tmp_path / "SPEC.md", "# EXP-001-probe\n\nNo frontmatter here.\n")

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert "frontmatter" in str(caught.value).lower()


def test_a_document_with_no_closing_fence_is_refused(tmp_path: Path) -> None:

    path = _write(tmp_path / "SPEC.md", "---\nid: EXP-001-probe\n\nbody\n")

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert "closing" in str(caught.value).lower() or "unterminated" in str(caught.value).lower()


def test_a_document_over_the_byte_cap_is_refused_by_stat_before_any_read(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:







    path = tmp_path / "SPEC.md"
    path.write_bytes(b"---\nid: EXP-001-probe\n---\n" + b"x" * MAX_DOCUMENT_BYTES)

    def _never(*args: object, **kwargs: object) -> str:
        raise AssertionError("read_text was called — the cap did not precede the read")

    monkeypatch.setattr(Path, "read_text", _never)

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert str(MAX_DOCUMENT_BYTES) in str(caught.value)


def test_a_missing_document_is_refused_as_a_frontmatter_error(tmp_path: Path) -> None:

    with pytest.raises(FrontmatterError):
        read_frontmatter(tmp_path / "absent.md")


def test_a_sequence_frontmatter_block_is_refused(tmp_path: Path) -> None:

    path = _write(tmp_path / "SPEC.md", "---\n- one\n- two\n---\nbody\n")

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert "mapping" in str(caught.value).lower()


def test_a_scalar_frontmatter_block_is_refused(tmp_path: Path) -> None:

    path = _write(tmp_path / "SPEC.md", "---\njust a string\n---\nbody\n")

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert "mapping" in str(caught.value).lower()


def test_an_empty_frontmatter_block_is_refused(tmp_path: Path) -> None:

    path = _write(tmp_path / "SPEC.md", "---\n---\nbody\n")

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert "mapping" in str(caught.value).lower()


def test_unparseable_yaml_in_the_block_is_refused(tmp_path: Path) -> None:

    path = _write(tmp_path / "SPEC.md", "---\nid: [unclosed\n---\nbody\n")

    with pytest.raises(FrontmatterError):
        read_frontmatter(path)


@pytest.mark.parametrize(
    "hostile_value",
    (
        "9" * 10_000,
        "[" * 2_000 + "0" + "]" * 2_000,
    ),
    ids=("long-integer", "deep-nesting"),
)
def test_non_yaml_parser_failures_are_normalized(
    tmp_path: Path, hostile_value: str
) -> None:


    path = _write(
        tmp_path / "SPEC.md",
        f"---\nid: EXP-001-probe\nbomb: {hostile_value}\n---\nbody\n",
    )

    with pytest.raises(FrontmatterError, match="unparseable frontmatter"):
        read_frontmatter(path)


def test_an_anchor_alias_frontmatter_block_is_refused(tmp_path: Path) -> None:







    path = _write(
        tmp_path / "SPEC.md",
        "---\na: &anchor [x, x]\nb: [*anchor, *anchor]\n---\nbody\n",
    )

    with pytest.raises(FrontmatterError) as caught:
        read_frontmatter(path)
    assert "alias" in str(caught.value).lower()


def test_render_round_trips_through_read(tmp_path: Path) -> None:

    mapping = {
        "id": "EXP-001-probe",
        "kind": "codegen",
        "title": "Probe",
        "questions": [{"id": "Q1", "text": "Does the emitter agree with the model?"}],
        "follows": [],
    }
    path = _write(tmp_path / "SPEC.md", render_frontmatter(mapping, "# Probe\n"))

    loaded, body = read_frontmatter(path)
    assert loaded == mapping
    assert body.strip() == "# Probe"


def test_two_renders_of_one_mapping_are_byte_identical(tmp_path: Path) -> None:





    mapping = {"kind": "codegen", "id": "EXP-001-probe", "title": "Probe"}
    first = render_frontmatter(mapping, "# Probe\n")
    second = render_frontmatter(dict(reversed(list(mapping.items()))), "# Probe\n")

    assert first == second, "two renders of one mapping disagreed byte for byte"
    assert first.endswith("\n")
    assert first.startswith("---\n")


def test_render_sorts_its_keys(tmp_path: Path) -> None:

    rendered = render_frontmatter({"z": 1, "a": 2, "m": 3}, "body\n")
    block = rendered.split("---\n")[1]
    keys = [line.split(":")[0] for line in block.splitlines() if line and not line[0].isspace()]
    assert keys == sorted(keys)

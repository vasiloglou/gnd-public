   347	        # else it reaches, like a model-hosted one: a role_ref into another fact
   348	        # type, or an object type without a role (milestone close R1-F1).
   349	        subjects: set[str] = set()
   350	        if locator.host in {"fact_type", "included_fact_type"} and locator.host_id is not None:
   351	            subjects.add(locator.host_id)
   352	        # Before AND after: a constraint spanning only unpopulated fact
   353	        # types must not be re-pointed at a populated one (review F1).
   354	        _role_ref_fact_types(operation.before, subjects)
   355	        _role_ref_fact_types(operation.after, subjects)
   356	        subjects |= self._playing(_object_scoped_types(operation.before) | _object_scoped_types(operation.after))

"""RF6b predecessor imports, body pins and complete split ownership."""
from __future__ import annotations

import ast
import hashlib
import importlib
import json
import pickle
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[1]
E = ROOT / '.gnd-planning/milestones/code-refactoring/evidence/RF6'


def runtime_baseline(subject):
    path = E / f'RF6b-{subject}-py{sys.version_info.major}{sys.version_info.minor}.json'
    if not path.exists():
        if (sys.version_info.major, sys.version_info.minor) != (3, 14):
            pytest.skip('No predecessor metadata baseline captured for this interpreter')
        path = E / f'RF6b-{subject}.json'
    return path


def inventory():
    return json.loads((E / 'RF6b-definition-baseline.json').read_text())


def homes():
    path = E / 'RF6b-moves.json'
    return {(r['module'], r['name']): r['home'] for r in json.loads(path.read_text())} if path.exists() else {}


def assert_bindings(baseline):
    producers = {(r['module'], r['name']): r['home'] for r in json.loads((E / 'RF6b-binding-homes.json').read_text())} if (E / 'RF6b-binding-homes.json').exists() else homes()
    for module, rows in baseline.items():
        facade = importlib.import_module(module)
        for row in rows:
            value = getattr(facade, row['name'])
            assert type(value).__name__ == row['kind'], row
            if callable(value):
                assert getattr(value, '__module__', None) == row['module'], row
                assert getattr(value, '__qualname__', None) == row['qualname'], row
            if row['kind'] == 'module':
                assert value.__name__ == row['module'], row
            if 'value' in row and row['name'] not in {
                '_DERIVATION_WORK', '_DERIVATION_ATOM_VISITS', '_DERIVATION_CLASSIFICATION_WORK'
            }:
                assert value == row['value'], row
            if (module, row['name']) in producers:
                assert value is getattr(importlib.import_module(producers[module, row['name']]), row['name'])


def live_baseline():
    """The frozen import baseline less exactly the owner-retired names."""
    from support.rf9_ci_sources import retired_names
    baseline = json.loads(runtime_baseline('import-baseline').read_text())
    assert {k: len(v) for k, v in baseline.items()} == {'gnd.model': 238, 'gnd.checker': 230}
    retired = retired_names()
    assert retired <= {(module, row['name']) for module, rows in baseline.items() for row in rows}
    return {module: [row for row in rows if (module, row['name']) not in retired]
            for module, rows in baseline.items()}


def test_all_predecessor_import_bindings_and_metadata():
    baseline = live_baseline()
    assert {k: len(v) for k, v in baseline.items()} == {'gnd.model': 238, 'gnd.checker': 227}
    assert_bindings(baseline)


def test_deleted_binding_is_observed(monkeypatch):
    baseline = live_baseline()
    import gnd.model
    monkeypatch.delattr(gnd.model, 'semantic_validate')
    with pytest.raises(AttributeError):
        assert_bindings(baseline)


def mc1_definition(module, name):
    path = ROOT / '.gnd-planning/milestones/model-composition/evidence/MC1/definition-successors.json'
    rows = json.loads(path.read_text())
    matches = [r for r in rows if (r['module'], r['name']) == (module, name)]
    assert len(matches) <= 1
    selected = matches[0] if matches else None
    # Each successor file names its predecessor by path and digest; the main CI
    # repair (2026-11-16) chains after MC3.
    chain = ('.gnd-planning/milestones/model-composition/evidence/MC3/definition-successors.json',
             '.gnd-planning/maintenance/2026-11-16-main-ci-repair/definition-successors.json')
    predecessor = path
    for successor_name in chain:
        successor_path = ROOT / successor_name
        successor = json.loads(successor_path.read_text())
        assert successor['predecessor'] == predecessor.relative_to(ROOT).as_posix()
        assert successor['predecessor_sha256'] == hashlib.sha256(predecessor.read_bytes()).hexdigest()
        for row in successor['successors']:
            if (row['module'], row['name']) == (module, name):
                assert selected is not None and row['home'] == selected['home'] and row['before'] == selected['after']
                assert row['reason']
                selected = {**selected, 'after': row['after'], 'reason': row['reason']}
        predecessor = successor_path
    return selected


@pytest.mark.parametrize('row', inventory(), ids=lambda r: r['module'] + '.' + r['name'])
def test_original_definition_body_is_verbatim(row):
    mc1 = mc1_definition(row['module'], row['name'])
    module = mc1['home'] if mc1 else homes().get((row['module'], row['name']), row['module'])
    relative = module.replace('.', '/')
    path = ROOT / 'src' / (relative + '.py')
    if not path.is_file():
        path = ROOT / 'src' / relative / '__init__.py'
    source = path.read_text()
    definitions = [n for n in ast.parse(source).body if isinstance(n, (ast.FunctionDef, ast.ClassDef)) and n.name == row['name']]
    from support.rf9_ci_sources import retired_names
    if (row['module'], row['name']) in retired_names():
        assert definitions == []
        return
    assert len(definitions) == 1
    node = definitions[0]
    start = min([node.lineno] + [d.lineno for d in node.decorator_list])
    body = ''.join(source.splitlines(keepends=True)[start-1:node.end_lineno])
    from support.rf9_ci_sources import definition_successor
    successor = definition_successor(row['module'], row['name'])
    if successor:
        assert successor['home'] == (mc1['historical_home'] if mc1 else module)
        assert successor['before'] == row['sha256'] and successor['reason']
    expected = successor['after'] if successor else row['sha256']
    if mc1:
        assert mc1['before'] == expected and mc1['reason']
        expected = mc1['after']
    assert hashlib.sha256(body.encode()).hexdigest() == expected
    value = getattr(importlib.import_module(row['module']), row['name'])
    assert pickle.loads(pickle.dumps(value)) is value


def test_actual_predecessor_validation_and_checker_patches_have_effect(monkeypatch):
    from gnd import checker, model
    from gnd.documents import Model
    from gnd.population import Population
    validation = importlib.import_module(model.semantic_validate.__code__.co_filename.endswith('/_validation.py') and 'gnd.model._validation' or 'gnd.model')
    seen = []
    monkeypatch.setattr(validation, '_SEMANTIC_RULES', (lambda doc: seen.append(doc) or [],))
    doc = {'object_types': [], 'fact_types': []}
    assert model.semantic_validate(doc) == []
    assert seen == [doc]
    core = importlib.import_module('gnd.checker._core' if Path(checker.check.__code__.co_filename).name == '_core.py' else 'gnd.checker')
    sentinel = object()
    monkeypatch.setattr(core, '_check_dispatch', lambda *args: sentinel)
    m = Model(version=1, object_types=[], fact_types=[])
    p = Population.model_construct(fact_types={})
    assert checker.check(m, p) is sentinel


def split_homes():
    return {ROOT / 'src/gnd' / name for name in (
        'model/__init__.py', 'model/_validation.py', 'model/_operations.py',
        'model/_includes.py', 'model/_paths.py',
        # IK2 (2026-10-24): induced-provenance rules, split out at the size ceiling.
        'model/_induction.py',

def _retained_files(read, roster, files, max_bytes):
    """Read a run's files: the stage chain first, then the rest, each against the manifest's digest."""
    artifacts = {}
    predecessor = None
    for index, stage in enumerate(STAGES):
        name = f"stage-{index}.json"
        raw = read(name)
        stage_record = _decode(raw, max_bytes=max_bytes)
        _need(sha256_hex(raw) == roster[name] and stage_record.get("stage") == stage
              and stage_record.get("predecessor_sha256") == predecessor
              and stage_record.get("payload_sha256") == roster[f"payload-{index}.json"],
              "stale retained reading stage")
        artifacts[name] = raw
        predecessor = sha256_hex(raw)
    for name in files:
        if name in artifacts:
            continue
        raw = read(name)
        _need(sha256_hex(raw) == roster[name], "stale retained reading output")
        artifacts[name] = raw
    retained = {}
    for stage_index in (1, 3):
        payload = _decode(artifacts[f"payload-{stage_index}.json"], max_bytes=max_bytes)
        rows = payload.get("attempts")
        _need(isinstance(rows, list) and all(isinstance(row, dict) and isinstance(row.get("section"), str)
                                             and "response" in row for row in rows), "invalid retained payload")
        retained.update({row["section"]: row["response"] for row in rows})
    return artifacts, retained

"""Normative ORM scalar identity for synthesis-side code.

This is deliberately independent of :mod:`gnd.checker`: the synthesis oracle
must not call the implementation it evaluates.  It nevertheless implements the
same specified domains: booleans are separate, all JSON numeric renderings
share one domain, strings are separate, and tuples are keyed component-wise.
"""

from __future__ import annotations

from typing import Any


def scalar_identity(value: Any) -> tuple[str, Any]:
    """Return the synthesis identity key for one interchange scalar."""
    if isinstance(value, bool):
        return ("boolean", value)
    if isinstance(value, (int, float)):
        return ("number", value)
    if isinstance(value, str):
        return ("string", value)
    if value is None:
        return ("null", None)
    return (f"python:{type(value).__qualname__}", repr(value))


def tuple_identity(values: tuple[Any, ...]) -> tuple[tuple[str, Any], ...]:
    """Return component-wise ORM identity for a projected tuple."""
    return tuple(scalar_identity(value) for value in values)

def validate_reference_structure(document: object) -> None:
    stack = [(document, 0)]
    while stack:
        node, parent_depth = stack.pop()
        if isinstance(node, (list, dict)):
            depth = parent_depth + 1
            if depth > 64:
                raise ReferenceInputError("reference container depth exceeds 64")

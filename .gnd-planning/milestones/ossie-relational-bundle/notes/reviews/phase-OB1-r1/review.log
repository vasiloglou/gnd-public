n.dumps(candidate, indent=1, ensure_ascii=False) + \"\\n\"\n\n# Every other top-level element must be unchanged in the candidate.\nfor key in model:\n    if key == \"constraints\":\n        continue\n    assert candidate[key] == model[key], key\nfor j, c in enumerate(model[\"constraints\"]):\n    if j != i:\n        assert candidate[\"constraints\"][j] == c, c[\"id\"]\n\nproposal = {\n    \"schema_version\": 3,\n    \"proposal_id\": \"credit-cap-6\",\n    \"expected_model_sha256\": hashlib.sha256(raw).hexdigest(),\n    \"candidate_model\": {\n        \"media_type\": \"application/json\",\n        \"encoding\": \"utf-8\",\n        \"text\": candidate_text,\n        \"sha256\": hashlib.sha256(candidate_text.encode(\"utf-8\")).hexdigest(),\n    },\n    \"operations\": [operation],\n    \"rationale\": (\n        \"Owner lowers the per-term credit cap from 18 to 6 for every student. \"\n        \"Only the credit_cap bound changes; the 6-course cap and all other \"\n        \"constraints, fact types and operations are unchanged.\"\n    ),\n    \"audit\": {\n        \"actor_id\": \"user:<user>\",\n        \"origin\": \"claude-code:gnd-model-evolve\",\n        \"requested_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    },\n    \"linked_projects\": [],\n    \"artifacts\": [],\n}\n\nPROPOSAL.write_text(json.dumps(proposal, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\nprint(\"wrote:\", PROPOSAL)\nprint(\"expected_model_sha256:\", proposal[\"expected_model_sha256\"])\nprint(\"candidate sha256:\", proposal[\"candidate_model\"][\"sha256\"])\nprint(\"canonical_before_sha256:\", operation[\"locator\"][\"canonical_before_sha256\"])\n"}, "caller": {"type": "direct"}}]}}

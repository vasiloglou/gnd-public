def _evolve_workspace_path(
    workspace: Path,
    value: str,
    *,
    label: str,
    required: bool,
    regular: bool = True,
) -> tuple[Path, str]:
    return _evolve_rooted_path(
        workspace,
        value,
        root_label="workspace",
        label=label,
        required=required,
        regular=regular,
    )

def _evolve_records_root(value: str) -> Path:
    records = _evolve_absolute_path(value, label="records root")
    _evolve_reject_existing_symlinks(records, label="records root")
    try:
        info = records.lstat()
    except FileNotFoundError:
        pass
    except OSError as error:
        raise _EvolutionCLIError(
            EXIT_IO, f"records root {records} could not be inspected: {error}"
        ) from error
    else:
        if not stat.S_ISDIR(info.st_mode):
            raise _EvolutionCLIError(EXIT_IO, f"records root {records} is not a real directory")
    try:
        return records.resolve(strict=False)
    except OSError as error:
        raise _EvolutionCLIError(
            EXIT_IO, f"records root {records} could not be resolved: {error}"
        ) from error

def _evolve_read_claim(
    path: Path,
    model_type: Any,
    *,
    label: str,
    anchor: Path | None = None,
    relative: str | None = None,
) -> Any:
    from gnd.evolve import (
        EvolutionFinalizationState,
        EvolutionIntent,
        EvolutionPreview,
        EvolutionProposal,
        EvolutionRecord,
        read_evolution_finalization_state,
        read_evolution_intent,
        read_evolution_preview,
        read_evolution_proposal,
        read_evolution_record,
    )

    readers = {
        EvolutionFinalizationState: read_evolution_finalization_state,
        EvolutionIntent: read_evolution_intent,
        EvolutionPreview: read_evolution_preview,
        EvolutionProposal: read_evolution_proposal,
        EvolutionRecord: read_evolution_record,
    }
    reader = readers.get(model_type)
    if reader is None:
        raise _EvolutionCLIError(
            EXIT_INTERNAL,
            f"{label} has no claim-specific evolution reader",
        )
from __future__ import annotations

import argparse
from datetime import datetime

import gnd.discover.service as _handler_discover_service
from gnd.commands._arguments import _add_format_argument

FAMILIES = _handler_discover_service.FAMILIES
#: Opt-in discovery families are excluded from the defaults.
OPT_IN = ("fact-type", _handler_discover_service.joined.FAMILY)


def _families(text: str) -> tuple[str, ...]:
    names = tuple(name.strip() for name in text.split(",") if name.strip())
    unknown = sorted(set(names) - set(FAMILIES) - set(OPT_IN))
    if not names or unknown:
        raise argparse.ArgumentTypeError(
            f"unknown families {unknown}; choose from {', '.join(FAMILIES + OPT_IN)}"
        )
    return tuple(family for family in FAMILIES + OPT_IN if family in names)


def _at_least(minimum: int):
    def parse(text: str) -> int:
        try:
            value = int(text)
        except ValueError as error:
            raise argparse.ArgumentTypeError(f"{text!r} is not an integer") from error
        if value < minimum:
            raise argparse.ArgumentTypeError(f"must be at least {minimum}")
        return value

    return parse


def _actor(text: str) -> str:
    if not text.strip():
        raise argparse.ArgumentTypeError("--actor must name who requests the proposal")
    return text


def _requested_at(text: str) -> datetime:
    try:
        value = datetime.fromisoformat(text)
    except ValueError as error:
        raise argparse.ArgumentTypeError(f"{text!r} is not an ISO-8601 time") from error
    if value.tzinfo is None or value.utcoffset() is None:
        raise argparse.ArgumentTypeError("--requested-at needs a UTC offset")
    return value


def _register_discover(subparsers):
    discover_parser = subparsers.add_parser(
        "discover",
        help="propose induced constraints observed in one population (IK4)",
        description=(
            "Propose candidate constraints of seven families (uniqueness, mandatory, "
            "value, frequency, subset, equality, exclusion) that hold in one "
            "population. A candidate is kept only when `gnd check` passes it with "
            "support > 0 and the model neither declares nor entails it. Writes a "
            "discovery report and, when anything is emitted, a `gnd evolve` "
            "proposal of induced, proposed, deontic constraints: admission stays a "
            "reviewed act. Exits 0 on success (also with nothing emitted), 3 on an "
            "invalid model or population, 11 when --out already exists (nothing "
            "written), 64 on a usage error, 66 on a missing input or reference "
            "file, 70 on an internal defect, 74 on a refused output or reference "
            "path."
        ),
    )
    discover_parser.add_argument("model", help="path to the model file")
    discover_parser.add_argument("population", help="path to the population file")
    discover_parser.add_argument("--out", required=True, help="write the evolve proposal here")
    discover_parser.add_argument("--report", required=True, help="write the discovery report here")
    discover_parser.add_argument(
        "--actor", required=True, type=_actor,
        help="who requests the proposal (its audit actor_id)",
    )
    discover_parser.add_argument(
        "--requested-at", required=True, type=_requested_at,
        help="when, as ISO-8601 with a UTC offset (the audit time; keeps output reproducible)",
    )
    discover_parser.add_argument(
        "--families", type=_families, default=FAMILIES,
        help="comma-separated subset of the seven default families; add fact-type or guarded-join to opt in",
    )
    discover_parser.add_argument(
        "--max-values", type=_at_least(1), default=20,
        help="largest distinct-value count for a value candidate (default 20)",
    )
    discover_parser.add_argument(
        "--max-pairs", type=_at_least(0), default=256,
        help="most unordered role pairs compared for subset/equality/exclusion (default 256)",
    )
    discover_parser.add_argument(
        "--min-support", type=_at_least(1), default=None,
        help="fact-type family: fewest distinct entities for a proposal (default 20)",
    )
    discover_parser.add_argument(
        "--show-values", action="store_true",
        help="fact-type family: also report each attribute value as text (disclosure mode decides)",
    )
    discover_parser.add_argument(
        "--type-evidence", default=None, metavar="PATH",
        help="fact-type family: also write the evidence the judgement skills read",
    )
    discover_parser.add_argument(
        "--type-evidence-in", default=None, metavar="PATH",
        help="fact-type family: the evidence file the judgements bind",
    )
    discover_parser.add_argument(
        "--duplicate-judgements", default=None, metavar="PATH",
        help="fact-type family: read duplicate verdicts (needs --type-evidence-in)",
    )
    discover_parser.add_argument(
        "--shape-judgements", default=None, metavar="PATH",
        help="fact-type family: read multi-valued shape verdicts (needs --type-evidence-in)",
    )
    discover_parser.add_argument("--joined-relation", metavar="FACT:SOURCE:TARGET",
                                 help="guarded-join family: binary relation and endpoint roles")
    discover_parser.add_argument("--joined-classifier", metavar="FACT:ENTITY:CLASS",
                                 help="guarded-join family: binary classifier and its roles")
    discover_parser.add_argument("--joined-marker", metavar="FACT:ENTITY:VALUE=JSON",
                                 help="guarded-join family: restrict same-class candidates by a target marker")
    discover_parser.add_argument("--max-directed-pairs", type=_at_least(0), metavar="N",
                                 help="guarded-join family: most ordered class pairs considered (default 256)")
    _add_format_argument(discover_parser)
    return {"discover_parser": discover_parser}


def add_parsers(subparsers, *, command: str | None = None):
    parsers = {}
    if command is None or command == "discover":
        selected = _register_discover(subparsers)
        parsers.update(selected)
        selected["discover_parser"].set_defaults(
            handler=lambda args, selected=selected: handle(args, selected)
        )
    if not parsers:
        raise ValueError(f"unsupported command: {command}")
    return parsers


def handle(args, parsers) -> int:
    if args.command == "discover":
        judging = {"type_evidence_in": args.type_evidence_in, "duplicate_judgements": args.duplicate_judgements,
                   "shape_judgements": args.shape_judgements}
        judging = {key: value for key, value in judging.items() if value is not None}
        if "fact-type" not in args.families and (args.show_values or args.min_support is not None
                                                 or args.type_evidence is not None or judging):
            parsers["discover_parser"].error(
                "--min-support, --show-values, --type-evidence, --type-evidence-in and the judgements "
                "options need --families fact-type")
        show_values, show_digests = False, True
        if "fact-type" in args.families:
            import sys

            from gnd.disclosure import DisclosureRefused, resolve, values_allowed

            try:
                show_values = values_allowed(args.show_values, "--show-values")
                show_digests = resolve() != "customer"
            except DisclosureRefused as error:
                print(f"gnd: error: {error}", file=sys.stderr)
                return 3
        joined = _handler_discover_service.joined
        joined_settings = None
        if joined.FAMILY in args.families:
            if args.joined_relation is None or args.joined_classifier is None:
                parsers["discover_parser"].error("guarded-join needs --joined-relation and --joined-classifier")
            try:
                joined_settings = joined.configure(
                    args.joined_relation, args.joined_classifier, args.joined_marker, args.max_directed_pairs
                )
            except ValueError as error:
                parsers["discover_parser"].error(str(error))
        elif any(value is not None for value in (
            args.joined_relation, args.joined_classifier, args.joined_marker, args.max_directed_pairs
        )):
            parsers["discover_parser"].error("joined options need --families guarded-join")
        return _handler_discover_service._cmd_discover(
            args.model,
            args.population,
            out=args.out,
            report=args.report,
            actor=args.actor,
            requested_at=args.requested_at,
            families=args.families,
            max_values=args.max_values,
            max_pairs=args.max_pairs,
            output_format=args.format,
            **({} if joined_settings is None else {"joined_settings": joined_settings}),
            **({} if "fact-type" not in args.families else {
                "min_support": 20 if args.min_support is None else args.min_support,
                "show_values": show_values,
                "show_digests": show_digests,
                **({} if args.type_evidence is None else {"type_evidence": args.type_evidence}),
                **judging,
            }),
        )

    raise ValueError(f"unsupported command: {args.command}")
    if not (result["final"] or result["type_operations"]):
        return None
    proposal_bytes, fits = _proposal_bytes(result, actor, requested_at, population_path)
    types_ = result["type_proposals"]
    # The size estimate is a pre-filter; the written bytes decide
    # (close review): drop type groups from the tail, in steps, until
    # both caps hold. The other families keep their own estimate, so
    # without type groups the proposal is written as before.
    while not fits and types_ is not None and types_.group_sizes:
        types_.drop_last(max(1, len(types_.group_sizes) // 16))
        result["type_operations"] = tuple(types_.operations)
        if not (result["final"] or result["type_operations"]):
            return None
        proposal_bytes, fits = _proposal_bytes(result, actor, requested_at, population_path)
    return proposal_bytes


def _evidence(result: dict[str, Any], min_support: int, show_values: bool, show_digests: bool) -> dict[str, Any]:
    fields = result["fields"]
    return evidence.build_evidence(
        result["view"], result["type_proposals"],
        model_sha256=fields["model"]["sha256"], population_sha256=fields["population"]["sha256"],
        min_support=min_support, show_values=show_values, show_digests=show_digests,
        redacted_generics=result["type_proposals"].redacted_generics,
        redacted_roles=RedactionPolicy.from_model(result["view"].model).effective_roles,
    )


def _induced(view: PopulationView, proposals: types.TypeProposals) -> dict[int, list[str]]:
    """Per group position, the fact types whose induced_from names its attribute (D4)."""
    by_origin: dict[tuple[str, str], list[str]] = {}
    for fact_id, origin in evidence.origins(view).items():
        if origin is not None:
            by_origin.setdefault((origin["generic"], origin["attribute_sha256"]), []).append(fact_id)
    return {number: by_origin[record.generic, record.attribute_sha256]
            for number, record in enumerate(proposals.groups)
            if (record.generic, record.attribute_sha256) in by_origin}


_BOUND_KEYS = ("model_sha256", "population_sha256", "min_support", "show_values", "show_digests")


def _first_difference(given: bytes, recomputed: bytes) -> str:
    """Which bound setting differs, by key only: the evidence may hold values."""
    try:
        old = _rf7_input.loads(given)
    except (ValueError, RecursionError):
        return "the evidence is not this run's evidence"
    new = _rf7_input.loads(recomputed)
    if isinstance(old, dict):
        for key in _BOUND_KEYS:
            if old.get(key) != new[key]:
                return f"{key} differs from this run's; the evidence does not bind this model, population and settings"
    return "groups differ from this run's; the evidence does not bind this model, population and settings"


def _cmd_discover(
    model: str,
    population: str,
    *,
    out: str,
    report: str,
    actor: str,
    requested_at: datetime,
    families: tuple[str, ...],
    max_values: int,
    max_pairs: int,
    output_format: str,
    min_support: int = 20,
    show_values: bool = False,
    show_digests: bool = True,
    type_evidence: str | None = None,
    type_evidence_in: str | None = None,
    duplicate_judgements: str | None = None,
    shape_judgements: str | None = None,
    joined_settings: joined.Settings | None = None,
) -> int:
    try:
        joined.require_family(families, joined_settings)
    except ValueError as error:
        _stderr(str(error))
        return EXIT_USAGE
    model_path, population_path = Path(model), Path(population)
    out_path, report_path = Path(out), Path(report)
    evidence_path = None if type_evidence is None else Path(type_evidence)
    evidence_in = None if type_evidence_in is None else Path(type_evidence_in)
    judgement_paths = {kind: Path(path) for kind, path in
                       (("duplicates", duplicate_judgements), ("shapes", shape_judgements)) if path is not None}
    judging = evidence_in is not None or bool(judgement_paths)
    if (evidence_path is not None or judging) and types.FAMILY not in families:
        _stderr("--type-evidence, --type-evidence-in and the judgements options need --families fact-type")
        return EXIT_USAGE
    if judging and (evidence_in is None or not judgement_paths):
        _stderr("--duplicate-judgements and --shape-judgements need --type-evidence-in, and it needs one of them")
        return EXIT_USAGE
    if judging and evidence_path is not None:
        _stderr("--type-evidence cannot be combined with --type-evidence-in")
        return EXIT_USAGE
    outputs = (out_path, report_path) + (() if evidence_path is None else (evidence_path,))
    inputs = (model_path, population_path) + (() if evidence_in is None else (evidence_in,)) + tuple(
        judgement_paths.values())
    resolved = [p.resolve() for p in (*outputs, *inputs)]
    if len(set(resolved)) != len(resolved):
        # --out, --report and the two inputs must be four different files (R9);
        # with --type-evidence, five (TS1); with judgements, every path (TS2).
        if judging:
            _stderr("--out, --report, MODEL, POPULATION, --type-evidence-in and the judgements files "
                    "must be different paths")
        elif evidence_path is None:
            _stderr("--out, --report, MODEL and POPULATION must be four different paths")
        else:
            _stderr("--out, --report, --type-evidence, MODEL and POPULATION must be five different paths")
        return EXIT_USAGE
    for path in inputs:
        if not path.is_file():
            _stderr(f"input {path} does not exist")
            return EXIT_NO_INPUT
    if out_path.is_symlink():
        _stderr(f"refusing to write through symbolic link {out_path}")
        return EXIT_IO
    if evidence_path is not None and evidence_path.is_symlink():
        _stderr(f"refusing to write through symbolic link {evidence_path}")
        return EXIT_IO
    if out_path.exists():
        # Owner ruling IK4-Q1 (2026-10-25): an existing proposal is never
        # overwritten or left beside a newer report; the run refuses first.
        _stderr(f"--out {out_path} already exists; nothing was written")
        return EXIT_COLLISION
    if evidence_path is not None and evidence_path.exists():
        _stderr(f"--type-evidence {evidence_path} already exists; nothing was written")
        return EXIT_COLLISION
    evidence_raw, documents, digests = b"", {}, {}
    if judging:
        # The judgements and their binding are checked before the model or
        # the population is read, so a wrong file refuses cheaply (TS2 §6.1).
        try:
            with evidence_in.open("rb") as handle:
                evidence_raw = handle.read(evidence.MAX_EVIDENCE_BYTES + 1)
            if len(evidence_raw) > evidence.MAX_EVIDENCE_BYTES:
                raise judgements.TypeJudgementError(
                    f"--type-evidence-in: the file exceeds {evidence.MAX_EVIDENCE_BYTES} bytes")
            evidence_sha256 = hashlib.sha256(evidence_raw).hexdigest()
            for kind, path in judgement_paths.items():
                documents[kind], digests[kind] = judgements.read(path, kind=kind)
                judgements.check_binding(documents[kind], kind=kind, evidence_sha256=evidence_sha256)
        except judgements.TypeJudgementError as error:
            _stderr(str(error))
            return EXIT_ILL_FORMED
        except OSError as error:
            _stderr(f"could not read input: {error}")
            return EXIT_IO
    try:
        result = discover(
            model_path, population_path,
            families=families, max_values=max_values, max_pairs=max_pairs,
            min_support=min_support, show_values=show_values, show_digests=show_digests,
            joined_settings=joined_settings,
        )
        loaded = result["view"].model
        if loaded.includes:
            exclude_input_outputs(model_path, loaded._included, outputs)
    except (IncludeInputError, ModelLoadError, ModelValidationError, PopulationLoadError, ReferenceInputError,
            types.GenericDeclarationError) as error:
        _stderr(str(error))
        return EXIT_ILL_FORMED
    except ArtifactError as error:
        # The reference binder is discover's only artifact read, and it passes
        # its own refusal through (IK4-Q2-R1). IKE-Q3 D1-A: evolve's exits, a
        # missing file 66 and any other refused path 74, judged by the cause
        # chain as evolve judges it.
        _stderr(f"reference population: {error}")
def _composed_view(data, *, source, root, historical=None, analysis=False,
                   bind_references=True):
    with retained_root(root) as descriptor:
        result = _load_model_at(data, source=source, descriptor=descriptor,
                                historical=historical, analysis=analysis)
        model = result.model if analysis else result
        if model is None:
            return result
        if bind_references and model.reference_populations:
            try:
                model._references = _bind_at(model, descriptor)
            except ReferenceHashMismatch:
                raise
            except Exception as error:
                raise ReferenceInputError(str(error), model=model) from error
        return result


def _load_model_bytes_captured(data, *, source, candidate=False):
    from gnd.model._includes import _refuse, guard_bytes, include_reason

    try:
        guard_bytes(data, source=source, route='captured-proposal-input')
    except ModelValidationError as error:
        if include_reason(error) != 'include:unsupported-route':
            raise
        if candidate:
            return load_model_bytes_composed(data, source=source, root=Path(source).parent)
        model = _load_model_no_follow(Path(source))
        if model._authored_sha256 != hashlib.sha256(data).hexdigest():
            _refuse('hash-mismatch')
        return model
    return load_model_bytes(data, source=source)

def _load_model_no_follow(path: Path) -> Model:
    """Strict path intake for consumers whose contract forbids symlink traversal."""
    from gnd import artifacts

    with retained_root(path.parent) as descriptor:
        data, _ = artifacts.read_regular_bounded_at(
            descriptor, path.name, max_bytes=MAX_MODEL_BYTES

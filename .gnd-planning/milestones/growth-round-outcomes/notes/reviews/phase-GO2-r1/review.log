def _kept(character: str) -> str:
    """``character`` as YAML keeps it inside a double-quoted JSON string."""
    if character == " " or character.isprintable():
        return character
    code = ord(character)
    return f"\\u{code:04x}" if code < 0x10000 else f"\\U{code:08x}"



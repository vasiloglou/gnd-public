   262	def _drift(text: str) -> list[str]:
   263	    """Every `gnd ...` invocation whose command, options or literal choices do not exist, and every
   264	    bare option that none of the driven commands has."""
   265	    parsers = _parsers()
   266	    known = {option: action for command in _COMMANDS for option, action in _actions(parsers[command]).items()}
   267	    problems = []
   268	    for span in _invocations(text):
   269	        words = span.split()
   270	        if words[:1] == ["gnd"]:
   271	            command = next((key for key in (tuple(words[1:3]), tuple(words[1:2])) if key in parsers), None)
   272	            if command is None:
   273	                problems.append(f"no such command: {span}")
   274	                continue
   275	            problems += _option_problems(span, words, _actions(parsers[command]))
   276	        elif words[0].startswith("--"):
   277	            problems += _option_problems(span, words, known)
   278	    return problems

+    for name in BUILT:
+        (work / name).unlink()
+    subprocess.run([sys.executable, str(BUILD), str(work)], check=True)
+    for name in BUILT:
+        assert (work / name).read_bytes() == (EXAMPLE / name).read_bytes(), name
+
+
+def test_T1_both_rounds_apply_and_publish_the_built_candidate(grown):

323:         _write_fidelity_case(folder / kind / "held-back-predicate", header, index,
324:                              inputs.raw["calibration.txt"], {"alternative_integrator": gold["alternative_integrator"]},
325:                              calibration[kind])
326:         report = _route(folder, "fidelity", header["model"], "--cases", kind,
327:                         "--artifacts", "bundle", "--format", "json").stdout
328:         measured[kind] = report, _recall(report)

   196	def constraint_change(path: str, before: Any, after: Any, *, family: Any = None) -> str:
   197	    """The closed strengthening/weakening list (plan §2.2, MG-D3 (a), (p1) F).
   198	
   199	    ``family`` is the constraint's ``type``: only a uniqueness constraint is
   200	    monotone in its role set (more roles, weaker key). A frequency
   201	    constraint's ``roles`` is a projection, and widening it makes finer groups
   202	    that must each reach ``bound.min``, so its change is neither (review F2).
   203	    """
   204	
   205	    leaf = path.rsplit(".", 1)[-1]
   206	    parent = path.rsplit(".", 1)[0] if "." in path else ""
   207	    parent_leaf = parent.rsplit(".", 1)[-1].split("[", 1)[0] if parent else ""
   208	    if path in {"rationale", "remedy"}:
   209	        # Author text: why the rule exists, what to do about a violation.
   210	        return _ADMITTED
   211	    if path == "provenance.reviewed_in":
   212	        # The audit key D-12 strips from a reviewed status change
   213	        # (`_without_review`); the change it accompanies is judged by `status`.
   214	        return _ADMITTED
   215	    if path == "roles":
   216	        return _subset(before, after) if family == "uniqueness" else _NEITHER
   217	    if path == "allowed":
   218	        return _subset(before, after)
   219	    if parent_leaf in {"range", "ranges", "bound"}:
   220	        if leaf == "min":
   221	            return _ordered(before, after, tightens_when_raised=True)
   222	        if leaf == "max":
   223	            return _ordered(before, after, tightens_when_raised=False)
   224	        if leaf == "min_inclusive" or leaf == "max_inclusive":
   225	            return _transition(before, after, (True, False))
   226	        return _NEITHER
   227	    if path == "modality":
   228	        return _transition(before, after, ("deontic", "alethic"))
   229	    if path == "status":
   230	        return _transition(before, after, ("proposed", "confirmed"))
   231	    return _NEITHER

     2	from __future__ import annotations
     3	
     4	from pathlib import Path
     5	
     6	
     7	def skill_name(path: str | Path) -> str | None:
     8	    """Return the ``name`` a SKILL.md declares in its frontmatter, or None."""
     9	    header = Path(path).read_text(encoding="utf-8").split("---")[1]
    10	    for line in header.splitlines():
    11	        if line.startswith("name:"):
    12	            return line.split(":")[1].strip()
    13	    return None
    14	
    15	
    16	def skill_names(root: str | Path) -> dict[str, str | None]:
    17	    """Map each skill directory under ``root`` to the name its SKILL.md declares."""
    18	    return {path.parent.name: skill_name(path) for path in sorted(Path(root).glob("*/SKILL.md"))}

ecar(header, index, document, candidate, \"document.md\", \"extracted.population.json\")\n294\t    document_manifest = {\n295\t        \"schema_version\": 1, \"model\": header[\"model\"], \"model_sha256\": index[\"model\"][\"sha256\"],\n296\t        \"source_population\": \"source.population.json\", \"source_population_sha256\": sha256_hex(source),\n297\t        \"document\": \"document.md\", \"document_sha256\": sha256_hex(document),\n298\t        \"applicable_sha256\": index[\"artifacts\"][\"reading.orm.applicable.json\"][\"sha256\"],\n299\t        \"renderer_skill\": \"gnd-render-doc\", \"renderer_skill_version\": \"1\",\n300\t        \"executing_model\": \"authored-public-fixture\", \"distractors\": [],\n301\t    }\n302\t    for name, raw in (\n303\t        (\"document.md\", document), (\"source.population.json\", source),\n304\t        (\"extracted.population.json\", candidate),\n305\t        (\"extracted.population.extraction.json\", canonical_json_bytes(sidecar)),\n306\t        (\"document.manifest.json\", canonical_json_bytes(document_manifest)),\n307\t    ):\n308\t        (case_root / name).write_bytes(raw)\n309\t\n310\t\n311\tdef _calibrate(folder, inputs, header, index, targeted):\n312\t    calibration = _decode(inputs.raw[\"calibration.json\"])\n313\t    gold = _decode(inputs.raw[\"gold.json\"])\n314\t    _need(set(gold) == CALIBRATION_FACTS, \"invalid held-back gold roster\")\n315\t    methods = next((row for row in targeted if row[\"section\"] == \"study-methods\"), None)\n316\t    facts = methods[\"response\"][\"facts\"] if methods is not None else {}\n317\t    observed = {name: facts[name] for name in (\"approximation\",) if name in facts}\n318\t    measured = {}\n319\t    for kind in (\"high\", \"low\"):\n320\t        _write_fidelity_case(folder / kind / \"run-methods\", header, index,\n321\t                             inputs.source_range(inputs.sections[\"study-methods\"]),\n322\t                             {\"approximation\": gold[\"approximatio
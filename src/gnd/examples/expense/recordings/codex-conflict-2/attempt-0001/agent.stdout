explicit\",\n      \"status\": \"confirmed\",\n      \"modality\": \"alethic\",\n      \"provenance\": {\n        \"user_quote\": \"Equipment expenses cost at most 3000 EUR.\"\n      }\n    },\n    {\n      \"id\": \"approval_limit_team_lead\",\n      \"type\": \"guarded\",\n      \"antecedent\": [\n        {\n          \"fact_type\": \"expense_approved_by_chain\",\n          \"bind\": {\n            \"expense\": \"$e\",\n            \"chain\": \"team-lead\"\n          }\n        },\n        {\n          \"fact_type\": \"expense_has_amount\",\n          \"bind\": {\n            \"expense\": \"$e\",\n            \"amount\": \"$a\"\n          }\n        }\n      ],\n      \"consequent\": {\n        \"comparison\": {\n          \"operator\": \"<=\",\n          \"left\": \"$a\",\n          \"right\": 100\n        }\n      },\n      \"source\": \"explicit\",\n      \"status\": \"confirmed\",\n      \"modality\": \"alethic\",\n      \"provenance\": {\n        \"user_quote\": \"The team-lead chain approves at most 100 EUR.\"\n      }\n    },\n    {\n      \"id\": \"approval_limit_finance\",\n      \"type\": \"guarded\",\n      \"antecedent\": [\n        {\n          \"fact_type\": \"expense_approved_by_chain\",\n          \"bind\": {\n            \"expense\": \"$e\",\n            \"chain\": \"finance\"\n          }\n        },\n        {\n          \"fact_type\": \"expense_has_amount\",\n          \"bind\": {\n            \"expense\": \"$e\",\n            \"amount\": \"$a\"\n          }\n        }\n      ],\n      \"consequent\": {\n        \"comparison\": {\n          \"operator\": \"<=\",\n          \"left\": \"$a\",\n          \"right\": 3000\n        }\n      },\n      \"source\": \"explicit\",\n      \"status\": \"confirmed\",\n      \"modality\": \"alethic\",\n      \"provenance\": {\n        \"user_quote\": \"The finance chain approves at most 3000 EUR.\"\n      }\n    }\n  ]\n}\n    },\n    {\n      \"id\": \"expense_is_approved\",\n      \"reading\": \"{Expense} is approved\",\n      \"roles\": [\n        {\n          \"object_type\": \"expense\",\n          \"role_name\": \"expense\"\n        }\n      ],\n      \"constraints\": [\n        {\n          \"id\": \"one_expense_is_approved\",\n          \"type\": \"uniqueness\",\n          \"roles\": [\n            \"expense\"\n          ],\n          \"source\": \"explicit\",\n          \"status\": \"confirmed\",\n          \"modality\": \"alethic\",\n          \"provenance\": {\n            \"user_quote\": \"Each expense has at most one value for this fact.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"expense_approved_by_chain\",\n      \"reading\": \"{Expense} is approved by {Chain}\",\n      \"roles\": [\n        {\n          \"object_type\": \"expense\",\n          \"role_name\": \"expense\"\n        },\n        {\n          \"object_type\": \"chain\",\n          \"role_name\": \"chain\"\n        }\n      ],\n      \"constraints\": [\n        {\n          \"id\": \"one_expense_approved_by_chain\",\n          \"type\": \"uniqueness\",\n          \"roles\": [\n            \"expense\"\n          ],\n          \"source\": \"explicit\",\n          \"status\": \"confirmed\",\n          \"modality\": \"alethic\",\n          \"provenance\": {\n            \"user_quote\": \"Each expense has at most one value for this fact.\"\n          }\n        }\n      ]\n    }\n  ],\n  \"constraints\": [\n    {\n      \"id\": \"known_categories\",\n      \"type\": \"value\",\n      \"object_type\": \"category\",\n      \"allowed\": [\n        \"meals\",\n        \"training\",\n        \"travel\",\n        \"equipment\"\n      ],\n      \"source\": \"explicit\",\n      \"status\": \"confirmed\",\n      \"modality\": \"alethic\",\n      \"provenance\": {\n        \"user_quote\": \"The four tutorial expense categories are meals, training, travel and equipment.\"\n      }\n    },\n    {\n      \"id\": \"known_chains\",\n324f9ebf1c8a2b7420143f078e26e7f1c1049a4b9414f935f438becc87f2f43d  ../session.contract.json\n60e1e3a77c83a96f494da91d357cc09f1c15a8557ac6491c096461f3c34bfcfd  ../input/seed.population.json\nb9ecff986774a2648cb687aeacf196d2822ee6c5b4261f0628f60026f04be730  ../input/TASK.md\n027c3631b207114f3d26966a62cb601b1b6d3bd031562f95f6bfcfa98f9ce2e0  ../model.orm.json\n","exit_code":0,"status":"completed"}}

++      "required": ["id", "path", "sha256"],
++      "additionalProperties": false,
++      "properties": {
++        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]{0,63}$"},
++        "path": {
++          "type": "string",
++          "maxLength": 256,
++          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
++        },
++        "sha256": {"$ref": "#/$defs/sha256"},

   188	def _transition(before: Any, after: Any, strengthening: tuple[Any, Any]) -> str:
   189	    if (before, after) == strengthening:
   190	        return _STRENGTHENING
   191	    if (before, after) == (strengthening[1], strengthening[0]):
   192	        return _WEAKENING
   193	    return _NEITHER

def discover(
    model_path: Path,
    population_path: Path,
    *,
    families: tuple[str, ...],
    max_values: int,
    max_pairs: int,
    min_support: int = 20,
    show_values: bool = False,
    show_digests: bool = True,
    joined_settings: joined.Settings | None = None,
) -> dict[str, Any]:
    """Run discovery; return the report fields plus private build inputs."""
    joined.require_family(families, joined_settings)
    model_bytes = _read_capped(model_path, MAX_MODEL_BYTES, ModelLoadError, "model")
    population_bytes = _read_capped(
        population_path, MAX_POPULATION_BYTES, PopulationLoadError, "population"
    )
    model = _load_model_bytes_captured(model_bytes, source=model_path)
    population = load_population_bytes(population_bytes, source=population_path, model=model)
    basename = population_path.name
    if len(basename) > MAX_EVIDENCE_REF or _REF.fullmatch(basename) is None:
        raise PopulationLoadError(
            f"population file name {basename!r} is not a valid induction evidence ref"
        )
    population, _ = _bind_references(model, population, model_path.parent)
    document = _parse_model_text(model_bytes.decode("utf-8"))
    work = Work()
    view = PopulationView(model, population, work)
    eligible, skipped_fact_types = _eligible(view, document)
    if types.FAMILY in families:
        types.generic_declarations(view)  # an invalid declaration refuses first
    redacted = RedactionPolicy.from_model(model).effective_roles
    generated = generate(
        view, families=families, fact_types=eligible, max_values=max_values,

@dataclass(frozen=True)
class _Prepared:
    manifest: Any
    model_bytes: bytes
    model: Any
    document: dict[str, Any]
    bound: Any
    neutral: dict[str, Any]
    tree: dict[str, bytes]
    columns: dict[str, Any]
    work: Any
    #: Each object type's ancestor closure, for the join check 9b (IL1, D12 (o)).
    closures: dict[str, frozenset[str]]
    #: One entry per candidate model loaded by check 10 and the final checks,
    #: so the import's work counts them (IK5-Q6).
    reloads: list[int] = field(default_factory=list)

    @property
    def digest(self) -> str:
        return _ilp.export_digest(self.tree)


def _prepare(model_path: Path, labels_path: Path, target: str) -> _Prepared:
    """Manifest, model, binding and the export tree, in the export's order."""
    from gnd.evolve.service import _parse_model_text
    from gnd.model import MAX_MODEL_BYTES, _load_model_bytes_captured
    from gnd.redaction import RedactionPolicy

    manifest = _labels.read_label_manifest(labels_path)
    if manifest.mode != "class":
        raise IlpError(EXIT_ILL_FORMED, f"expected-state: label manifest {labels_path} is in "
                       "expected-state mode; the export learns from class labels (IK5-D2)")
    model_bytes = _read_capped(model_path, MAX_MODEL_BYTES, "model")
    model = _load_model_bytes_captured(model_bytes, source=model_path)
    if model.reference_populations:
        raise IlpError(EXIT_ILL_FORMED, "references: models with declared reference "
                       "populations are not exported (IK5 boundary)")
    bound = _labels.bind_manifest(manifest, model, hashlib.sha256(model_bytes).hexdigest())
    cache: dict[tuple[str, str], Any] = {}
    populations = []
    for entry in manifest.document["populations"]:
        key = (entry["path"], entry["sha256"])
        if key not in cache:
            cache[key] = _labels.read_population(manifest, entry, model)
        populations.append(cache[key])
    neutral, columns, work = _ilp.build_neutral(
        model=model, model_sha256=hashlib.sha256(model_bytes).hexdigest(), manifest=manifest,
        populations=populations, redacted=RedactionPolicy.from_model(model).effective_roles,
    )
    target = _learners.learner(target).binds or target
    entry = _learners.learner(target)
    rendering = entry.render(neutral) if entry.render is not None else {}
    tree = _ilp.export_tree(neutral, target, rendering, adapter_version=entry.adapter_version)
    return _Prepared(manifest, model_bytes, model, _parse_model_text(model_bytes.decode("utf-8")),
                     bound, neutral, tree, columns, work,
                     _ilp.type_closures(model))



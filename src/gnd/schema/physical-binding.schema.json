{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gnd:physical-binding:1",
  "title": "GND physical binding",
  "description": "A delivered relational schema and where it holds a GND model's roles. Read by `gnd export ossie --physical-binding`. The rules are in representation-format.md, \"Ossie interchange\", \"Physical binding\".",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gnd-physical-binding/1"
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "roles": {
      "$ref": "#/$defs/role_bindings"
    },
    "extension_roles": {
      "$ref": "#/$defs/role_bindings"
    }
  },
  "required": [
    "schema",
    "tables",
    "roles"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "column_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        },
        "primary_key": {
          "$ref": "#/$defs/column_list"
        },
        "unique_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column_list"
          }
        }
      },
      "required": [
        "columns"
      ],
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "properties": {
        "sql_type": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "references": {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "#/$defs/name"
            },
            "columns": {
              "$ref": "#/$defs/column_list"
            }
          },
          "required": [
            "table",
            "columns"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "identifier",
                "reference"
              ]
            },
            "object_type": {
              "$ref": "#/$defs/name"
            }
          },
          "required": [
            "kind",
            "object_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "role"
            },
            "fact_type": {
              "$ref": "#/$defs/name"
            },
            "role": {
              "$ref": "#/$defs/name"
            }
          },
          "required": [
            "kind",
            "fact_type",
            "role"
          ],
          "additionalProperties": false
        }
      ]
    },
    "role_bindings": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/name"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column_ref"
          }
        }
      }
    },
    "column_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "#/$defs/name"
            },
            "column": {
              "$ref": "#/$defs/name"
            }
          },
          "required": [
            "table",
            "column"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

s(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(), scenario=\"unavailable\"))\n577\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(), unavailable=[\"absent\"]))\n578\t    producer = Producer()\n579\t    report = reading.run(out, fixture=CALLER, producer=producer, unavailable=[\"a-methods\"])\n580\t    assert \"a-methods\" not in {call.section for call in producer.seen}\n581\t    states = {row[\"question\"]: row[\"state\"] for row in report[\"coverage\"]}\n582\t    assert states[\"a-method\"] == \"unavailable\"\n583\t    assert report[\"settings\"][\"unavailable\"] == [\"a-methods\"]\n584\t\n585\t\n586\tdef test_t20_a_bound_over_a_given_retained_cap_refuses(tmp_path):\n587\t    out = tmp_path / \"run\"\n588\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Forbidden(),\n589\t                                      limits=ReadingLimits(retained_bytes=200 * 1024)), \"retained-file cap\")\n590\t\n591\t\n592\tdef test_t20_a_derived_cap_over_the_ceiling_refuses(tmp_path):\n593\t    root = _wide_root(tmp_path, 4096)\n594\t    limits = ReadingLimits(roster=4096, input_bytes=8 << 20, response_bytes=1 << 20)\n595\t    out = tmp_path / \"run\"\n596\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden(), limits=limits),\n597\t             \"retained-file ceiling\")\n598\t\n599\t\n600\tdef test_t20_a_run_at_the_response_ceiling_reads_back(tmp_path):\n601\t    root = _wide_root(tmp_path, 9)\n602\t    key = \"k\" * 1000\n603\t    padding = [key] * ((1 << 20) // 1003 - 2)\n604\t\n605\t    class Padded:\n606\t        def produce(self, call):\n607\t            return {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": padding}\n608\t\n609\t    assert len(canonical_json_bytes(Padded().produce(None))) <= 1 << 20\n610\t    limits = ReadingLimits(response_bytes=1 << 20)\n611\t    out = tmp_path / \"run\"\n612\t    started = time.monotonic()\n613\t    report = reading.run(out, fixture=root, producer=Padded(), limits=limits)\n614\t    assert time.monotonic() - started < 60\n615\t    cap = report[\"settings\"][\"limits\"][\"retained_bytes\"]\n616\t    assert cap <= reading.LIMIT_CEILINGS[\"retained_bytes\"]\n617\t    sizes = {name: len(raw) for name, raw in _files(out).items()}\n618\t    assert max(sizes.values()) > 8 << 20\n619\t    for name in sizes:\n620\t        read_regular_bounded(out, name, max_bytes=cap)\n621\t\n622\t\n623\tdef test_t20_default_limits_derive_a_cap_above_today(plain):\n624\t    out, report, _ = plain\n625\t    assert report[\"settings\"][\"limits\"][\"retained_bytes\"] > reading.RETAINED_FLOOR\n626\t    assert json.loads((out / \"run.json\").read_bytes())[\"settings\"] == report[\"settings\"]\n627\t\n628\t\n629\tclass Empty:\n630\t    def produce(self, call):\n631\t        return {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []}\n632\t\n633\t\n634\tdef _reads_back(out, report):\n635\t    cap = report[\"settings\"][\"limits\"][\"retained_bytes\"]\n636\t    for name, raw in _files(out).items():\n637\t        assert len(raw) <= cap, (name, len(raw), cap)\n638\t\n639\t\n640\tdef test_r1_long_roster_strings_stay_under_the_recorded_cap(tmp_path):\n641\t    root = _root(tmp_path)\n642\t    _edit(root, \"roster.json\", lambda roster: roster[\"sources\"][0].update(version=\"v\" * 200_000))\n643\t    limits = ReadingLimits(roster=7, input_bytes=1 << 20, response_bytes=1024)\n644\t    out = tmp_path / \"run\"\n645\t    report = reading.run(out, fixture=root, producer=Empty(), limits=limits)\n646\t    _reads_back(out, report)\n647\t\n648\t\n649\tdef test_r1_a_padded_saved_table_stays_under_the_recorded_cap(tmp_path):\n650\t    root = _root(tmp_path)\n651\t    raw = canonical_json_bytes(ANSWERS) + b\" \" * (2 << 20)\n652\t    (root / \"responses.json\").write_bytes(raw)\n653\t    (root / \"producer-pin.json\").write_bytes(canonical_json_bytes({\"sha256\": sha256_hex(raw)}))\n654\t    out = tmp_path / \"run\"\n655\t    report = reading.run(out, fixture=root, limits=ReadingLimits(input_bytes=4 << 20))\n656\t    _reads_back(out, report)\n657\t\n658\t\n659\t@pytest.mark.parametrize(\"kind\", [\"surrogate\", \"huge-int\"])\n660\tdef test_r2_an_unserializable_answer_refuses(tmp_path, kind):\n661\t    value = chr(0xD800) if kind == \"surrogate\" else 10**5000\n662\t    answers = {**ANSWERS, \"a-opening\": {\"outcome\": \"accepted\", \"proposal_keys\": [],\n663\t                                        \"facts\": {\"paper_title\": [{\"paper\": \"paper-a\", \"title\": value}]}}}\n664\t    out = tmp_path / \"run\"\n665\t    _refuses(out, lambda: reading.run(out, fixture=CALLER, producer=Producer(answers)))\n666\t\n667\t\n668\tdef test_r2_an_unserializable_receipt_refuses(tmp_path):\n669\t    class Surrogate:\n670\t        def review(self, call):\n671\t            return {\"decision\": \"supported\", \"basis\": chr(0xD800)}\n672\t\n673\t    root = _root(tmp_path, profile=_profile(review=True))\n674\t    out = tmp_path / \"run\"\n675\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Producer(), reviewer=Surrogate()))\n676\t\n677\t\n678\tdef test_r3_a_malformed_saved_review_refuses_before_any_call(tmp_path):\n679\t    root = _root(tmp_path, profile=_profile(review=True))\n680\t    (root / \"reviews.json\").write_bytes(canonical_json_bytes({\"a-opening\": []}))\n681\t    out = tmp_path / \"run\"\n682\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden()))\n683\t\n684\t\n685\tdef test_r4_a_superseded_required_question_stays_with_its_own_source(tmp_path):\n686\t    root = _root(tmp_path)\n687\t\n688\t    def cross(roster):\n689\t        for question in roster[\"questions\"]:\n690\t            question[\"required\"] = question[\"id\"] == \"a-title\"\n691\t            if question[\"id\"] == \"a-title\":\n692\t                question[\"superseded_by\"] = \"b-title\"\n693\t\n694\t    _edit(root, \"roster.json\", cross)\n695\t    report = reading.run(tmp_path / \"run\", f
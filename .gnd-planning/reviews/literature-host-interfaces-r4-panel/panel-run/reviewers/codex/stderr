198: def _review_attempts(inputs, attempts):
199:     verified = []
200:     for row in attempts:
201:         if row["outcome"] != "accepted":
202:             continue
203:         name = row["section"]
204:         receipt = inputs.reviews.get(name)
205:         _need(isinstance(receipt, dict) and receipt.get("decision") == "supported"
206:               and receipt.get("excerpt_sha256") == row["excerpt_sha256"]
207:               and receipt.get("facts_sha256") == sha256_hex(canonical_json_bytes(row["response"]["facts"]))
208:               and isinstance(receipt.get("basis"), str) and bool(receipt["basis"]),
209:               "stale semantic reading review")
210:         verified.append({"section": name, **receipt})
211:     return verified

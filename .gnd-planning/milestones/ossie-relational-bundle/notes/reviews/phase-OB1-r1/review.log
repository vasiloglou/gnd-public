+    """T2 and T5: an artifact above 10 MiB publishes with --max-output-bytes 33554432."""
+    out = tmp_path / "large.json"
+    start = monotonic()
+    assert cli.main(_export_argv(large_source, out, "--max-output-bytes", "33554432")) == 0
+    elapsed = monotonic() - start

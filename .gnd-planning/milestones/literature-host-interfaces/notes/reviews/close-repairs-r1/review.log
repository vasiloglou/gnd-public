+{"role":"tool","tool_call_id":"tool_MnglNVJDWRhrXJtsHweX38Nx","content":"1\t\"\"\"LH4: admission rules as data, the status policy-refused, and max_targets as an argument.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport hashlib\n5\timport json\n6\timport time\n7\t\n8\timport pytest\n9\tfrom test_lh3_admission_shape import (\n10\t    PACKAGED,\n11\t    ROWS,\n12\t    SHAPE,\n13\t    VERDICTS,\n14\t    _admit,\n15\t    _admitted,\n16\t    _case,\n17\t    _refuses,\n18\t    _wide,\n19\t)\n20\t\n21\tfrom gnd.artifacts import canonical_json_bytes\n22\tfrom gnd.examples.literature import assertion_admission as admission\n23\t\n24\tPOLARITY = {\"id\": \"claim_polarity\", \"reading\": \"{Claim} has polarity {Note}\",\n25\t            \"roles\": [{\"role_name\": \"claim\", \"object_type\": \"claim\"}, {\"role_name\": \"polarity\", \"object_type\": \"note\"}]}\n26\tROWS_P = {**ROWS, \"claim_polarity\": [{\"claim\": \"c1\", \"polarity\": \"asserts\"}, {\"claim\": \"c2\", \"polarity\": \"asserts\"},\n27\t                                     {\"claim\": \"c2\", \"polarity\": \"negates\"}, {\"claim\": \"c4\", \"polarity\": \"asserts\"}]}\n28\tRULES_A = {\"format\": admission.RULES_FORMAT, \"requirements\": [\n29\t    {\"id\": \"positive\", \"fact_type\": \"claim_polarity\", \"role\": \"polarity\", \"admissible\": [\"asserts\"],\n30\t     \"reasons\": [{\"value\": \"negates\", \"reason\": \"negated\"}]}]}\n31\tRULES_B = {\"format\": admission.RULES_FORMAT, \"requirements\": [\n32\t    {\"id\": \"named-actor\", \"fact_type\": \"claim_actor\", \"role\": \"actor\", \"admissible\": [\"Quartz\", \"Slate\"],\n33\t     \"reasons\": []}]}\n34\t\n35\t\n36\tdef _sha(raw):\n37\t    return hashlib.sha256(raw).hexdigest()\n38\t\n39\t\n40\tdef _add_polarity(model):\n41\t    model[\"fact_types\"].append(POLARITY)\n42\t\n43\t\n44\tdef _polar(tmp_path, name=\"case\", verdicts=None):\n45\t    return _case(tmp_path, rows=ROWS_P, name=name, verdicts=verdicts, edit_model=_add_polarity)\n46\t\n47\t\n48\tdef _stage(record, stage=\"admission-rules\"):\n49\t    return {row[\"assertion\"]: (row[\"status\"], row[\"reason\"]) for row in record[\"stages\"][stage]}\n50\t\n51\t\n52\tdef _packaged(out, **kwargs):\n53\t    return admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\", PACKAGED / \"policy.json\",\n54\t                           PACKAGED / \"receipts.json\", PACKAGED / \"evidence\", out, **kwargs)\n55\t\n56\t\n57\tdef test_t1_two_rules_files_admit_two_sets(tmp_path):\n58\t    root = _polar(tmp_path)\n59\t    _, out_a = _admit(root, root.parent / \"a\", shape=SHAPE, rules=RULES_A)\n60\t    _, out_b = _admit(root, root.parent / \"b\", shape=SHAPE, rules=RULES_B)\n61\t    admitted_a = {row[\"claim\"] for row in _admitted(out_a)[\"facts\"][\"claim_passage\"]}\n62\t    admitted_b = {row[\"claim\"] for row in _admitted(out_b)[\"facts\"][\"claim_passage\"]}\n63\t    assert admitted_a == {\"c1\"}\n64\t    assert admitted_b == {\"c1\", \"c3\"}\n65\t\n66\t\n67\tdef test_t2_policy_refused_is_distinct_from_fail(tmp_path):\n68\t    record, _ = _admit(_polar(tmp_path), shape=SHAPE, rules=RULES_A)\n69\t    assert _stage(record) == {\"c1\": (\"pass\", None), \"c2\": (\"policy-refused\", \"negated\"),\n70\t                              \"c3\": (\"policy-refused\", \"positive\"), \"c4\": (\"fail\", \"rejected\")}\n71\t\n72\t\n73\tdef test_t3_every_row_must_be_admissible_and_one_must_exist(tmp_path):\n74\t    record, out = _admit(_polar(tmp_path), shape=SHAPE, rules=RULES_A)\n75\t    statuses = _stage(record)\n76\t    assert statuses[\"c2\"][0] == \"policy-refused\" and statuses[\"c3\"][0] == \"policy-refused\"\n77\t    assert {row[\"claim\"] for row in _admitted(out)[\"facts\"][\"claim_polarity\"]} == {\"c1\"}\n78\t\n79\t\n80\t@pytest.mark.parametrize(\"value\", [3, 1025, 0, True])\n81\tdef test_t4_max_targets(tmp_path, value):\n82\t    out = tmp_path / \"out\"\n83\t    _refuses(lambda: _admit(_polar(tmp_path), out, shape=SHAPE, max_targets=value), \"input:max-targets\")\n84\t    assert not out.exists()\n85\t\n86\t\n87\tdef test_t4_max_targets_at_the_policy_size_admits(tmp_path):\n88\t    record, _ = _admit(_polar(tmp_path), shape=SHAPE, max_targets=len(VERDICTS))\n89\t    assert record[\"max_targets\"] == len(VERDICTS)\n90\t\n91\t\n92\tdef _requirement(**changes):\n93\t    return {**RULES_A[\"requirements\"][0], **changes}\n94\t\n95\t\n96\tRULE_DEFECTS = {\n97\t    \"not-object\": ([], \"rules:invalid\"),\n98\t    \"key-missing\": ({\"format\": admission.RULES_FORMAT}, \"rules:invalid\"),\n99\t    \"extra-key\": ({**RULES_A, \"mode\": \"any\"}, \"rules:invalid\"),\n100\t    \"duplicate-id\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [_requirement(), _requirement()]},\n101\t                     \"rules:invalid\"),\n102\t    \"empty-admissible\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [_requirement(admissible=[])]},\n103\t                         \"rules:invalid\"),\n104\t    \"reason-for-admissible\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [\n105\t        _requirement(reasons=[{\"value\": \"asserts\", \"reason\": \"odd\"}])]}, \"rules:invalid\"),\n106\t    \"too-many\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [\n107\t        _requirement(id=f\"r{index}\") for index in range(65)]}, \"rules:invalid\"),\n108\t    \"unknown-fact-type\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [\n109\t        _requirement(fact_type=\"claim_author\")]}, \"rules:unknown-fact-type\"),\n110\t    \"not-attached\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [\n111\t        _requirement(fact_type=\"quantity_value\", role=\"value\")]}, \"rules:unknown-fact-type\"),\n112\t    \"unknown-role\": ({\"format\": admission.RULES_FORMAT, \"requirements\": [_requirement(role=\"tone\")]},\n113\t                     \"rules:unknown-role\"),\n114\t}\n115\t\n116\t\n117\t@pytest.mark.parametrize(\"case\", sorted(RULE_DEFECTS))\n118\tdef test_t5_a_bad_rule_refuses_before_the_judgment_route(tmp_path, monkeypatch, case):\n119\t    rules, reason = RULE_DEFECTS[case]\n120\t    root = _polar(tmp_path)\n121\t    monkeypatch.setattr(admission, \"_judgments\", lambda *_: pytest.fail(\"ran the judgment route\"))\n122\t    out = tmp_path / \"out\"\n123\t    _refuses(lambda: _admit(root, out, shape=SHAPE, rules=rules), reason)\n124\t    assert not out.exists()\n125\t\n126\t\n127\tdef test_t5_the_packaged_shape_names_assertion_statement_only(tmp_path, monkeypatch):\n128\t    rules = {\"format\": admission.RULES_FORMAT, \"requirements\": [\n129\t        {\"id\": \"work\", \"fact_type\": admission.WORK, \"role\": \"work\", \"admissible\": [\"x\"], \"reasons\": []}]}\n130\t    monkeypatch.setattr(admission, \"_judgments\", lambda *_: pytest.fail(\"ran the judgment route\"))\n131\t    out = tmp_path / \"out\"\n132\t    _refuses(lambda: _packaged(out, rules=rules), \"rules:unknown-fact-type\")\n133\t    assert not out.exists()\n134\t\n135\t\n136\tdef test_t6_the_default_rules_are_the_packaged_comparison(tmp_path):\n137\t    first = _packaged(tmp_path / \"one\")\n138\t    second = _packaged(tmp_path / \"two\", rules=admission.DEFAULT_RULES)\n139\t    assert first[\"schema\"] == admission.SCHEMA and second[\"schema\"] == admission.SHAPED_SCHEMA\n140\t    old = {row[\"index\"]: row for row in first[\"stages\"][\"positive-own-findings\"]}\n141\t    new = {row[\"index\"]: row for row in second[\"stages\"][\"positive-own-findings\"]}\n142\t    assert [old[index][\"reason\"] for index in sorted(old)] == [new[index][\"reason\"] for index in sorted(new)]\n143\t    supported = {row[\"index\"] for row in first[\"stages\"][\"semantic-support\"] if row[\"status\"] == \"pass\"}\n144\t    for index, row in old.items():\n145\t        expected = \"policy-refused\" if row[\"status\"] == \"fail\" and index in supported else row[\"status\"]\n146\t        assert new[index][\"status\"] == expected\n147\t    assert [new[index][\"status\"] for index in (3, 4, 5, 6)] == [\"policy-refused\"] * 4\n148\t    assert (tmp_path / \"one/admitted.population.json\").read_bytes() == (\n149\t        tmp_path / \"two/admitted.population.json\").read_bytes()\n150\t\n151\t\n152\tdef test_t7_a_v2_record_binds_every_setting(tmp_path):\n153\t    root = _polar(tmp_path)\n154\t    base, _ = _admit(root, root.parent / \"base\", shape=SHAPE, rules=RULES_A)\n155\t    assert base[\"shape\"] == \"caller\" and base[\"shape_sha256\"] == _sha(canonical_json_bytes(SHAPE))\n156\t    assert base[\"rules_sha256\"] == _sha(canonical_json_bytes(RULES_A))\n157\t    assert base[\"max_targets\"] == admission.MAX_TARGETS and base[\"max_rows\"] == admission.MAX_ROWS\n158\t    changed = {\n159\t        \"shape_sha256\": {\"shape\": {**SHAPE, \"follow\": []}},\n160\t        \"rules_sha256\": {\"rules\": RULES_B},\n161\t        \"max_targets\": {\"max_targets\": len(VERDICTS)},\n162\t        \"max_rows\": {\"max_rows\": 1000},\n163\t    }\n164\t    for field, change in changed.items():\n165\t        arguments = {\"shape\": SHAPE, \"rules\": RULES_A, **change}\n166\t        record, _ = _admit(root, root.parent / field, **arguments)\n167\t        assert record[field] != base[field], field\n168\t    rules_only = _packaged(tmp_path / \"packaged\", rules=admission.DEFAULT_RULES)\n169\t    assert (rules_only[\"shape\"], rules_only[\"shape_sha256\"], rules_only[\"max_rows\"]) == (\"packaged\", None, None)\n170\t\n171\t\n172\tdef test_t8_sixty_four_requirements_at_the_row_ceiling(tmp_path):\n173\t    count, per = 1024, 61\n174\t    rows = _wide(count, per)\n175\t    verdicts = {(\"claim_passage\", index): \"approve\" for index in range(count)}\n176\t    root = _case(tmp_path, rows=rows, verdicts=verdicts)\n177\t    actors = [f\"a{extra}\" for extra in range(per)]\n178\t    rules = {\"format\": admission.RULES_FORMAT, \"requirements\": [\n179\t        {\"id\": f\"r{number}\", \"fact_type\": \"claim_actor\", \"role\": \"actor\", \"admissible\": actors, \"reasons\": []}\n180\t        for number in range(admission.MAX_REQUIREMENTS)]}\n181\t    started = time.monotonic()\n182\t    record, _ = _admit(root, shape=SHAPE, rules=rules, max_rows=admission.MAX_ROWS_CEILING)\n183\t    assert time.monotonic() - started < 60\n184\t    assert all(row[\"status\"] == \"pass\" for row in record[\"stages\"][\"admission-rules\"])\n185\t    assert json.dumps(record[\"stages\"]).count(\"policy-refused\") == 0\n186\t\n187\t\n188\t@pytest.mark.parametrize(\"kind\", [\"object\", \"list\", \"infinity\", \"nan\"])\n189\t@pytest.mark.parametrize(\"where\", [\"admissible\", \"reason-value\"])\n190\tdef test_r1_a_rule_value_must_be_a_json_scalar(tmp_path, monkeypatch, kind, where):\n191\t    value = {\"object\": {}, \"list\": [], \"infinity\": float(\"inf\"), \"nan\": float(\"nan\")}[kind]\n192\t    if where == \"admissible\":\n193\t        requirement = _requirement(admissible=[value])\n194\t    else:\n195\t        requirement = _requirement(reasons=[{\"value\": value, \"reason\": \"odd\"}])\n196\t    rules = {\"format\": admission.RULES_FORMAT, \"requirements\": [requirement]}\n197\t    monkeypatch.setattr(admission, \"_judgments\", lambda *_: pytest.fail(\"ran the judgment route\"))\n198\t    out = tmp_path / \"out\"\n199\t    _refuses(lambda: _admit(_polar(tmp_path), out, shape=SHAPE, rules=rules), \"rules:invalid\")\n200\t    assert not out.exists()\n201\t\n202\t\n203\tdef test_r2_reasons_are_optional(tmp_path):\n204\t    requirement = {key: value for key, value in _requirement().items() if key != \"reasons\"}\n205\t    rules = {\"format\": admission.RULES_FORMAT, \"requirements\": [requirement]}\n206\t    record, _ = _admit(_polar(tmp_path), shape=SHAPE, rules=rules)\n207\t    assert _stage(record)[\"c2\"] == (\"policy-refused\", \"positive\")"}
+{"role":"tool","tool_call_id":"tool_xlShGcsYMIql7RZC9jdQJ5sV","content":"1\t\"\"\"LH3: admission over a caller-named assertion entity, identified by its own handle.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport hashlib\n5\timport json\n6\timport shutil\n7\timport subprocess\n8\timport sys\n9\timport time\n10\tfrom pathlib import Path\n11\t\n12\timport pytest\n13\t\n14\tfrom gnd.artifacts import canonical_json_bytes\n15\tfrom gnd.examples.literature import assertion_admission as admission\n16\tfrom gnd.examples.literature.assurance_report import Refusal\n17\tfrom gnd.judgments import judgment_fact_digest, judgment_receipt_digest\n18\t\n19\tFIXTURE = Path(__file__).parent / \"fixtures/lh3-admission\"\n20\tPACKAGED = Path(__file__).resolve().parents[1] / \"src/gnd/examples/literature/assertions\"\n21\tSHAPE = {\"format\": admission.SHAPE_FORMAT, \"assertion\": \"claim\", \"follow\": [\"quantity\"]}\n22\tH18 = {\n23\t    \"admitted.population.json\": \"6e45b93d\",\n24\t    \"raw.population.json\": \"ea96584c\",\n25\t    \"judgment-report.json\": \"3726a424\",\n26\t    \"admission.json\": \"6d262018\",\n27\t}\n28\tROWS = {\n29\t    \"claim_passage\": [{\"claim\": \"c1\", \"passage\": \"p1\"}, {\"claim\": \"c2\", \"passage\": \"p1\"},\n30\t                      {\"claim\": \"c3\", \"passage\": \"p2\"}, {\"claim\": \"c4\", \"passage\": \"p2\"}],\n31\t    \"claim_actor\": [{\"claim\": \"c1\", \"actor\": \"Quartz\"}, {\"claim\": \"c1\", \"actor\": \"Slate\"},\n32\t                    {\"claim\": \"c3\", \"actor\": \"Quartz\"}, {\"claim\": \"c4\", \"actor\": \"Basalt\"}],\n33\t    \"claim_object\": [{\"claim\": \"c2\", \"object\": \"error rate\"}, {\"claim\": \"c3\", \"object\": \"noise\"}],\n34\t    \"claim_condition\": [{\"claim\": \"c2\", \"condition\": \"low noise\"}, {\"claim\": \"c2\", \"condition\": \"trial A\"},\n35\t                        {\"claim\": \"c2\", \"condition\": \"none\"}],\n36\t    \"claim_quantity\": [{\"claim\": \"c1\", \"quantity\": \"q1\"}, {\"claim\": \"c3\", \"quantity\": \"q2\"},\n37\t                       {\"claim\": \"c4\", \"quantity\": \"q1\"}],\n38\t    \"claim_paper\": [{\"claim\": \"c1\", \"paper\": \"w1\"}],\n39\t    \"claim_supports\": [{\"claim\": \"c1\", \"other\": \"c2\"}, {\"claim\": \"c1\", \"other\": \"c4\"}],\n40\t    \"quantity_value\": [{\"quantity\": \"q1\", \"value\": \"12\"}, {\"quantity\": \"q2\", \"value\": \"3\"}],\n41\t    \"quantity_unit\": [{\"quantity\": \"q1\", \"unit\": \"percent\"}, {\"quantity\": \"q2\", \"unit\": \"dB\"}],\n42\t    \"quantity_source\": [{\"quantity\": \"q1\", \"claim\": \"c4\"}, {\"quantity\": \"q2\", \"claim\": \"c3\"}],\n43\t    \"paper_title\": [{\"paper\": \"w1\", \"title\": \"Quartz study\"}],\n44\t}\n45\tVERDICTS = {(\"claim_passage\", 0): \"approve\", (\"claim_passage\", 1): \"approve\",\n46\t            (\"claim_passage\", 2): \"approve\", (\"claim_passage\", 3): \"reject\"}\n47\t\n48\t\n49\tdef _sha(raw: bytes) -> str:\n50\t    return hashlib.sha256(raw).hexdigest()\n51\t\n52\t\n53\tdef _case(tmp_path, *, rows=None, verdicts=None, name=\"case\", model=\"claims.orm.json\", edit_model=None):\n54\t    \"\"\"A caller's admission inputs: model and include, raw population, policy, saved receipts, evidence.\"\"\"\n55\t    root = tmp_path / name\n56\t    root.mkdir()\n57\t    for file in (\"claims.orm.json\", \"terms.orm.json\"):\n58\t        shutil.copyfile(FIXTURE / file, root / file)\n59\t    if edit_model is not None:\n60\t        document = json.loads((root / \"claims.orm.json\").read_bytes())\n61\t        edit_model(document)\n62\t        (root / \"claims.orm.json\").write_bytes(canonical_json_bytes(document))\n63\t    shutil.copytree(FIXTURE / \"evidence\", root / \"evidence\")\n64\t    rows = ROWS if rows is None else rows\n65\t    verdicts = VERDICTS if verdicts is None else verdicts\n66\t    model_raw = (root / model).read_bytes()\n67\t    population = {\"population\": {\"covers\": sorted(rows), \"model\": admission.MODEL,\n68\t                                 \"model_id\": \"urn:gnd-test:lh3-claims@1\", \"source\": \"fixture\"},\n69\t                  \"instances\": {}, \"facts\": rows}\n70\t    raw = canonical_json_bytes(population)\n71\t    (root / \"raw.population.json\").write_bytes(raw)\n72\t    evidence = (root / \"evidence/passages.txt\").read_bytes()\n73\t    receipts = []\n74\t    for number, ((fact_type, index), verdict) in enumerate(verdicts.items()):\n75\t        receipts.append({\n76\t            \"receipt_id\": f\"opinion-{number:04d}\", \"judge_id\": \"corpus-author\", \"verdict\": verdict,\n77\t            \"trust\": \"consumer-pinned\", \"external_evidence\": None,\n78\t            \"subject\": {\"model_sha256\": _sha(model_raw), \"population_sha256\": _sha(raw), \"reference_identity\": None,\n79\t                        \"fact_type\": fact_type, \"index\": index,\n80\t                        \"fact_sha256\": judgment_fact_digest(fact_type, index, rows[fact_type][index])},\n81\t            \"sources\": [{\"path\": \"passages.txt\", \"sha256\": _sha(evidence),\n82\t                         \"quote\": {\"start\": 0, \"end\": 10, \"sha256\": _sha(evidence[:10])}}],\n83\t        })\n84\t    policy = json.loads((PACKAGED / \"policy.json\").read_bytes())\n85\t    policy[\"targets\"] = [{\"fact_type\": fact_type, \"index\": index} for fact_type, index in verdicts]\n86\t    policy[\"trusted_receipts\"] = [{\"judge_id\": \"corpus-author\", \"receipt_sha256\": judgment_receipt_digest(item)}\n87\t                                  for item in receipts]\n88\t    (root / \"policy.json\").write_bytes(canonical_json_bytes(policy))\n89\t    (root / \"receipts.json\").write_bytes(canonical_json_bytes({\"schema_version\": 1, \"receipts\": receipts}))\n90\t    return root\n91\t\n92\t\n93\tdef _admit(root, out=None, **kwargs):\n94\t    out = out or root.parent / f\"{root.name}-out\"\n95\t    record = admission.admit(root / \"claims.orm.json\", root / \"raw.population.json\", root / \"policy.json\",\n96\t                             root / \"receipts.json\", root / \"evidence\", out, **kwargs)\n97\t    return record, out\n98\t\n99\t\n100\tdef _admitted(out):\n101\t    return json.loads((out / \"admitted.population.json\").read_bytes())\n102\t\n103\t\n104\tdef _refuses(call, reason):\n105\t    with pytest.raises(Refusal) as caught:\n106\t        call()\n107\t    assert caught.value.reason == reason\n108\t\n109\t\n110\t@pytest.fixture(scope=\"module\")\n111\tdef shaped(tmp_path_factory):\n112\t    root = _case(tmp_path_factory.mktemp(\"lh3\"))\n113\t    record, out = _admit(root, shape=SHAPE)\n114\t    return root, record, out\n115\t\n116\t\n117\tdef test_t1_every_attached_and_followed_row_of_an_admitted_claim(shaped):\n118\t    root, record, out = shaped\n119\t    facts = _admitted(out)[\"facts\"]\n120\t    assert facts[\"claim_passage\"] == ROWS[\"claim_passage\"][:3]\n121\t    assert facts[\"claim_actor\"] == ROWS[\"claim_actor\"][:3]\n122\t    assert facts[\"claim_object\"] == ROWS[\"claim_object\"]\n123\t    assert facts[\"claim_condition\"] == ROWS[\"claim_condition\"]\n124\t    assert facts[\"claim_quantity\"] == ROWS[\"claim_quantity\"][:2]\n125\t    assert facts[\"claim_paper\"] == ROWS[\"claim_paper\"]\n126\t    assert facts[\"quantity_value\"] == ROWS[\"quantity_value\"]\n127\t    assert facts[\"quantity_unit\"] == ROWS[\"quantity_unit\"]\n128\t    assert all(\"c4\" not in json.dumps(rows) for rows in facts.values())\n129\t    assert record[\"schema\"] == admission.SHAPED_SCHEMA\n130\t    assert record[\"shape_sha256\"] == _sha(canonical_json_bytes(SHAPE))\n131\t    assert {row[\"assertion\"]: row[\"status\"] for row in record[\"stages\"][\"semantic-support\"]} == {\n132\t        \"c1\": \"pass\", \"c2\": \"pass\", \"c3\": \"pass\", \"c4\": \"fail\"}\n133\t    check = root.parent / \"check\"\n134\t    check.mkdir()\n135\t    for file in (\"terms.orm.json\",):\n136\t        shutil.copyfile(root / file, check / file)\n137\t    shutil.copyfile(root / \"claims.orm.json\", check / admission.MODEL)\n138\t    shutil.copyfile(out / \"admitted.population.json\", check / \"admitted.population.json\")\n139\t    done = subprocess.run([sys.executable, \"-m\", \"gnd\", \"check\", admission.MODEL, \"admitted.population.json\"],\n140\t                          cwd=check, capture_output=True, check=False)\n141\t    assert done.returncode == 0, done.stdout.decode()[-600:]\n142\t\n143\t\n144\tdef test_t1_covers_lists_attached_and_followed_fact_types(shaped):\n145\t    _, _, out = shaped\n146\t    covers = _admitted(out)[\"population\"][\"covers\"]\n147\t    assert set(covers) == set(ROWS) - {\"paper_title\"}\n148\t    assert \"paper_title\" not in _admitted(out)[\"facts\"]\n149\t\n150\t\n151\tdef test_t2_an_entity_that_objectifies_a_fact_type_refuses(tmp_path):\n152\t    out = tmp_path / \"out\"\n153\t    shape = {\"format\": admission.SHAPE_FORMAT, \"assertion\": \"assertion\", \"follow\": []}\n154\t    _refuses(lambda: admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\",\n155\t                                     PACKAGED / \"policy.json\", PACKAGED / \"receipts.json\", PACKAGED / \"evidence\",\n156\t                                     out, shape=shape), \"shape:objectified-assertion\")\n157\t    assert not out.exists()\n158\t\n159\t\n160\tdef test_t3_support_is_every_target_admitted_and_at_least_one(tmp_path):\n161\t    verdicts = {**VERDICTS, (\"claim_actor\", 1): \"reject\"}\n162\t    del verdicts[(\"claim_passage\", 2)]\n163\t    record, out = _admit(_case(tmp_path, verdicts=verdicts), shape=SHAPE)\n164\t    reasons = {row[\"assertion\"]: row[\"reason\"] for row in record[\"stages\"][\"semantic-support\"]}\n165\t    assert reasons == {\"c1\": \"rejected\", \"c2\": None, \"c3\": \"missing\", \"c4\": \"rejected\"}\n166\t    facts = _admitted(out)[\"facts\"]\n167\t    assert facts[\"claim_condition\"] == ROWS[\"claim_condition\"]\n168\t    assert facts[\"claim_passage\"] == [ROWS[\"claim_passage\"][1]]\n169\t\n170\t\n171\tdef test_t4_a_row_between_two_claims_needs_both_admitted(shaped):\n172\t    _, _, out = shaped\n173\t    assert _admitted(out)[\"facts\"][\"claim_supports\"] == [{\"claim\": \"c1\", \"other\": \"c2\"}]\n174\t\n175\t\n176\tdef test_t5_an_include_root_admits_and_binds_its_include(shaped, tmp_path):\n177\t    root, record, _ = shaped\n178\t    assert record[\"includes\"] == {\"terms.orm.json\": _sha((root / \"terms.orm.json\").read_bytes())}\n179\t    edited = _case(tmp_path)\n180\t    path = edited / \"terms.orm.json\"\n181\t    path.write_bytes(path.read_bytes() + b\"\\n\")\n182\t    out = tmp_path / \"out\"\n183\t    _refuses(lambda: _admit(edited, out, shape=SHAPE), \"input:model\")\n184\t    assert not out.exists()\n185\t\n186\t\n187\tdef _shape(**changes):\n188\t    return {**SHAPE, **changes}\n189\t\n190\t\n191\tREFUSALS = {\n192\t    \"shape-not-object\": ([\"claim\"], \"shape:invalid\"),\n193\t    \"shape-key-missing\": ({\"format\": admission.SHAPE_FORMAT, \"assertion\": \"claim\"}, \"shape:invalid\"),\n194\t    \"shape-extra-key\": (_shape(stop=True), \"shape:invalid\"),\n195\t    \"unknown-assertion\": (_shape(assertion=\"author\"), \"shape:unknown-assertion\"),\n196\t    \"value-type-assertion\": (_shape(assertion=\"note\"), \"shape:unknown-assertion\"),\n197\t    \"unknown-follow\": (_shape(follow=[\"author\"]), \"shape:unknown-follow\"),\n198\t    \"duplicate-follow\": (_shape(follow=[\"quantity\", \"quantity\"]), \"shape:invalid\"),\n199\t    \"no-attached-facts\": (_shape(assertion=\"venue\", follow=[]), \"shape:no-attached-facts\"),\n200\t}\n201\t\n202\t\n203\t@pytest.mark.parametrize(\"case\", sorted(REFUSALS))\n204\tdef test_t6_a_shape_refusal_publishes_nothing(tmp_path, case):\n205\t    shape, reason = REFUSALS[case]\n206\t    root = _case(tmp_path)\n207\t    out = tmp_path / \"out\"\n208\t    _refuses(lambda: _admit(root, out, shape=shape), reason)\n209\t    assert not out.exists()\n210\t\n211\t\n212\tdef test_t6_a_target_outside_the_shape_refuses(tmp_path):\n213\t    verdicts = {**VERDICTS, (\"quantity_value\", 0): \"approve\"}\n214\t    out = tmp_path / \"out\"\n215\t    _refuses(lambda: _admit(_case(tmp_path, verdicts=verdicts), out, shape=SHAPE), \"judgments:target-outside-shape\")\n216\t    assert not out.exists()\n217\t\n218\t\n219\tdef test_t6_an_include_path_outside_the_root_refuses(tmp_path):\n220\t    root = _case(tmp_path)\n221\t    model = json.loads((root / \"claims.orm.json\").read_bytes())\n222\t    model[\"includes\"][0][\"path\"] = \"../terms.orm.json\"\n223\t    (root / \"claims.orm.json\").write_bytes(canonical_json_bytes(model))\n224\t    out = tmp_path / \"out\"\n225\t    _refuses(lambda: _admit(root, out, shape=SHAPE), \"input:include-path\")\n226\t    assert not out.exists()\n227\t\n228\t\n229\t@pytest.mark.parametrize(\"value\", [0, 65537, True])\n230\tdef test_t6_max_rows_out_of_range_refuses(tmp_path, value):\n231\t    out = tmp_path / \"out\"\n232\t    _refuses(lambda: _admit(_case(tmp_path), out, shape=SHAPE, max_rows=value), \"input:max-rows\")\n233\t    assert not out.exists()\n234\t\n235\t\n236\tdef test_t6_max_rows_without_a_shape_refuses(tmp_path):\n237\t    out = tmp_path / \"out\"\n238\t    _refuses(lambda: admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\",\n239\t                                     PACKAGED / \"policy.json\", PACKAGED / \"receipts.json\", PACKAGED / \"evidence\",\n240\t                                     out, max_rows=100), \"input:max-rows\")\n241\t    assert not out.exists()\n242\t\n243\t\n244\tdef test_t7_the_value_none_is_ordinary(shaped):\n245\t    _, _, out = shaped\n246\t    assert {\"claim\": \"c2\", \"condition\": \"none\"} in _admitted(out)[\"facts\"][\"claim_condition\"]\n247\t\n248\t\n249\tdef test_t8_the_packaged_call_keeps_its_bytes(tmp_path):\n250\t    out = tmp_path / \"packaged\"\n251\t    record = admission.admit(PACKAGED / \"model.orm.yaml\", PACKAGED / \"raw.population.json\",\n252\t                             PACKAGED / \"policy.json\", PACKAGED / \"receipts.json\", PACKAGED / \"evidence\", out)\n253\t    assert record[\"schema\"] == admission.SCHEMA and \"shape_sha256\" not in record\n254\t    for name, prefix in H18.items():\n255\t        assert _sha((out / name).read_bytes()).startswith(prefix), name\n256\t    reasons = {row[\"index\"]: row[\"reason\"] for row in record[\"stages\"][\"positive-own-findings\"]}\n257\t    assert [reasons[index] for index in (3, 4, 5, 6)] == [\"negated\", \"baseline-comparison\", \"speculation\",\n258\t                                                           \"cites-other-work\"]\n259\t\n260\t\n261\tdef _wide(count, rows_per_claim):\n262\t    rows = {name: [] for name in ROWS}\n263\t    for number in range(count):\n264\t        claim = f\"c{number}\"\n265\t        rows[\"claim_passage\"].append({\"claim\": claim, \"passage\": \"p\"})\n266\t        rows[\"claim_quantity\"].append({\"claim\": claim, \"quantity\": f\"q{number}\"})\n267\t        rows[\"quantity_value\"].append({\"quantity\": f\"q{number}\", \"value\": str(number)})\n268\t        for extra in range(rows_per_claim):\n269\t            rows[\"claim_actor\"].append({\"claim\": claim, \"actor\": f\"a{extra}\"})\n270\t    return rows\n271\t\n272\t\n273\tdef test_t9_the_row_ceiling_in_time_and_one_over_refuses(tmp_path):\n274\t    count, per = 1024, 61\n275\t    rows = _wide(count, per)\n276\t    total = sum(len(value) for name, value in rows.items() if name != \"paper_title\")\n277\t    assert total == admission.MAX_ROWS_CEILING\n278\t    verdicts = {(\"claim_passage\", index): \"approve\" for index in range(count)}\n279\t    root = _case(tmp_path, rows=rows, verdicts=verdicts)\n280\t    started = time.monotonic()\n281\t    record, out = _admit(root, shape=SHAPE, max_rows=total)\n282\t    assert time.monotonic() - started < 60\n283\t    assert len(_admitted(out)[\"facts\"][\"claim_actor\"]) == count * per\n284\t    assert all(row[\"status\"] == \"pass\" for row in record[\"stages\"][\"semantic-support\"])\n285\t    second = tmp_path / \"again\"\n286\t    _refuses(lambda: _admit(root, second, shape=SHAPE, max_rows=total - 1), \"input:row-cap\")\n287\t    assert not second.exists()\n288\t\n289\t\n290\tdef test_t10_shared_and_unlisted_entities(shaped):\n291\t    _, _, out = shaped\n292\t    facts = _admitted(out)[\"facts\"]\n293\t    assert facts[\"quantity_value\"].count({\"quantity\": \"q1\", \"value\": \"12\"}) == 1\n294\t    assert {\"claim\": \"c4\", \"quantity\": \"q1\"} not in facts[\"claim_quantity\"]\n295\t    assert facts[\"quantity_source\"] == [{\"quantity\": \"q2\", \"claim\": \"c3\"}]\n296\t    assert \"paper_title\" not in facts\n297\t\n298\t\n299\tdef test_t10_with_an_empty_follow_list_nothing_is_followed(tmp_path):\n300\t    record, out = _admit(_case(tmp_path), shape=_shape(follow=[]))\n301\t    facts = _admitted(out)[\"facts\"]\n302\t    assert \"quantity_value\" not in facts and \"quantity_unit\" not in facts\n303\t    assert facts[\"claim_quantity\"] == ROWS[\"claim_quantity\"][:2]\n304\t    assert record[\"schema\"] == admission.SHAPED_SCHEMA\n305\t\n306\t\n307\tdef _model(*fact_types):\n308\t    return {\"object_types\": [{\"id\": \"claim\", \"kind\": \"entity\"}, {\"id\": \"passage\", \"kind\": \"entity\"},\n309\t                             {\"id\": \"note\", \"kind\": \"value\"}],\n310\t            \"fact_types\": [{\"id\": name, \"roles\": [{\"role_name\": role, \"object_type\": kind} for role, kind in roles]}\n311\t                           for name, roles in fact_types]}\n312\t\n313\t\n314\tdef _target(fact_type, index, admitted=True):\n315\t    return {\"fact_type\": fact_type, \"index\": index, \"admitted\": admitted,\n316\t            \"judgments\": [{\"verdict\": \"approve\" if admitted else \"reject\"}]}\n317\t\n318\t\n319\tCLAIM_SEEN = (\"claim_seen\", [(\"claim\", \"claim\"), (\"passage\", \"passage\")])\n320\tLONE_SHAPE = {\"format\": admission.SHAPE_FORMAT, \"assertion\": \"claim\", \"follow\": []}\n321\t\n322\t\n323\tdef test_r1_a_boolean_handle_is_not_a_number(tmp_path):\n324\t    subject = {\"population\": {}, \"facts\": {\"claim_seen\": [{\"claim\": True, \"passage\": \"p\"},\n325\t                                                           {\"claim\": 1, \"passage\": \"p\"}]}}\n326\t    population, stages = admission.project_shaped(subject, [_target(\"claim_seen\", 0)], _model(CLAIM_SEEN),\n327\t                                                   LONE_SHAPE)\n328\t    assert population[\"facts\"][\"claim_seen\"] == [{\"claim\": True, \"passage\": \"p\"}]\n329\t    assert [row[\"status\"] for row in stages[\"semantic-support\"]] == [\"pass\", \"fail\"]\n330\t\n331\t\n332\tdef test_r1_one_and_one_point_zero_are_one_number():\n333\t    subject = {\"population\": {}, \"facts\": {\"claim_seen\": [{\"claim\": 1, \"passage\": \"p\"},\n334\t                                                           {\"claim\": 1.0, \"passage\": \"q\"}]}}\n335\t    population, stages = admission.project_shaped(subject, [_target(\"claim_seen\", 0)], _model(CLAIM_SEEN),\n336\t                                                   LONE_SHAPE)\n337\t    assert len(population[\"facts\"][\"claim_seen\"]) == 2 and len(stages[\"semantic-support\"]) == 1\n338\t\n339\t\n340\t@pytest.mark.parametrize(\"includes\", [1, True, [1], [{\"path\": 3}]])\n341\tdef test_r2_a_malformed_include_list_refuses(includes):\n342\t    raw = canonical_json_bytes({\"version\": 5, \"object_types\": [], \"fact_types\": [], \"includes\": includes})\n343\t    _refuses(lambda: admission._include_paths(raw), \"input:include-path\")\n344\t\n345\t\n346\tdef test_r2_a_missing_include_refuses(tmp_path):\n347\t    root = _case(tmp_path)\n348\t    (root / \"terms.orm.json\").unlink()\n349\t    out = tmp_path / \"out\"\n350\t    _refuses(lambda: _admit(root, out, shape=SHAPE), \"input:include-read\")\n351\t    assert not out.exists()\n352\t\n353\t\n354\tdef test_r3_an_opaque_value_is_an_ordinary_value():\n355\t    subject = {\"format_version\": 2, \"population\": {}, \"facts\": {\n356\t        \"claim_seen\": [{\"claim\": \"c1\", \"passage\": \"p\"}],\n357\t        \"claim_note\": [{\"claim\": \"c1\", \"note\": {\"$opaque\": \"unreadable-note\"}}]}}\n358\t    model = _model(CLAIM_SEEN, (\"claim_note\", [(\"claim\", \"claim\"), (\"note\", \"note\")]))\n359\t    population, _ = admission.project_shaped(subject, [_target(\"claim_seen\", 0)], model, LONE_SHAPE)\n360\t    assert population[\"facts\"][\"claim_note\"] == subject[\"facts\"][\"claim_note\"]\n361\t\n362\t\n363\tdef test_r4_covers_is_linear_in_the_fact_types():\n364\t    count = 40_000\n365\t    names = [f\"seen_{index}\" for index in range(count)]\n366\t    model = _model(*[(name, [(\"claim\", \"claim\")]) for name in names])\n367\t    subject = {\"population\": {}, \"facts\": {name: [{\"claim\": \"c1\"}] for name in names}}\n368\t    started = time.monotonic()\n369\t    admission.project_shaped(subject, [_target(names[0], 0)], model, LONE_SHAPE, max_rows=65536)\n370\t    assert time.monotonic() - started < 1.5\n371\t\n372\t\n373\t@pytest.mark.parametrize(\"missing\", [\"claims.orm.json\", \"raw.population.json\", \"policy.json\", \"receipts.json\"])\n374\tdef test_r5_a_missing_primary_input_refuses_without_its_path(tmp_path, missing):\n375\t    root = _case(tmp_path)\n376\t    (root / missing).unlink()\n377\t    out = tmp_path / \"out\"\n378\t    _refuses(lambda: _admit(root, out, shape=SHAPE), \"input:read\")\n379\t    assert not out.exists()"}
+{"role":"assistant","content":"The tests look aligned with the plan. Now the phase records and close record — especially the unread repairs the rubric flags.","tool_calls":[{"type":"function","id":"tool_WfrjcmSIUhNbrCTht1oVzjrs","function":{"name":"Read","arguments":"{\"max_chars\":60000,\"path\":\".gnd-planning/milestones/literature-host-interfaces/002-phase-LH1.md\"}"}},{"type":"function","id":"tool_LZ14uw3W0mAxt1vbhkj4oUjL","function":{"name":"Read","arguments":"{\"max_chars\":60000,\"path\":\".gnd-planning/milestones/literature-host-interfaces/003-phase-LH2.md\"}"}}]}
+{"role":"tool","tool_call_id":"tool_WfrjcmSIUhNbrCTht1oVzjrs","content":"1\t---\n2\tmilestone: literature-host-interfaces\n3\tstation: \"phase-LH1\"\n4\tskill: \"n/a -- repository development, not a gnd-solve station over a domain model\"\n5\tscope: phase-LH1\n6\tdate: 2026-11-23\n7\tgates:\n8\t  - command: \"ruling: delegated (auto=true) approved .gnd-planning/milestones/literature-host-interfaces/notes/phase-LH1-spec.md sha256 93cd0f95314cdd027900475bb4ea0e1558fa3e0a04efae357302ba3e38c90e12\"\n9\t    exit: \"n/a -- ruling\"\n10\t  - command: \"uv run pytest -q tests/test_lh1_reading_host.py tests/test_ld3_reading_workflow.py tests/test_ld4_revision.py tests/test_ld5_verdict.py tests/test_li1_assurance_report.py tests/test_ld1_competency_examples.py --tb=short\"\n11\t    exit: 0\n12\t    output: \"251 passed in 379.01s (0:06:19)\"\n13\t    note: \"plan §9 LH1 row plus tests/test_ld1_competency_examples.py, added because depth.py changed (spec finding 9)\"\n14\t  - command: \"the project.md structure and inventory guard block (12 files)\"\n15\t    exit: 0\n16\t    output: \"679 passed, 2 deselected in 120.93s (0:02:00)\"\n17\t  - command: \"uv run ruff check\"\n18\t    exit: 0\n19\t    output: \"All checks passed!\"\n20\t  - command: \"python3 scripts/components_index.py changed --base 78934ee3 --strict\"\n21\t    exit: 0\n22\t    output: \"changed against 78934ee3 (78934ee): 114 file(s) differ; 0 to fix, 0 warning(s), 1 to reread\"\n23\t    note: \"the reread line names examples.literature_depth: depth.py gained two keyword arguments whose defaults are today's values; its entry is still accurate\"\n24\tslow_cadence:\n25\t  command: \"uv run pytest -q -m \\\"evidence or census\\\"\"\n26\t  trigger: \"explicit owner request or separately scoped CI selection\"\n27\t  reason: \"the broad controls are outside this phase's impact closure\"\n28\tevidence:\n29\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/phase-LH1-spec.md\n30\t    sha256: b9e48c65cef90190afb05d7d262cbd06635b56a7fc58b238a612c309f236f25f\n31\t  - path: src/gnd/examples/literature/reading.py\n32\t    sha256: 679c10561d839745d66ce8c1aa1760f2b720c5e2e55dd2d385073fda44f7684f\n33\t  - path: src/gnd/examples/literature/depth.py\n34\t    sha256: f50ff0cbd22f73cf151b5985eb207828111e0cbde06cd4213e7c9211b4a798f7\n35\t  - path: src/gnd/examples/literature/reading_fixture/README.md\n36\t    sha256: 046790deff8f792fcbdd7c66b603d5d7383f241c92b4aa91e958c8f493e8dd90\n37\t  - path: tests/test_lh1_reading_host.py\n38\t    sha256: b4974946ba1f1ed9f2d56c1c68cd30218148ad09c825e4681de7aa34755770b7\n39\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/reviews/phase-LH1-r1/review.md\n40\t    sha256: 402e117938f29a690a0b415442adc31ee11248714815cd53a35fc8fee70ab4e8\n41\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/reviews/phase-LH1-r1/FINDINGS.md\n42\t    sha256: ac9b4f12c47d966b651df467dd710c4a4642b5abbaa757635595cc467f7519ec\n43\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/reviews/phase-LH1-r2/review.md\n44\t    sha256: bb1d287477545ce37c7b1ff68071e7082793b771c9b8ec959656849c08086579\n45\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/reviews/phase-LH1-r2/FINDINGS.md\n46\t    sha256: fd788e05f04bd7afd19844ecdfc9043e95a41401b819607200284ea8b16a1989\n47\t  - path: dev/components/COMPONENTS.md\n48\t    sha256: 8243162ca04ce32a39a90b79c62c9b243aae3d2280c1a600ed022b264e09e7cc\n49\t---\n50\t\n51\t# Phase LH1: a live producer over a caller root\n52\t\n53\t## Claim\n54\t\n55\t`reading.run()` takes a producer object over a root that holds\n56\t`profile.json` and writes a `literature-reading-run/2` folder. Every LH1\n57\tcriterion has a test in `tests/test_lh1_reading_host.py` (the spec's T1 to\n58\tT20, plus regressions R1 to R8 from review):\n59\t\n60\t| Criterion | Tests |\n61\t|---|---|\n62\t| LH1-C1 | T1 |\n63\t| LH1-C2 | T2 |\n64\t| LH1-C3 | T3 |\n65\t| LH1-C4 | T4, T5, T6, T19 |\n66\t| LH1-C5 | T7 (three cases, including D6's continuation) |\n67\t| LH1-C6 | T8 |\n68\t| LH1-C7 | T9 (17 malformed answers), R2 |\n69\t| LH1-C8 | T10 |\n70\t| LH1-C9 | T11, and `test_ld3`, `test_ld4`, `test_ld5` unedited |\n71\t| LH1-C10 | T12 (roster, input, response, budget, timeout and route-output ceilings), T20 (retained ceiling) |\n72\t| LH1-C11 | T13 |\n73\t| LH1-C12 | T14 |\n74\t| LH1-C13 | T15: exits 2, 1 and 4 through real caller models; any other exit refuses |\n75\t| LH1-C14 | T20, R1, R5 |\n76\t\n77\tThe three packaged run configurations equal the trees recorded at\n78\t`78934ee3` before any edit (`389adcdc`), file for file, and their `run.json`\n79\tdigests are P3's.\n80\t\n81\t## Gate\n82\t\n83\tDelegated approval (auto=true), 2026-11-23, under the owner's\n84\t`/process-milestone literature-host-interfaces auto`. It covered the spec at\n85\tsha256 `93cd0f95…0e12` (commit `c0068c27`), with LH1-D1 to LH1-D5 as\n86\tproposed. The spec has since been appended only, with its implementation\n87\tfindings; the current bytes are the evidence row above. The owner's\n88\t`/process-milestone … auto` supersedes the plan gate's D15 ruling (phase by\n89\tphase) for this milestone.\n90\t\n91\t## Review\n92\t\n93\tOne reviewer is one reviewer. Codex ran in the other harness, read-only,\n94\tthrough `review_tool.py` (plan D13), for two rounds:\n95\t\n96\t| Round | Read | Findings | Blocking | Self-inflicted |\n97\t|---|---|---|---|---|\n98\t| r1 | the LH1 diff, base `c5fbaf58` | 4 | 4 | 0 |\n99\t| r2 | the r1 repair, base `83de2846` | 4 | 2 | 2 |\n100\t\n101\tEvery finding was reproduced before it was fixed, and each fix has a\n102\tregression test that failed on the code before it (the ledgers name them).\n103\tRound 2 was declared the last round in r1's ledger before it ran; its\n104\trepairs (`59fd62f0`) are not read by any reviewer. Both retained reviews\n105\twere sanitized of this machine's paths by `review_tool.py sanitize`, as\n106\ttheir headers say.\n107\t\n108\t## Refactoring review\n109\t\n110\tRefactors EXECUTED, each behavior-preserving behind T11's byte comparison\n111\tand the unedited `test_ld3`, `test_ld4`, `test_ld5`:\n112\t\n113\t- The packaged constants (model and include names, label, producer label,\n114\t  calibration literals, conflict fact, step switches, route exits) became one\n115\t  data object, `PACKAGED_PROFILE`, read by the same loop as a caller's\n116\t  profile (R0.4).\n117\t- `gnd extract` moved out of `_public_results` into `_extract`, which runs\n118\t  before the first producer call for both roots.\n119\t- One row validator (`_fact_rows`) and one serializer for untrusted values\n120\t  (`_canonical`) replaced checks spread across the loop.\n121\t\n122\tDeferred: none. `assurance_report._coverage_units` re-checks the coverage\n123\trow shape that `reading._outcomes` writes; it predates this phase and is\n124\toutside its homes, and it stays as an independent reader by design.\n125\t\n126\t## Refuted premises and findings\n127\t\n128\t- **Size.** `reading.py` grew from 610 to 1,146 lines (+695, -159 with\n129\t  `depth.py`), past the 400-line split threshold of plan §6 and spec §10.\n130\t  Splitting into LH1a and LH1b was ruled out by delegated approval (spec\n131\t  finding 1). The estimate of 300 to 380 lines was low by roughly half,\n132\t  most of it in the review repairs.\n133\t- The spec's retained bound (\"roster cap times 1 KiB\") did not bound\n134\t  roster strings or saved files; it is now a measured bound per file (r1-F1,\n135\t  r2-F1).\n136\t- Spec findings 2 to 9 record the other departures from the spec's letter.\n137\t\n138\t## Open questions\n139\t\n140\tNone opened by this phase.\n141\t\n142\t## Boundary\n143\t\n144\t- **Replay of a caller run** is LH2's. `replay()` refuses a `/2` folder.\n145\t- **No review reads `59fd62f0`'s repairs.** The round budget was two, and\n146\t  round 2 read only the round-1 repair.\n147\t- **Speed.** The time bounds are measured on this machine (Apple silicon,\n148\t  2026-11-23); T12 and T20 hold them, but other machines are not measured.\n149\t- **Packaged steps on new arguments.** The packaged root refuses every new\n150\t  argument (LH1-D1); a host gets the new behavior only through a profile.\n151\t- **Out of scope.** No change to any stable command, to `revision.py` or to\n152\t  `assurance_report.py`; no command-line flag."}
+{"role":"tool","tool_call_id":"tool_LZ14uw3W0mAxt1vbhkj4oUjL","content":"1\t---\n2\tmilestone: literature-host-interfaces\n3\tstation: \"phase-LH2\"\n4\tskill: \"n/a -- repository development, not a gnd-solve station over a domain model\"\n5\tscope: phase-LH2\n6\tdate: 2026-11-23\n7\tgates:\n8\t  - command: \"ruling: delegated (auto=true) approved .gnd-planning/milestones/literature-host-interfaces/notes/phase-LH2-spec.md sha256 2e15cb11bdf2d9106acfe5b2beaa4572d86ba68dbb94889fc54a08c60dcd4ef8\"\n9\t    exit: \"n/a -- ruling\"\n10\t  - command: \"uv run pytest -q tests/test_lh2_reading_replay.py tests/test_lh1_reading_host.py tests/test_ld3_reading_workflow.py tests/test_ld4_revision.py tests/test_ld5_verdict.py tests/test_li1_assurance_report.py tests/test_ld1_competency_examples.py --tb=short\"\n11\t    exit: 0\n12\t    output: \"281 passed in 508.98s (0:08:28)\"\n13\t    note: \"plan §9 LH2 row plus tests/test_ld1_competency_examples.py (depth.py, LH1 finding 9)\"\n14\t  - command: \"uv run python tools/run_tutorials.py --group literature\"\n15\t    exit: 0\n16\t    output: \"15 tutorial blocks passed\"\n17\t  - command: \"the project.md structure and inventory guard block (12 files)\"\n18\t    exit: 0\n19\t    output: \"679 passed, 2 deselected in 106.53s (0:01:46)\"\n20\t  - command: \"uv run ruff check\"\n21\t    exit: 0\n22\t    output: \"All checks passed!\"\n23\t  - command: \"python3 scripts/components_index.py changed --base 0c23f30c --strict\"\n24\t    exit: 0\n25\t    output: \"changed against 0c23f30c (0c23f30): 19 file(s) differ; 0 to fix, 0 warning(s), 0 to reread\"\n26\tslow_cadence:\n27\t  command: \"uv run pytest -q -m \\\"evidence or census\\\"\"\n28\t  trigger: \"explicit owner request or separately scoped CI selection\"\n29\t  reason: \"the broad controls are outside this phase's impact closure\"\n30\tevidence:\n31\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/phase-LH2-spec.md\n32\t    sha256: ec41cccdf7bb099e1129e11fb141126b35b4b2e60887ac8996e3abfadbaed647\n33\t  - path: src/gnd/examples/literature/reading.py\n34\t    sha256: cad2bea4aa679310e154f98bcdad3e85e89cba581812ba703f059d737246d8b6\n35\t  - path: src/gnd/examples/literature/assurance_report.py\n36\t    sha256: eb5bf73f97b9a7f400ae4c68348334fd8dfba932ceea5b585341f74da3d56078\n37\t  - path: src/gnd/examples/literature/reading_fixture/README.md\n38\t    sha256: 797c060777fd392dee286322c38b45ac4faf79df08847f50dbe46acf449c57c7\n39\t  - path: tests/test_lh2_reading_replay.py\n40\t    sha256: 84f9895071d52affdceff71defc02d8ff75f8c7cb6136d27832cd067ed8d7983\n41\t  - path: tests/test_lh1_reading_host.py\n42\t    sha256: c0db56071a7f2f5c17ff521949c748b3aaf7f5b2656950b698741ff1b19cc5fe\n43\t  - path: docs/literature/commands.md\n44\t    sha256: 9d7f3d092c276124d8df27689abbad397d912922f7d34ee8f7b3c72a60470181\n45\t  - path: docs/release-notes.md\n46\t    sha256: 3fde981b1b7c920b17cae776352b7bdda18a358df90b40b37e601e4270a3f62e\n47\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/reviews/phase-LH2-r1/review.md\n48\t    sha256: 066aed2030be6d523d8d0df9a083bde32cda16f12559400cb80ac2ce9530ea3a\n49\t  - path: .gnd-planning/milestones/literature-host-interfaces/notes/reviews/phase-LH2-r1/FINDINGS.md\n50\t    sha256: 5736726aaeffba3890039819e20712b559e644fe7d8cbe7d6aab2890f63da674\n51\t---\n52\t\n53\t# Phase LH2: replay of a caller run\n54\t\n55\t## Claim\n56\t\n57\t`replay(folder, fixture=root)` re-derives a `literature-reading-run/2`\n58\tfolder from its own files and the caller root, with no producer and no\n59\treviewer, and refuses every changed file, changed input, malformed manifest\n60\tand out-of-ceiling setting. Criteria and their tests in\n61\t`tests/test_lh2_reading_replay.py`:\n62\t\n63\t| Criterion | Tests |\n64\t|---|---|\n65\t| LH2-C1 | T1 (a plain live run and a declared run with a live reviewer, replayed byte-identical with zero calls) |\n66\t| LH2-C2 | T2 (one changed byte in the response table and in a receipt; a consistently rewritten folder with and without the expected digest) |\n67\t| LH2-C3 | T3 (lowered and raised limits with a document budget; the 9-section run at the response ceiling within 60 s; `route_seconds` 601) |\n68\t| LH2-C4 | T4 (source, profile, model and include each refuse \"stale reading input\") |\n69\t| LH2-C5 | `test_ld3`, `test_ld4`, `test_ld5` unedited, in the focused lane |\n70\t| LH2-C6 | T6 |\n71\t| LH2-C7 | T7 |\n72\t| spec §6.1 | T8: a `/2` folder under the packaged root and a `/1` folder under a caller root each refuse by name |\n73\t| rule 1, rule 3 | T9 (seven malformed manifests refuse before any run file; every run file read under the recorded cap; saved and empty live runs replay), R1 to R3 |\n74\t\n75\t## Gate\n76\t\n77\tDelegated approval (auto=true), 2026-11-23, under the owner's\n78\t`/process-milestone literature-host-interfaces auto`, of the spec at sha256\n79\t`2e15cb11…4ef8` (commit `33fe059b`), LH2-D1 and LH2-D2 as proposed. The\n80\tspec has since been appended only. The milestone coordinator's GO for LH2\n81\tconcerned file order with literature-reading-reference and approved\n82\tnothing.\n83\t\n84\t## Review\n85\t\n86\tOne reviewer is one reviewer: Codex in the other harness, read-only,\n87\tthrough `review_tool.py`, one round over the LH2 diff (base `33fe059b`).\n88\tThree findings, all reproduced, one blocking and two hardening, none\n89\tself-inflicted; all fixed at `9df661c8` with regression tests that failed\n90\tbefore the fix. The convergence rules did not call for a second round, so\n91\tthe repairs carry no review opinion. The retained review was sanitized of\n92\tthis machine's paths, as its header says.\n93\t\n94\t## Refactoring review\n95\t\n96\tRefactors EXECUTED, behavior-preserving behind the unedited `test_ld3`,\n97\t`test_ld4`, `test_ld5`: the stage-chain and file reading of a run moved into\n98\tone helper, `_retained_files`, shared by the `/1` and `/2` readers, and now\n99\tdecodes each file under the cap it was read with. Deferred: none.\n100\t\n101\t## Refuted premises\n102\t\n103\t**Plan D4's 64 MiB retained-file ceiling.** Every JSON reader in the\n104\trepository goes through `gnd.input_policy`, which refuses JSON over 10 MiB\n105\t(`MAX_BYTES`). LH1's run at the response ceiling (63 sections, a 63 MiB\n106\tpayload) completed and could not be read back, contradicting LH1-C14 and\n107\tLH2-C3. Repaired in this phase by delegated approval: the ceiling is\n108\t`gnd.input_policy.MAX_BYTES`, imported, and the ceiling runs use 9 sections\n109\t(spec finding 1). The plan text is repaired at milestone close (open\n110\tquestion Q1).\n111\t\n112\t## Open questions\n113\t\n114\t| ID | Question | Owner | Target |\n115\t|---|---|---|---|\n116\t| Q1 | Plan §10 D4 and §2 LH1 still say the retained-file ceiling is 64 MiB; the shipped ceiling is the JSON read cap, 10 MiB | milestone close | plan repair at close |\n117\t\n118\t## Boundary\n119\t\n120\t- **The reading pair ends here.** LH1 and LH2 are delivered as the first of\n121\t  two pull requests (README, deviation from plan §8).\n122\t- **No review reads `9df661c8`'s repairs.**\n123\t- **A consistently rewritten folder replays** unless the host passes the\n124\t  digest `run()` returned; the README says so.\n125\t- **Out of scope.** No command-line flag for a caller root; `revision.py`'s\n126\t  packaged replay is unchanged."}

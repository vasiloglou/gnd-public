332: def _recall(raw):
333:     value = _decode(raw)
334:     rows = [row for row in value["per_fact_type"] if row["id"] in CALIBRATION_FACTS]
335:     _need(value["cases"]["ran"] == 2 and value["cases"]["failed"] == value["cases"]["skipped"] == 0
336:           and len(rows) == len(CALIBRATION_FACTS) and {row["id"] for row in rows} == CALIBRATION_FACTS,
337:           "invalid fidelity census")
338:     counts = [sum(row["recall"][key] for row in rows) for key in ("numerator", "denominator")]
339:     _need(all(type(count) is int for count in counts) and 0 <= counts[0] <= counts[1],
340:           "invalid fidelity denominator")
341:     return counts

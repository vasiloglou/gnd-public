   331	def _reply_rule_problems(text: str) -> list[str]:
   332	    section = _section(text, "The reply shape")
   333	    rows = _table_rows(section)
   334	    elements, sample_rows = rows.get("`object_types`, `fact_types`", ""), rows.get("`rows`", "")
   335	    prose = "\n".join(line for line in section if not line.startswith("|"))
   336	    problems = []
   337	    if "New elements only" not in elements or "is not repeated here" not in elements:
   338	        problems.append("the element row does not say a reply repeats no element the model has")
   339	    if "ids that already exist are reused" in elements:
   340	        problems.append("the element row keeps the old, ambiguous wording")
   341	    if "`open_questions` entry" not in sample_rows or "fact_types.modify" not in sample_rows:
   342	        problems.append("the rows row does not route rows for an existing fact type to open_questions")
   343	    if "is never repeated in\n`object_types` or `fact_types`" not in prose:
   344	        problems.append("the reply-shape prose does not state the rule")
   345	    block = prose.split("```json\n", 1)[1].split("\n```", 1)[0]
   346	    example = json.loads(block)
   347	    added = {entry["id"] for entry in example["fact_types"] + example["derived_fact_types"]}
   348	    hosts = {entry["host"] for entry in example["constraints"]} - {"model"}
   349	    if not hosts - added:
   350	        problems.append("the example names no fact type the model already has")
   351	    return problems

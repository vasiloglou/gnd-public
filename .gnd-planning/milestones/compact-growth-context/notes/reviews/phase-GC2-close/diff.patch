     "direct_lookup": {"query": "reading: has version", "shown": direct,
                       "partial": True, "view_sha256": view_hash},
     "ambiguous_document": ambiguous,
     "decisions": [
         {"decision": "reuse", "id": fact["id"], "span": [start, start + len(quote)],
-         "bindings": {"work": "W-1", "version": "V-1"},

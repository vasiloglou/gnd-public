   373	def _strengthening_only(before: Any, after: Any) -> bool:
   374	    """Every refusing key of a constraint MODIFY strengthens; a `neither` key is never cleared."""
   375	    family = _lookup(before, "type")
   376	    for path, left, right in diff_paths(before, after):
   377	        verdict = constraint_change(path, left, right, family=family)
   378	        if verdict not in (_ADMITTED, _WEAKENING, _STRENGTHENING):
   379	            return False
   380	    return True

     "provenance": {"user_quote": "Use is_shipped instead of the raw state code."}},
    {"id": "delivered_two_forms", "type": "guarded", "modality": "deontic", "source": "explicit", "status": "confirmed",
     "antecedent": [{"fact_type": "question_mentions_phrase", "bind": {"phrase": "delivered"}}],
     "consequent": {"any_of": [
       {"exists": {"atoms": [
         {"fact_type": "filter_on", "bind": {"filter": "$f", "concept": "Order", "role": "status"}},
         {"fact_type": "filter_literal", "bind": {"filter": "$f", "literal": "D"}}
       ]}},
       {"exists": {"atoms": [
         {"fact_type": "filter_on", "bind": {"filter": "$f", "concept": "Order", "role": "status"}},
         {"fact_type": "filter_literal", "bind": {"filter": "$f", "literal": "P"}},
         {"fact_type": "plan_uses_unary", "bind": {"fact_type": "Carrier_confirmation"}}
       ]}}
     ]},
     "provenance": {"user_quote": "Delivered means status D or status P with carrier confirmation."}},
    {"id": "exclude_test_accounts", "type": "guarded", "modality": "deontic", "source": "explicit", "status": "confirmed",
     "antecedent": [{"fact_type": "question_mentions_phrase", "bind": {"phrase": "exclude test accounts"}}],
     "consequent": {"exists": {"atoms": [
       {"fact_type": "plan_negates_unary", "bind": {"fact_type": "Customer_is_test"}},
       {"fact_type": "plan_negates_unary", "bind": {"fact_type": "Customer_is_internal"}}
     ]}},
     "provenance": {"user_quote": "Exclude test accounts by negating is_test and is_internal."}}

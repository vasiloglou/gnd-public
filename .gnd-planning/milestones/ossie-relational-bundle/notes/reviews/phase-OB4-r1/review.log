   181	
   182	ColumnRef = tuple[str, str]
   183	_ROLE_SECTIONS = ("roles", "extension_roles")
   184	
   185	
   186	class _Binder:
   187	    def __init__(self, model: Any, view: OntologyView, binding: Binding) -> None:
   188	        self.model = model
   189	        self.view = view
   190	        self.sha256 = binding.sha256
   191	        self.tables: Mapping[str, Any] = binding.document["tables"]
   192	        # The binding's two role sections, by member name. (The name is a variable so
   193	        # that this is not read as a model query: the document is a binding, not a model.)
   194	        self.role_sections: dict[str, Mapping[str, Any]] = {
   195	            section: binding.document.get(section, {}) for section in _ROLE_SECTIONS
   196	        }
   197	        index = ModelIndex.for_model(model)
   198	        self.objects = index.object_types_by_id()
   199	        self.players: Mapping[str, Mapping[str, str]] = index.role_object_types()
   200	        self.facts = list(index.iter_fact_types_shared())
   201	        self.spelled: dict[str, list[ColumnRef]] = {}
   202	        for table, body in self.tables.items():
   203	            for column in body["columns"]:
   204	                self.spelled.setdefault(f"{table}.{column}", []).append((table, column))
   205	        #: (section, fact type, model role name) -> columns, filled by the name checks.
   206	        self.bound: dict[tuple[str, str, str], tuple[ColumnRef, ...]] = {}
   207	        self._arity: dict[str, int | None] = {}
   208	
   209	    # -- iteration in sorted order ------------------------------------------------------
   210	
   211	    def columns(self) -> Iterable[tuple[str, str, Mapping[str, Any]]]:
   212	        for table in sorted(self.tables):
   213	            for column in sorted(self.tables[table]["columns"]):
   214	                yield table, column, self.tables[table]["columns"][column]
   215	
   216	    def role_entries(self) -> Iterable[tuple[str, str, str, list[Any]]]:
   217	        """(section, fact type, role name as written, column references)."""
   218	        for section in ("roles", "extension_roles"):
   219	            for fact in sorted(self.role_sections[section]):
   220	                for role in sorted(self.role_sections[section][fact]):
   221	                    yield section, fact, role, self.role_sections[section][fact][role]
   222	
   223	    def targets(self, kinds: tuple[str, ...]) -> Iterable[tuple[str, str, Mapping[str, str]]]:
   224	        for table, column, body in self.columns():
   225	            for target in body.get("targets", ()):
   226	                if target["kind"] in kinds:
   227	                    yield table, column, target
   228	
   229	    # -- step 5: names ---------------------------------------------------------------------
   230	
   231	    def check_names(self) -> None:
   232	        # binding:name-collision. Expressions quote and uppercase every name.
   233	        for label, names in [("tables", sorted(self.tables)),
   234	                             *((f"columns of {t}", sorted(self.tables[t]["columns"])) for t in sorted(self.tables))]:
   235	            seen: dict[str, str] = {}
   236	            for name in names:
   237	                other = seen.setdefault(name.upper(), name)
   238	                if other != name:
   239	                    raise BindingError("binding:name-collision", f"{label}: {other!r} and {name!r} are one identifier")
   240	        # binding:unknown-table
   241	        for table, column, body in self.columns():
   242	            target = body.get("references", {}).get("table")
   243	            if target is not None and target not in self.tables:
   244	                raise BindingError("binding:unknown-table", f"{table}.{column} references table {target!r}")
   245	        for _section, fact, role, references in self.role_entries():
   246	            for reference in references:
   247	                if not isinstance(reference, str) and reference["table"] not in self.tables:
   248	                    raise BindingError("binding:unknown-table", f"{fact}.{role} names table {reference['table']!r}")
   249	        # binding:unknown-column
   250	        for table in sorted(self.tables):
   251	            body = self.tables[table]
   252	            for key in [body.get("primary_key", ()), *body.get("unique_keys", ())]:
   253	                for column in key:
   254	                    if column not in body["columns"]:
   255	                        raise BindingError("binding:unknown-column", f"a key of {table} names column {column!r}")
   256	        for table, column, body in self.columns():
   257	            reference = body.get("references")
   258	            if reference is not None:
   259	                for name in reference["columns"]:
   260	                    if name not in self.tables[reference["table"]]["columns"]:
   261	                        raise BindingError(
   262	                            "binding:unknown-column", f"{table}.{column} references {reference['table']}.{name}")
   263	        for _section, fact, role, references in self.role_entries():
   264	            for reference in references:
   265	                if isinstance(reference, str):
   266	                    if reference not in self.spelled:
   267	                        raise BindingError("binding:unknown-column", f"{fact}.{role} names column {reference!r}")
   268	                elif reference["column"] not in self.tables[reference["table"]]["columns"]:
   269	                    raise BindingError(
   270	                        "binding:unknown-column", f"{fact}.{role} names column {reference['table']}.{reference['column']}")
   271	        # binding:ambiguous-column. A string is looked up, never split on its dots.
   272	        for _section, fact, role, references in self.role_entries():
   273	            for reference in references:
   274	                if isinstance(reference, str) and len(self.spelled[reference]) > 1:
   275	                    raise BindingError(
   276	                        "binding:ambiguous-column", f"{fact}.{role}: {reference!r} spells more than one table and column")
   277	        # binding:unknown-fact-type
   278	        for _section, fact, _role, _references in self.role_entries():
   279	            if fact not in self.players:
   280	                raise BindingError("binding:unknown-fact-type", f"{fact!r} is not a fact type of the model")
   281	        for table, column, target in self.targets(("role",)):
   282	            if target["fact_type"] not in self.players:
   283	                raise BindingError("binding:unknown-fact-type", f"a target of {table}.{column} names {target['fact_type']!r}")
   284	        # binding:role-name, then binding:unknown-role. A name that normalizes to nothing,
   285	        # or like another, cannot be looked up, so it is judged before the lookup.
   286	        resolved: dict[tuple[str, str, str], str] = {}
   287	        model_names: dict[str, dict[str, str]] = {}
   288	        named_facts = sorted({fact for _s, fact, _r, _c in self.role_entries()}
   289	                             | {target["fact_type"] for _t, _c, target in self.targets(("role",))})
   290	        for fact in named_facts:
   291	            names: dict[str, str] = {}
   292	            for role in self.players[fact]:
   293	                normal = normalize_role_name(role)
   294	                if not normal or normal in names:
   295	                    raise BindingError("binding:role-name", f"the roles of {fact} cannot be told apart once normalized")
   296	                names[normal] = role
   297	            model_names[fact] = names
   298	        for section in ("roles", "extension_roles"):
   299	            for fact in sorted(self.role_sections[section]):
   300	                written: dict[str, str] = {}
   301	                for role in sorted(self.role_sections[section][fact]):
   302	                    normal = normalize_role_name(role)
   303	                    if not normal:
   304	                        raise BindingError("binding:role-name", f"{fact}: role name {role!r} has no letter or digit")
   305	                    if normal in written:
   306	                        raise BindingError(
   307	                            "binding:role-name", f"{fact}: {written[normal]!r} and {role!r} are one role name")
   308	                    written[normal] = role
   309	        for table, column, target in self.targets(("role",)):
   310	            if not normalize_role_name(target["role"]):
   311	                raise BindingError("binding:role-name", f"a target of {table}.{column} names role {target['role']!r}")
   312	        for section, fact, role, _references in self.role_entries():
   313	            match = model_names[fact].get(normalize_role_name(role))
   314	            if match is None:
   315	                raise BindingError("binding:unknown-role", f"{fact} has no role {role!r}")
   316	            resolved[(section, fact, role)] = match
   317	        for table, column, target in self.targets(("role",)):
   318	            if normalize_role_name(target["role"]) not in model_names[target["fact_type"]]:
   319	                raise BindingError(
   320	                    "binding:unknown-role", f"a target of {table}.{column}: {target['fact_type']} has no role {target['role']!r}")
   321	        # binding:unknown-object-type
   322	        for table, column, target in self.targets(("identifier", "reference")):
   323	            if target["object_type"] not in self.objects:
   324	                raise BindingError("binding:unknown-object-type", f"a target of {table}.{column} names {target['object_type']!r}")
   325	        self.model_names = model_names
   326	        for section, fact, role, references in self.role_entries():
   327	            self.bound[(section, fact, resolved[(section, fact, role)])] = tuple(
   328	                self.spelled[r][0] if isinstance(r, str) else (r["table"], r["column"]) for r in references)
   329	
   330	    # -- identification, as the ontology declares it ---------------------------------------
   331	
   332	    def components(self, object_type: str) -> list[tuple[str, str, str]] | None:
   333	        """(fact type, component role, component player) per identifying relationship of
   334	        a composite identifier, in the ontology's order; None for any other object type."""
   335	        form, payload = self.view.identification.get(object_type, (None, None))
   336	        if form != "composite":
   337	            return None
   338	        result = []
   339	        for fact in payload:
   340	            _owner, order, players = self.view.relations[fact]
   341	            result.append((fact, order[1], players[order[1]]))
   342	        return result
   343	
   344	    def arity(self, object_type: str) -> int | None:
   345	        """How many columns hold one object of the type; None when the ontology declares
   346	        no identifier for it (the mapping then lists it as identification-differs)."""
   347	        if object_type in self._arity:
   348	            return self._arity[object_type]
   349	        self._arity[object_type] = None  # a re-entrant request has no answer
   350	        result: int | None
   351	        if self.objects[object_type]["kind"] == "value" or self.view.identification.get(object_type, (None,))[0] == "simple":
   352	            result = 1
   353	        elif (components := self.components(object_type)) is not None:
   354	            parts = [self.arity(player) for _fact, _role, player in components]
   355	            result = None if None in parts else sum(parts)  # type: ignore[arg-type]
   356	        else:
   357	            result = None
   358	        self._arity[object_type] = result
   359	        return result
   360	
   361	    def related(self, first: str, second: str) -> bool:
   362	        """The same object type, or one a subtype of the other."""
   363	        def ancestors(object_type: str) -> set[str]:
   364	            seen, pending = set(), [object_type]
   365	            while pending:
   366	                current = pending.pop()
   367	                if current not in seen:
   368	                    seen.add(current)
   369	                    pending += [str(parent) for parent in self.objects.get(current, {}).get("subtype_of") or ()]
   370	            return seen
   371	
   372	        return first in ancestors(second) or second in ancestors(first)
   373	
   374	    def declared_homes(self) -> list[tuple[str, str]]:
   375	        """(table, object type) wherever every primary-key column is marked as that
   376	        object type's identifier, in sorted order."""
   377	        declared = []
   378	        for table in sorted(self.tables):
   379	            key = tuple(self.tables[table].get("primary_key", ()))
   380	            marked = [
   381	                {t["object_type"] for t in self.tables[table]["columns"][c].get("targets", ()) if t["kind"] == "identifier"}
   382	                for c in key
   383	            ]
   384	            declared += [(table, object_type) for object_type in (sorted(set.intersection(*marked)) if marked else ())]
   385	        return declared
   386	
   387	    def home_tables(self) -> dict[str, str]:
   388	        """object type -> the table its object mapping reads: the first declared home
   389	        whose key is exactly the columns its identifier is bound to there."""
   390	        homes: dict[str, str] = {}
   391	        for table, object_type in self.declared_homes():
   392	            if object_type not in homes and self.home_key(object_type, table) is not None:
   393	                homes[object_type] = table
   394	        return homes
   395	
   396	    def identified_through(self, whole: str, part: str) -> bool:
   397	        """Whether ``part`` is a component of ``whole``'s identifier, at any depth."""
   398	        seen, pending = set(), [whole]
   399	        while pending:
   400	            current = pending.pop()
   401	            if current in seen:
   402	                continue
   403	            seen.add(current)
   404	            for _fact, _role, player in self.components(current) or ():
   405	                if self.related(player, part):
   406	                    return True
   407	                pending.append(player)
   408	        return False
   409	
   410	    def home_key(self, object_type: str, table: str) -> tuple[str, ...] | None:
   411	        """The table's key columns in the object type's identification order, or None
   412	        when the key is not that object type's identifier."""
   413	        key = tuple(self.tables[table].get("primary_key", ()))
   414	        if self.objects[object_type]["kind"] != "entity" or self.arity(object_type) is None:
   415	            return None
   416	        components = self.components(object_type)
   417	        if components is None:
   418	            return key if len(key) == 1 else None
   419	        ordered: list[str] = []
   420	        for fact, role, _player in components:
   421	            columns = self.bound.get(("roles", fact, role))
   422	            if columns is None or any(t != table for t, _c in columns):
   423	                return None
   424	            ordered += [column for _t, column in columns]
   425	        return tuple(ordered) if sorted(ordered) == sorted(key) else None
   426	
   427	    # -- step 6: contradictions ------------------------------------------------------------
   428	
   429	    def foreign_keys(self, table: str) -> list[tuple[tuple[str, ...], str, tuple[str, ...]]]:
   430	        """(columns, target table, target columns) per group of equal `references`, in
   431	        the order of each group's first column. Columns pair by table column order."""
   432	        groups: dict[tuple[str, tuple[str, ...]], list[str]] = {}
   433	        for column, body in self.tables[table]["columns"].items():
   434	            reference = body.get("references")
   435	            if reference is not None:
   436	                groups.setdefault((reference["table"], tuple(reference["columns"])), []).append(column)
   437	        return [(tuple(columns), target, target_columns) for (target, target_columns), columns in groups.items()]
   438	
   439	    def check_contradictions(self) -> None:
   440	        # binding:reference-group
   441	        for table in sorted(self.tables):
   442	            for columns, target, target_columns in self.foreign_keys(table):
   443	                if len(columns) != len(target_columns):
   444	                    raise BindingError(
   445	                        "binding:reference-group",
   446	                        f"{table}: {len(columns)} column(s) reference {len(target_columns)} column(s) of {target}")
   447	        # binding:reference-not-a-key
   448	        for table in sorted(self.tables):
   449	            for _columns, target, target_columns in self.foreign_keys(table):
   450	                body = self.tables[target]
   451	                keys = [tuple(body.get("primary_key", ())), *(tuple(key) for key in body.get("unique_keys", ()))]
   452	                if target_columns not in keys:
   453	                    raise BindingError(
   454	                        "binding:reference-not-a-key", f"{table} references {target}{list(target_columns)}, which is not a key")
   455	        # binding:partial-fact-type
   456	        for section in ("roles", "extension_roles"):
   457	            for fact in sorted(self.role_sections[section]):
   458	                missing = sorted(role for role in self.players[fact] if (section, fact, role) not in self.bound)
   459	                if missing:
   460	                    raise BindingError("binding:partial-fact-type", f"{fact}: no columns for role {missing[0]!r}")
   461	        # binding:role-arity
   462	        for (_section, fact, role), columns in sorted(self.bound.items()):
   463	            wanted = self.arity(self.players[fact][role])
   464	            if wanted is not None and len(columns) != wanted:
   465	                raise BindingError(
   466	                    "binding:role-arity", f"{fact}.{role} needs {wanted} column(s) and has {len(columns)}")
   467	        # binding:target-mismatch
   468	        holders: dict[ColumnRef, list[tuple[str, str, str]]] = {}
   469	        for (section, fact, role), columns in sorted(self.bound.items()):
   470	            for reference in columns:
   471	                holders.setdefault(reference, []).append((section, fact, role))
   472	        for table, column, target in self.targets(("role",)):
   473	            role = self.model_names[target["fact_type"]][normalize_role_name(target["role"])]
   474	            if not any((fact, name) == (target["fact_type"], role) for _s, fact, name in holders.get((table, column), ())):
   475	                raise BindingError(
   476	                    "binding:target-mismatch", f"{table}.{column} is not among the columns of {target['fact_type']}.{role}")
   477	        for table, column, target in self.targets(("reference",)):
   478	            if not any(self.players[fact][role] == target["object_type"] for _s, fact, role in holders.get((table, column), ())):
   479	                raise BindingError(
   480	                    "binding:target-mismatch", f"{table}.{column} holds no role played by {target['object_type']}")
   481	        # binding:key-role
   482	        for table, object_type in self.declared_homes():
   483	            identifying = {(fact, role) for fact, role, _player in self.components(object_type) or ()}
   484	            for column in self.tables[table]["primary_key"]:
   485	                for _section, fact, role in holders.get((table, column), ()):
   486	                    if not self.related(self.players[fact][role], object_type) and (fact, role) not in identifying:
   487	                        raise BindingError(
   488	                            "binding:key-role", f"{table}.{column} is a key of {object_type} and holds {fact}.{role}")
   489	        # binding:incompatible-keys
   490	        for reference in sorted(holders):
   491	            held = sorted({self.players[fact][role] for section, fact, role in holders[reference] if section == "roles"})
   492	            for first in held:
   493	                for second in held:
   494	                    compatible = (
   495	                        self.related(first, second)
   496	                        # A key column holds an entity and the part of its identifier kept there.
   497	                        or self.identified_through(first, second)
   498	                        or self.identified_through(second, first)
   499	                    )
   500	                    if first < second and not compatible:
   501	                        raise BindingError(
   502	                            "binding:incompatible-keys",
   503	                            f"{reference[0]}.{reference[1]} holds both {first} and {second}")
   504	        self.homes = self.home_tables()
   505	
   506	    # -- the relational schema -------------------------------------------------------------
   507	
   508	    def schema(self) -> RelationalSchema:
   509	        carried: dict[tuple[str, str], tuple[str, ...]] = {}
   510	        unmapped: dict[tuple[str, str], str] = {}
   511	        placements: list[RolePlacement] = []
   512	        fact_table: dict[str, str] = {}
   513	        role_columns: dict[tuple[str, str], tuple[str, ...]] = {}
   514	        for fact in self.facts:

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnd.dev/schema/discover.schema.json",
  "title": "GND discovery report",
  "description": "The gnd-discover/1 report written by `gnd discover` (IK4). Every key is always present, possibly empty or zero, so a reader can tell 'nothing found' from 'not looked at'. It states the bounds used and counts every skipped role, pair and key subset, every candidate rejected by its check verdict, and every candidate suppressed by a catalogue or redundancy rule. Emitted candidates are induced, proposed, deontic constraints whose `gnd check` verdict was pass with support > 0; near-misses are reported, never emitted. Support is computed by discovery from the population; it is a recorded claim in the evolve proposal, not a checker output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "command",
    "gnd_version",
    "model",
    "population",
    "bounds",
    "skipped",
    "rejected",
    "suppressed",
    "emitted",
    "near_misses",
    "work",
    "proposal"
  ],
  "properties": {
    "schema_version": {
      "const": "gnd-discover/1"
    },
    "tool": {
      "const": "gnd"
    },
    "command": {
      "const": "discover"
    },
    "gnd_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "$ref": "#/$defs/input"
    },
    "population": {
      "$ref": "#/$defs/input"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "max_values",
        "max_pairs",
        "max_key_arity"
      ],
      "properties": {
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "uniqueness",
              "mandatory",
              "value",
              "frequency",
              "subset",
              "equality",
              "exclusion",
              "fact-type"
            ]
          }
        },
        "max_values": {
          "type": "integer",
          "minimum": 1
        },
        "max_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "max_key_arity": {
          "const": 4
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_types",
        "value_roles",
        "redacted_value_roles",
        "unrepresentable_value_roles",
        "derived_mandatory_roles",
        "pairs",
        "key_subsets",
        "over_budget"
      ],
      "properties": {
        "fact_types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_type",
              "reason"
            ],
            "properties": {
              "fact_type": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "derived",
                  "referenced-by-operation"
                ]
              }
            }
          }
        },
        "value_roles": {
          "type": "integer",
          "minimum": 0
        },
        "pairs": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "key_subsets": {
          "type": "integer",
          "minimum": 0
        },
        "redacted_value_roles": {
          "type": "integer",
          "minimum": 0
        },
        "unrepresentable_value_roles": {
          "type": "integer",
          "minimum": 0
        },
        "derived_mandatory_roles": {
          "type": "integer",
          "minimum": 0
        },
        "over_budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vacuous",
        "unchecked",
        "fail",
        "warning"
      ],
      "properties": {
        "vacuous": {
          "type": "integer",
          "minimum": 0
        },
        "unchecked": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "suppressed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "equality-implies-subset",
        "frequency-max-1-is-uniqueness",
        "unscoped-value-implies-scoped",
        "reference-scheme-implies-uniqueness",
        "spanning-uniqueness",
        "superkey",
        "redundant-subset",
        "redundant-frequency",
        "redundant-superkey"
      ],
      "properties": {
        "declared": {
          "type": "integer",
          "minimum": 0
        },
        "equality-implies-subset": {
          "type": "integer",
          "minimum": 0
        },
        "frequency-max-1-is-uniqueness": {
          "type": "integer",
          "minimum": 0
        },
        "unscoped-value-implies-scoped": {
          "type": "integer",
          "minimum": 0
        },
        "reference-scheme-implies-uniqueness": {
          "type": "integer",
          "minimum": 0
        },
        "spanning-uniqueness": {
          "type": "integer",
          "minimum": 0
        },
        "superkey": {
          "type": "integer",
          "minimum": 0
        },
        "redundant-subset": {
          "type": "integer",
          "minimum": 0
        },
        "redundant-frequency": {
          "type": "integer",
          "minimum": 0
        },
        "redundant-superkey": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "emitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "family",
          "constraint",
          "support"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "uniqueness",
              "mandatory",
              "value",
              "frequency",
              "subset",
              "equality",
              "exclusion"
            ]
          },
          "constraint": {
            "type": "object",
            "required": [
              "type",
              "source",
              "status",
              "modality",
              "provenance"
            ],
            "properties": {
              "source": {
                "const": "induced"
              },
              "status": {
                "const": "proposed"
              },
              "modality": {
                "const": "deontic"
              }
            }
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 1
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "near_misses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "host",
          "constraint",
          "violations",
          "subjects",
          "counterexamples"
        ],
        "properties": {
          "family": {
            "enum": [
              "uniqueness",
              "mandatory",
              "value",
              "frequency",
              "subset",
              "equality",
              "exclusion"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "constraint": {
            "type": "object",
            "required": [
              "type"
            ]
          },
          "violations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "subjects": {
            "type": "integer",
            "minimum": 20
          },
          "counterexamples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uniqueness",
        "mandatory",
        "value",
        "frequency",
        "sets",
        "total",
        "ceiling"
      ],
      "properties": {
        "uniqueness": {
          "type": "integer",
          "minimum": 0
        },
        "mandatory": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "frequency": {
          "type": "integer",
          "minimum": 0
        },
        "sets": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ceiling": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "proposal": {
      "type": [
        "string",
        "null"
      ]
    },
    "fact_type_proposals": {
      "description": "Present only with --families fact-type (CT4). Opaque row ids and SHA-256 digests of attribute values; `value` only when the disclosure mode allows --show-values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_support",
        "proposed",
        "shape_matches",
        "skipped",
        "row_visits"
      ],
      "properties": {
        "min_support": {
          "type": "integer",
          "minimum": 1
        },
        "proposed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_type",
              "generic",
              "support",
              "rows"
            ],
            "properties": {
              "fact_type": {
                "type": "string"
              },
              "generic": {
                "type": "string"
              },
              "attribute_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "support": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numerator",
                  "denominator"
                ],
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ft[0-9]+#[0-9]+$"
                }
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "judged": {
                "description": "Present only under judgement (TS2): a verdict decided this proposal.",
                "const": true
              },
              "shape": {
                "description": "Present only for a group judged many-to-many (TS2): the uniqueness spans both roles.",
                "const": "many-to-many"
              }
            }
          }
        },
        "shape_matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generic",
              "existing"
            ],
            "properties": {
              "generic": {
                "type": "string"
              },
              "attribute_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "existing": {
                "type": "string"
              },
              "judged": {
                "description": "Present only under judgement (TS2): a duplicate verdict named `existing`.",
                "const": true
              }
            }
          }
        },
        "skipped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "redacted_attribute_roles",
            "mixed_type_groups",
            "below_support",
            "multi_valued",
            "over_budget"
          ],
          "properties": {
            "redacted_attribute_roles": {
              "type": "integer",
              "minimum": 0
            },
            "mixed_type_groups": {
              "type": "integer",
              "minimum": 0
            },
            "below_support": {
              "type": "integer",
              "minimum": 0
            },
            "multi_valued": {
              "type": "integer",
              "minimum": 0
            },
            "over_budget": {
              "type": "integer",
              "minimum": 0
            },
            "judged_skip": {
              "description": "Present only under judgement (TS2): multi-valued groups judged skip.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "row_visits": {
          "type": "integer",
          "minimum": 0
        },
        "judgements": {
          "description": "Present only under judgement (TS2): the raw-byte SHA-256 of the evidence and of each judgements file, null for a file not given.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_sha256",
            "duplicates_sha256",
            "shapes_sha256"
          ],
          "properties": {
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "duplicates_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "shapes_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}

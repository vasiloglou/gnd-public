   405	    index = ModelIndex.for_model(before)
   406	    existing_fact_types = {
   407	        str(_lookup(row, "id")) for row in index.iter_fact_types_shared() if _lookup(row, "id") is not None
   408	    }
   409	    added_fact_types: set[str] = set()

   247	    # -- the effective uniqueness set -----------------------------------------------
   248	
   249	    def uc_roles(self, fact: dict[str, Any], constraint: dict[str, Any]) -> tuple[str, ...]:
   250	        names = set(ModelIndex.constraint_roles(constraint))
   251	        return tuple(r for r in self.roles(fact) if r in names)
   252	
   253	    def effective(self, fact: dict[str, Any]) -> list[tuple[tuple[str, ...], bool]]:
   254	        """(role tuple in role order, preferred) for the effective uniqueness set.
   255	
   256	        With no counting uniqueness, the implied spanning one (S1). Duplicates over the
   257	        same roles are one key, preferred if any of them is (review r1 F2).
   258	        """
   259	        found: dict[tuple[str, ...], bool] = {}
   260	        for constraint in fact.get("constraints") or ():
   261	            if constraint.get("type") != "uniqueness" or constraint.get("scope") == "external":
   262	                continue
   263	            if not _confirmed(constraint):
   264	                continue
   265	            roles = self.uc_roles(fact, constraint)
   266	            found[roles] = found.get(roles, False) or bool(constraint.get("preferred"))
   267	        if not found:
   268	            return [(tuple(self.roles(fact)), False)]
   269	        sets = {roles: set(roles) for roles in found}
   270	        return [
   271	            (roles, preferred) for roles, preferred in found.items()
   272	            if not any(other < sets[roles] for other in sets.values())  # implied by a shorter one (plan F9)
   273	        ]
   274	
   275	    # -- placement --------------------------------------------------------------------
   276	
   277	    def players(self, fact: dict[str, Any]) -> dict[str, str]:
   278	        return self.role_players.get(str(fact.get("id")), {})
   279	
   280	    def roles(self, fact: dict[str, Any]) -> list[str]:
   281	        """Role names in declared order."""
   282	        return list(self.players(fact))
   283	
   284	    def owner_of(self, oid: str) -> str:
   285	        """HALPIN absorbs an inheriting subtype into its root supertype's table."""
   286	        if self.variant is not RmapVariant.HALPIN:
   287	            return oid
   288	        seen = set()
   289	        while oid not in seen:
   290	            seen.add(oid)
   291	            obj = self.objects.get(oid, {})
   292	            parents = obj.get("subtype_of") or []
   293	            if not parents or not obj.get("inherits_reference"):
   294	                return oid
   295	            oid = str(parents[0])
   296	        return oid
   297	
   298	    def is_absorbed(self, oid: str) -> bool:
   299	        return self.owner_of(oid) != oid
   300	
   301	    def run(self) -> RelationalSchema:
   302	        derived = set()
   303	        for fact in self.facts:
   304	            fid = str(fact.get("id"))
   305	            if fact.get("derivation") == "derived" and fact.get("storage") in (None, "computed"):
   306	                derived.add(fid)
   307	
   308	        functional_count: dict[str, int] = defaultdict(int)
   309	        effective: dict[str, list[tuple[int, tuple[str, ...]]]] = {}
   310	        for fact in self.facts:
   311	            fid = str(fact.get("id"))
   312	            effective[fid] = self.effective(fact)
   313	            if fid in derived:
   314	                continue
   315	            players = self.players(fact)
   316	            for roles, _ in effective[fid]:
   317	                if len(roles) == 1 and len(players) > 1:
   318	                    functional_count[players[roles[0]]] += 1
   319	
   320	        # Composite identification components (rule 2): fact type id -> entity.
   321	        components: dict[str, str] = {}
   322	        for oid, (_, refs) in sorted(self.identifiers.items()):
   323	            if self.identity(oid)[0] == "composite":
   324	                for fact_type, _role in refs:
   325	                    components.setdefault(fact_type, oid)
   326	
   327	        placed = self.placed
   328	        for fact in self.facts:
   329	            fid = str(fact.get("id"))
   330	            if fid in derived:
   331	                continue
   332	            placed[fid] = self.place(fact, effective[fid], components, functional_count)
   333	
   334	        # Which object types get a table (S7, A4, A15).
   335	        tabled: set[str] = set()
   336	        for fid, p in placed.items():
   337	            if p.rule in (1, 2, 3, 4, 5):
   338	                tabled.add(p.owner)
   339	        for oid, obj in self.objects.items():
   340	            if obj.get("kind") == "entity" and obj.get("independent"):
   341	                tabled.add(self.owner_of(oid))
   342	        if self.variant is RmapVariant.ALTERNATE:
   343	            # A separate subtype table references its supertype's table (review r1 F6).
   344	            pending = list(tabled)
   345	            while pending:
   346	                obj = self.objects.get(pending.pop(), {})
   347	                supers = obj.get("subtype_of") or []
   348	                if supers and obj.get("inherits_reference") and str(supers[0]) not in tabled:
   349	                    tabled.add(str(supers[0]))
   350	                    pending.append(str(supers[0]))
   351	
   352	        return self.build(derived, effective, placed, tabled)
   353	
   354	    def place(self, fact, eff, components, functional_count) -> _Placed:
   355	        fid = str(fact.get("id"))
   356	        roles = self.roles(fact)
   357	        players = self.players(fact)
   358	        singles = [r[0] for r, _ in eff if len(r) == 1 and len(roles) > 1]
   359	        # Rule 1: the reference fact type of a popular or general reference (S4).
   360	        if len(roles) == 2:
   361	            for role in roles:
   362	                other = roles[1 - roles.index(role)]
   363	                entity = self.objects.get(players[role], {})
   364	                reference = entity.get("reference") or {}
   365	                if (
   366	                    entity.get("kind") == "entity"
   367	                    and reference.get("mode") in ("popular", "general")
   368	                    and reference.get("value_type") == players[other]
   369	                    and other in singles
   370	                ):
   371	                    return _Placed(1, self.owner_of(players[role]), subject_role=role)
   372	        # Rule 2: an identification component.
   373	        if fid in components:
   374	            return _Placed(2, self.owner_of(components[fid]))
   375	        # Rule 3: objectified.
   376	        if fact.get("objectified_as"):
   377	            return _Placed(3, str(fact.get("objectified_as")))
   378	        # Rule 4: unary.
   379	        if len(roles) == 1:
   380	            return _Placed(4, self.owner_of(players[roles[0]]), subject_role=roles[0])
   381	        # Rule 5: functional on a single role.
   382	        if singles:
   383	            subject = self.subject(fact, singles, players, roles, functional_count)
   384	            return _Placed(5, self.owner_of(players[subject]), subject_role=subject)
   385	        # Rule 6: own table.
   386	        return _Placed(6, fid, key_roles=self.primary(fact, eff, roles))
   387	
   388	    def subject(self, fact, singles, players, roles, functional_count) -> str:
   389	        if len(singles) == 1:
   390	            return singles[0]
   391	        mandatory = {
   392	            str(c.get("role"))
   393	            for c in fact.get("constraints") or ()
   394	            if c.get("type") == "mandatory" and _confirmed(c)
   395	        }
   396	        covered = [r for r in singles if r in mandatory]
   397	        if len(covered) == 1:
   398	            return covered[0]
   399	        position = {r: i for i, r in enumerate(roles)}
   400	        if self.variant is RmapVariant.HALPIN:
   401	            return min(singles, key=lambda r: (players[r], position[r]))
   402	        return min(singles, key=lambda r: (-functional_count[players[r]], players[r], position[r]))
   403	
   404	    def primary(self, fact, eff, roles) -> tuple[str, ...]:
   405	        position = {r: i for i, r in enumerate(roles)}
   406	        preferred = [r for r, flag in eff if flag]
   407	        if preferred:
   408	            return min(preferred, key=lambda r: tuple(sorted(position[x] for x in r)))
   409	        return min((r for r, _ in eff), key=lambda r: (len(r), tuple(sorted(position[x] for x in r))))

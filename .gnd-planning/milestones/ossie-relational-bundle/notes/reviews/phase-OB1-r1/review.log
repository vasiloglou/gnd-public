"""Approved RF7 accepting/refusing siblings and shared-policy dirty controls."""
from __future__ import annotations

import importlib
import json  # noqa: F401 -- historical compatibility binding
from decimal import Decimal
from io import BytesIO, StringIO

import pytest


def policy():
    return importlib.import_module('gnd.input_policy')


@pytest.mark.parametrize('raw', ['{"x":1,"x":2}', '{"x":NaN}', '[Infinity]', '[1e999]', '[' * 65 + '0' + ']' * 65])
def test_json_refusal(raw):
    with pytest.raises(ValueError):
        policy().loads(raw)


def test_json_acceptance_types_and_custom_hooks():
    p = policy()
    assert p.loads('{"x":1.25,"n":1,"s":"[[["}') == {'x': 1.25, 'n': 1, 's': '[[['}
    assert p.loads('[1e100]', parse_float=Decimal) == [Decimal('1e100')]
    assert p.loads('{"x":1}', object_hook=lambda value: ('object', value)) == ('object', {'x': 1})
    assert p.loads('[' * 64 + '0' + ']' * 64)
    for handle in (BytesIO(b'{"x":1}'), StringIO('{"x":1}')):
        assert p.load(handle) == {'x': 1}
    with pytest.raises(ValueError):
        p.loads('[1e999]', parse_float=Decimal)
    with pytest.raises(ValueError):
        p.loads('{"x":1,"x":2}', object_pairs_hook=lambda items: dict(items))


def test_json_decoder_trailing_and_depth():
    decoder = policy().JSONDecoder()
    assert decoder.raw_decode('{"x":1} trailing') == ({'x': 1}, 7)
    with pytest.raises(ValueError):
        decoder.decode('{"x":1} trailing')
    with pytest.raises(ValueError):
        decoder.raw_decode('[' * 65 + '0' + ']' * 65)


@pytest.mark.parametrize('raw,limits', [
    ('x: &a [1]\ny: *a', {}), ('x: 1', {'max_bytes': 3}),
    ('x: [1, 2]', {'max_events': 3}), ('x: [[1]]', {'max_depth': 2}),
])
def test_yaml_preconstruction_refusal(raw, limits):
    with pytest.raises(ValueError):
        policy().guard_yaml(raw, **limits)


def test_yaml_accepted_quote_and_limits():
    policy().guard_yaml('x: "*alias [["\ny: [1, 2]')


@pytest.mark.parametrize('value', ['2024-02-29T00:00:00Z', '2024-02-29T00:00', '2024-02-29T00:00:00.123456+01:30'])
def test_datetime_accepted(value):
    assert policy().parse_datetime(value).year == 2024


@pytest.mark.parametrize('value', ['20240229T000000', '2024-02-29 00:00:00', '2024-02-29t00:00:00z', '2024-02-29T00:00:00+0130', '2024-02-29T00:00:00+01:99', '2024-02-30T00:00:00Z', '2024-02-29T00:00:00.1234567Z', '２０２４-02-29T00:00:00Z'])
def test_datetime_refusal(value):
    with pytest.raises(ValueError):
        policy().parse_datetime(value)


@pytest.mark.parametrize('raw', ['[12345678]', b'[12345678]', bytearray(b'[12345678]')])
def test_json_byte_cap_before_decode(raw, monkeypatch):
    p = policy()
    monkeypatch.setattr(p, 'MAX_BYTES', 8)
    with pytest.raises(ValueError, match='byte cap'):
        p.loads(raw)
    assert p.loads('[1]') == [1]


def test_stream_read_is_bounded(monkeypatch):
    p = policy()
    monkeypatch.setattr(p, 'MAX_BYTES', 8)
    reads = []

    class Handle:
        def read(self, limit):
            reads.append(limit)
            return b' ' * limit

    with pytest.raises(ValueError, match='byte cap'):
        p.load(Handle())
    assert reads == [9]


def test_native_encoded_bytes_and_custom_refusal():
    p = policy()
    for encoding in ('utf-16', 'utf-32'):
        assert p.loads('{"x":1}'.encode(encoding)) == {'x': 1}

    def refuse(token):
        raise ValueError('caller numeric refusal')

    with pytest.raises(ValueError, match='caller numeric refusal'):
        p.loads('[1e999]', parse_float=refuse)
"""Independently reproduced RF7 review findings and accepting siblings."""
import json

import pytest

from gnd.errors import ModelLoadError
from gnd.model import load_model_bytes
from gnd.model_queries import primitive_for


def shared_ancestor_types():
    types = {name: {'id': name, 'kind': 'value', 'primitive': primitive}
             for name, primitive in [('Q', 'Integer'), ('P', 'String'), ('Z', 'String')]}
    for name, parents in [('X', ['Q']), ('Y', ['P']), ('W', ['Z']),
                          ('A', ['X', 'Y']), ('B', ['X', 'W']), ('R', ['A', 'B'])]:
        types[name] = {'id': name, 'kind': 'entity', 'inherits_reference': True,
                       'subtype_of': parents}
    return types


@pytest.mark.parametrize('variant', ['truthy', 'strict'])
def test_shared_ancestor_cannot_hide_parent_ambiguity(variant):
    types = shared_ancestor_types()
    assert primitive_for('A', types, variant=variant) is None
    assert primitive_for('B', types, variant=variant) is None
    assert primitive_for('R', types, variant=variant) is None
    types['Q']['primitive'] = 'String'
    assert primitive_for('R', types, variant=variant) == 'String'


@pytest.mark.parametrize('token', ['NaN', 'Infinity', '-Infinity', '1e999'])
@pytest.mark.parametrize('source', ['m.orm.yaml', 'm.json'])
def test_json_policy_refusal_does_not_become_yaml_string(token, source):
    raw = ('{"version":1,"model_id":' + token + ',"object_types":[],"fact_types":[]}').encode()
    with pytest.raises(ModelLoadError, match='JSON'):
        load_model_bytes(raw, source=source)
    valid = {'version': 1, 'model_id': 'finite', 'object_types': [], 'fact_types': []}
    assert load_model_bytes(json.dumps(valid).encode(), source=source).model_id == 'finite'


def test_yaml_unquoted_flow_mapping_remains_accepted():
    raw = b'{version: 1, model_id: finite, object_types: [], fact_types: []}'
    assert load_model_bytes(raw, source='m.orm.yaml').model_id == 'finite'


def test_mutating_pairs_hook_cannot_erase_duplicate_evidence():
    from gnd.input_policy import loads

    def clear(items):
        items.clear()
        return {}

    with pytest.raises(ValueError, match='duplicate'):
        loads('{"x":1,"x":2}', object_pairs_hook=clear)
    assert loads('{"x":1}', object_pairs_hook=clear) == {}


def test_sidecar_read_is_bounded_and_maps_cap_error(tmp_path, monkeypatch):
    from io import BytesIO
    from pathlib import Path

    from gnd import input_policy
    from gnd.synth.provenance import SidecarError, read_sidecar

    reads = []

    class Stream(BytesIO):
        def read(self, size=-1):
            reads.append(size)
            return super().read(size)

    monkeypatch.setattr(input_policy, 'MAX_BYTES', 8)
    monkeypatch.setattr(Path, 'open', lambda *args, **kwargs: Stream(b' ' * 100))
    with pytest.raises(SidecarError, match='byte cap'):
        read_sidecar(tmp_path / 'sidecar.json')
    assert reads == [9]


def test_standalone_primitive_shared_ancestor_ambiguity():
    from gnd.export.pyrel_runtime import ModelIndex
    types = shared_ancestor_types()
    index = ModelIndex({'object_types': list(types.values())})
    assert index.primitive('R') is None
    types['Q']['primitive'] = 'String'
    assert ModelIndex({'object_types': list(types.values())}).primitive('R') == 'String'


+
+def test_t11_an_unknown_type_is_kept_and_not_refused(tmp_path):
+    binding = json.loads((corpus.CORPUS / "V1" / "binding.json").read_text(encoding="utf-8"))
+    binding["tables"]["cust"]["columns"]["email_addr"]["sql_type"] = "CITEXT[]"

   121	def _validate(model: dict[str, Any], tmp_path: Path) -> tuple[int, dict[str, Any]]:
   122	    buffer = io.StringIO()
   123	    YAML().dump(model, buffer)
   124	    path = tmp_path / "model.orm.yaml"
   125	    path.write_text(buffer.getvalue(), encoding="utf-8")
   126	    result = run_main(["validate", str(path), "--document", str(DOCUMENT), "--format", "json"])
   127	    return result.returncode, json.loads(result.stdout)

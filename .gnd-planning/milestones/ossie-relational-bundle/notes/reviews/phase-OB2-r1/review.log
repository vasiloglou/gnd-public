   152	            self._primitive[value_type] = primitive_for(value_type, self.objects, variant="strict")
   153	        return self._primitive[value_type]
   154	
   155	    def identity(self, oid: str) -> tuple[str, Any]:
   156	        if oid not in self._identity:
   157	            obj = self.objects.get(oid, {})
   158	            if obj.get("kind") == "value":
   159	                self._identity[oid] = ("value", oid)
   160	            elif (obj.get("reference") or {}).get("mode") == "unit-based":
   161	                self._identity[oid] = ("unit", oid)  # A3: before refscheme
   162	            elif (direct := self.index.reference_value_types().get(oid)) is not None:
   163	                # refscheme's first path, through ModelIndex's documented cache of
   164	                # the same resolver: one walk per model instead of one per entity.
   165	                self._identity[oid] = ("direct", direct)
   166	            else:
   167	                self._identity[oid] = reference_identity(oid, self.model)
   168	        return self._identity[oid]
   169	
   170	    def key(self, oid: str) -> _Key | None:
   171	        """Key columns of an object type, or None when its identification is unmatchable."""
   172	        if oid in self._keys:
   173	            return self._keys[oid]
   174	        self._keys[oid] = None  # a re-entrant request is unmatchable
   175	        kind, payload = self.identity(oid)
   176	        result: _Key | None
   177	        if kind == "value":
   178	            result = _Key([oid], [self.primitive(oid)], [("reference", oid)], [None])
   179	        elif kind == "unit":
   180	            result = _Key([f"{oid}_value"], ["Number"], [("reference", oid)], [None])
   181	        elif kind == "direct":
   182	            result = _Key([str(payload)], [self.primitive(str(payload))], [("reference", oid)], [None])
   183	        elif kind == "composite":
   184	            result = _Key([], [], [], [])
   185	            for entry in payload:
   186	                role, player = str(entry["role"]), str(entry["object_type"])
   187	                origin = (str(entry["fact_type"]), role)
   188	                if self.objects.get(player, {}).get("kind") == "value":
   189	                    result.names.append(role)
   190	                    result.datatypes.append(self.primitive(player))
   191	                    result.origins.append(origin)
   192	                    result.components.append(None)
   193	                    continue
   194	                inner = self.key(player)
   195	                if inner is None:
   196	                    result = None
   197	                    break
   198	                for name, datatype in zip(inner.names, inner.datatypes):
   199	                    result.names.append(f"{role}_{name}")
   200	                    result.datatypes.append(datatype)
   201	                    result.origins.append(origin)
   202	                    result.components.append((role, player))
   203	        else:
   204	            result = None
   205	        self._keys[oid] = result
   206	        return result
   207	
   208	    # -- the effective uniqueness set -----------------------------------------------
   209	
   210	    def effective(self, fact: dict[str, Any]) -> list[tuple[int, tuple[str, ...]]]:
   211	        """(constraint index, role tuple in role order) for the effective uniqueness set.
   212	
   213	        Index -1 marks the implied spanning uniqueness (S1). Duplicates keep the first.
   214	        """
   215	        order = self.roles(fact)
   216	        found: list[tuple[int, tuple[str, ...]]] = []
   217	        for index, constraint in enumerate(fact.get("constraints") or ()):
   218	            if constraint.get("type") != "uniqueness" or constraint.get("scope") == "external":
   219	                continue
   220	            if not _confirmed(constraint):
   221	                continue
   222	            roles = set(ModelIndex.constraint_roles(constraint))
   223	            found.append((index, tuple(r for r in order if r in roles)))
   224	        if not found:
   225	            return [(-1, tuple(order))]
   226	        sets = [set(roles) for _, roles in found]
   227	        kept: list[tuple[int, tuple[str, ...]]] = []
   228	        seen: set[tuple[str, ...]] = set()
   229	        for (index, roles), role_set in zip(found, sets):
   230	            if any(other < role_set for other in sets):
   231	                continue  # implied by a shorter one (plan F9)
   232	            if roles in seen:
   233	                continue
   234	            seen.add(roles)
   235	            kept.append((index, roles))
   236	        return kept
   237	
   238	    # -- placement --------------------------------------------------------------------
   239	
   240	    def players(self, fact: dict[str, Any]) -> dict[str, str]:
   241	        return self.role_players.get(str(fact.get("id")), {})
   242	
   243	    def roles(self, fact: dict[str, Any]) -> list[str]:
   244	        """Role names in declared order."""
   245	        return list(self.players(fact))
   246	
   247	    def owner_of(self, oid: str) -> str:
   248	        """HALPIN absorbs an inheriting subtype into its root supertype's table."""
   249	        if self.variant is not RmapVariant.HALPIN:
   250	            return oid
   251	        seen = set()
   252	        while oid not in seen:
   253	            seen.add(oid)
   254	            obj = self.objects.get(oid, {})
   255	            parents = obj.get("subtype_of") or []
   256	            if not parents or not obj.get("inherits_reference"):
   257	                return oid
   258	            oid = str(parents[0])
   259	        return oid
   260	
   261	    def is_absorbed(self, oid: str) -> bool:
   262	        return self.owner_of(oid) != oid
   263	
   264	    def run(self) -> RelationalSchema:
   265	        derived = set()
   266	        for fact in self.facts:
   267	            fid = str(fact.get("id"))
   268	            if fact.get("derivation") == "derived" and fact.get("storage") in (None, "computed"):
   269	                derived.add(fid)
   270	
   271	        functional_count: dict[str, int] = defaultdict(int)
   272	        effective: dict[str, list[tuple[int, tuple[str, ...]]]] = {}
   273	        for fact in self.facts:
   274	            fid = str(fact.get("id"))
   275	            effective[fid] = self.effective(fact)
   276	            if fid in derived:
   277	                continue
   278	            players = self.players(fact)
   279	            for _, roles in effective[fid]:
   280	                if len(roles) == 1 and len(players) > 1:
   281	                    functional_count[players[roles[0]]] += 1
   282	
   283	        # Composite identification components (rule 2): fact type id -> entity.
   284	        components: dict[str, str] = {}
   285	        for oid, obj in self.objects.items():
   286	            if obj.get("kind") != "entity":
   287	                continue
   288	            kind, payload = self.identity(oid)
   289	            if kind == "composite":
   290	                for entry in payload:
   291	                    components.setdefault(str(entry["fact_type"]), oid)
   292	
   293	        placed: dict[str, _Placed] = {}
   294	        for fact in self.facts:
   295	            fid = str(fact.get("id"))
   296	            if fid in derived:
   297	                continue
   298	            placed[fid] = self.place(fact, effective[fid], components, functional_count)
   299	
   300	        # Which object types get a table (S7, A4, A15).
   301	        tabled: set[str] = set()
   302	        for fid, p in placed.items():
   303	            if p.rule in (1, 2, 3, 4, 5):
   304	                tabled.add(p.owner)
   305	        for oid, obj in self.objects.items():
   306	            if obj.get("kind") == "entity" and obj.get("independent"):
   307	                tabled.add(self.owner_of(oid))
   308	
   309	        return self.build(derived, effective, placed, tabled)
   310	


# What this repository takes from dev-tools: the three milestone-workflow skills,
# delivered to both discovery roots so the copies stay byte-identical.
# `python3 <dev-tools>/devtools/sync.py apply --project .` copies them and
# `... check --project .` confirms them against .devtools-receipt.json.
# The repository's own rules for these skills live in
# <root>/skills/process-phase/references/project.md, which the sync never writes.

[[sync]]
source = "skills/milestone/process-milestone"
dest = ".claude/skills/process-milestone"
values = { planning_dir = ".gnd-planning" }

[[sync]]
source = "skills/milestone/process-milestone"
dest = ".codex/skills/process-milestone"
values = { planning_dir = ".gnd-planning" }

[[sync]]
source = "skills/milestone/process-phase"
dest = ".claude/skills/process-phase"
values = { planning_dir = ".gnd-planning" }

[[sync]]
source = "skills/milestone/process-phase"
dest = ".codex/skills/process-phase"
values = { planning_dir = ".gnd-planning" }

[[sync]]
source = "skills/milestone/start-milestone"
dest = ".claude/skills/start-milestone"
values = { planning_dir = ".gnd-planning" }

[[sync]]
source = "skills/milestone/start-milestone"
dest = ".codex/skills/start-milestone"
values = { planning_dir = ".gnd-planning" }

# handle-issue triages, reproduces and routes a GitHub issue, delivered to both roots.
[[sync]]
source = "skills/handle-issue"
dest = ".claude/skills/handle-issue"

[[sync]]
source = "skills/handle-issue"
dest = ".codex/skills/handle-issue"

# dev-handoff writes a branch's hand-off note in .gnd-planning/handoffs/ when work moves
# to another assistant, account or machine; dev-takeover is the receiving side and runs
# dev-handoff's script. Both go to both discovery roots, with the same settings.
[[sync]]
source = "skills/dev-handoff"
dest = ".claude/skills/dev-handoff"

[sync.settings."scripts/handoff.settings.json"]
planning_dir = ".gnd-planning"
base_branch = "main"
max_mb = 200
rebuild_paths = []
tools = ["git", "gh", "uv"]
env_paths = [".venv"]
setup_command = "uv sync --locked --group dev"
key_files = []

[[sync]]
source = "skills/dev-takeover"
dest = ".claude/skills/dev-takeover"

[[sync]]
source = "skills/dev-handoff"
dest = ".codex/skills/dev-handoff"

[sync.settings."scripts/handoff.settings.json"]
planning_dir = ".gnd-planning"
base_branch = "main"
max_mb = 200
rebuild_paths = []
tools = ["git", "gh", "uv"]
env_paths = [".venv"]
setup_command = "uv sync --locked --group dev"
key_files = []

[[sync]]
source = "skills/dev-takeover"
dest = ".codex/skills/dev-takeover"

# The component index: the skill in both discovery roots, and the script that builds it.
[[sync]]
source = "skills/components"
dest = ".claude/skills/components"
exclude = ["scripts/components_index.py"]

[[sync]]
source = "skills/components"
dest = ".codex/skills/components"
exclude = ["scripts/components_index.py"]

[[sync]]
source = "skills/components/scripts/components_index.py"
dest = "scripts/components_index.py"

[sync.settings."components_index.settings.json"]
package_dir = "src/gnd"
import_prefix = "gnd"
extra_source_dirs = ["tools"]
docs_dir = "dev/components"
script_path = "scripts/components_index.py"
verb_list = "shared"

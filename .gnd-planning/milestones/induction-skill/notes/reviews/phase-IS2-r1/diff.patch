t\n\nnew_text = json.dumps(model, separators=(\",\", \":\"), ensure_ascii=False) + \"\\n\"\nnew_digest = hashlib.sha256(new_text.encode(\"utf-8\")).hexdigest()\nprint(\"dropped from candidate:\", len(dropped), sorted(dropped))\n\nproposal[\"candidate_model\"][\"text\"] = new_text\nproposal[\"candidate_model\"][\"sha256\"] = new_digest\nproposal[\"operations\"] = [op for op in proposal[\"operations\"] if op[\"operation_id\"] in KEEP_OPS]\nproposal[\"rationale\"] = \"gnd discover, refund-level subset of 10 candidates observed in south.yaml (customer-level and amount-level candidates dropped by owner choice)\"\n\nwith open(DST, \"w\", encoding=\"utf-8\") as fh:\n    json.dump(proposal, fh, indent=2, ensure_ascii=False)\n    fh.write(\"\\n\")\n\nprint(\"kept operations:\", [op[\"operation_id\"] for op in proposal[\"operations\"]])\nprint(\"new candidate sha256:\", new_digest)\n"}, "caller": {"type": "direct"}}]}}

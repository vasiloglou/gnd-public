+{"role":"tool","tool_call_id":"tool_aeOzabAm04sbakFGSYlvPH8H","content":"1\t\"\"\"LH2: replay of a caller run from its folder and the caller's root.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport json\n5\timport shutil\n6\timport time\n7\t\n8\timport pytest\n9\tfrom test_lh1_reading_host import (\n10\t    ANSWERS,\n11\t    CALLER,\n12\t    Empty,\n13\t    Producer,\n14\t    Reviewer,\n15\t    _edit,\n16\t    _files,\n17\t    _root,\n18\t    _wide_root,\n19\t)\n20\t\n21\tfrom gnd.artifacts import ArtifactError, canonical_json_bytes, sha256_hex\n22\tfrom gnd.examples.literature import reading\n23\tfrom gnd.examples.literature.assurance_report import score_reading_coverage\n24\tfrom gnd.examples.literature.reading import ReadingLimits\n25\t\n26\t\n27\tdef _same(report, replayed):\n28\t    assert replayed[\"producer_calls\"] == {\"broad-extraction\": 0, \"targeted-extraction\": 0}\n29\t    assert {k: v for k, v in replayed.items() if k != \"producer_calls\"} == {\n30\t        k: v for k, v in report.items() if k != \"producer_calls\"}\n31\t\n32\t\n33\tdef _rewrite(run, name, change):\n34\t    \"\"\"Change one file of a run and re-pin it in the manifest, leaving the rest as it is.\"\"\"\n35\t    path = run / name\n36\t    path.write_bytes(change(path.read_bytes()))\n37\t    manifest = json.loads((run / \"run.json\").read_bytes())\n38\t    manifest[\"artifacts\"][name] = sha256_hex(path.read_bytes())\n39\t    (run / \"run.json\").write_bytes(canonical_json_bytes(manifest))\n40\t\n41\t\n42\tdef _manifest(run, change):\n43\t    manifest = json.loads((run / \"run.json\").read_bytes())\n44\t    change(manifest)\n45\t    (run / \"run.json\").write_bytes(canonical_json_bytes(manifest))\n46\t\n47\t\n48\t@pytest.fixture(scope=\"module\")\n49\tdef plain(tmp_path_factory):\n50\t    out = tmp_path_factory.mktemp(\"lh2\") / \"run\"\n51\t    return out, reading.run(out, fixture=CALLER, producer=Producer())\n52\t\n53\t\n54\t@pytest.fixture(scope=\"module\")\n55\tdef declared(tmp_path_factory):\n56\t    base = tmp_path_factory.mktemp(\"lh2-declared\")\n57\t    root = _root(base, declared=True)\n58\t    out = base / \"run\"\n59\t    return root, out, reading.run(out, fixture=root, producer=Producer(), reviewer=Reviewer())\n60\t\n61\t\n62\tdef _copy(run, tmp_path, name=\"copy\"):\n63\t    target = tmp_path / name\n64\t    shutil.copytree(run, target)\n65\t    return target\n66\t\n67\t\n68\tdef test_t1_a_caller_run_replays_with_no_calls(plain, declared):\n69\t    out, report = plain\n70\t    before = _files(out)\n71\t    _same(report, reading.replay(out, fixture=CALLER, expected_evidence_sha256=report[\"evidence_sha256\"]))\n72\t    assert _files(out) == before\n73\t    root, run, report = declared\n74\t    _same(report, reading.replay(run, fixture=root))\n75\t    assert json.loads((run / \"run.json\").read_bytes())[\"settings\"][\"reviewer\"] == \"live\"\n76\t\n77\t\n78\t@pytest.mark.parametrize((\"name\", \"old\", \"new\"), [\n79\t    (\"producer-output-table.json\", b\"Graph sampling\", b\"Graph Sampling\"),\n80\t    (\"reviews.json\", b\"the excerpt states\", b\"the excerpt States\"),\n81\t])\n82\tdef test_t2_one_changed_byte_refuses(declared, tmp_path, name, old, new):\n83\t    root, run, _ = declared\n84\t    copy = _copy(run, tmp_path)\n85\t    _rewrite(copy, name, lambda raw: raw.replace(old, new, 1))\n86\t    with pytest.raises(reading.ExampleError):\n87\t        reading.replay(copy, fixture=root)\n88\t\n89\t\n90\tdef test_t2_a_consistent_rewrite_needs_the_expected_digest(plain, tmp_path):\n91\t    _, report = plain\n92\t    answers = {**ANSWERS, \"a-results\": {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []}}\n93\t    other = tmp_path / \"other\"\n94\t    reading.run(other, fixture=CALLER, producer=Producer(answers))\n95\t    reading.replay(other, fixture=CALLER)\n96\t    with pytest.raises(reading.ExampleError, match=\"expected digest\"):\n97\t        reading.replay(other, fixture=CALLER, expected_evidence_sha256=report[\"evidence_sha256\"])\n98\t\n99\t\n100\tdef test_t3_non_default_limits_replay_with_them(tmp_path):\n101\t    limits = ReadingLimits(roster=64, input_bytes=1 << 20, response_bytes=64 * 1024)\n102\t    out = tmp_path / \"run\"\n103\t    report = reading.run(out, fixture=CALLER, producer=Producer(), limits=limits, document_budget=200)\n104\t    replayed = reading.replay(out, fixture=CALLER)\n105\t    _same(report, replayed)\n106\t    assert replayed[\"settings\"][\"limits\"][\"roster\"] == 64\n107\t    assert replayed[\"settings\"][\"document_budget_bytes\"] == 200\n108\t\n109\t\n110\tdef test_t3_the_response_ceiling_run_replays_in_time(tmp_path):\n111\t    root = _wide_root(tmp_path, 9)\n112\t    padding = [\"k\" * 1000] * ((1 << 20) // 1003 - 2)\n113\t\n114\t    class Padded:\n115\t        def produce(self, call):\n116\t            return {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": padding}\n117\t\n118\t    out = tmp_path / \"run\"\n119\t    report = reading.run(out, fixture=root, producer=Padded(), limits=ReadingLimits(response_bytes=1 << 20))\n120\t    started = time.monotonic()\n121\t    replayed = reading.replay(out, fixture=root)\n122\t    assert time.monotonic() - started < 60\n123\t    assert replayed[\"evidence_sha256\"] == report[\"evidence_sha256\"]\n124\t\n125\t\n126\tdef test_t3_a_setting_above_its_ceiling_refuses(plain, tmp_path):\n127\t    out, _ = plain\n128\t    copy = _copy(out, tmp_path)\n129\t    _manifest(copy, lambda manifest: manifest[\"settings\"][\"limits\"].update(route_seconds=601))\n130\t    with pytest.raises(reading.ExampleError, match=\"route_seconds\"):\n131\t        reading.replay(copy, fixture=CALLER)\n132\t\n133\t\n134\tdef _repin_source(root):\n135\t    path = root / \"survey-a.txt\"\n136\t    path.write_bytes(path.read_bytes() + b\"Appendix.\\n\")\n137\t    _edit(root, \"roster.json\", lambda roster: roster[\"sources\"][0].update(sha256=sha256_hex(path.read_bytes())))\n138\t\n139\t\n140\t@pytest.mark.parametrize(\"change\", [\"source\", \"profile\", \"model\", \"include\"])\n141\tdef test_t4_a_changed_input_refuses(plain, tmp_path, change):\n142\t    out, _ = plain\n143\t    root = _root(tmp_path)\n144\t    if change == \"source\":\n145\t        _repin_source(root)\n146\t    elif change == \"profile\":\n147\t        _edit(root, \"profile.json\", lambda profile: profile.update(producer_label=\"host-extractor-2\"))\n148\t    else:\n149\t        name = \"survey.orm.json\" if change == \"model\" else \"terms.orm.json\"\n150\t        (root / name).write_bytes((root / name).read_bytes() + b\"\\n\")\n151\t    with pytest.raises(reading.ExampleError, match=\"stale reading input\"):\n152\t        reading.replay(out, fixture=root)\n153\t\n154\t\n155\tdef test_t6_the_scorer_scores_a_caller_run(plain):\n156\t    out, report = plain\n157\t    score = score_reading_coverage(out, report[\"coverage\"], fixture=CALLER)\n158\t    assert score[\"status\"] == \"pass\"\n159\t    assert score_reading_coverage(out, report[\"coverage\"])[\"status\"] != \"pass\"\n160\t\n161\t\n162\tdef test_t7_steps_that_differ_from_the_profile_refuse(declared, tmp_path):\n163\t    root, run, _ = declared\n164\t    copy = _copy(run, tmp_path)\n165\t\n166\t    def skip(manifest):\n167\t        manifest[\"steps\"][\"calibration\"] = \"skipped\"\n168\t        manifest[\"steps\"][\"absence\"] = \"skipped\"\n169\t        for name in (\"fidelity-high.json\", \"fidelity-low.json\", \"scope.json\", \"closure.json\"):\n170\t            del manifest[\"artifacts\"][name]\n171\t\n172\t    _manifest(copy, skip)\n173\t    with pytest.raises(reading.ExampleError, match=\"reading steps differ from the profile\"):\n174\t        reading.replay(copy, fixture=root)\n175\t\n176\t\n177\tdef test_t8_each_run_replays_only_against_its_own_kind_of_root(plain, tmp_path):\n178\t    out, _ = plain\n179\t    with pytest.raises(reading.ExampleError, match=\"a caller run replays against its own root\"):\n180\t        reading.replay(out)\n181\t    packaged = tmp_path / \"packaged\"\n182\t    reading.run(packaged)\n183\t    with pytest.raises(reading.ExampleError, match=\"a packaged run replays against the packaged root\"):\n184\t        reading.replay(packaged, fixture=CALLER)\n185\t\n186\t\n187\tMANIFEST_DEFECTS = {\n188\t    \"settings-key-missing\": lambda m: m[\"settings\"].pop(\"unavailable\"),\n189\t    \"settings-extra-key\": lambda m: m[\"settings\"].update(stop=\"never\"),\n190\t    \"retained-null\": lambda m: m[\"settings\"][\"limits\"].update(retained_bytes=None),\n191\t    \"limit-bool\": lambda m: m[\"settings\"][\"limits\"].update(roster=True),\n192\t    \"step-maybe\": lambda m: m[\"steps\"].update(review=\"maybe\"),\n193\t    \"roster-without-reviews\": lambda m: m[\"artifacts\"].pop(\"reviews.json\"),\n194\t}\n195\t\n196\t\n197\t@pytest.mark.parametrize(\"case\", [*sorted(MANIFEST_DEFECTS), \"not-canonical\"])\n198\tdef test_t9_a_malformed_manifest_refuses_before_any_run_file(declared, tmp_path, monkeypatch, case):\n199\t    root, run, _ = declared\n200\t    copy = _copy(run, tmp_path)\n201\t    if case == \"not-canonical\":\n202\t        (copy / \"run.json\").write_bytes((copy / \"run.json\").read_bytes() + b\" \")\n203\t    else:\n204\t        _manifest(copy, MANIFEST_DEFECTS[case])\n205\t    monkeypatch.setattr(reading, \"_read_run_file\", lambda *_: pytest.fail(\"read a run file\"))\n206\t    with pytest.raises((reading.ExampleError, ArtifactError)):\n207\t        reading.replay(copy, fixture=root)\n208\t\n209\t\n210\tdef test_t9_the_run_files_are_read_under_the_recorded_cap(plain, tmp_path, monkeypatch):\n211\t    out, report = plain\n212\t    seen = []\n213\t    original = reading._read_run_file\n214\t\n215\t    def recording(folder, name, max_bytes):\n216\t        seen.append(max_bytes)\n217\t        return original(folder, name, max_bytes)\n218\t\n219\t    monkeypatch.setattr(reading, \"_read_run_file\", recording)\n220\t    reading.replay(out, fixture=CALLER)\n221\t    assert seen and set(seen) == {report[\"settings\"][\"limits\"][\"retained_bytes\"]}\n222\t\n223\t\n224\tdef test_t9_a_saved_run_replays(tmp_path):\n225\t    root = _root(tmp_path)\n226\t    raw = canonical_json_bytes(ANSWERS)\n227\t    (root / \"responses.json\").write_bytes(raw)\n228\t    (root / \"producer-pin.json\").write_bytes(canonical_json_bytes({\"sha256\": sha256_hex(raw)}))\n229\t    out = tmp_path / \"run\"\n230\t    report = reading.run(out, fixture=root)\n231\t    _same(report, reading.replay(out, fixture=root))\n232\t\n233\t\n234\tdef test_t9_an_empty_live_run_replays(tmp_path):\n235\t    out = tmp_path / \"run\"\n236\t    report = reading.run(out, fixture=CALLER, producer=Empty())\n237\t    _same(report, reading.replay(out, fixture=CALLER))\n238\t\n239\t\n240\tdef test_r1_a_receipt_at_the_response_cap_replays(tmp_path):\n241\t    root = _root(tmp_path, profile=_profile_review())\n242\t    filler = 512 - len(canonical_json_bytes({\"basis\": \"\", \"decision\": \"supported\"}))\n243\t\n244\t    class Full:\n245\t        def review(self, call):\n246\t            return {\"decision\": \"supported\", \"basis\": \"b\" * filler}\n247\t\n248\t    limits = ReadingLimits(response_bytes=512)\n249\t    answers = {name: {\"outcome\": \"empty\", \"facts\": {}, \"proposal_keys\": []} for name in ANSWERS}\n250\t    answers[\"a-opening\"] = {\"outcome\": \"accepted\", \"proposal_keys\": [],\n251\t                            \"facts\": {\"paper_title\": [{\"paper\": \"p\", \"title\": \"t\"}]}}\n252\t    out = tmp_path / \"run\"\n253\t    try:\n254\t        report = reading.run(out, fixture=root, producer=Producer(answers), reviewer=Full(), limits=limits)\n255\t    except reading.ExampleError:\n256\t        assert not out.exists()\n257\t        return\n258\t    _same(report, reading.replay(out, fixture=root))\n259\t\n260\t\n261\tdef _profile_review():\n262\t    value = json.loads((CALLER / \"profile.json\").read_bytes())\n263\t    value[\"review\"] = True\n264\t    return value\n265\t\n266\t\n267\t@pytest.mark.parametrize(\"change\", [{\"budget_bytes\": True}, {\"scenario\": \"unavailable\"}])\n268\tdef test_r2_top_level_settings_refuse_before_any_run_file(plain, tmp_path, monkeypatch, change):\n269\t    out, _ = plain\n270\t    copy = _copy(out, tmp_path)\n271\t    _manifest(copy, lambda manifest: manifest.update(change))\n272\t    monkeypatch.setattr(reading, \"_read_run_file\", lambda *_: pytest.fail(\"read a run file\"))\n273\t    with pytest.raises(reading.ExampleError):\n274\t        reading.replay(copy, fixture=CALLER)\n275\t\n276\t\n277\tdef _rechain(run, name, raw):\n278\t    \"\"\"Replace one payload and re-pin it through the stage chain and the manifest.\"\"\"\n279\t    (run / name).write_bytes(raw)\n280\t    manifest = json.loads((run / \"run.json\").read_bytes())\n281\t    manifest[\"artifacts\"][name] = sha256_hex(raw)\n282\t    predecessor = None\n283\t    for index in range(6):\n284\t        stage = json.loads((run / f\"stage-{index}.json\").read_bytes())\n285\t        stage[\"predecessor_sha256\"] = predecessor\n286\t        stage[\"payload_sha256\"] = manifest[\"artifacts\"][f\"payload-{index}.json\"]\n287\t        stage_raw = canonical_json_bytes(stage)\n288\t        (run / f\"stage-{index}.json\").write_bytes(stage_raw)\n289\t        manifest[\"artifacts\"][f\"stage-{index}.json\"] = predecessor = sha256_hex(stage_raw)\n290\t    (run / \"run.json\").write_bytes(canonical_json_bytes(manifest))\n291\t\n292\t\n293\t@pytest.mark.parametrize(\"payload\", [{}, {\"attempts\": [1]}, {\"attempts\": [{\"section\": \"a-opening\"}]}])\n294\tdef test_r3_a_malformed_retained_payload_refuses(plain, tmp_path, payload):\n295\t    out, _ = plain\n296\t    copy = _copy(out, tmp_path)\n297\t    _rechain(copy, \"payload-1.json\", canonical_json_bytes(payload))\n298\t    with pytest.raises((reading.ExampleError, ArtifactError)):\n299\t        reading.replay(copy, fixture=CALLER)"}

class ModelIdentityLocator(_ClosedFrozenModel):
    """The atomic top-level ``version``/``model_id`` identity pair."""

    locator_kind: Literal["model-identity"] = "model-identity"

    def reference(self) -> str:
        return "model.identity"


class SourceDocumentLocator(_ClosedFrozenModel):
    """One declared ``source.documents`` entry of an unattended model, by its digest (UG3).

    Admitted in proposal ``schema_version`` 3 only: the v1 and v2 graphs are
    frozen, so a v1 or v2 proposal that carries it is refused when it is read."""

    locator_kind: Literal["source-document"] = "source-document"
    sha256: Sha256String

    def reference(self) -> str:
        return f"source.documents[{self.sha256}]"


StableLocator = ElementLocator | RoleLocator | ConstraintLocator | ModelIdentityLocator | SourceDocumentLocator | IncludeLocator

_SOURCE_DOCUMENT_KEYS = frozenset({"sha256", "label"})


def _refuse_source_documents_before_v3(
    schema_version: int, operations: tuple[Any, ...], label: str
) -> None:
    """UG3-D10 (a): the v1 and v2 graphs are frozen, so every reader of an outer
    document that carries operations (a proposal, a record) refuses the locator
    below version 3 when it is read, before any version gate (exit 3)."""
    if schema_version != EVOLUTION_SCHEMA_VERSION and any(
        isinstance(item.locator, SourceDocumentLocator) for item in operations
    ):
        raise ValueError(
            f"source-document operations require {label} schema_version {EVOLUTION_SCHEMA_VERSION}"
        )


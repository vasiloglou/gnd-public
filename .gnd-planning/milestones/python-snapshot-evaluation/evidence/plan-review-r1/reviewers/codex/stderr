   238	        raise ReceiptRefused("foreign")
   239	    if not isinstance(model, Model) or not isinstance(pre, Population):
   240	        raise ReceiptRefused("path-inputs")
   241	    if not receipt.reusable:
   242	        raise ReceiptRefused("not-reusable")
   243	    if references is not None or receipt.options != ():
   244	        raise ReceiptRefused("options")
   245	    if model is not receipt.model:

parser = parsers.get('verify_parser')\n84\t    if args.command == \"verify\":\n85\t        if args.no_extraction and args.sidecar is not None:\n86\t            # A usage contradiction, not a verdict: --sidecar names a handoff\n87\t            # to validate while --no-extraction opts out of extraction\n88\t            # entirely. Routed through the parser so it exits 64 with no\n89\t            # payload, exactly like every other malformed invocation (WR-03).\n90\t            verify_parser.error(\n91\t                \"--sidecar and --no-extraction are contradictory: --sidecar \"\n92\t                \"names an extraction handoff to validate, --no-extraction \"\n93\t                \"declares there was none\"\n94\t            )\n95\t        return _handler_export_verification_service._cmd_verify(\n96\t            args.model,\n97\t            args.population,\n98\t            args.sidecar,\n99\t            args.artifacts,\n100\t            args.no_extraction,"}

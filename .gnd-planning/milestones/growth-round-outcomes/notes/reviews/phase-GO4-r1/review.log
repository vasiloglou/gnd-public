   173	def _subset(before: Any, after: Any) -> str:
   174	    # The proposal reader freezes operation dicts, so lists arrive as tuples.
   175	    if not (isinstance(before, (list, tuple)) and isinstance(after, (list, tuple))):
   176	        return _NEITHER
   177	    try:
   178	        left, right = set(before), set(after)
   179	    except TypeError:
   180	        return _NEITHER
   181	    if right < left:
   182	        return _STRENGTHENING
   183	    if right > left:
   184	        return _WEAKENING
   185	    return _NEITHER

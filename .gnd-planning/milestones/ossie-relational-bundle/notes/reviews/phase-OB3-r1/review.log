def _relationship(fact, names, order, role_types):
    by_role = {role: names[object_type] for role, object_type in role_types.items()}
    first, *additional = order
    roles = [{"concept": by_role[role], "name": role} for role in additional]
    tokens = {first: "{" + by_role[first] + "}"}
    tokens.update({role: f"{{{by_role[role]}:{role}}}" for role in additional})
    readings, inverse = _verbalizes(fact, tokens, role_types)
    result = {"name": fact["id"], "verbalizes": readings}
    if roles:
        result["roles"] = roles
    return result, inverse


def _add_references(objects, components, names, functional_links, constraints, mapped, indexes, identification):
    # Pre-index composite UC candidates by their shared identifying entity.
    composite = {}
    for i, constraint in enumerate(constraints):
        if (
            constraint.get("type") != "uniqueness"
            or constraint.get("scope") != "external"
            or constraint.get("modality") != "alethic"
            or constraint.get("status") != "confirmed"
        ):
            continue
        links = []
        entity = None
        for ref in constraint.get("role_refs", ()):
            fact_id = ref["fact_type"]
            link = functional_links.get(fact_id)
            if link is None:
                break
            owner, dependent_role = link
            if dependent_role != ref["role"]:
                break
            if entity is not None and owner != entity:
                break
            entity = owner
            links.append(fact_id)
        else:
            if entity is not None and links:
                priority = bool(constraint.get("preferred"))
                previous = composite.get(entity)
                if previous is None or (priority and not previous[0]):
                    composite[entity] = (priority, i, links)

    for oid, obj in objects.items():
        ref = obj.get("reference") or {}
        component = components[oid]
        mode = ref.get("mode")
        path = ("object_types", indexes[oid], "reference")
        if mode in {"popular", "general"}:
            value_type = ref["value_type"]
            rels = component.setdefault("relationships", [])
            used = {r["name"] for r in rels}
            key = "gnd_reference"
            while key in used:
                key = "_" + key
            rels.append(
                {
                    "name": key,
                    "roles": [{"concept": names[value_type]}],
                    "verbalizes": [f"{{{names[oid]}}} is identified by {{{names[value_type]}}}"],
                    "multiplicity": "OneToOne",
                }
            )
            component["identify_by"] = [key]
            identification[oid] = ("simple", key)
            mapped[path] = _NATIVE_LITERAL
            mapped[(*path, "value_type")] = _NATIVE_LITERAL
        elif mode == "external" and oid in composite:
            _, index, links = composite[oid]
            component["identify_by"] = links
            identification[oid] = ("composite", tuple(links))
            mapped[path] = _NATIVE_LITERAL
            mapped[("constraints", index)] = _NATIVE_LITERAL


def _inherit_identifiers(objects, components, indexes, mapped, identification):
    parents = {oid: tuple(obj.get("subtype_of") or ()) for oid, obj in objects.items()}
    try:
        order = list(TopologicalSorter(parents).static_order())
    except CycleError as error:
        raise OssieInputError("ossie:cyclic-subtypes") from error
    direct = {
        oid
        for oid, obj in objects.items()
        if (obj.get("reference") or {}).get("mode") in {"popular", "general"}
    }
    for oid in order:
        if not objects[oid].get("inherits_reference") or len(parents[oid]) != 1:
            continue
        parent = parents[oid][0]
        if parent not in direct:
            continue
        child = components[oid]
        inherited = components[parent]["identify_by"]
        own_names = {relationship["name"] for relationship in child.get("relationships", ())}
        if inherited and not child.get("identify_by") and own_names.isdisjoint(inherited):
            child["identify_by"] = list(inherited)
            identification[oid] = identification[parent]
            direct.add(oid)
            mapped[("object_types", indexes[oid], "inherits_reference")] = _NATIVE_LITERAL


def _ontology(document, model):
    ontology, mapped, _view = _project(document, model)
    return ontology, mapped


def _project(document, model):
    """The ontology, its loss dispositions, and the view the relational mapping reads."""
    index = ModelIndex.for_model(model)
    objects = index.object_types_by_id()
    # Role name -> object type per fact type, in declared role order.
    role_types_by_fact = index.role_object_types()
    fact_types = list(index.iter_fact_types())
    names = _names(objects)
    if not names:
        raise OssieInputError("an Ossie ontology requires at least one concept")
    indexes = {obj["id"]: i for i, obj in enumerate(document.get("object_types", ()))}
    components = {}
    mapped = {}
    for oid, i in indexes.items():
        obj = objects[oid]
        component = {
            "concept": names[oid],
            "type": "EntityType" if obj["kind"] == "entity" else "ValueType",
        }
        source = ("object_types", i)
        target = ("ontology", i)
        mapped[source] = _NATIVE_LITERAL
        mapped[(*source, "kind")] = _NATIVE_LITERAL
        if names[oid] == obj.get("name"):
            mapped[(*source, "name")] = _copy((*target, "concept"))
        parents = obj.get("subtype_of") or ()
        if parents:
            component["extends"] = [names[parent] for parent in parents]
            mapped[(*source, "subtype_of")] = _NATIVE_LITERAL
            for index in range(len(parents)):
                mapped[(*source, "subtype_of", index)] = _NATIVE_LITERAL
        primitive = obj.get("primitive")
        if primitive and not parents:
            base = {"Duration": "Integer", "Number": "Decimal"}.get(primitive, primitive)
            if base in _BUILTINS:
                component["extends"] = [base]
                if primitive == base:
                    mapped[(*source, "primitive")] = _copy((*target, "extends", 0))
        if obj.get("description"):
            component["description"] = obj["description"]["summary"]
            mapped[(*source, "description", "summary")] = _copy((*target, "description"))
        components[oid] = component

    functional_links = {}
    projected_relations = {}
    identification = {}
    relations = {}
    for i, fact in enumerate(fact_types):
        role_types = role_types_by_fact[fact["id"]]
        order, multiplicity, constraints = _role_order(fact, role_types)
        owner = role_types[order[0]]
        relationship, inverse = _relationship(fact, names, order, role_types)
        if multiplicity:
            relationship["multiplicity"] = multiplicity
        rels = components[owner].setdefault("relationships", [])
        target = ("ontology", indexes[owner], "relationships", len(rels))
        rels.append(relationship)
        projected_relations[fact["id"]] = ProjectedRelation(
            names[owner],
            tuple(role_types),
            order,
            dict(role_types),
            relationship,
        )
        relations[fact["id"]] = (owner, tuple(order), dict(role_types))
        source = ("fact_types", i)
        for path in (source, (*source, "reading"), (*source, "roles")):
            mapped[path] = _NATIVE_LITERAL
        mapped[(*source, "id")] = _copy((*target, "name"))
        if inverse:
            mapped[(*source, "inverse_reading")] = _NATIVE_LITERAL
        role_positions = {role: index for index, role in enumerate(order)}
        for j, role_name in enumerate(role_types):
            projected_index = role_positions[role_name]
            path = (*source, "roles", j)
            mapped[path] = _NATIVE_LITERAL
            mapped[(*path, "object_type")] = _NATIVE_LITERAL
            if projected_index:
                mapped[(*path, "role_name")] = _copy(
                    (*target, "roles", projected_index - 1, "name")
                )
        for j in constraints:
            cpath = (*source, "constraints", j)
            constraint = fact["constraints"][j]
            for path in (cpath, (*cpath, "type"), (*cpath, "roles"), (*cpath, "scope")):
                mapped[path] = _NATIVE_LITERAL
            for k in range(len(ModelIndex.constraint_roles(constraint))):
                mapped[(*cpath, "roles", k)] = _NATIVE_LITERAL
        if len(order) == 2 and multiplicity:
            functional_links[fact["id"]] = (owner, order[1])
    _add_references(
        objects,
        components,
        names,
        functional_links,
        document.get("constraints", ()),
        mapped,
        indexes,
        identification,
    )

    _inherit_identifiers(objects, components, indexes, mapped, identification)

    ontology = {
        "version": _VERSION,
        "name": document.get("model_id") or "gnd_model",
        "ontology": list(components.values()),
    }
    if document.get("model_id"):
        mapped[("model_id",)] = _copy(("name",))
    place_formulas(document, ontology, components, projected_relations, mapped, fact_types)
    view = OntologyView(
        name=ontology["name"],
        concepts={oid: names[oid] for oid in components},
        kinds={oid: objects[oid]["kind"] for oid in components},
        identification=identification,
        relations=relations,
    )
    return ontology, mapped, view


def _metadata(document, mapped):
    rows = []
    elements = defaultdict(dict)
    refused = False

def _encode(document, output_format: str) -> bytes:
    """One Ossie document in the run's format; every exported document uses this."""
    if output_format == "json":
        return canonical_json_bytes(document)
    if output_format == "yaml":
        yaml = YAML(typ="safe", pure=True)
        yaml.version = (1, 1)
        yaml.default_flow_style = False
        yaml.sort_base_mapping_type_on_output = False
        stream = StringIO()
        yaml.dump(document, stream)
        return stream.getvalue().encode("utf-8")
    raise OssieInputError("unsupported Ossie output format")


def _relational(model, view, data: bytes, identity: str, *, output_format: str, document_name: str):
    """The semantic model and mapping for the ontology bytes ``data`` (OB3)."""
    schema = map_model(model, variant=RmapVariant.HALPIN)  # D5
    if not schema.tables:
        # The pinned core-spec requires at least one dataset. A model that maps to no
        # table has no relational files; the run then writes the ontology's three.
        return None, None
    semantic_name = f"{view.name}_relational"
    semantic_file = f"{document_name}.semantic_model.{output_format}"
    semantic = build_semantic_model(schema, semantic_name)
    semantic_bytes = _encode(semantic, output_format)
    mapping = build_mapping(
        schema,
        dispositions(model, schema),
        view,
        name=f"{view.name}_mapping",
        ontology_iri=f"./{document_name}",
        semantic_model_name=semantic_name,
        semantic_model_iri=f"./{semantic_file}",
        bindings={
            "model_identity": identity,
            "ontology_sha256": hashlib.sha256(data).hexdigest(),
            "semantic_model_sha256": hashlib.sha256(semantic_bytes).hexdigest(),
        },
    )
    validate_relational(semantic, mapping)
    return semantic_bytes, _encode(mapping, output_format)


def render_ossie(
    model_path: Path,
    *,
    output_format: str,
    strict: bool = False,
    max_output_bytes: int = DEFAULT_MAX_OUTPUT_BYTES,
    relational: bool = True,
    document_name: str | None = None,
) -> OssieArtifacts:
    """Render the deterministic artifacts of one bounded, admitted model read.

    The ontology, its sidecar and its loss report always. With ``relational``, also
    the semantic model and the mapping; ``document_name`` is the file name the
    ontology will have, which the mapping's references are built from (default
    ``ontology.<format>``).

    Every artifact must fit in ``max_output_bytes``; otherwise the whole export is
    refused with ``ossie:output-size`` and nothing is returned to publish.
    """
    require_byte_bound("max_output_bytes", max_output_bytes)
    document, model = _read_model(model_path)
    ontology, mapped, view = _project(document, model)
    _schema().validate(ontology)
    incompatible = {}
    for index, constraint in enumerate(document.get("constraints", ())):
        reason = guarded_clause_refusal(constraint)
        if reason is not None:
            incompatible[("constraints", index)] = reason
    for index, fact in enumerate(ModelIndex(None, document).iter_fact_types_shared()):
        if any(
            where_uses_membership(clause.get("where"))
            for clause in iter_derivation_clauses(fact.get("derivation_rule"))
        ):
            incompatible[("fact_types", index, "derivation_rule")] = "membership-unsupported"
    mapped.update((path, ("extension", reason, None)) for path, reason in incompatible.items())
    rows, elements, refused = _metadata(document, mapped)
    if strict and refused:
        raise OssieInputError(_POPULATION_REFUSAL)
    if strict and incompatible:
        raise OssieInputError(next(iter(incompatible.values())))
    data = _encode(ontology, output_format)
    try:
        identity = model_identity(model)
        binding = {"model_identity": identity, "document_sha256": hashlib.sha256(data).hexdigest()}
        report = canonical_json_bytes(
            {"schema": "gnd-ossie-loss/1", **binding, "dispositions": rows}
        )
        sidecar = canonical_json_bytes(
            {"schema": "gnd-ossie-sidecar/1", **binding, "elements": elements}
        )
    except (ModelIdentityError, UnicodeEncodeError, ValueError) as error:
        raise OssieInputError("model has no encodable interchange identity") from error
    semantic_model = mapping = None
    if relational:
        semantic_model, mapping = _relational(
            model, view, data, identity,
            output_format=output_format, document_name=document_name or f"ontology.{output_format}",
        )
    artifacts = (data, sidecar, report, semantic_model, mapping)
    if max(len(artifact) for artifact in artifacts if artifact is not None) > max_output_bytes:
        raise OssieInputError("ossie:output-size")
    from gnd.redaction import RedactionPolicy

    declared = {row.fact_type for row in RedactionPolicy.from_model(model).declarations}
    return OssieArtifacts(data, sidecar, report, len(declared), semantic_model, mapping)
    listed = f"; {len(not_checked)} rule(s) are not checked (listed in the program)" if not_checked else ""
    print(f"Exported the model's rules as PyRel requirements ({target} version) to {out_path}{listed}")
    return 0




def _cmd_export_ossie(
    model: str,
    out: str,
    *,
    loss_report: str | None,
    output_format: str,
    strict: bool,
    max_output_bytes: int | None = None,
    ontology_only: bool = False,
) -> int:
    from gnd.artifacts import ArtifactError
    from gnd.errors import ModelLoadError, ModelValidationError
    from gnd.export.ossie import DEFAULT_MAX_OUTPUT_BYTES, OssieInputError, render_ossie
    from gnd.safefs import publish_new_files

    try:
        bundle = render_ossie(
            Path(model),
            output_format=output_format,
            strict=strict,
            max_output_bytes=DEFAULT_MAX_OUTPUT_BYTES if max_output_bytes is None else max_output_bytes,
            relational=not ontology_only,
            document_name=Path(out).name,
        )
    except FileNotFoundError as error:
        print(f"missing input: {error}", file=sys.stderr)
        return EXIT_NO_INPUT
    except (ModelLoadError, ModelValidationError, OssieInputError) as error:
        print(f"invalid Ossie export input: {error}", file=sys.stderr)
        return EXIT_ILL_FORMED
    except OSError as error:
        print(f"cannot read model: {error}", file=sys.stderr)
        return EXIT_IO
    except Exception as error:  # noqa: BLE001 -- map unexpected export failures to the internal band
        print(f"Ossie export failed: {error}", file=sys.stderr)
        return EXIT_INTERNAL

    # One create-once group; the ontology is written last, as the commit marker.
    group = [
        (Path(loss_report or out + ".loss.json"), bundle.loss_report),
        (Path(out + ".gnd.json"), bundle.sidecar),
    ]
    if bundle.semantic_model is not None and bundle.mapping is not None:
        group += [
            (Path(f"{out}.semantic_model.{output_format}"), bundle.semantic_model),
            (Path(f"{out}.mapping.{output_format}"), bundle.mapping),
        ]
    group.append((Path(out), bundle.document))
    try:
        publish_new_files(group)
    except FileExistsError as error:
        print(f"output exists: {error}", file=sys.stderr)
        return EXIT_COLLISION
    except (OSError, ArtifactError) as error:
        print(f"Ossie output failure: {error}", file=sys.stderr)
        return EXIT_IO
    print(f"Exported Ossie ontology to {out}")
    if bundle.semantic_model is not None:
        print(f"Exported Ossie semantic model and mapping to {out}.semantic_model.{output_format} "
              f"and {out}.mapping.{output_format}")
    elif not ontology_only:
        print("note: the model maps to no table, so no semantic model or mapping is written.", file=sys.stderr)
    if bundle.redacted_fact_types:
        # Issue 169, owner ruling of 2026-11-11: `redact` withholds population values
        # from reports and does not change an export of the model's own text.
        count = bundle.redacted_fact_types
        subject = "1 fact type declares" if count == 1 else f"{count} fact types declare"
        print(
            f"note: {subject} `redact`. The export carries the readings, constraints and "
            "provenance text of every fact type, redacted or not; `redact` withholds "
            "population values from reports and does not change an export. "
            "Read the loss report before you share these files.",
            file=sys.stderr,
        )
    return 0


def _register_export(subparsers):
    export_parser = subparsers.add_parser("export", help="export an optional standalone artifact")
    export_targets = export_parser.add_subparsers(dest="export_target", required=True)
    from gnd.export.souffle_cli import add_parsers
    add_parsers(export_targets)
    from gnd.export.lean_cli import add_parsers as add_lean_parsers



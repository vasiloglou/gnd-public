   313	def _section(text: str, heading: str) -> list[str]:
   314	    """The lines of one ``## heading`` section, by its heading line."""
   315	    lines = text.splitlines()
   316	    start = lines.index(f"## {heading}") + 1
   317	    end = next((i for i in range(start, len(lines)) if lines[i].startswith("## ")), len(lines))
   318	    return lines[start:end]
   319	
   320	
   321	def _table_rows(lines: list[str]) -> dict[str, str]:
   322	    """A markdown table's rows by their first cell; a row is one line of `|`-separated cells."""
   323	    rows = {}
   324	    for line in lines:
   325	        if line.startswith("| ") and not line.startswith("|---"):
   326	            cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
   327	            rows[cells[0]] = " | ".join(cells[1:])
   328	    return rows
   329	

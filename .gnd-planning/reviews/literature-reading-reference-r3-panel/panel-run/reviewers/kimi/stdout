(1 for a in assertions if a[\"support\"] == \"supported\")\n514\t    abstained = sorted(a[\"passage\"] for a in assertions if a[\"passage\"] in inputs.abstentions)\n515\t    label_disagreements = sum(1 for a in assertions if a.get(\"label_disagreement\") is not None)\n516\t    common = {\"sample_size\": len(assertions), \"label_disagreements\": label_disagreements,\n517\t              \"routes\": [_public(r3)] if r3 else []}\n518\t    if r3 is None:\n519\t        return _stage(\"semantic-support\", metrics={}, floors=FLOORS[\"semantic-support\"], route_present=False, **common)\n520\t    counts = None if _refused(r3) or r3[\"exit\"] != 0 else _fidelity_counts(r3[\"payload\"], fact_types)\n521\t    if counts is None:\n522\t        return _stage(\"semantic-support\", metrics={}, floors=FLOORS[\"semantic-support\"], route_present=True,\n523\t                      route_refused=True, refused=len(assertions), **common)\n524\t    refused_docs = set(counts[\"failed_cases\"])\n525\t    refused = sum(1 for a in assertions if inputs.passages.get(a[\"passage\"], {}).get(\"document\") in refused_docs)\n526\t    metrics = {\"precision\": (counts[\"tp\"], counts[\"extracted_total\"]),\n527\t               \"recall\": (counts[\"tp\"], supported),\n528\t               \"abstention\": (len(abstained), len(assertions))}\n529\t    return _stage(\"semantic-support\", metrics=metrics, floors=FLOORS[\"semantic-support\"], route_present=True,\n530\t                  refused=refused, unresolved=counts[\"unresolved\"],\n531\t                  disagreements={\"count\": (supported - counts[\"tp\"]) + counts[\"unmatched\"], \"units\": abstained,\n532\t                                 \"note\": \"gnd fidelity reports counts, not which fact matched; units lists abstained passages only\"},\n533\t                  extra={\"per_domain\": per_domain, \"aggregate\": \"harness micro-total over the assertion fact types\"},\n534\t                  **common)"}

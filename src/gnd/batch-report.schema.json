{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnd.dev/schema/batch-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "command", "model", "issues", "rows", "summary"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "tool": {"const": "gnd"},
    "command": {"const": "check-batch"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projections", "outcomes", "aggregate_exit"],
      "properties": {
        "projections": {"type": "integer", "minimum": 0},
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "violated", "inadequate", "ill_formed", "indeterminate"],
          "properties": {
            "accepted": {"type": "integer", "minimum": 0},
            "violated": {"type": "integer", "minimum": 0},
            "inadequate": {"type": "integer", "minimum": 0},
            "ill_formed": {"type": "integer", "minimum": 0},
            "indeterminate": {"type": "integer", "minimum": 0}
          }
        },
        "aggregate_exit": {"enum": [0, 1, 2, 3, 4]}
      }
    },
    "redaction": {"$ref": "#/$defs/redaction"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}, "required": ["schema_version"]},
      "then": {"not": {"required": ["redaction"]}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
      "then": {"required": ["redaction"]}
    }
  ],
  "$defs": {
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "declarations"],
      "properties": {
        "mode": {"enum": ["applied", "unredacted"]},
        "declarations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "source", "fact_type", "roles"],
            "properties": {
              "case_id": {"type": ["string", "null"]},
              "source": {"enum": ["role", "fact-type"]},
              "fact_type": {"type": "string", "minLength": 1},
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "warning", "unchecked", "vacuous"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "unchecked": {"type": "integer", "minimum": 0},
        "vacuous": {"type": "integer", "minimum": 0}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "message", "rule_id", "severity"],
      "properties": {
        "path": {"type": "string"},
        "message": {"type": "string"},
        "rule_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning"]}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "outcome", "exit_code", "counts", "failing_constraints", "issues"],
      "properties": {
        "population": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
        },
        "outcome": {"enum": ["accepted", "violated", "inadequate", "ill_formed", "indeterminate"]},
        "exit_code": {"enum": [0, 1, 2, 3, 4]},
        "counts": {"$ref": "#/$defs/counts"},
        "failing_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    }
  }
}

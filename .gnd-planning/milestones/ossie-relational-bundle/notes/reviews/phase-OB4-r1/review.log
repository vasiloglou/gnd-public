"""Build a physical binding shaped like delivered DDL from a model's own Rmap schema.

For the OB4 scale and totality tests: every table, key and foreign key of the Rmap
becomes a binding table, and every role placement a `roles` entry. ``keep`` chooses
the fact types to bind; the others are left unbound.
"""

from __future__ import annotations

_SQL = {"String": "VARCHAR(100)", "Integer": "BIGINT", "Boolean": "BOOLEAN", "Float": "DOUBLE PRECISION"}


def binding_from_rmap(model, keep=lambda fact_type: True) -> dict:
    from gnd.rmap import map_model

    schema = map_model(model)
    tables = {}
    for table in schema.tables:
        columns = {}
        for column in table.columns:
            columns[column.name] = {"sql_type": _SQL[column.datatype]} if column.datatype in _SQL else {}
        for key in table.foreign_keys:
            for name in key.columns:
                columns[name]["references"] = {"table": key.target_table, "columns": list(key.target_columns)}
        if table.subject[0] == "object_type":
            for name in table.primary_key:
                columns[name]["targets"] = [{"kind": "identifier", "object_type": table.subject[1]}]
        tables[table.name] = {"columns": columns, "primary_key": list(table.primary_key)}
    roles: dict[str, dict[str, list[dict[str, str]]]] = {}
    for placement in schema.roles:
        if keep(placement.fact_type):
            roles.setdefault(placement.fact_type, {})[placement.role] = [
                {"table": placement.table, "column": column} for column in placement.columns
            ]
    return {"schema": "gnd-physical-binding/1", "tables": tables, "roles": roles}
"""Deterministic large models for the Rmap time-bound tests (OB2 T4)."""

from __future__ import annotations

_MOD = {"source": "explicit", "status": "confirmed", "modality": "alethic", "provenance": {"user_quote": "generated"}}


def _uc(roles):
    return {"type": "uniqueness", "roles": roles, **_MOD}


def large_rmap_model(entities: int = 1400, fact_types: int = 4500) -> dict:
    """``entities`` popular-reference entities and ``fact_types`` fact types: one in four
    functional to a value type, m:n between entities, unary, or ternary with an n-1 key."""
    objects = [{"id": "code", "name": "Code", "kind": "value", "primitive": "String"}]
    for e in range(entities):
        objects.append({"id": f"e{e:05d}", "name": f"E{e:05d}", "kind": "entity",
                        "reference": {"mode": "popular", "value_type": f"e{e:05d}_id"}})
        objects.append({"id": f"e{e:05d}_id", "name": f"E{e:05d}Id", "kind": "value", "primitive": "Integer"})
    facts = []
    for f in range(fact_types):
        a, b, c = f"e{f % entities:05d}", f"e{(f * 7 + 1) % entities:05d}", f"e{(f * 13 + 2) % entities:05d}"
        fid = f"f{f:05d}"
        shape = f % 4
        if shape == 0:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} has {{Code}}",
                          "roles": [{"object_type": a, "role_name": "subject"}, {"object_type": "code", "role_name": "code"}],
                          "constraints": [_uc(["subject"])]})
        elif shape == 1:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} relates to {{E{b[1:]}}}",
                          "roles": [{"object_type": a, "role_name": "left"}, {"object_type": b, "role_name": "right"}],
                          "constraints": [_uc(["left", "right"])]})
        elif shape == 2:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} is flagged",
                          "roles": [{"object_type": a, "role_name": "subject"}]})
        else:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} meets {{E{b[1:]}}} at {{E{c[1:]}}}",
                          "roles": [{"object_type": a, "role_name": "first"}, {"object_type": b, "role_name": "second"},
                                    {"object_type": c, "role_name": "place"}],
                          "constraints": [_uc(["first", "second"])]})
    return {"version": 1, "source": {"kind": "text-conversation", "confidence": "standard", "mode": "guided"},
            "object_types": objects, "fact_types": facts}

def _relationship(fact, names, order, role_types):
    by_role = {role: names[object_type] for role, object_type in role_types.items()}
    first, *additional = order
    roles = [{"concept": by_role[role], "name": role} for role in additional]
    tokens = {first: "{" + by_role[first] + "}"}
    tokens.update({role: f"{{{by_role[role]}:{role}}}" for role in additional})
    readings, inverse = _verbalizes(fact, tokens, role_types)
    result = {"name": fact["id"], "verbalizes": readings}
    if roles:
        result["roles"] = roles
    return result, inverse


def _add_references(objects, components, names, functional_links, constraints, mapped, indexes, identification):
    # Pre-index composite UC candidates by their shared identifying entity.
    composite = {}
    for i, constraint in enumerate(constraints):
        if (
            constraint.get("type") != "uniqueness"
            or constraint.get("scope") != "external"
            or constraint.get("modality") != "alethic"
            or constraint.get("status") != "confirmed"
        ):
            continue
        links = []
        entity = None
        for ref in constraint.get("role_refs", ()):
            fact_id = ref["fact_type"]
            link = functional_links.get(fact_id)
            if link is None:
                break
            owner, dependent_role = link
            if dependent_role != ref["role"]:
                break
            if entity is not None and owner != entity:
                break
            entity = owner
            links.append(fact_id)
        else:
            if entity is not None and links:
                priority = bool(constraint.get("preferred"))
                previous = composite.get(entity)
                if previous is None or (priority and not previous[0]):
                    composite[entity] = (priority, i, links)

    for oid, obj in objects.items():
        ref = obj.get("reference") or {}
        component = components[oid]
        mode = ref.get("mode")
        path = ("object_types", indexes[oid], "reference")
        if mode in {"popular", "general"}:
            value_type = ref["value_type"]
            rels = component.setdefault("relationships", [])
            used = {r["name"] for r in rels}
            key = "gnd_reference"
            while key in used:
                key = "_" + key
            rels.append(
                {
                    "name": key,
                    "roles": [{"concept": names[value_type]}],
                    "verbalizes": [f"{{{names[oid]}}} is identified by {{{names[value_type]}}}"],
                    "multiplicity": "OneToOne",
                }
            )
            component["identify_by"] = [key]
            identification[oid] = ("simple", key)
            mapped[path] = _NATIVE_LITERAL
            mapped[(*path, "value_type")] = _NATIVE_LITERAL
        elif mode == "external" and oid in composite:
            _, index, links = composite[oid]
            component["identify_by"] = links
            identification[oid] = ("composite", tuple(links))
            mapped[path] = _NATIVE_LITERAL
            mapped[("constraints", index)] = _NATIVE_LITERAL



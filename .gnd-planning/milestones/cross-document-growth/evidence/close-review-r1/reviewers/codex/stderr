from pathlib import Path
from typing import Literal

from pydantic import BaseModel, ConfigDict, Field

from gnd import input_policy
from gnd.artifacts import (
    ArtifactError,
    canonical_json_bytes,
    publish_leaf_atomic,
    read_regular_bounded,
    sha256_hex,

from __future__ import annotations

import sys
from pathlib import Path

from gnd.exits import EXIT_COLLISION, EXIT_ILL_FORMED, EXIT_INTERNAL, EXIT_IO, EXIT_NO_INPUT


def _cmd_export_pyrel(
    model_path: str, out_path: str, *, duckdb_path: str = ":memory:", connection: str | None = None
) -> int:
    from gnd.export.emit import render_pyrel
    from gnd.export.pyrel_runtime import ExportInputError, write_new

    try:
        source = render_pyrel(Path(model_path), duckdb_path=duckdb_path, connection=connection)
    except FileNotFoundError as error:
        print(f"missing input: {error}", file=sys.stderr)
        return EXIT_NO_INPUT
    except ExportInputError as error:
        print(f"invalid model: {error}", file=sys.stderr)
        return 3
    except Exception as error:  # noqa: BLE001 -- preserve predecessor refusal contract
        print(f"export failed: {error}", file=sys.stderr)
        return EXIT_INTERNAL
    try:
        write_new(Path(out_path), source)
    except FileExistsError as error:
        print(f"output exists: {error}", file=sys.stderr)
        return EXIT_COLLISION
    except Exception as error:  # noqa: BLE001 -- preserve predecessor refusal contract
        print(f"output failure: {error}", file=sys.stderr)
        return EXIT_INTERNAL
    print(f"Exported PyRel program to {out_path}")
    return 0

_cmd_export_pyrel.__module__ = "gnd.cli"


def _cmd_export_pyrel_rules(model_path: str, out_path: str, *, target: str) -> int:
    """Write the model's rules as a readable PyRel program of requirements (duckdb or lqp)."""
    from gnd.export.emit import render_pyrel_rules_report
    from gnd.export.pyrel_runtime import ExportInputError, write_new

    try:
        source, not_checked = render_pyrel_rules_report(Path(model_path), target)
    except FileNotFoundError as error:
        print(f"missing input: {error}", file=sys.stderr)
        return EXIT_NO_INPUT
    except ExportInputError as error:
        print(f"cannot write the rules program: {error}", file=sys.stderr)
        return 3
    except Exception as error:  # noqa: BLE001 -- same refusal contract as the checker export
        print(f"export failed: {error}", file=sys.stderr)
        return EXIT_INTERNAL
    try:
        write_new(Path(out_path), source)
    except FileExistsError as error:
        print(f"output exists: {error}", file=sys.stderr)
        return EXIT_COLLISION
    except OSError as error:
        print(f"output failure: {error}", file=sys.stderr)
        return EXIT_INTERNAL
    listed = f"; {len(not_checked)} rule(s) are not checked (listed in the program)" if not_checked else ""
    print(f"Exported the model's rules as PyRel requirements ({target} version) to {out_path}{listed}")
    return 0




def _cmd_export_ossie(model: str, out: str, *, loss_report: str | None, output_format: str, strict: bool) -> int:
    from gnd.artifacts import ArtifactError
    from gnd.errors import ModelLoadError, ModelValidationError
    from gnd.export.ossie import OssieInputError, render_ossie
    from gnd.safefs import publish_new_files

    try:
        bundle = render_ossie(Path(model), output_format=output_format, strict=strict)
    except FileNotFoundError as error:
        print(f"missing input: {error}", file=sys.stderr)
        return EXIT_NO_INPUT
    except (ModelLoadError, ModelValidationError, OssieInputError) as error:
        print(f"invalid Ossie export input: {error}", file=sys.stderr)
        return EXIT_ILL_FORMED
    except OSError as error:
        print(f"cannot read model: {error}", file=sys.stderr)
        return EXIT_IO
    except Exception as error:  # noqa: BLE001 -- map unexpected export failures to the internal band
        print(f"Ossie export failed: {error}", file=sys.stderr)
        return EXIT_INTERNAL

    try:
        publish_new_files([
            (Path(loss_report or out + ".loss.json"), bundle.loss_report),
            (Path(out + ".gnd.json"), bundle.sidecar),
            (Path(out), bundle.document),
        ])
    except FileExistsError as error:
        print(f"output exists: {error}", file=sys.stderr)
        return EXIT_COLLISION
    except (OSError, ArtifactError) as error:
        print(f"Ossie output failure: {error}", file=sys.stderr)
        return EXIT_IO
    print(f"Exported Ossie ontology to {out}")
    if bundle.redacted_fact_types:
        # Issue 169, owner ruling of 2026-11-11: `redact` withholds population values
        # from reports and does not change an export of the model's own text.
        count = bundle.redacted_fact_types
        subject = "1 fact type declares" if count == 1 else f"{count} fact types declare"
        print(
            f"note: {subject} `redact`. The export carries the readings, constraints and "
            "provenance text of every fact type, redacted or not; `redact` withholds "
            "population values from reports and does not change an export. "
            "Read the loss report before you share these files.",
            file=sys.stderr,
        )
    return 0


def _register_export(subparsers):
    export_parser = subparsers.add_parser("export", help="export an optional standalone artifact")
    export_targets = export_parser.add_subparsers(dest="export_target", required=True)
    from gnd.export.souffle_cli import add_parsers
    add_parsers(export_targets)
    from gnd.export.lean_cli import add_parsers as add_lean_parsers

    add_lean_parsers(export_targets)
    pyrel_parser = export_targets.add_parser("pyrel", help="export a standalone PyRel program")
    pyrel_parser.add_argument("model", help="path to the model file")
    pyrel_parser.add_argument("--out", required=True, help="new Python program path")
"""``gnd export ilp`` and ``gnd import ilp-rules``: the ILP bridge service (IK5).

Contract page: ``docs/reference/ilp-bridge.md``. Spec:
``.gnd-planning/milestones/induced-knowledge/notes/phase-IK5-spec.md``.

**Export** validation order (spec §4 rule 3): arguments, the manifest read and
schema, the mode check, model load, binding, each population (path, digest,
load), representability, render, write.

**Import** validation order: arguments, the clauses read, the run-record read,
the clause-digest binding, the manifest read and mode check, model load,
binding, the export recomputed and its digest compared, the learner binding,
the coverage shape, the fragment checks per clause, candidate-model validation,
re-evaluation, the set comparison, then the proposal write. Every refusal is
exit 3 with a named reason (IK5-D8) and writes nothing; admission is
all-or-nothing (IK5-D9). GND computes coverage and support itself; the
learner's sets are only compared (IK-R2).
"""


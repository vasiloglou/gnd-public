+   attachments=$(mktemp -d)
+   gh release download v0.5.0 --repo vasiloglou/gnd-public --dir "$attachments"
+   cmp SHA256SUMS.txt "$attachments/SHA256SUMS.txt"
+   (cd "$attachments" && shasum -a 256 -c SHA256SUMS.txt)

   411	    subjects_of = ConstraintSubjects(index)
   412	
   413	    def refuse(position: int, operation: Any, cell: str, detail: str) -> None:
   414	        if population_outcomes is not None and cell.startswith("constraint.populated."):
   415	            if not _population_eligible(operation, operation.kind) or (
   416	                operation.kind is _MODIFY and not _strengthening_only(operation.before, operation.after)
   417	            ):
   418	                detail = f"{detail}; population: not eligible"
   419	            else:
   420	                outcome = population_outcomes.get(position, "not-located")
   421	                if outcome == POPULATION_PASS:
   422	                    return
   423	                detail = f"{detail}; population: {outcome}"
   424	        issues.append(
   425	            PolicyIssue(
   426	                operation_index=position,
   427	                operation_id=operation.operation_id,
   428	                reference=operation.reference(),
   429	                cell=cell,
   430	                detail=f"{operation.reference()}: {detail}",
   431	            )
   432	        )
   433	
   434	    for position, operation in enumerate(proposal.operations):
   435	        locator = operation.locator
   436	        kind = operation.kind
   437	        locator_kind = locator.locator_kind
   438	        if locator_kind == "element":
   439	            collection = locator.collection
   440	            if collection == "operations":
   441	                continue
   442	            if kind is _ADD:
   443	                if collection == "fact_types":
   444	                    added_fact_types.add(locator.element_id)
   445	                continue
   446	            if kind is _MODIFY:
   447	                allowed = _OBJECT_TYPE_MODIFY_KEYS if collection == "object_types" else _FACT_TYPE_MODIFY_KEYS
   448	                detail = _element_modify_detail(operation.before, operation.after, allowed)
   449	                if detail is not None:
   450	                    refuse(position, operation, f"{collection}.modify", detail)
   451	                continue
   452	            refuse(position, operation, f"{collection}.{kind.value}", f"{kind.value} refused")
   453	            continue
   454	        if locator_kind == "role":
   455	            if kind is _ADD and locator.fact_type_id in added_fact_types:
   456	                continue
   457	            if kind is _ADD and locator.fact_type_id not in existing_fact_types:
   458	                # Neither existing nor added here: the replay refuses it (3)
   459	                # before the policy; admitted so the policy stays total.
   460	                continue
   461	            refuse(position, operation, f"role.{kind.value}", f"{kind.value} refused on an existing fact type")

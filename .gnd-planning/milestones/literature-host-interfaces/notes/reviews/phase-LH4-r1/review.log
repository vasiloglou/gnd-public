    record, out = _admit(_case(tmp_path, verdicts=verdicts), shape=SHAPE)
    reasons = {row["assertion"]: row["reason"] for row in record["stages"]["semantic-support"]}
    assert reasons == {"c1": "rejected", "c2": None, "c3": "missing", "c4": "rejected"}

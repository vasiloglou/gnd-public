{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnd.dev/schemas/mined-import.schema.json",
  "title": "GND mined-rules import: the miner run record (gnd-mined-run/1) and the import report (gnd-mined-import/1)",
  "description": "ilp-learners IL4. The run record binds a miner's printed rules to the population it mined; the report is what gnd import mined-rules --format json prints. Contract: docs/reference/ilp-bridge.md, \"AMIE-style miner\".",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/report"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "learner",
        "rules_sha256",
        "population_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "gnd-mined-run/1"
        },
        "learner": {
          "$ref": "#/$defs/learner"
        },
        "rules_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "population_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool",
        "command",
        "target",
        "learner",
        "population_sha256",
        "inputs",
        "rules",
        "proposal"
      ],
      "properties": {
        "schema_version": {
          "const": "gnd-mined-import/1"
        },
        "tool": {
          "const": "gnd"
        },
        "command": {
          "const": "import mined-rules"
        },
        "target": {
          "enum": [
            "amie"
          ]
        },
        "learner": {
          "$ref": "#/$defs/learner"
        },
        "population_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "population",
            "rules",
            "run"
          ],
          "properties": {
            "model": {
              "$ref": "#/$defs/ref"
            },
            "population": {
              "$ref": "#/$defs/ref"
            },
            "rules": {
              "$ref": "#/$defs/ref"
            },
            "run": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "ref",
              "support",
              "confidence",
              "reported",
              "body_size_agrees"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "ref": {
                "type": "string",
                "pattern": "^constraints\\[[0-9]+\\]$"
              },
              "support": {
                "$ref": "#/$defs/count"
              },
              "confidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "formula",
                  "value"
                ],
                "properties": {
                  "formula": {
                    "const": "std-confidence-head-pairs"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "reported": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "support",
                  "body_size",
                  "head_coverage",
                  "std_confidence",
                  "pca_confidence",
                  "pca_body_size",
                  "functional_variable"
                ],
                "properties": {
                  "support": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "body_size": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "head_coverage": {
                    "type": "string"
                  },
                  "std_confidence": {
                    "type": "string"
                  },
                  "pca_confidence": {
                    "type": "string"
                  },
                  "pca_body_size": {
                    "type": "string"
                  },
                  "functional_variable": {
                    "type": "string"
                  }
                }
              },
              "body_size_agrees": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "proposal": {
          "type": "string"
        }
      }
    }
  }
}

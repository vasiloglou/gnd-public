   464	            subjects = subjects_of.of(operation)
   465	            # `populated` is computed from the before model, so a same-proposal
   466	            # fact type is never in it; no subtraction is needed (review F5).
   467	            if not (subjects & populated):
   468	                continue
   469	            if kind is _ADD:
   470	                refuse(position, operation, "constraint.populated.add", "new constraint on a populated fact type")
   471	            elif kind is _MODIFY:
   472	                detail = _constraint_modify_detail(operation.before, operation.after)
   473	                if detail is not None:
   474	                    refuse(position, operation, "constraint.populated.modify", detail)
   475	            # DELETE: removing a constraint cannot invalidate an admitted fact.
   476	            continue
   477	        if locator_kind == "model-identity":
   478	            refuse(position, operation, "model_identity.modify", "model identity change refused")
   479	            continue
   480	        if locator_kind == "source-document":
   481	            # UG3: a round may declare a new document; changing or removing a
   482	            # declared one changes what earlier spans were checked against.
   483	            if kind is not _ADD:
   484	                refuse(position, operation, f"source_document.{kind.value}",
   485	                       f"{kind.value} of a declared source document refused")
   486	            continue
   487	        if locator_kind == "include":
   488	            refuse(position, operation, "include.repin-include", "shared vocabulary re-pin refused")
   489	            continue
   490	        # Fail closed: a locator kind with no rule is refused, never admitted.
   491	        raise EvolutionPolicyGapError(locator_kind)
   492	    return tuple(issues)


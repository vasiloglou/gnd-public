"""Deterministic large models for the Rmap time-bound tests (OB2 T4)."""

from __future__ import annotations

_MOD = {"source": "explicit", "status": "confirmed", "modality": "alethic", "provenance": {"user_quote": "generated"}}


def _uc(roles):
    return {"type": "uniqueness", "roles": roles, **_MOD}


def large_rmap_model(entities: int = 1400, fact_types: int = 4500) -> dict:
    """``entities`` popular-reference entities and ``fact_types`` fact types: one in four
    functional to a value type, m:n between entities, unary, or ternary with an n-1 key."""
    objects = [{"id": "code", "name": "Code", "kind": "value", "primitive": "String"}]
    for e in range(entities):
        objects.append({"id": f"e{e:05d}", "name": f"E{e:05d}", "kind": "entity",
                        "reference": {"mode": "popular", "value_type": f"e{e:05d}_id"}})
        objects.append({"id": f"e{e:05d}_id", "name": f"E{e:05d}Id", "kind": "value", "primitive": "Integer"})
    facts = []
    for f in range(fact_types):
        a, b, c = f"e{f % entities:05d}", f"e{(f * 7 + 1) % entities:05d}", f"e{(f * 13 + 2) % entities:05d}"
        fid = f"f{f:05d}"
        shape = f % 4
        if shape == 0:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} has {{Code}}",
                          "roles": [{"object_type": a, "role_name": "subject"}, {"object_type": "code", "role_name": "code"}],
                          "constraints": [_uc(["subject"])]})
        elif shape == 1:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} relates to {{E{b[1:]}}}",
                          "roles": [{"object_type": a, "role_name": "left"}, {"object_type": b, "role_name": "right"}],
                          "constraints": [_uc(["left", "right"])]})
        elif shape == 2:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} is flagged",
                          "roles": [{"object_type": a, "role_name": "subject"}]})
        else:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} meets {{E{b[1:]}}} at {{E{c[1:]}}}",
                          "roles": [{"object_type": a, "role_name": "first"}, {"object_type": b, "role_name": "second"},
                                    {"object_type": c, "role_name": "place"}],
                          "constraints": [_uc(["first", "second"])]})
    return {"version": 1, "source": {"kind": "text-conversation", "confidence": "standard", "mode": "guided"},
            "object_types": objects, "fact_types": facts}
# OB3 corpus gate

**Owner approval, 2026-11-24.** `auto=false`.

The owner was asked "Do you approve the corpus and amendment r1.1, or would
you rather I push the branch so you can read it on GitHub first?" and
answered:

> Approve corpus, r1.1

| Item | Value |
|---|---|
| Spec, with amendment r1.1 (§14, B1–B14) | [phase-OB3-spec.md](notes/phase-OB3-spec.md), sha256 `0b8c85f542a93b6a5db7a97d6895ea988011dd8894a5c1136b741b9014c7ec4c` |
| Corpus | [tests/fixtures/ossie_relational](../../../tests/fixtures/ossie_relational/README.md) at commit `68511ff8` when approved, `3fe44225` after the branch was rebased onto main (same bytes): 7 cases with stories |
| Expected files | 21 files (7 semantic models, 7 mappings, 7 extension copies), hand-derived. sha256 of their concatenation, in the order semantic models, mappings, extensions, each sorted by case: `f4926423d727483e7028c5d5cf1d13b4092fcfaa372547b90af63601ef5477b2` |
| Review state | not reviewed; the upstream validator (opt-in oracle lane) was not run |

## Effect

- **The approved expected files are fixed.** Changing one returns it to the
  owner, and the earlier file is kept. Cases added during implementation get
  ids of their own.
- **Implementation waits (E1).** It starts on a branch cut from main after
  PRs #264, #266 and #270 merge. The harness then lands red first, and each
  implementation commit names the cases it turns green.
- **E1's condition is met.** On 2026-11-24 the owner said "Merge all three".
  PR #264 merged as `bf79ef0a`, #266 as `1ed8ab61` and #270 as `fd733185`.
  The combined tree (`95ca5a24`) was tested before the merges: 1,423 passed
  and 1 failed, the known `test_reference_closure_and_declared_bootstrap`;
  ruff clean. This branch was then rebased onto main.

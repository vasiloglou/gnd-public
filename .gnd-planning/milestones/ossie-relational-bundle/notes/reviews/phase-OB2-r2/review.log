   130	class _Mapper:
   131	    def __init__(self, model: Any, variant: RmapVariant) -> None:
   132	        self.model = model
   133	        self.variant = variant
   134	        self.index = ModelIndex.for_model(model)
   135	        self.objects: dict[str, dict[str, Any]] = dict(self.index.object_types_by_id())
   136	        # Read-only rows from the shared index (RF6: model queries go through ModelIndex).
   137	        self.facts: list[dict[str, Any]] = list(self.index.iter_fact_types_shared())
   138	        self.role_players: dict[str, dict[str, str]] = self.index.role_object_types()
   139	        self.fact_by_id = {str(f.get("id")): f for f in self.facts}
   140	        self.top: list[dict[str, Any]] = list(model.constraints or ())
   141	        self.unmapped: dict[tuple[str, str], tuple[str, str]] = {}
   142	        self.carried: dict[tuple[str, str], tuple[str, ...]] = {}
   143	        self._primitive: dict[str, str | None] = {}
   144	        self._identity: dict[str, tuple[str, Any]] = {}
   145	        self._keys: dict[str, _Key | None] = {}
   146	        self.placed: dict[str, _Placed] = {}
   147	        # fact type id -> role name -> the columns that hold it (rules 3, 5 and 6).
   148	        self.role_cols: dict[str, dict[str, list[str]]] = {}
   149	        self.tables: dict[str, dict[str, Any]] = {}
   150	        # Preferred, confirmed alethic external uniqueness per anchored entity, built once.
   151	        self.identifiers: dict[str, tuple[int, list[tuple[str, str]]]] = {}
   152	        for index, constraint in enumerate(self.top):
   153	            if (
   154	                constraint.get("type") == "uniqueness"
   155	                and constraint.get("scope") == "external"
   156	                and constraint.get("preferred")
   157	                and _confirmed(constraint)
   158	            ):
   159	                refs = self.refs(constraint)
   160	                anchor = self.anchor(refs)
   161	                if anchor is not None:
   162	                    current = self.identifiers.get(anchor)
   163	                    if current is None or sorted(refs) < sorted(current[1]):
   164	                        self.identifiers[anchor] = (index, refs)

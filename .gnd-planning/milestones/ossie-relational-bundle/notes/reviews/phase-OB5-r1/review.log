def render_ossie(
    model_path: Path,
    *,
    output_format: str,
    strict: bool = False,
    max_output_bytes: int = DEFAULT_MAX_OUTPUT_BYTES,
    relational: bool = True,
    document_name: str | None = None,
    physical_binding: Path | None = None,
) -> OssieArtifacts:
    """Render the deterministic artifacts of one bounded, admitted model read.

    The ontology, its sidecar and its loss report always. With ``relational``, also
    the semantic model and the mapping; ``document_name`` is the file name the
    ontology will have, which the mapping's references are built from (default
    ``ontology.<format>``).

    Every artifact must fit in ``max_output_bytes``; otherwise the whole export is
    refused with ``ossie:output-size`` and nothing is returned to publish.
    """
    require_byte_bound("max_output_bytes", max_output_bytes)
    if physical_binding is not None and not relational:
        raise ValueError("a physical binding needs the relational files")
    # The binding's syntax and schema need no model, so they are judged first.
    binding = None if physical_binding is None else read_binding(physical_binding)
    document, model = _read_model(model_path)
    ontology, mapped, view = _project(document, model)
    _schema().validate(ontology)
    # Its names and contradictions need the model and the ontology view, and are
    # judged before the strict refusals below.
    bound = None if binding is None else bind(model, view, binding)
    incompatible = {}
    for index, constraint in enumerate(document.get("constraints", ())):
        reason = guarded_clause_refusal(constraint)
        if reason is not None:
            incompatible[("constraints", index)] = reason
    for index, fact in enumerate(ModelIndex(None, document).iter_fact_types_shared()):
        if any(
            where_uses_membership(clause.get("where"))
            for clause in iter_derivation_clauses(fact.get("derivation_rule"))
        ):
            incompatible[("fact_types", index, "derivation_rule")] = "membership-unsupported"
    mapped.update((path, ("extension", reason, None)) for path, reason in incompatible.items())
    rows, elements, refused = _metadata(document, mapped)
    if strict and refused:
        raise OssieInputError(_POPULATION_REFUSAL)
    if strict and incompatible:
        raise OssieInputError(next(iter(incompatible.values())))
    data = _encode(ontology, output_format)
    try:
        identity = model_identity(model)
        binding = {"model_identity": identity, "document_sha256": hashlib.sha256(data).hexdigest()}
        report = canonical_json_bytes(
            {"schema": "gnd-ossie-loss/1", **binding, "dispositions": rows}
        )
        sidecar = canonical_json_bytes(
            {"schema": "gnd-ossie-sidecar/1", **binding, "elements": elements}
        )
    except (ModelIdentityError, UnicodeEncodeError, ValueError) as error:
        raise OssieInputError("model has no encodable interchange identity") from error
    semantic_model = mapping = None
    if relational:
        semantic_model, mapping = _relational(
            model, view, data, identity,
            output_format=output_format, document_name=document_name or f"ontology.{output_format}",
            bound=bound,
        )
    artifacts = (data, sidecar, report, semantic_model, mapping)
    if max(len(artifact) for artifact in artifacts if artifact is not None) > max_output_bytes:
        raise OssieInputError("ossie:output-size")
    from gnd.redaction import RedactionPolicy

    declared = {row.fact_type for row in RedactionPolicy.from_model(model).declarations}
    return OssieArtifacts(data, sidecar, report, len(declared), semantic_model, mapping)
def read_binding(path: Path) -> Binding:
    """Read and schema-check a binding. A missing file raises ``FileNotFoundError``."""
    try:
        descriptor = open_regular(path)
    except NotRegularFileError as error:
        raise BindingError("binding:not-a-file", "the path is not a regular file") from error
    with open(descriptor, "rb") as stream:
        raw = stream.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        raise BindingError("binding:size", f"the file is larger than {MAX_BYTES} bytes")
    try:
        document = loads(raw, max_bytes=MAX_BYTES)
        # An escaped lone surrogate is JSON but not text: no output could carry it (r1 F1).
        json.dumps(document, ensure_ascii=False).encode("utf-8")
    except (ValueError, RecursionError, OverflowError) as error:
        raise BindingError("binding:syntax", "the file is not JSON text within the input limits") from error
    violations = sorted((_pointer(error.absolute_path), error.message) for error in _validator().iter_errors(document))
    if violations:
        pointer, message = violations[0]
        raise BindingError("binding:schema", f"at {pointer or 'the document root'}: {message[:200]}")
    return Binding(document, hashlib.sha256(raw).hexdigest())


def _pointer(parts: Iterable[Any]) -> str:
    """An RFC 6901 JSON pointer; `~` and `/` in a member name are escaped (r1 F6)."""
    return "".join("/" + str(part).replace("~", "~0").replace("/", "~1") for part in parts)



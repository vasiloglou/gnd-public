\"roles\", k)] = _NATIVE_LITERAL\n383\t        if len(order) == 2 and multiplicity:\n384\t            functional_links[fact[\"id\"]] = (owner, order[1])\n385\t    _add_references(\n386\t        objects,\n387\t        components,\n388\t        names,\n389\t        functional_links,\n390\t        document.get(\"constraints\", ()),\n391\t        mapped,\n392\t        indexes,\n393\t        identification,\n394\t    )\n395\t\n396\t    _inherit_identifiers(objects, components, indexes, mapped, identification)\n397\t\n398\t    ontology = {\n399\t        \"version\": _VERSION,\n400\t        \"name\": document.get(\"model_id\") or \"gnd_model\",\n401\t        \"ontology\": list(components.values()),\n402\t    }\n403\t    if document.get(\"model_id\"):\n404\t        mapped[(\"model_id\",)] = _copy((\"name\",))\n405\t    place_formulas(document, ontology, components, projected_relations, mapped, fact_types)\n406\t    view = OntologyView(\n407\t        name=ontology[\"name\"],\n408\t        concepts={oid: names[oid] for oid in components},\n409\t        kinds={oid: objects[oid][\"kind\"] for oid in components},\n410\t        identification=identification,\n411\t        relations=relations,\n412\t    )\n413\t    return ontology, mapped, view\n414\t\n415\t\n416\tdef _metadata(document, mapped):\n417\t    rows = []\n418\t    elements = defaultdict(dict)\n419\t    refused = False\n420\t\n421\t    def visit(value, path=(), owner=\"\", refusal=False, formula=False):\n422\t        nonlocal refused\n423\t        population = path == (\"reference_populations\",) or (\n424\t            len(path) == 3 and path[0] == \"fact_types\" and path[2] == \"sample_population\"\n425\t        )\n426\t        refusal = refusal or (population and bool(value))\n427\t        if isinstance(value, dict) and isinstance(value.get(\"id\"), str):\n428\t            owner = value[\"id\"]\n429\t        pointer = _pointers(*path)\n430\t        children = (\n431\t            value.items()\n432\t            if isin
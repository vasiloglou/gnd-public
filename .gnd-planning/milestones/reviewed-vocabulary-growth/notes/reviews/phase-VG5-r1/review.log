def judgments(
    model_path,
    population_path,
    policy_path,
    receipts_path,
    *,
    trusted_root,
    reference_root=None,
    unredacted=False,
):
    """Evaluate saved opinions without obtaining any external judgment."""
    unredacted = _values_allowed(unredacted, "unredacted=True")
    from pathlib import Path

    from gnd.artifacts import ArtifactError, read_regular_bounded
    from gnd.judgments import (
        JudgmentInputError,
        evaluate_judgments,
        read_judgment_policy,
        read_judgment_receipts,
        redact_policy,
    )
    from gnd.model import (
        ModelLoadError,
        ModelValidationError,
        bind_declared_references,
        load_model_bytes,
    )
    from gnd.population import (  # noqa: F811 -- local compatibility binding
        PopulationLoadError,
        load_population_bytes,
    )

    result = {
        "schema_version": 15,
        "command": "judgments",
        "outcome": 3,
        "error": None,
        "mechanical_report": None,
        "judgment_policy": None,
    }

    def read(path, maximum):
        path = Path(path).absolute()
        try:
            return read_regular_bounded(path.parent, path.name, max_bytes=maximum)[0]
        except ArtifactError as error:
            raise JudgmentInputError(
                "limit" if any(w in str(error) for w in ("cap", "over", "exceed")) else "binding",
                "input unavailable or unstable",
            ) from error

    try:
        policy = read_judgment_policy(read(policy_path, 1024 * 1024))
        receipts = read_judgment_receipts(read(receipts_path, 10 * 1024 * 1024))
        mr, pr = read(model_path, 10 * 1024 * 1024), read(population_path, 10 * 1024 * 1024)
        from gnd.model._includes import bytes_declare_includes
        model_root = None
        if bytes_declare_includes(mr, source=model_path):
            # An include root composes as gnd check composes it; its references
            # are bound below, under --reference-root, like any other model's.
            from gnd.model import load_model_bytes_composed
            model_root = Path(model_path).absolute().parent
            model = load_model_bytes_composed(mr, source=model_path, root=model_root,
                                              bind_references=False)
        else:
            model = load_model_bytes(mr, source=model_path)
        candidate = load_population_bytes(pr, source=population_path, model=model)
        refs = bind_declared_references(model, root=reference_root or Path(model_path).parent)
        raw_mechanical = _check_unresolved(model, candidate, admission=True, references=refs,
                                           unredacted=True)
        result["mechanical_report"] = (
            raw_mechanical
            if unredacted
            else _check_unresolved(model, candidate, admission=True, references=refs,
                                   unredacted=False)
        )
        for payload in (raw_mechanical, result["mechanical_report"]):
            inner = payload.get("report", payload)
            inner["model"], inner["population"] = str(model_path), str(population_path)
        decision = evaluate_judgments(
            policy,
            receipts,
            model=model,
            candidate=candidate,
            mechanical_report=raw_mechanical,
            model_bytes=mr,
            population_bytes=pr,
            trusted_root=trusted_root,
            references=refs,
            model_root=model_root,
        )
        result["outcome"] = 0 if decision["admission"] else 1
        result["judgment_policy"] = decision if unredacted else redact_policy(decision)
    except JudgmentInputError as error:
        result.update(
            outcome=4 if error.reason in {"limit", "io"} else 3,
            error={"reason": error.reason, "message": str(error)},
        )
    except ModelValidationError as error:
        # The report's reason is closed (judgment.schema.json); an include code
        # travels in the message only.
        code = next((i.rule_id for i in error.issues if i.rule_id.startswith("include:")), None)
        result.update(error={"reason": "binding",
                             "message": code or "invalid bound judgment input"})
    except (
        ValueError,
        TypeError,
        OSError,
        ArtifactError,  # an unbindable reference file (IKE-Q3 D2-A)
        ModelLoadError,
        PopulationLoadError,
    ):
        result.update(error={"reason": "binding", "message": "invalid bound judgment input"})
    return result



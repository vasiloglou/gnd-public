def load_model_bytes(data: bytes, *, source: str | Path) -> Model:
    """Validate one immutable bounded buffer; source is diagnostic metadata."""
    doc = parse_model_document(data, source=source)
    from gnd.model._includes import _refuse, declares_includes, parse_declarations

    if declares_includes(doc):
        if "includes" not in doc:
            parse_declarations(doc)
        _refuse("unresolved")
    return _finish_model(doc)


def _model_warnings(doc, origins):
    from gnd.model._includes import included_rows, remap_issues
    from gnd.model._unattended import _INCLUDED

    issues = remap_issues(_layer1_structural(doc), origins)
    if issues:
        raise ModelValidationError(issues)
    # VG3: the unattended rules read which elements came from an include.
    token = _INCLUDED.set(included_rows(doc, origins))
    try:
        issues = remap_issues(semantic_validate(dict(doc)), origins)
    finally:
        _INCLUDED.reset(token)
    errors = [issue for issue in issues if issue.severity == "error"]
    warnings = [issue for issue in issues if issue.severity == "warning"]
    if errors:
        raise ModelValidationError(errors, warnings)
    return warnings


def _finish_model(doc, origins=(), included=(), *, _warnings=None, _references_validated=False) -> Model:
    warnings = _model_warnings(doc, origins) if _warnings is None else _warnings
    model = Model.model_validate({**dict(doc), "warnings": warnings})

    model._provenance = origins
    model._included = included
    if not _references_validated:
        validate_declarations(model)
    _attach_compiled_obligations(model)
    return model



def _load_model_at(data, *, source, descriptor, historical=None, analysis=False):
    from gnd.model._includes import CompositionView, _refuse, compose, declares_includes

    doc = parse_model_document(data, source=source)
    if declares_includes(doc):
        issues = [] if analysis else None
        doc, origins, included = compose(doc, descriptor=descriptor, source=source,
                                         historical=historical, issues=issues)
        if analysis:
            warnings = []
            try:
                warnings = _model_warnings(doc, origins)
                _validate_reference_document(doc)
            except ModelValidationError as error:
                issues.extend(error.issues)
            except ReferenceInputError as error:
                issues.append(ValidationIssue(path='$.reference_populations', message=str(error),
                                              rule_id='evolve:reference-ownership'))
            if issues:
                return CompositionView(doc, origins, included, tuple(issues))
            model = _finish_model(doc, origins, included, _warnings=warnings, _references_validated=True)
        else:
            model = _finish_model(doc, origins, included)
        model._authored_sha256 = hashlib.sha256(data).hexdigest()
        return CompositionView(doc, origins, included, (), model) if analysis else model
    if historical is not None:
        _refuse('declaration')
    model = load_model_bytes(data, source=source)
    if model.reference_populations:
        model._authored_sha256 = hashlib.sha256(data).hexdigest()
    return CompositionView(doc, (), (), (), model) if analysis else model


def load_model_bytes_composed(data: bytes, *, source: str | Path, root: str | Path,
                              bind_references: bool = True) -> Model:
    """Resolve the authored model and bind references under one retained root.

    ``bind_references=False`` composes and authenticates the includes under
    ``root`` but leaves declared reference populations unbound, for a caller
    that binds them itself under another root (``gnd judgments check
    --reference-root``). Composition and validation are the same either way.
    """
    return _composed_view(data, source=source, root=root, bind_references=bind_references)


def _composed_view(data, *, source, root, historical=None, analysis=False,
                   bind_references=True):
    with retained_root(root) as descriptor:
        result = _load_model_at(data, source=source, descriptor=descriptor,
                                historical=historical, analysis=analysis)
        model = result.model if analysis else result
        if model is None:
            return result
        if bind_references and model.reference_populations:
            try:
                model._references = _bind_at(model, descriptor)
            except ReferenceHashMismatch:
                raise
            except Exception as error:
                raise ReferenceInputError(str(error), model=model) from error
        return result


def _load_model_bytes_captured(data, *, source, candidate=False):
    from gnd.model._includes import _refuse, guard_bytes, include_reason

    try:
        guard_bytes(data, source=source, route='captured-proposal-input')
    except ModelValidationError as error:
        if include_reason(error) != 'include:unsupported-route':
            raise
        if candidate:
            return load_model_bytes_composed(data, source=source, root=Path(source).parent)
        model = _load_model_no_follow(Path(source))
        if model._authored_sha256 != hashlib.sha256(data).hexdigest():
            _refuse('hash-mismatch')
        return model
    return load_model_bytes(data, source=source)

def _load_model_no_follow(path: Path) -> Model:
    """Strict path intake for consumers whose contract forbids symlink traversal."""
    from gnd import artifacts

    with retained_root(path.parent) as descriptor:
        data, _ = artifacts.read_regular_bounded_at(
            descriptor, path.name, max_bytes=MAX_MODEL_BYTES
        )
        model = _load_model_at(data, source=path, descriptor=descriptor)
        if model.reference_populations:
            try:
                model._references = _bind_at(model, descriptor)
            except ReferenceHashMismatch:
                raise
            except Exception as error:
                raise ReferenceInputError(str(error), model=model) from error
        return model


def load_model(path: str | Path) -> Model:
    """Read model and reference bytes beneath a single retained directory."""

    from gnd import artifacts

    path = Path(path)
    if hasattr(os, "O_NOFOLLOW") and hasattr(os, "O_DIRECTORY"):
        try:
            return _load_model_no_follow(path)
        except (OSError, artifacts.ArtifactError):
            # Only reference-free models retain the historical symlink route.
            pass
    import stat

    if not stat.S_ISREG(path.stat().st_mode):
        raise ModelLoadError("model path is not a regular file")
    with path.open("rb") as handle:
        data = handle.read(MAX_MODEL_BYTES + 1)
    from gnd.model._includes import _refuse, declares_includes
    if declares_includes(parse_model_document(data, source=path)):
        _refuse("unreadable", "$.includes")
    model = load_model_bytes(data, source=path)
    if model.reference_populations:
        raise ReferenceInputError(
            "safe reference descriptor traversal is unavailable or refused the model path",
            model=model,
        )
    return model
"""RF3 shared dependency home; algorithms retain predecessor semantics."""
from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any

from pydantic import BaseModel, ConfigDict, Field, PrivateAttr, model_serializer

from gnd.errors import ValidationIssue


class DeonticNote(BaseModel):
    """A retained top-level deontic note from the ORM document."""

    text: str
    rationale: str | None = None


@dataclass(frozen=True)
class ElementOrigin:
    origin: str
    composed_address: str
    original_address: str
    element_id: str | None


@dataclass(frozen=True)
class IncludedFile:
    id: str
    path: str
    sha256: str
    version: int
    model_id: str | None
    source: dict[str, Any] | None
    raw: bytes = field(default=b"", repr=False, compare=False)


class Model(BaseModel):
    """A loaded, validated ORM conceptual model."""

    # Attribute assignment is the common mutation path and should fail
    # immediately. Nested dictionaries/lists remain mutable, so Population's
    # validation marker also binds a digest of current model content.
    model_config = ConfigDict(frozen=True, extra="forbid")

    version: int
    #: D-06: a stable, OPAQUE identifier for this model. Optional for backward
    #: compatibility — every model authored before the field existed has None,
    #: and the population header cross-check simply does not run for those. It
    #: is never resolved to a path and never opened (T-01.1-01); the
    #: unforgeable runtime proof that a population was validated against THIS
    #: model is ``Population.validated_against`` (D-02), not this string.
    model_id: str | None = None
    source: dict[str, Any] = Field(default_factory=dict)
    object_types: list[dict[str, Any]]
    fact_types: list[dict[str, Any]]
    constraints: list[dict[str, Any]] = Field(default_factory=list)
    #: ORM+ v2 state transitions, raw dicts like every other section. A v1
    #: document loads with ``operations: []`` and is byte-identical to what it
    #: loaded before v2 existed. Every downstream consumer feature-detects on
    #: THIS list being non-empty, never on ``version``: a ``version: 2``
    #: document that declares no operations must behave exactly like a v1 one,
    #: and a version test would silently make it behave differently.
    operations: list[dict[str, Any]] = Field(default_factory=list)
    reference_populations: list[dict[str, Any]] = Field(default_factory=list)
    includes: list[dict[str, Any]] = Field(default_factory=list)
    fact_type_constraints: list[dict[str, Any]] = Field(default_factory=list)
    _provenance: tuple[ElementOrigin, ...] = PrivateAttr(default=())
    _included: tuple[IncludedFile, ...] = PrivateAttr(default=())
    _authored_sha256: str | None = PrivateAttr(default=None)
    _references: Any = PrivateAttr(default=None)
    rejected_proposals: list[dict[str, Any]] = Field(default_factory=list)
    #: Trace-compiled obligations, keyed by operation id (B2). A SIDE TABLE
    #: rather than an ``operation["compiled"]`` key, which is what the plan and
    #: the phase spec first described.
    #:
    #: The attachment was tried and reproduced a defect: ``operations_digest``
    #: is taken over the operations section, so writing into those dicts moved
    #: the digest and every committed steps.json stopped matching its own model.
    #: Stripping the key back out before hashing would have worked only if no
    #: author could ever write one -- and ``$defs.operation`` does not set
    #: ``additionalProperties: false``, so an authored ``compiled:`` key is legal
    #: YAML that the digest would then silently ignore. A private attribute has
    #: neither problem: the loaded section stays exactly as authored, and there
    #: is nothing for a key to collide with.
    _compiled: dict[str, list[dict[str, Any]]] = PrivateAttr(default_factory=dict)

    def model_dump(self, *args: Any, **kwargs: Any) -> dict[str, Any]:
        document = super().model_dump(*args, **kwargs)
        if not self.reference_populations:
            document.pop("reference_populations", None)
        return document

    @model_serializer(mode="wrap")
    def _omit_empty_include_fields(self, handler):
        document = handler(self)
        for name in ("includes", "fact_type_constraints"):
            if not getattr(self, name):
                document.pop(name, None)
        return document

    def compiled_obligations(self, operation_id: str) -> list[dict[str, Any]]:
        """The compiled and retained obligations of one operation, in order."""
        return self._compiled.get(str(operation_id), [])

    deontic_notes: list[DeonticNote] = Field(default_factory=list)
    warnings: list[ValidationIssue] = Field(default_factory=list)


DeonticNote.__module__ = 'gnd.model'

Model.__module__ = 'gnd.model'



413: def _read_retained(run):
414:     raw_manifest = _read(run, "run.json")
415:     manifest = _decode(raw_manifest)
416:     _need(raw_manifest == canonical_json_bytes(manifest), "noncanonical reading manifest")
417:     roster = manifest.get("artifacts")
418:     _need(manifest.get("format") == "literature-reading-run/1"
419:           and isinstance(roster, dict) and set(roster) == set(FILES), "incomplete stage roster")
420:     artifacts = {}
421:     predecessor = None
422:     for index, stage in enumerate(STAGES):
423:         name = f"stage-{index}.json"
424:         raw = _read(run, name)
425:         stage_record = _decode(raw)
426:         _need(sha256_hex(raw) == roster[name] and stage_record.get("stage") == stage
427:               and stage_record.get("predecessor_sha256") == predecessor
428:               and stage_record.get("payload_sha256") == roster[f"payload-{index}.json"],
429:               "stale retained reading stage")
430:         artifacts[name] = raw
431:         predecessor = sha256_hex(raw)
432:     for name in FILES:
433:         if name in artifacts:
434:             continue
435:         raw = _read(run, name)
436:         _need(sha256_hex(raw) == roster[name], "stale retained reading output")
437:         artifacts[name] = raw
438:     retained = {}
439:     for stage_index in (1, 3):
440:         payload = _decode(artifacts[f"payload-{stage_index}.json"])
441:         retained.update({row["section"]: row["response"] for row in payload["attempts"]})
442:     return manifest, artifacts, retained

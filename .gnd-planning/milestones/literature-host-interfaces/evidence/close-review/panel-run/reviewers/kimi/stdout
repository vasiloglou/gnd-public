\": 1, \"check\": 1}\n194\t    assert report[\"absence\"] == {\"status\": \"qualified\", \"below_floor_status\": \"unavailable\"}\n195\t    population = json.loads((tmp_path / \"run/broad.population.json\").read_bytes())\n196\t    assert population[\"facts\"][\"paper_venue\"] == [{\"paper\": \"paper-a\", \"value\": \"Host workshop\"}]\n197\t\n198\t\n199\t@pytest.mark.parametrize(\"missing\", [\"gold.json\", \"calibration.json\", \"calibration.txt\", \"conflict.json\",\n200\t                                     \"conflict.txt\", \"scope.json\", \"closure.json\"])\n201\tdef test_t6_a_declared_file_that_is_missing_refuses(tmp_path, missing):\n202\t    root = _root(tmp_path, declared=True)\n203\t    (root / missing).unlink()\n204\t    out = tmp_path / \"run\"\n205\t    _refuses(out, lambda: reading.run(out, fixture=root, producer=Forbidden(), reviewer=Reviewer()))\n206\t\n207\t\n208\tdef test_t7_a_document_budget_ends_one_document(tmp_path):\n209\t    report = reading.run(tmp_path / \"run\", fixture=CALLER, producer=Producer(), document_budget=72)\n210\t    documents = {row[\"source\"]: row for row in report[\"documents\"]}\n211\t    assert \"a-methods\" in report[\"omitted\"]\n212\t    assert {row[\"section\"] for row in report[\"inspections\"]} >= {\"a-opening\", \"a-results\"}\n213\t    assert documents[\"survey-a\"][\"stop\"] == \"budget-exhausted\" and documents[\"survey-a\"][\"omitted\"] == 1\n214\t    assert documents[\"survey-b\"][\"omitted\"] == 0 and documents[\"survey-b\"][\"attempted\"] == 2\n215\t    assert documents[\"survey-b\"][\"stop\"] == \"available-evidence-exhausted\"\n216\t    assert report[\"stop\"] == \"budget-exhausted\"\n217\t    assert sum(row[\"reading_bytes\"] for row in documents.values()) == report[\"reading_bytes\"]\n218\t\n219\t\n220\tdef test_t7_a_source_with_nothing_required_is_complete(tmp_path):\n221\t    root = _root(tmp_path)\n222\t\n223\t    def relax(roster):\n224\t        for question in roster[\"questions\"]:\n225\t            
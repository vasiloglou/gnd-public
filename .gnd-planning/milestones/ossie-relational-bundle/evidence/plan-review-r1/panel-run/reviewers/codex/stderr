   627	def _loss_report_bytes(digest, source_identity, identity_verified, rows) -> bytes:
   628	    # Serialize each row once and cap the total before a foreign tree can
   629	    # amplify to a large report through repeated pointer prefixes.
   630	    empty = canonical_json_bytes({
   631	        "schema": "gnd-ossie-import-loss/1",
   632	        "document_sha256": digest,
   633	        "source_model_identity": source_identity,
   634	        "source_identity_verified": identity_verified,
   635	        "dispositions": [],
   636	    })
   637	    prefix, _, suffix = empty.partition(b'"dispositions":[]')
   638	    result = bytearray(prefix)
   639	    result.extend(b'"dispositions":[')
   640	    for i, row in enumerate(rows):
   641	        data = canonical_json_bytes(row).rstrip()
   642	        if len(result) + len(data) + len(suffix) + 2 > 2 * MAX_BYTES:
   643	            raise OssieImportError("loss-size")
   644	        if i:
   645	            result.extend(b",")
   646	        result.extend(data)
   647	    result.extend(b"]")
   648	    result.extend(suffix)
   649	    return bytes(result)

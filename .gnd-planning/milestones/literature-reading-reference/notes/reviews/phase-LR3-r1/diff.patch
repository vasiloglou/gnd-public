+{"role":"tool","tool_call_id":"tool_vRQ7qzwxkiRsl8RtqRUBDJhF","content":"1\tfrom __future__ import annotations\n2\t\n3\timport gnd.export.verification_service as _handler_export_verification_service\n4\tfrom gnd.commands._arguments import _add_format_argument, _add_unredacted_argument\n5\t\n6\t\n7\tdef _register_verify(subparsers):\n8\t    verify_parser = subparsers.add_parser(\n9\t        \"verify\",\n10\t        help=\"run the full derived verifier over a pre-extracted population (VER-01, VER-02)\",\n11\t        description=(\n12\t            \"Run the full derived verifier: popvalidate then check over a \"\n13\t            \"PRE-EXTRACTED population file. This command never calls a model \"\n14\t            \"and never orchestrates extraction (R-03''): the executing agent \"\n15\t            \"running the gnd-extract skill writes the population and its \"\n16\t            \"<population>.extraction.json sidecar, and verify validates the \"\n17\t            \"handoff before composing the checker. Exit bands are REUSED \"\n18\t            \"unchanged with precedence 3 > 1 > 4 > 2 > 0: 3 ill-formed \"\n19\t            \"(including an ill-formed extraction handoff), 1 alethic fail, 4 \"\n20\t            \"indeterminate, 2 vacuous, 0 pass. The payload's extraction block \"\n21\t            \"carries the machine-readable state (ran | skipped | failed + \"\n22\t            \"reason); a missing sidecar is extraction:sidecar-missing, a \"\n23\t            \"malformed one extraction:sidecar-invalid, and a digest that does \"\n24\t            \"not match the file bytes extraction:binding-mismatch — all exit \"\n25\t            \"3, state failed. skipped is written ONLY by --no-extraction. \"\n26\t            \"Never a fidelity rate in this payload: a checker pass over an \"\n27\t            \"uncalibrated extraction is checker acceptance, not proof of \"\n28\t            \"faithfulness.\"\n29\t        ),\n30\t    )\n31\t    verify_parser.add_argument(\"model\", help=\"path to the model file\")\n32\t    verify_parser.add_argument(\n33\t        \"population\", help=\"path to the PRE-EXTRACTED population file (YAML or JSON)\"\n34\t    )\n35\t    verify_parser.add_argument(\n36\t        \"--sidecar\",\n37\t        default=None,\n38\t        help=(\n39\t            \"path to the extraction sidecar (default: the population path with \"\n40\t            \"an .extraction.json suffix, beside the population)\"\n41\t        ),\n42\t    )\n43\t    verify_parser.add_argument(\n44\t        \"--artifacts\",\n45\t        default=None,\n46\t        help=(\n47\t            \"directory containing the model's extraction bundle; required on \"\n48\t            \"the extraction path so projection_sha256 is verified\"\n49\t        ),\n50\t    )\n51\t    verify_parser.add_argument(\n52\t        \"--no-extraction\",\n53\t        dest=\"no_extraction\",\n54\t        action=\"store_true\",\n55\t        help=(\n56\t            \"the INTENTIONAL opt-out: check a population that was not produced \"\n57\t            \"by an extraction; records extraction.state=skipped with the reason\"\n58\t        ),\n59\t    )\n60\t    verify_parser.add_argument(\n61\t        \"--out\",\n62\t        default=None,\n63\t        help=\"also write the JSON payload to this path (from argv only)\",\n64\t    )\n65\t    _add_format_argument(verify_parser)\n66\t    _add_unredacted_argument(verify_parser)\n67\t\n68\t    return {'verify_parser': verify_parser}\n69\t\n70\t\n71\tdef add_parsers(subparsers, *, command: str | None = None):\n72\t    parsers = {}\n73\t    if command is None or command == 'verify':\n74\t        selected = _register_verify(subparsers)\n75\t        parsers.update(selected)\n76\t        selected['verify_parser'].set_defaults(handler=lambda args, selected=selected: handle(args, selected))\n77\t    if not parsers:\n78\t        raise ValueError(f\"unsupported command: {command}\")\n79\t    return parsers\n80\t\n81\t\n82\tdef handle(args, parsers) -> int:\n83\t    verify_parser = parsers.get('verify_parser')\n84\t    if args.command == \"verify\":\n85\t        if args.no_extraction and args.sidecar is not None:\n86\t            # A usage contradiction, not a verdict: --sidecar names a handoff\n87\t            # to validate while --no-extraction opts out of extraction\n88\t            # entirely. Routed through the parser so it exits 64 with no\n89\t            # payload, exactly like every other malformed invocation (WR-03).\n90\t            verify_parser.error(\n91\t                \"--sidecar and --no-extraction are contradictory: --sidecar \"\n92\t                \"names an extraction handoff to validate, --no-extraction \"\n93\t                \"declares there was none\"\n94\t            )\n95\t        return _handler_export_verification_service._cmd_verify(\n96\t            args.model,\n97\t            args.population,\n98\t            args.sidecar,\n99\t            args.artifacts,\n100\t            args.no_extraction,"}

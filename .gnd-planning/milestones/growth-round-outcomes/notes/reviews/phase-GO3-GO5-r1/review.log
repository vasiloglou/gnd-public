#: The matrix cells `gnd evolve preview --policy additive` can refuse (MG2).
#: One closed spelling, shared by the preview document, the policy walk and
#: the contract table; a cell outside it fails to read.
PolicyCell = Literal[
    "object_types.modify",
    "object_types.rename",
    "object_types.delete",
    "fact_types.modify",
    "fact_types.rename",
    "fact_types.delete",
    "role.add",
    "role.modify",
    "role.rename",
    "role.delete",
    "constraint.populated.add",
    "constraint.populated.modify",
    "model_identity.modify",
    "source_document.modify",
    "source_document.delete",
    "include.repin-include",
]

#: The four optional preview fields the additive policy writes. They are
#: omitted from the serialized document when unset, so a preview made without
#: `--policy` keeps the bytes and `preview_sha256` it had before the policy
#: existed; `accepted_blast_radius_sha256` keeps writing `null` as before.
_POLICY_FIELDS = ("policy", "populated_args", "populated", "policy_issues")

#: Every optional preview field omitted when unset: the policy's four, the
#: shape report's one (MG3) and the population check's one (UG2), under the
#: same rule.
_OPTIONAL_PREVIEW_FIELDS = (*_POLICY_FIELDS, "shape_matches", "population_check",
                            "before_includes", "candidate_includes", "operation_outcomes")


class EvolutionPolicyGapError(Exception):
    """A locator kind the additive policy has no rule for (UG3, exit 3 by type).

    Fail closed: an unknown kind is refused, never admitted. It carries the
    kind word only, never operator text. The locator union is closed, so this
    is reachable only through ``model_construct``."""

    def __init__(self, locator_kind: str) -> None:
        super().__init__(f"the additive policy has no rule for locator kind {locator_kind!r}")
        self.locator_kind = locator_kind


class PolicyIssue(_ClosedFrozenModel):
    """One operation the additive policy refused, by index, locator and cell.

    `detail` names ids, key names and the verdict word only; it never carries a
    constraint or sample value, so the preview stays value-free."""

    operation_index: int = Field(ge=0)
    operation_id: StableId
    reference: NonEmptyString
    cell: PolicyCell
    detail: NonEmptyString


#: GO2 (#227): what one preview says about each operation of a proposal. The
#: evolution contract's preview section is the home of these words.
OperationVerdict = Literal[
    "admitted",
    "refused-by-policy",
    "refused-by-validation",
    "refused-by-d12",
    "dropped-with",
    "unassessed",
]
#: The preview's gates in the order it runs them (GO2). An outcome row names
#: the ones that did not run over its operation.
OutcomeGate = Literal[
    "current-model",
    "include-ownership",
    "operations-gate",
    "candidate-validation",
    "semantic-validation",
    "replay-equality",
    "d12",
    "policy",
]
OUTCOME_GATES: tuple[str, ...] = OutcomeGate.__args__  # type: ignore[attr-defined]


class OperationOutcome(_ClosedFrozenModel):
    """One operation's outcome (GO2). ``detail`` names ids, rule ids and verdict
    words only, as `PolicyIssue.detail` does, so a preview stays value-free."""

    operation_index: int = Field(ge=0)
    operation_id: StableId
    reference: NonEmptyString
    verdict: OperationVerdict
    detail: str = Field(default="", max_length=512)
    gates_not_run: tuple[OutcomeGate, ...] = ()

    @model_validator(mode="after")
    def _gates_match_verdict(self) -> OperationOutcome:
        if (self.verdict == "unassessed") != bool(self.gates_not_run):
            raise ValueError("gates_not_run is set exactly when the verdict is unassessed")
        if list(self.gates_not_run) != sorted(set(self.gates_not_run), key=OUTCOME_GATES.index):
            raise ValueError("gates_not_run must be unique and in gate order")
        return self


def _outcomes_cover(outcomes: tuple[OperationOutcome, ...], operations: tuple[Any, ...] | None) -> None:
    """Rows are the operations in order: one row each, with its id and reference."""
    if [row.operation_index for row in outcomes] != list(range(len(outcomes))):
        raise ValueError("operation_outcomes must hold one row per operation, in order")
    if operations is None:
        return
    if len(outcomes) != len(operations):
        raise ValueError("operation_outcomes must hold one row per operation, in order")
    for row, operation in zip(outcomes, operations, strict=True):
        if (row.operation_id, row.reference) != (operation.operation_id, operation.locator.reference()):
            raise ValueError("operation_outcomes names an operation the proposal does not carry")


class OutcomeRefusal(_ClosedFrozenModel):
    """The refusal that stopped a preview (GO2): its gate, its exit and its
    message exactly as `gnd evolve preview` printed it."""

    gate: OutcomeGate
    exit: int = Field(ge=1, le=255)
    message: NonEmptyString


class EvolutionOutcomeReport(_ClosedFrozenModel):
    """GO2: the outcome of every operation of a proposal no preview was written
    for. Its own type, so `apply` refuses it where a preview is due."""

    schema_version: Literal[1] = 1
    kind: Literal["evolution-outcome-report"] = "evolution-outcome-report"
    proposal_id: StableId
    proposal_sha256: Sha256String
    before_model: CommittedText
    refusal: OutcomeRefusal
    operation_outcomes: tuple[OperationOutcome, ...]

    @model_validator(mode="after")
    def _rows_in_order(self) -> EvolutionOutcomeReport:
        _outcomes_cover(self.operation_outcomes, None)
        return self


def read_evolution_outcome_report_document(document: Any) -> EvolutionOutcomeReport:
    """The closed reader of an outcome report: any other JSON is a named refusal."""
    return EvolutionOutcomeReport.model_validate(document)


#: The population check's outcome per constraint operation (UG2). The checker's
#: five verdict words, spelled as `gnd.checker` spells them, plus three of the
#: check's own: a populated subject with no fact in the population, a subject
#: with sample rows in the current model, and a verdict that could not be
#: located (a defect guard). Only `pass` clears a refusal.
PopulationOutcome = Literal[
    "pass",
    "fail",
    "warning",
    "unchecked",
    "vacuous",
    "uncovered",
    "sample-rows",
    "not-located",
]


class PopulationAdmission(_ClosedFrozenModel):
    """One populated-constraint operation the supplied population cleared (UG2)."""

    operation_index: int = Field(ge=0)
    reference: NonEmptyString
    outcome: Literal["pass"]


class PopulationCheckRecord(_ClosedFrozenModel):
    """What a `--check-population` admission rested on: digests and ids only (UG2).

    No path, no count and no population value; `admitted` is in operation order.
    """

    sha256: Sha256String
    model_id: NonEmptyString
    admitted: tuple[PopulationAdmission, ...]

    @model_validator(mode="after")
    def _admitted_in_order(self) -> PopulationCheckRecord:
        indexes = [row.operation_index for row in self.admitted]
        if indexes != sorted(set(indexes)):
            raise ValueError("population_check.admitted must be unique and in operation order")

## Constraints — top-level (cross-fact-type and object-type scope)

```yaml
constraints:
  # External uniqueness (composite identifier across binary fact types)
  - type: uniqueness
    scope: external
    role_refs:
      # Reference the country and code roles so the SHARED State entity is the
      # anchor role of both fact types — the checker joins on shared anchor
      # object types; disjoint anchors would make the join undefined (unchecked).
      - { fact_type: state_in_country, role: country }
      - { fact_type: state_has_code, role: code }
    preferred: true                           # double-bar — this composite is the entity's preferred identifier
    source: explicit
    status: confirmed
    modality: alethic
    provenance: { csdp_step: 4, dialogue_turn: 22, user_quote: "Country plus state code identifies a state." }

  # Mandatory-disjunctive (inclusive-or)
  - type: mandatory-disjunctive
    role_refs:
      - { fact_type: visitor_has_passport, role: visitor }
      - { fact_type: visitor_has_license, role: visitor }
    source: common-sense
    status: proposed
    modality: deontic
    rationale: "Visitors must present at least one identity document."
    provenance: { library_entry: identity-document-required, matched_pattern: "visitor identity alternatives" }

  # Object-type value constraint (enumeration)
  - type: value
    object_type: gender
    allowed: ['M', 'F']
    source: explicit
    status: confirmed
    modality: alethic
    provenance: { csdp_step: 6, dialogue_turn: 25, user_quote: "Gender is recorded as M or F." }

  # Object-type value constraint (single range)
  - type: value
    object_type: age
    range:
      min: 0
      min_inclusive: true
      max_inclusive: false                    # max omitted → open-ended above
    source: common-sense
    status: proposed
    modality: deontic
    rationale: "Ages are non-negative."
    provenance: { library_entry: non-negative-age, matched_pattern: "Age value type" }

  # Object-type value constraint (multiple disjoint ranges)
  - type: value
    object_type: latitude_offset
    ranges:                                   # list form for multiple disjoint ranges
      - { min: -100, max: -20, min_inclusive: true, max_inclusive: true }
      - { min:   40, max: 100, min_inclusive: true, max_inclusive: true }
    source: user-supplied
    status: confirmed
    modality: alethic
    provenance: { added_at_step: 7d }

  # Role-scope value constraint (hybrid `object_type` + `role_ref` form)
  # Use when a generic primitive value type (e.g., Integer) appears in multiple
  # roles that each want different bounds. The `object_type` names the primitive
  # being constrained; `role_ref` narrows the scope to a specific role.
  - type: value
    object_type: integer                      # the primitive being constrained
"""Deterministic large models for the Rmap time-bound tests (OB2 T4)."""

from __future__ import annotations

_MOD = {"source": "explicit", "status": "confirmed", "modality": "alethic", "provenance": {"user_quote": "generated"}}


def _uc(roles):
    return {"type": "uniqueness", "roles": roles, **_MOD}


def large_rmap_model(entities: int = 1400, fact_types: int = 4500) -> dict:
    """``entities`` popular-reference entities and ``fact_types`` fact types: one in four
    functional to a value type, m:n between entities, unary, or ternary with an n-1 key."""
    objects = [{"id": "code", "name": "Code", "kind": "value", "primitive": "String"}]
    for e in range(entities):
        objects.append({"id": f"e{e:05d}", "name": f"E{e:05d}", "kind": "entity",
                        "reference": {"mode": "popular", "value_type": f"e{e:05d}_id"}})
        objects.append({"id": f"e{e:05d}_id", "name": f"E{e:05d}Id", "kind": "value", "primitive": "Integer"})
    facts = []
    for f in range(fact_types):
        a, b, c = f"e{f % entities:05d}", f"e{(f * 7 + 1) % entities:05d}", f"e{(f * 13 + 2) % entities:05d}"
        fid = f"f{f:05d}"
        shape = f % 4
        if shape == 0:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} has {{Code}}",
                          "roles": [{"object_type": a, "role_name": "subject"}, {"object_type": "code", "role_name": "code"}],
                          "constraints": [_uc(["subject"])]})
        elif shape == 1:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} relates to {{E{b[1:]}}}",
                          "roles": [{"object_type": a, "role_name": "left"}, {"object_type": b, "role_name": "right"}],
                          "constraints": [_uc(["left", "right"])]})
        elif shape == 2:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} is flagged",
                          "roles": [{"object_type": a, "role_name": "subject"}]})
        else:
            facts.append({"id": fid, "reading": f"{{E{a[1:]}}} meets {{E{b[1:]}}} at {{E{c[1:]}}}",
                          "roles": [{"object_type": a, "role_name": "first"}, {"object_type": b, "role_name": "second"},
                                    {"object_type": c, "role_name": "place"}],
                          "constraints": [_uc(["first", "second"])]})
    return {"version": 1, "source": {"kind": "text-conversation", "confidence": "standard", "mode": "guided"},
            "object_types": objects, "fact_types": facts}

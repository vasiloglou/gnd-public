+{"role":"tool","tool_call_id":"tool_zn73IzmXsMNgQAOF3NPQjtDd","content":"1\t\"\"\"Publish the positive contextual assertions selected by saved judgments.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport asyncio\n7\timport json\n8\timport math\n9\timport os\n10\timport re\n11\timport sys\n12\timport tempfile\n13\tfrom collections import deque\n14\tfrom pathlib import Path, PurePosixPath\n15\tfrom typing import Any\n16\t\n17\tfrom gnd.anchors import read_regular_path, strict_json\n18\tfrom gnd.artifacts import ArtifactError, canonical_json_bytes, publish_directory_once, sha256_hex\n19\tfrom gnd.disclosure import ENVIRONMENT as DISCLOSURE_ENV\n20\tfrom gnd.process import ProcessLimits, run_bounded_process\n21\tfrom gnd.synth.identity import scalar_identity\n22\t\n23\tfrom .assurance_report import Refusal\n24\t\n25\tSCHEMA = \"literature-assertion-admission/1\"\n26\tSHAPED_SCHEMA = \"literature-assertion-admission/2\"\n27\tSHAPE_FORMAT = \"literature-assertion-shape/1\"\n28\tMAX_ROWS, MAX_ROWS_CEILING = 16384, 65536\n29\tRULES_FORMAT = \"literature-admission-rules/1\"\n30\tMAX_REQUIREMENTS = 64\n31\tRULE_NAME = re.compile(r\"[a-z][a-z0-9-]{0,63}\\Z\")\n32\tSTATEMENT = \"assertion_statement\"\n33\tWORK = \"assertion_names_work\"\n34\tPASSAGE = \"assertion_names_passage\"\n35\tMODEL, RAW, POLICY, RECEIPTS = \"model.orm.yaml\", \"raw.population.json\", \"policy.json\", \"receipts.json\"\n36\tREPORT, ADMITTED, RECORD = \"judgment-report.json\", \"admitted.population.json\", \"admission.json\"\n37\tCAP = 10 << 20\n38\tREPORT_CAP = 16 << 20\n39\tMAX_TARGETS = 1024\n40\tABSENT_CONDITIONS = frozenset({\"unspecified\", \"none\", \"n/a\"})\n41\tROLES = {\n42\t    \"passage\", \"work\", \"version\", \"predicate\", \"actor\", \"actor_kind\", \"object\", \"object_kind\",\n43\t    \"qualification\", \"condition\", \"regime\", \"experiment\", \"polarity\", \"attribution\",\n44\t}\n45\tTAGS = {\n46\t    \"actor_kind\": (\"sense\", \"mention\"), \"object_kind\": (\"sense\", \"mention\"),\n47\t    \"qualification\": (\"conditional\", \"unqualified\"), \"polarity\": (\"asserts\", \"negates\"),\n48\t    \"attribution\": (\"own-finding\", \"baseline-comparison\", \"speculation\", \"cites-other-work\"),\n49\t}\n50\tDEFAULT_RULES = {\"format\": RULES_FORMAT, \"requirements\": [\n51\t    {\"id\": \"positive\", \"fact_type\": STATEMENT, \"role\": \"polarity\", \"admissible\": [\"asserts\"],\n52\t     \"reasons\": [{\"value\": \"negates\", \"reason\": \"negated\"}]},\n53\t    {\"id\": \"own-finding\", \"fact_type\": STATEMENT, \"role\": \"attribution\", \"admissible\": [\"own-finding\"],\n54\t     \"reasons\": [{\"value\": value, \"reason\": value}\n55\t                 for value in (\"baseline-comparison\", \"speculation\", \"cites-other-work\")]},\n56\t]}\n57\tLIMITS = ProcessLimits(timeout_seconds=90, terminate_grace_seconds=1, stdin_limit_bytes=0,\n58\t                       stdout_limit_bytes=REPORT_CAP, stderr_limit_bytes=128 << 10,\n59\t                       total_output_limit_bytes=REPORT_CAP + (128 << 10))\n60\t\n61\t\n62\tdef _rows(value: Any, roles: set[str]) -> list[dict]:\n63\t    if not isinstance(value, list) or len(value) > MAX_TARGETS:\n64\t        raise Refusal(\"input:invalid-contextual-population\")\n65\t    for row in value:\n66\t        if (not isinstance(row, dict) or set(row) != roles\n67\t                or not all(isinstance(item, str) and item.strip() for item in row.values())):\n68\t            raise Refusal(\"input:invalid-contextual-population\")\n69\t    return value\n70\t\n71\t\n72\tdef _identities(works: list[dict], passages: list[dict]) -> dict[tuple[str, str], str]:\n73\t    work_by_id = {row[\"assertion\"]: row[\"work\"] for row in works}\n74\t    passage_by_id = {row[\"assertion\"]: row[\"passage\"] for row in passages}\n75\t    if len(work_by_id) != len(works) or len(passage_by_id) != len(passages) or work_by_id.keys() != passage_by_id.keys():\n76\t        raise Refusal(\"input:assertion-identities\")\n77\t    by_location = {(work, passage_by_id[identifier]): identifier for identifier, work in work_by_id.items()}\n78\t    if len(by_location) != len(work_by_id):\n79\t        raise Refusal(\"input:assertion-identities\")\n80\t    return by_location\n81\t\n82\t\n83\tdef _targets(items: Any, count: int) -> dict[int, dict]:\n84\t    if not isinstance(items, list) or len(items) > MAX_TARGETS:\n85\t        raise Refusal(\"judgments:invalid-result\")\n86\t    by_index = {}\n87\t    for item in items:\n88\t        if not isinstance(item, dict) or item.get(\"fact_type\") != STATEMENT:\n89\t            raise Refusal(\"judgments:invalid-result\")\n90\t        index, judgments = item.get(\"index\"), item.get(\"judgments\")\n91\t        if (type(index) is not int or not 0 <= index < count or index in by_index\n92\t                or type(item.get(\"admitted\")) is not bool or not isinstance(judgments, list) or len(judgments) > 32\n93\t                or not all(isinstance(j, dict) and j.get(\"verdict\") in (\"approve\", \"reject\", \"abstain\", \"missing\")\n94\t                           for j in judgments)):\n95\t            raise Refusal(\"judgments:invalid-result\")\n96\t        by_index[index] = item\n97\t    return by_index\n98\t\n99\t\n100\tdef _target_reason(target: dict | None) -> str | None:\n101\t    \"\"\"Map one target's judgment to a support reason; None when it is admitted.\"\"\"\n102\t    if target is None:\n103\t        return \"missing\"\n104\t    if target[\"admitted\"]:\n105\t        return None\n106\t    verdicts = {item[\"verdict\"] for item in target[\"judgments\"]}\n107\t    for verdict, reason in ((\"missing\", \"missing\"), (\"reject\", \"rejected\"), (\"abstain\", \"abstained\")):\n108\t        if verdict in verdicts:\n109\t            return reason\n110\t    return \"approval-or-mechanical-floor\"\n111\t\n112\t\n113\tdef _support(row: dict, target: dict | None) -> str | None:\n114\t    missing = row[\"condition\"].strip().casefold() in ABSENT_CONDITIONS\n115\t    if row[\"qualification\"] == \"conditional\" and missing:\n116\t        return \"missing-condition\"\n117\t    if row[\"qualification\"] == \"unqualified\" and not missing:\n118\t        return \"qualification-mismatch\"\n119\t    return _target_reason(target)\n120\t\n121\t\n122\tdef _rule_value(value: Any) -> bool:\n123\t    \"\"\"A value a rule may name: a JSON scalar, a finite number included.\"\"\"\n124\t    return value is None or type(value) in (str, int, bool) or type(value) is float and math.isfinite(value)\n125\t\n126\t\n127\tdef _rules(value: Any, roles: dict[str, set[str]]) -> list[dict]:\n128\t    \"\"\"Check a rules document against the fact types its requirements may name, and normalize it.\"\"\"\n129\t    if (not isinstance(value, dict) or set(value) != {\"format\", \"requirements\"} or value[\"format\"] != RULES_FORMAT\n130\t            or not isinstance(value[\"requirements\"], list) or not 1 <= len(value[\"requirements\"]) <= MAX_REQUIREMENTS):\n131\t        raise Refusal(\"rules:invalid\")\n132\t    requirements, ids = [], set()\n133\t    for item in value[\"requirements\"]:\n134\t        if (not isinstance(item, dict) or not {\"id\", \"fact_type\", \"role\", \"admissible\"} <= set(item)\n135\t                or not set(item) <= {\"id\", \"fact_type\", \"role\", \"admissible\", \"reasons\"}\n136\t                or not isinstance(item[\"id\"], str) or RULE_NAME.fullmatch(item[\"id\"]) is None or item[\"id\"] in ids\n137\t                or not isinstance(item[\"fact_type\"], str) or not isinstance(item[\"role\"], str)\n138\t                or not isinstance(item[\"admissible\"], list) or not item[\"admissible\"]\n139\t                or not isinstance(item.get(\"reasons\", []), list)\n140\t                or not all(map(_rule_value, item[\"admissible\"]))):\n141\t            raise Refusal(\"rules:invalid\")\n142\t        ids.add(item[\"id\"])\n143\t        admissible = [_identity(entry) for entry in item[\"admissible\"]]\n144\t        reasons = {}\n145\t        for entry in item.get(\"reasons\", []):\n146\t            if (not isinstance(entry, dict) or set(entry) != {\"value\", \"reason\"} or not _rule_value(entry[\"value\"])\n147\t                    or not isinstance(entry[\"reason\"], str) or RULE_NAME.fullmatch(entry[\"reason\"]) is None):\n148\t                raise Refusal(\"rules:invalid\")\n149\t            reasons[_identity(entry[\"value\"])] = entry[\"reason\"]\n150\t        if (len(set(admissible)) != len(admissible) or len(reasons) != len(item.get(\"reasons\", []))\n151\t                or set(reasons) & set(admissible)):\n152\t            raise Refusal(\"rules:invalid\")\n153\t        if item[\"fact_type\"] not in roles:\n154\t            raise Refusal(\"rules:unknown-fact-type\")\n155\t        if item[\"role\"] not in roles[item[\"fact_type\"]]:\n156\t            raise Refusal(\"rules:unknown-role\")\n157\t        requirements.append({\"id\": item[\"id\"], \"fact_type\": item[\"fact_type\"], \"role\": item[\"role\"],\n158\t                             \"admissible\": frozenset(admissible), \"reasons\": reasons})\n159\t    return requirements\n160\t\n161\t\n162\tdef _evaluate_rules(requirements: list[dict], rows_of) -> str | None:\n163\t    \"\"\"The one evaluator: the first requirement an assertion fails gives its reason; None when it passes all.\n164\t\n165\t    An assertion satisfies a requirement when it has at least one row of the named fact type and every\n166\t    such row has an admissible value; the reason is the one declared for the offending value, else the\n167\t    requirement's ID.\n168\t    \"\"\"\n169\t    for requirement in requirements:\n170\t        rows = rows_of(requirement[\"fact_type\"])\n171\t        if not rows:\n172\t            return requirement[\"id\"]\n173\t        for row in rows:\n174\t            key = _identity(row[requirement[\"role\"]])\n175\t            if key not in requirement[\"admissible\"]:\n176\t                return requirement[\"reasons\"].get(key, requirement[\"id\"])\n177\t    return None\n178\t\n179\t\n180\tdef project(subject: Any, targets: Any, *, requirements: list[dict] | None = None,\n181\t            policy_status: str = \"fail\") -> tuple[dict, dict]:\n182\t    \"\"\"Project accepted positive occurrences and their original identity links.\n183\t\n184\t    ``requirements`` default to the packaged rules (polarity, then attribution); ``policy_status`` is the\n185\t    status of a supported statement that fails one, ``fail`` in a ``/1`` record and ``policy-refused`` in a\n186\t    ``/2`` record.\n187\t    \"\"\"\n188\t    requirements = _rules(DEFAULT_RULES, {STATEMENT: ROLES}) if requirements is None else requirements\n189\t    if not isinstance(subject, dict) or not isinstance(subject.get(\"population\"), dict):\n190\t        raise Refusal(\"input:invalid-contextual-population\")\n191\t    facts = subject.get(\"facts\")\n192\t    if not isinstance(facts, dict) or set(facts) != {STATEMENT, WORK, PASSAGE}:\n193\t        raise Refusal(\"input:invalid-contextual-population\")\n194\t    statements = _rows(facts[STATEMENT], ROLES)\n195\t    works = _rows(facts[WORK], {\"assertion\", \"work\"})\n196\t    passages = _rows(facts[PASSAGE], {\"assertion\", \"passage\"})\n197\t    identities = _identities(works, passages)\n198\t    locations = {(row[\"work\"], row[\"passage\"]) for row in statements}\n199\t    if locations != identities.keys() or len(locations) != len(statements):\n200\t        raise Refusal(\"input:assertion-identities\")\n201\t    verified = _targets(targets, len(statements))\n202\t    stages: dict[str, list[dict]] = {\"semantic-support\": [], \"positive-own-findings\": []}\n203\t    kept, included = [], set()\n204\t    for index, row in enumerate(statements):\n205\t        if any(row[tag] not in allowed for tag, allowed in TAGS.items()):\n206\t            raise Refusal(\"input:invalid-contextual-population\")\n207\t        support = _support(row, verified.get(index))\n208\t        effective = support\n209\t        if effective is None:\n210\t            effective = _evaluate_rules(requirements, lambda name, row=row: [row] if name == STATEMENT else [])\n211\t        stages[\"semantic-support\"].append(\n212\t            {\"index\": index, \"status\": \"pass\" if support is None else \"fail\", \"reason\": support})\n213\t        stages[\"positive-own-findings\"].append({\n214\t            \"index\": index, \"status\": \"pass\" if effective is None else \"fail\" if support is not None else policy_status,\n215\t            \"reason\": effective})\n216\t        if effective is None:\n217\t            kept.append(row)\n218\t            included.add(identities[row[\"work\"], row[\"passage\"]])\n219\t    return {\n220\t        **({\"format_version\": subject[\"format_version\"]} if \"format_version\" in subject else {}),\n221\t        \"population\": {**subject[\"population\"], \"source\": \"tool-output\", \"producer\": SCHEMA,\n222\t                       \"covers\": [STATEMENT, WORK, PASSAGE]},\n223\t        \"instances\": {},\n224\t        \"facts\": {\n225\t            STATEMENT: kept,\n226\t            WORK: [row for row in works if row[\"assertion\"] in included],\n227\t            PASSAGE: [row for row in passages if row[\"assertion\"] in included],\n228\t        },\n229\t    }, stages\n230\t\n231\t\n232\tdef _shape(value: Any) -> tuple[str, tuple[str, ...]]:\n233\t    if (not isinstance(value, dict) or set(value) != {\"format\", \"assertion\", \"follow\"}\n234\t            or value[\"format\"] != SHAPE_FORMAT or not isinstance(value[\"assertion\"], str)\n235\t            or not isinstance(value[\"follow\"], list)\n236\t            or not all(isinstance(name, str) for name in value[\"follow\"])\n237\t            or len(set(value[\"follow\"])) != len(value[\"follow\"]) or value[\"assertion\"] in value[\"follow\"]):\n238\t        raise Refusal(\"shape:invalid\")\n239\t    return value[\"assertion\"], tuple(value[\"follow\"])\n240\t\n241\t\n242\tdef _max_rows(value: Any) -> int:\n243\t    if value is None:\n244\t        return MAX_ROWS\n245\t    if type(value) is not int or not 1 <= value <= MAX_ROWS_CEILING:\n246\t        raise Refusal(\"input:max-rows\")\n247\t    return value\n248\t\n249\t\n250\tdef _include_paths(model_bytes: bytes) -> list[str]:\n251\t    \"\"\"The relative paths of the includes a model root declares.\"\"\"\n252\t    from gnd.model._includes import bytes_declare_includes\n253\t    from gnd.model._parsing import parse_model_document\n254\t\n255\t    if not bytes_declare_includes(model_bytes, source=MODEL):\n256\t        return []\n257\t    document = parse_model_document(model_bytes, source=MODEL)\n258\t    entries = document.get(\"includes\", []) if isinstance(document, dict) else None\n259\t    if not isinstance(entries, list):\n260\t        raise Refusal(\"input:include-path\")\n261\t    paths = []\n262\t    for entry in entries:\n263\t        path = entry.get(\"path\") if isinstance(entry, dict) else None\n264\t        parts = PurePosixPath(path).parts if isinstance(path, str) else ()\n265\t        if (not parts or PurePosixPath(path).is_absolute() or \"..\" in parts or \"\\\\\" in path\n266\t                or path in (MODEL, RAW, POLICY, RECEIPTS) or path in paths):\n267\t            raise Refusal(\"input:include-path\")\n268\t        paths.append(path)\n269\t    return paths\n270\t\n271\t\n272\tdef _model_document(snapshots: dict[str, bytes], includes: dict[str, bytes]) -> dict:\n273\t    \"\"\"The model the judgment route checks, as plain data, composed for an include root.\"\"\"\n274\t    from gnd.model import (\n275\t        ModelLoadError,\n276\t        ModelValidationError,\n277\t        load_model_bytes,\n278\t        load_model_bytes_composed,\n279\t    )\n280\t\n281\t    with tempfile.TemporaryDirectory(prefix=\"gnd-assertion-model-\") as folder:\n282\t        root = Path(folder).resolve()\n283\t        try:\n284\t            if includes:\n285\t                for name, raw in includes.items():\n286\t                    (root / name).parent.mkdir(parents=True, exist_ok=True)\n287\t                    (root / name).write_bytes(raw)\n288\t                loaded = load_model_bytes_composed(snapshots[MODEL], source=MODEL, root=root, bind_references=False)\n289\t            else:\n290\t                loaded = load_model_bytes(snapshots[MODEL], source=MODEL)\n291\t        except (ModelLoadError, ModelValidationError, ValueError, TypeError, OSError) as error:\n292\t            raise Refusal(\"input:model\") from error\n293\t    return loaded.model_dump(mode=\"json\", exclude_none=True)\n294\t\n295\t\n296\tdef _identity(value: Any) -> tuple:\n297\t    \"\"\"A handle's identity as the checker keeps it: booleans, numbers and strings apart, 1 and 1.0 one.\"\"\"\n298\t    if isinstance(value, (dict, list)):\n299\t        return (\"json\", canonical_json_bytes(value))\n300\t    return scalar_identity(value)\n301\t\n302\t\n303\tdef _attached_roles(model: dict, shape: Any) -> dict[str, set[str]]:\n304\t    \"\"\"The role names of each fact type a shape's assertion type plays a role in.\"\"\"\n305\t    assertion, _ = _shape(shape)\n306\t    return {item[\"id\"]: {role[\"role_name\"] for role in item[\"roles\"]} for item in model.get(\"fact_types\", [])\n307\t            if any(role[\"object_type\"] == assertion for role in item[\"roles\"])}\n308\t\n309\t\n310\tdef project_shaped(subject: Any, targets: Any, model: dict, shape: Any, max_rows: int = MAX_ROWS, *,\n311\t                   requirements: list[dict] | None = None) -> tuple[dict, dict]:\n312\t    \"\"\"Admit the assertions of a caller-named entity type, with every attached and followed row they keep.\"\"\"\n313\t    assertion, follow = _shape(shape)\n314\t    kinds = {item[\"id\"]: item[\"kind\"] for item in model.get(\"object_types\", [])}\n315\t    if kinds.get(assertion) != \"entity\":\n316\t        raise Refusal(\"shape:unknown-assertion\")\n317\t    if any(kinds.get(name) != \"entity\" for name in follow):\n318\t        raise Refusal(\"shape:unknown-follow\")\n319\t    fact_types = model.get(\"fact_types\", [])\n320\t    if any(item.get(\"objectified_as\") == assertion for item in fact_types):\n321\t        raise Refusal(\"shape:objectified-assertion\")\n322\t    roles = {item[\"id\"]: [(role[\"role_name\"], role[\"object_type\"]) for role in item[\"roles\"]] for item in fact_types}\n323\t    attached = [name for name, pairs in roles.items() if any(kind == assertion for _, kind in pairs)]\n324\t    if not attached:\n325\t        raise Refusal(\"shape:no-attached-facts\")\n326\t    followed = set(follow)\n327\t    attached_names = set(attached)\n328\t    covers = [name for name, pairs in roles.items()\n329\t              if name in attached_names or any(kind in followed for _, kind in pairs)]\n330\t    if not isinstance(subject, dict) or not isinstance(subject.get(\"population\"), dict):\n331\t        raise Refusal(\"input:invalid-contextual-population\")\n332\t    facts = subject.get(\"facts\")\n333\t    if not isinstance(facts, dict):\n334\t        raise Refusal(\"input:invalid-contextual-population\")\n335\t    rows = {}\n336\t    for name in covers:\n337\t        value = facts.get(name, [])\n338\t        names = {role for role, _ in roles[name]}\n339\t        if not isinstance(value, list) or not all(isinstance(row, dict) and set(row) == names for row in value):\n340\t            raise Refusal(\"input:invalid-contextual-population\")\n341\t        rows[name] = value\n342\t    if sum(map(len, rows.values())) > max_rows:\n343\t        raise Refusal(\"input:row-cap\")\n344\t    if not isinstance(targets, list) or len(targets) > MAX_TARGETS:\n345\t        raise Refusal(\"judgments:invalid-result\")\n346\t    seen, by_assertion, order, owned = set(), {}, {}, {}\n347\t    holders = {name: [role for role, kind in roles[name] if kind == assertion] for name in covers}\n348\t    for name in attached:\n349\t        for row in rows[name]:\n350\t            for role in holders[name]:\n351\t                key = _identity(row[role])\n352\t                order.setdefault(key, (len(order), row[role]))\n353\t                owned.setdefault((key, name), []).append(row)\n354\t    for item in targets:\n355\t        if not isinstance(item, dict) or item.get(\"fact_type\") not in roles:\n356\t            raise Refusal(\"judgments:invalid-result\")\n357\t        name, index, judgments = item[\"fact_type\"], item.get(\"index\"), item.get(\"judgments\")\n358\t        if name not in attached_names:\n359\t            raise Refusal(\"judgments:target-outside-shape\")\n360\t        if (type(index) is not int or not 0 <= index < len(rows[name]) or (name, index) in seen\n361\t                or type(item.get(\"admitted\")) is not bool or not isinstance(judgments, list) or len(judgments) > 32\n362\t                or not all(isinstance(j, dict) and j.get(\"verdict\") in (\"approve\", \"reject\", \"abstain\", \"missing\")\n363\t                           for j in judgments)):\n364\t            raise Refusal(\"judgments:invalid-result\")\n365\t        seen.add((name, index))\n366\t        for role in holders[name]:\n367\t            by_assertion.setdefault(_identity(rows[name][index][role]), []).append(item)\n368\t    reasons, policy = {}, {}\n369\t    for key in sorted(order, key=lambda item: order[item][0]):\n370\t        found = by_assertion.get(key)\n371\t        reasons[key] = \"missing\" if not found else next(\n372\t            (reason for reason in map(_target_reason, found) if reason is not None), None)\n373\t        if reasons[key] is None and requirements is not None:\n374\t            policy[key] = _evaluate_rules(requirements, lambda name, key=key: owned.get((key, name), []))\n375\t    admitted = {key for key, reason in reasons.items() if reason is None and policy.get(key) is None}\n376\t    index = {}\n377\t    for name in covers:\n378\t        for position, row in enumerate(rows[name]):\n379\t            for role, kind in roles[name]:\n380\t                if kind in followed:\n381\t                    index.setdefault((kind, _identity(row[role])), []).append((name, position))\n382\t    kept, queue = set(), deque()\n383\t\n384\t    def keep(name, position):\n385\t        row = rows[name][position]\n386\t        if (name, position) in kept or any(_identity(row[role]) not in admitted for role in holders[name]):\n387\t            return\n388\t        kept.add((name, position))\n389\t        queue.extend((kind, _identity(row[role])) for role, kind in roles[name] if kind in followed)\n390\t\n391\t    for name in attached:\n392\t        for position in range(len(rows[name])):\n393\t            keep(name, position)\n394\t    visited = set()\n395\t    while queue:\n396\t        instance = queue.popleft()\n397\t        if instance in visited:\n398\t            continue\n399\t        visited.add(instance)\n400\t        for name, position in index.get(instance, ()):\n401\t            keep(name, position)\n402\t    population = {\n403\t        **({\"format_version\": subject[\"format_version\"]} if \"format_version\" in subject else {}),\n404\t        \"population\": {**subject[\"population\"], \"source\": \"tool-output\", \"producer\": SHAPED_SCHEMA, \"covers\": covers},\n405\t        \"instances\": {},\n406\t        \"facts\": {name: [row for position, row in enumerate(rows[name]) if (name, position) in kept] for name in covers},\n407\t    }\n408\t    stages = {\"semantic-support\": [{\"assertion\": order[key][1], \"status\": \"pass\" if reason is None else \"fail\",\n409\t                                    \"reason\": reason} for key, reason in reasons.items()]}\n410\t    if requirements is not None:\n411\t        stages[\"admission-rules\"] = [\n412\t            {\"assertion\": order[key][1], \"status\": \"fail\", \"reason\": reason} if reason is not None\n413\t            else {\"assertion\": order[key][1], \"status\": \"pass\" if policy[key] is None else \"policy-refused\",\n414\t                  \"reason\": policy[key]}\n415\t            for key, reason in reasons.items()]\n416\t    return population, stages\n417\t\n418\t\n419\tdef _judgments(snapshots: dict[str, bytes], trusted_root: Path) -> tuple[dict, bytes]:\n420\t    \"\"\"Run the standard judgment route with the immutable input snapshot.\"\"\"\n421\t    with tempfile.TemporaryDirectory(prefix=\"gnd-assertions-\") as folder:\n422\t        cwd = Path(folder).resolve()\n423\t        for name, raw in snapshots.items():\n424\t            (cwd / name).parent.mkdir(parents=True, exist_ok=True)\n425\t            (cwd / name).write_bytes(raw)\n426\t        argv = (sys.executable, \"-m\", \"gnd\", \"judgments\", \"check\", MODEL, RAW,\n427\t                \"--policy\", POLICY, \"--receipts\", RECEIPTS, \"--trusted-root\", str(trusted_root.absolute()),\n428\t                \"--format\", \"json\")\n429\t        environment = ({} if DISCLOSURE_ENV not in os.environ else {DISCLOSURE_ENV: os.environ[DISCLOSURE_ENV]})\n430\t        done = asyncio.run(run_bounded_process(argv, cwd=cwd, env=environment, limits=LIMITS,\n431\t                                               disclosed_names=frozenset({DISCLOSURE_ENV})))\n432\t    if done.return_code not in (0, 1) or done.stdout_truncated or not done.process_group_cleaned:\n433\t        raise Refusal(\"judgments:refused\")\n434\t    report = strict_json(done.stdout, max_bytes=REPORT_CAP, too_large=\"judgments:report-cap\")\n435\t    if (not isinstance(report, dict) or report.get(\"command\") != \"judgments\"\n436\t            or type(report.get(\"outcome\")) is not int or report[\"outcome\"] != done.return_code\n437\t            or report.get(\"error\") is not None or not isinstance(report.get(\"judgment_policy\"), dict)):\n438\t        raise Refusal(\"judgments:invalid-result\")\n439\t    judgment = report[\"judgment_policy\"]\n440\t    if judgment.get(\"verification_contract\") != \"consumer-pinned-bytes-v1\":\n441\t        raise Refusal(\"judgments:consumer-pins-required\")\n442\t    _verify_report_inputs(judgment, snapshots)\n443\t    return judgment, done.stdout\n444\t\n445\t\n446\tdef _verify_report_inputs(judgment: dict, snapshots: dict[str, bytes]) -> None:\n447\t    policy = strict_json(snapshots[POLICY], max_bytes=1 << 20, too_large=\"input:policy-cap\")\n448\t    receipt_bytes = snapshots[RECEIPTS]\n449\t    receipts = strict_json(receipt_bytes, max_bytes=CAP, too_large=\"input:receipt-cap\")\n450\t    if not receipts[\"receipts\"]:\n451\t        receipt_bytes = canonical_json_bytes({\"schema_version\": 1, \"receipts\": []})\n452\t    targets = judgment.get(\"targets\")\n453\t    if (judgment.get(\"policy_sha256\") != sha256_hex(snapshots[POLICY])\n454\t            or judgment.get(\"receipts_sha256\") != sha256_hex(receipt_bytes)\n455\t            or not isinstance(targets, list)\n456\t            or not all(isinstance(item, dict) for item in targets)\n457\t            or [{\"fact_type\": item.get(\"fact_type\"), \"index\": item.get(\"index\")} for item in targets] != policy[\"targets\"]):\n458\t        raise Refusal(\"judgments:binding-mismatch\")\n459\t\n460\t\n461\tdef admit(model: Path, raw: Path, policy: Path, receipts: Path, trusted_root: Path, out: Path, *,\n462\t          shape: dict | None = None, rules: dict | None = None, max_targets: int | None = None,\n463\t          max_rows: int | None = None) -> dict:\n464\t    \"\"\"Check saved opinion bytes, project supported rows and publish one bound result.\n465\t\n466\t    With ``shape`` (``{\"format\": SHAPE_FORMAT, \"assertion\": ENTITY, \"follow\": [ENTITY, ...]}``) the\n467\t    assertions are the instances of a caller-named entity type, identified by their own handle, and a\n468\t    ``literature-assertion-admission/2`` record is written; without it, the packaged shape. ``rules``\n469\t    (``literature-admission-rules/1``) replace the packaged comparison, and ``max_targets`` (1 to 1,024)\n470\t    lowers the target cap; either one also writes ``/2``.\n471\t    \"\"\"\n472\t    out = out.absolute()\n473\t    if out.exists() or out.is_symlink():\n474\t        raise Refusal(\"output:exists\")\n475\t    if shape is None and max_rows is not None:\n476\t        raise Refusal(\"input:max-rows\")\n477\t    if shape is not None:\n478\t        _shape(shape)\n479\t    rows_cap = _max_rows(max_rows)\n480\t    if max_targets is not None and (type(max_targets) is not int or not 1 <= max_targets <= MAX_TARGETS):\n481\t        raise Refusal(\"input:max-targets\")\n482\t    shaped = any(value is not None for value in (shape, rules, max_targets, max_rows))\n483\t    try:\n484\t        snapshots = {\n485\t            name: read_regular_path(path, label=name, max_bytes=(1 << 20) if name == POLICY else CAP)\n486\t            for name, path in ((MODEL, model), (RAW, raw), (POLICY, policy), (RECEIPTS, receipts))\n487\t        }\n488\t    except (ArtifactError, OSError) as error:\n489\t        if shape is None:\n490\t            raise\n491\t        raise Refusal(\"input:read\") from error\n492\t    includes = {}\n493\t    if shape is not None:\n494\t        base = Path(model).absolute().parent\n495\t        try:\n496\t            includes = {path: read_regular_path(base / path, label=\"include\", max_bytes=CAP)\n497\t                        for path in _include_paths(snapshots[MODEL])}\n498\t        except (ArtifactError, OSError) as error:\n499\t            raise Refusal(\"input:include-read\") from error\n500\t    document = _model_document(snapshots, includes) if shape is not None else None\n501\t    requirements = None\n502\t    if rules is not None:\n503\t        allowed = {STATEMENT: ROLES} if shape is None else _attached_roles(document, shape)\n504\t        requirements = _rules(rules, allowed)\n505\t    if max_targets is not None:\n506\t        targets = strict_json(snapshots[POLICY], max_bytes=1 << 20, too_large=\"input:policy-cap\")\n507\t        if not isinstance(targets, dict) or not isinstance(targets.get(\"targets\"), list) \\\n508\t                or len(targets[\"targets\"]) > max_targets:\n509\t            raise Refusal(\"input:max-targets\")\n510\t    judgment, report_raw = _judgments({**snapshots, **includes}, trusted_root)\n511\t    subject = strict_json(snapshots[RAW], max_bytes=CAP, too_large=\"input:population-cap\")\n512\t    if shape is None:\n513\t        population, stages = project(subject, judgment.get(\"targets\"), requirements=requirements,\n514\t                                     policy_status=\"policy-refused\" if shaped else \"fail\")\n515\t    else:\n516\t        population, stages = project_shaped(subject, judgment.get(\"targets\"), document, shape, rows_cap,\n517\t                                            requirements=requirements)\n518\t    admitted_raw = canonical_json_bytes(population)\n519\t    record = {\n520\t        \"schema\": SCHEMA, \"model_sha256\": sha256_hex(snapshots[MODEL]), \"raw_sha256\": sha256_hex(snapshots[RAW]),\n521\t        \"policy_sha256\": sha256_hex(snapshots[POLICY]), \"receipts_sha256\": sha256_hex(snapshots[RECEIPTS]),\n522\t        \"judgment_report_sha256\": sha256_hex(report_raw), \"admitted_sha256\": sha256_hex(admitted_raw), \"stages\": stages,\n523\t    }\n524\t    if shaped:\n525\t        record.update({\n526\t            \"schema\": SHAPED_SCHEMA, \"includes\": {path: sha256_hex(raw) for path, raw in includes.items()},\n527\t            \"shape\": \"packaged\" if shape is None else \"caller\",\n528\t            \"shape_sha256\": None if shape is None else sha256_hex(canonical_json_bytes(shape)),\n529\t            \"rules_sha256\": None if rules is None else sha256_hex(canonical_json_bytes(rules)),\n530\t            \"max_targets\": MAX_TARGETS if max_targets is None else max_targets,\n531\t            \"max_rows\": None if shape is None else rows_cap,\n532\t        })\n533\t    publish_directory_once(\n534\t        out.parent, out.name, {RAW: snapshots[RAW], REPORT: report_raw, ADMITTED: admitted_raw,\n535\t                               RECORD: canonical_json_bytes(record)},\n536\t        manifest_name=RECORD, max_file_bytes=REPORT_CAP, max_total_bytes=4 * REPORT_CAP,\n537\t    )\n538\t    return record\n539\t\n540\t\n541\tdef main(argv: list[str] | None = None) -> int:\n542\t    parser = argparse.ArgumentParser(description=__doc__)\n543\t    for label in (\"model\", \"raw\", \"policy\", \"receipts\", \"trusted_root\"):\n544\t        parser.add_argument(label, type=Path)\n545\t    parser.add_argument(\"--out\", required=True, type=Path)\n546\t    args = parser.parse_args(argv)\n547\t    try:\n548\t        admit(args.model, args.raw, args.policy, args.receipts, args.trusted_root, args.out)\n549\t    except Refusal as error:\n550\t        print(json.dumps({\"exit_code\": 3, \"reason\": error.reason}))\n551\t        return 3\n552\t    except (ArtifactError, OSError, ValueError, UnicodeError, RecursionError):\n553\t        print(json.dumps({\"exit_code\": 3, \"reason\": \"input-or-output:invalid\"}))\n554\t        return 3\n555\t    print(json.dumps({\"exit_code\": 0}))\n556\t    return 0\n557\t\n558\t\n559\tif __name__ == \"__main__\":\n560\t    raise SystemExit(main())"}

562: def run(out: Path, *, budget=DEFAULT_BUDGET, scenario="full", fixture: Path = FIXTURE) -> dict:
563:     """Run the saved-response workflow and retain its complete evidence."""
564:     _need(not out.exists() and not out.is_symlink(), "reading output already exists")
565:     inputs = ReadingInputs(fixture)
566:     manifest, artifacts, report = _evaluate(inputs, budget, scenario, producer=SavedProducer(inputs.responses))
567:     out.mkdir()
568:     for name, raw in artifacts.items():
569:         (out / name).write_bytes(raw)
570:     (out / "run.json").write_bytes(canonical_json_bytes(manifest))
571:     return report
